            ]
          },
          {
            "name": "# of YTD Budget (Active student) (Non-Lương)",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Budget (Active student) (Non-Lương)],",
              "    DATESYTD('Calendar'[Date])",
              ")"
            ]
          },
          {
            "name": "# of YTD Budget Approved (Non-Lương)",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Budget Approved (Non-Lương)],",
              "    DATESYTD('Calendar'[Date])",
              ")"
            ]
          },
          {
            "name": "# of YTD Budget Remaining (Non-Lương)",
            "expression": [
              "",
              "[# of YTD Budget (Active student) (Non-Lương)]",
              "-",
              "[# of YTD Actual Expense (Non-Lương)]"
            ]
          },
          {
            "name": "# of Prev Year YTD Budget Approved",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Budget Approved],",
              "    DATESYTD(DATEADD('Calendar'[Date], -1, YEAR))",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% YTD Budget Approved Var",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of YTD Budget Approved] - [# of Prev Year YTD Budget Approved],",
              "    [# of Prev Year YTD Budget Approved]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Prev Year YTD Budget (Active student)",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Budget (Active student)],",
              "    DATESYTD(DATEADD('Calendar'[Date], -1, YEAR))",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of YTD Budget (Active student) Var",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of YTD Budget (Active student)] - [# of Prev Year YTD Budget (Active student)],",
              "    [# of Prev Year YTD Budget (Active student)]",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Prev Year YTD Actual Expense",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Actual Expense],",
              "    DATESYTD(DATEADD('Calendar'[Date], -1, YEAR))",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of YTD Actual Expense Var",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of YTD Actual Expense] - [# of Prev Year YTD Actual Expense],",
              "    [# of Prev Year YTD Actual Expense]",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Prev Year YTD Actual ActiveStudent Fin",
            "expression": [
              "",
              "CALCULATE(",
              "\t[# of Actual ActiveStudent Fin],",
              "\tDATESYTD(DATEADD('Calendar'[Date], -1, YEAR))",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% YTD Actual ActiveStudent Fin Var",
            "expression": [
              "",
              "DIVIDE(",
              "\t[# of YTD Actual ActiveStudent Fin] - [# of Prev Year YTD Actual ActiveStudent Fin],",
              "\t[# of Prev Year YTD Actual ActiveStudent Fin]",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% YTD Actual Expense label",
            "expression": [
              " SWITCH(",
              "    TRUE(),",
              "    [% of YTD Actual Expense] >= 0.9, \"Over Budget\",",
              "    [% of YTD Actual Expense] < 0.8, \"Healthy\",",
              "    \"Warning\"",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Actual Active Student",
            "expression": [
              "",
              "CALCULATE(",
              "    SUMX(",
              "        SUMMARIZE(",
              "            'Budget Management',",
              "            'Budget Management'[CampusCode],",
              "            'Budget Management'[MonthYear]",
              "        ),",
              "        CALCULATE( MAX('Budget Management'[Actual ActiveStudent]))",
              "    ),",
              "    REMOVEFILTERS('Budget Management'[Department]), NOT('Budget Management'[CampusCode] IN \t{\"NWE_VPTT\", \"HCM_VPTT\", \"EDU_VPTT\"})",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "# of FullYear Actual Expense",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Budget Management'[FullYear Actual Expense])",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of FullYear Actual Student",
            "expression": [
              "",
              "CALCULATE(",
              "    SUMX(",
              "        SUMMARIZE(",
              "            'Budget Management',",
              "            'Budget Management'[CampusCode],",
              "            'Budget Management'[MonthYear]",
              "        ),",
              "        CALCULATE( MAX('Budget Management'[FullYear Actual Student]) )",
              "    ),",
              "    REMOVEFILTERS('Budget Management'[Department])",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of YTD Actual Active Student",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Actual Active Student],",
              "    DATESYTD('Calendar'[Date])",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Full Year FullYear Actual Expense",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of FullYear Actual Expense],",
              "    ALLEXCEPT('Calendar','Calendar'[Year])",
              ")"
            ],
            "formatString": "\\$#,0.00;(\\$#,0.00);\\$#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"$ English (United States)\" Symbol=\"$\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Full Year FullYear Actual Student",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of FullYear Actual Student],",
              "    ALLEXCEPT('Calendar','Calendar'[Year])",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Full Year Cost Per Student",
            "expression": [
              "",
              "DIVIDE(",
              "\t[# of Full Year FullYear Actual Expense],",
              "\t[# of Full Year FullYear Actual Student]",
              "\t)"
            ],
            "formatString": "0.00"
          },
          {
            "name": "# of Actual Expense Full Dept",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Budget Management'[Actual Expense]), REMOVEFILTERS('Budget Management'[Department])",
              ")"
            ]
          },
          {
            "name": "# of YTD Actual Expense Full Dept",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Actual Expense Full Dept],",
              "    DATESYTD('Calendar'[Date])",
              ")"
            ]
          },
          {
            "name": "# of Full Year Actual Expense Full Dept",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Actual Expense Full Dept],",
              "    ALLEXCEPT('Calendar','Calendar'[Year])",
              ")"
            ]
          },
          {
            "name": "# of YTD Academic",
            "expression": [
              "",
              "DIVIDE(",
              "\t[# of YTD Actual Expense Full Dept],",
              "\t[# of YTD Actual Active Student]",
              "\t)"
            ]
          },
          {
            "name": "# of Full Year Actual Student",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Actual Active Student],",
              "    ALLEXCEPT('Calendar','Calendar'[Year])",
              ")"
            ]
          },
          {
            "name": "# of Full Year Academic",
            "expression": [
              "",
              "DIVIDE(",
              "\t[# of Full Year Actual Expense Full Dept],",
              "\t[# of Full Year Actual Student]",
              "\t)"
            ]
          },
          {
            "name": "% of Actual / Budget Student",
            "expression": [
              " DIVIDE(SUMX(",
              "    SUMMARIZE(",
              "        FILTER('Budget Management', NOT('Budget Management'[CampusCode] IN \t{\"NWE_VPTT\", \"HCM_VPTT\", \"EDU_VPTT\"})),",
              "        'Budget Management'[CampusCode],",
              "        'Budget Management'[MonthYear]",
              "    ),",
              "    CALCULATE(MAX('Budget Management'[Actual ActiveStudent]))",
              ")",
              ",",
              "SUMX(",
              "    SUMMARIZE(",
              "        FILTER('Budget Management', NOT('Budget Management'[CampusCode] IN \t{\"NWE_VPTT\", \"HCM_VPTT\", \"EDU_VPTT\"})),",
              "        'Budget Management'[CampusCode],",
              "        'Budget Management'[MonthYear]",
              "    ),",
              "    CALCULATE(MAX('Budget Management'[Budget ActiveStudent]))",
              ")",
              ", BLANK()",
              ") "
            ]
          }
        ]
      },
