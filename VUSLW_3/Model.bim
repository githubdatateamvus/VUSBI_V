        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TEACHING_HOURS_DETAIL_MONTH_F = Source{[Schema=\"DWH\",Item=\"VW_TEACHING_HOURS_DETAIL_MONTH_F\"]}[Data]",
                "in",
                "    DWH_VW_TEACHING_HOURS_DETAIL_MONTH_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Hour By Month By Main Campus",
            "expression": [
              " COALESCE(IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "     CALCULATE(SUM('Teaching Hours Detail By  Main Campus'[Total Hours]),USERELATIONSHIP('Teaching Hours Detail By  Main Campus'[Salary Month Year - Adjusted],'Salary Month Year'[Salary Month Year])),",
              "     CALCULATE(SUM('Teaching Hours Detail By  Main Campus'[Total Hours]),USERELATIONSHIP('Teaching Hours Detail By  Main Campus'[Salary Month Year],'Salary Month Year'[Salary Month Year]))",
              "",
              "),0.0)"
            ]
          },
          {
            "name": "# of Avg Hour Teacher By Main Campus",
            "expression": " DIVIDE('Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus],'Teaching Hours Detail By  Main Campus'[# of Month Teacher By Main Campus],0.0)"
          },
          {
            "name": "# of Month Teacher By Main Campus",
            "expression": [
              "",
              "VAR from_date =",
              "    CALCULATE ( MIN ( 'Teaching Hours Detail By  Main Campus'[Date] ) )",
              "VAR to_date =",
              "    CALCULATE ( MAX ( 'Teaching Hours Detail By  Main Campus'[Date] ) )",
              "RETURN",
              "  COALESCE(",
              "    IF (",
              "        ISBLANK ( from_date ) || ISBLANK ( to_date ),",
              "        BLANK (),",
              "        MAX ( 1, DATEDIFF ( from_date, to_date, MONTH ) )",
              "    )",
              ",0.0)"
            ]
          },
          {
            "name": "# of Class By Month By Main Campus",
            "expression": [
              " COALESCE(IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "    CALCULATE(DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[ClassId]),USERELATIONSHIP('Teaching Hours Detail By  Main Campus'[Salary Month Year - Adjusted],'Salary Month Year'[Salary Month Year])),",
              "    CALCULATE(DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[ClassId]),USERELATIONSHIP('Teaching Hours Detail By  Main Campus'[Salary Month Year],'Salary Month Year'[Salary Month Year]))",
              " ),0)"
            ]
          },
          {
            "name": "# of Hour TA By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "   CALCULATE('Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus],",
              "\t\t    FILTER(",
              "\t\t       'Teaching Hours Detail By  Main Campus',",
              "\t\t        'Teaching Hours Detail By  Main Campus'[Teacher Type Adjusted] = \"TA\"",
              "\t\t    )",
              "                         )",
              "     ,",
              "     CALCULATE('Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus],",
              "\t\t    FILTER(",
              "\t\t        'Teaching Hours Detail By  Main Campus',",
              "\t\t        'Teaching Hours Detail By  Main Campus'[Teacher Type] = \"TA\"",
              "\t\t    )",
              "                         )",
              "",
              "),0.0)"
            ]
          },
          {
            "name": "# of Hour Teacher By Main Campus",
            "expression": [
              "",
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "   CALCULATE('Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus],",
              "\t\t    FILTER(",
              "\t\t       'Teaching Hours Detail By  Main Campus',",
              "\t\t        'Teaching Hours Detail By  Main Campus'[Teacher Type Adjusted]<> \"TA\"",
              "",
              "\t\t    )",
              "                         )",
              "     ,",
              "     CALCULATE('Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus],",
              "\t\t    FILTER(",
              "\t\t        'Teaching Hours Detail By  Main Campus',",
              "\t\t        'Teaching Hours Detail By  Main Campus'[Teacher Type] <> \"TA\"",
              "",
              "\t\t    )",
              "                         )",
              "",
              "),0.0)"
            ]
          },
          {
            "name": "# of Hour Teacher NN By Main Campus",
            "expression": [
              "",
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              " CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour Teacher By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Teacher Type Adjusted] = \"NN\"",
              "    )",
              ")",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour Teacher By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Teacher Type] = \"NN\"",
              "    )",
              ")",
              "",
              "),0.0)"
            ]
          },
          {
            "name": "# of Hour Teacher NN Fulltime By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour Teacher NN By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Contract Type Adjusted]= \"FT\"",
              "    )",
              ")",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour Teacher NN By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[ContractType] = \"FT\"",
              "    )",
              ")",
              "",
              "),0.0)",
              "",
              ""
            ]
          },
          {
            "name": "# of Hour Teacher VN By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              " CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour Teacher By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Teacher Type Adjusted] = \"VN\"",
              "    )",
              ")",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour Teacher By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Teacher Type] = \"VN\"",
              "    )",
              ")",
              "",
              "),0.0)"
            ]
          },
          {
            "name": "# of Hour Teacher VN Fulltime By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "CALCULATE(",
              "     'Teaching Hours Detail By  Main Campus'[# of Hour Teacher VN By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Contract Type Adjusted]= \"FT\"",
              "    )",
              ")",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour Teacher VN By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[ContractType] = \"FT\"",
              "    )",
              ")",
              "",
              "),0.0)",
              ""
            ]
          },
          {
            "name": "# of Hour Teacher VN Parttime By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "CALCULATE(",
              "     'Teaching Hours Detail By  Main Campus'[# of Hour Teacher VN By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Contract Type Adjusted]= \"PT\"",
              "",
              "    )",
              ")",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour Teacher VN By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[ContractType] = \"PT\"",
              "",
              "    )",
              ")",
              "",
              "),0.0)",
              ""
            ]
          },
          {
            "name": "# of Main Hour By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Is SubTime Adjusted] = \"Main Hour\"",
              "    )",
              ")",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[IsSubTime] = \"Main Hour\"",
              "    )",
              ")",
              "",
              "",
              "),0.0)",
              ""
            ]
          },
          {
            "name": "# of Max Avg Hour Teacher By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "    CALCULATE( AVERAGE('Teaching Hours Detail By  Main Campus'[FullTimeType]) ,USERELATIONSHIP('Teaching Hours Detail By  Main Campus'[Salary Month Year - Adjusted],'Salary Month Year'[Salary Month Year])),",
              "    CALCULATE (AVERAGE('Teaching Hours Detail By  Main Campus'[FullTimeType]),USERELATIONSHIP('Teaching Hours Detail By  Main Campus'[Salary Month Year],'Salary Month Year'[Salary Month Year]))",
              " ),0.0)"
            ]
          },
          {
            "name": "# of Sub Hour By Main Campus",
            "expression": [
              "",
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "   CALCULATE('Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus],",
              "\t\t    FILTER(",
              "\t\t       'Teaching Hours Detail By  Main Campus',",
              "\t\t        'Teaching Hours Detail By  Main Campus'[Is SubTime Adjusted]=\"Sub Hour\"",
              "",
              "\t\t    )",
              "                         )",
              "     ,",
              "     CALCULATE(",
              "\t\t    'Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus],",
              "\t\t    FILTER(",
              "\t\t        'Teaching Hours Detail By  Main Campus',",
              "\t\t        'Teaching Hours Detail By  Main Campus'[IsSubTime] = \"Sub Hour\"",
              "",
              "\t\t    )",
              ")",
              "",
              "",
              "),0.0)",
              ""
            ]
          },
          {
            "name": "# of TA Have Hours By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              " CALCULATE(",
              "    DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[Teacher Key]),",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Teacher Type Adjusted] = \"TA\"",
              "    )",
              ")",
              "",
              "     ,",
              "    CALCULATE(",
              "    DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[Teacher Key]),",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Teacher Type] = \"TA\"",
              "    )",
              ")",
              "",
              "",
              "),0.0)"
            ]
          },
          {
            "name": "# of TA Have Hours Is Main Hours By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              " CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of TA Have Hours By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Is SubTime Adjusted] = \"Main Hour\"",
              "    )",
              ")",
              "",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of TA Have Hours By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[IsSubTime] = \"Main Hour\"",
              "    )",
              ")",
              "",
              "),0.0)",
              ""
            ]
          },
          {
            "name": "# of TA Have Hours Is Sub Hours By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              " CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of TA Have Hours By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Is SubTime Adjusted] = \"Sub Hour\"",
              "",
              "    )",
              ")",
              "",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of TA Have Hours By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[IsSubTime] = \"Sub Hour\"",
              "",
              "    )",
              ")",
              "",
              "),0)",
              ""
            ]
          },
          {
            "name": "# of Teacher Have Hours By Main Campus",
            "expression": [
              "",
              "",
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "CALCULATE(",
              "    DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[Teacher Key]),",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Teacher Type Adjusted] <> \"TA\"",
              "    )",
              ")",
              "     ,",
              "CALCULATE(",
              "    DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[Teacher Key]),",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Teacher Type] <> \"TA\"",
              "    )",
              ")",
              "",
              ")"
            ]
          },
          {
            "name": "# of Teacher Have Hours Is Main Hours   By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "CALCULATE( ",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Is SubTime Adjusted] = \"Main Hour\"",
              "    )",
              ")",
              "",
              "",
              "     ,",
              "CALCULATE( ",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[IsSubTime] = \"Main Hour\"",
              "    )",
              ")",
              "",
              "",
              "),0)",
              ""
            ]
          },
          {
            "name": "# of Teacher Have Hours Is Sub Hours  By Main Campus",
            "expression": [
              "",
              "",
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "CALCULATE( ",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Is SubTime Adjusted] = \"Sub Hour\"",
              "    )",
              "",
              "    )",
              "",
              "",
              "",
              "     ,",
              "CALCULATE( ",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[IsSubTime] = \"Sub Hour\"",
              "    )",
              "",
              "    )",
              "",
              "",
              "",
              ")",
              ""
            ]
          },
          {
            "name": "# of Teacher FT Have Hours Is Main Hours By Main Campus",
            "expression": [
              "",
              "COALESCE(",
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              " CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours Is Main Hours   By Main Campus],",
              "",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Contract Type Adjusted] = \"FT\"",
              "    )",
              ")",
              "",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of TA Have Hours By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[ContractType] = \"FT\"    )",
              ")",
              "",
              "),0)",
              ""
            ]
          },
          {
            "name": "# of Teacher FT Have Hours Is Sub Hours By Main Campus",
            "expression": [
              "",
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              " CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours Is Sub Hours  By Main Campus],",
              "",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Contract Type Adjusted] = \"FT\"",
              "    )",
              ")",
              "",
              "",
              "     ,",
              "    CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours Is Sub Hours  By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[ContractType] = \"FT\"    )",
              ")",
              "",
              ")",
              "",
              ""
            ]
          },
          {
            "name": "# of Teacher PT Have Hours Is Main Hours By Main Campus",
            "expression": [
              "",
              "",
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours Is Main Hours   By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Contract Type Adjusted]= \"PT\"",
              "    )",
              ")",
              "     ,",
              "CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours Is Main Hours   By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[ContractType] = \"PT\"",
              "    )",
              ")",
              "",
              ")"
            ]
          },
          {
            "name": "# of Teacher PT Have Hours Is Sub Hours By Main Campus",
            "expression": [
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours Is Sub Hours  By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[Contract Type Adjusted]= \"PT\"",
              "    )",
              ")",
              "     ,",
              "CALCULATE(",
              "    'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours Is Sub Hours  By Main Campus],",
              "    FILTER(",
              "        'Teaching Hours Detail By  Main Campus',",
              "        'Teaching Hours Detail By  Main Campus'[ContractType] = \"PT\"",
              "    )",
              ")",
              "",
              ")"
            ]
          },
          {
            "name": "# of Teacher NN Have Hours By Main Campus",
            "expression": [
              "",
              "",
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "   CALCULATE(  DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[Teacher Key]),",
              "",
              "\t\t    FILTER(",
              "\t\t       'Teaching Hours Detail By  Main Campus',",
              "\t\t        'Teaching Hours Detail By  Main Campus'[Teacher Type] = \"NN\"",
              "",
              "\t\t    )",
              "                         )",
              "     ,",
              "     CALCULATE(    DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[Teacher Key]),",
              "",
              "\t\t    FILTER(",
              "\t\t        'Teaching Hours Detail By  Main Campus',       ",
              "\t\t         'Teaching Hours Detail By  Main Campus'[Teacher Type] = \"NN\"",
              "",
              "\t\t    )",
              "                         )",
              "",
              ")"
            ]
          },
          {
            "name": "# of Teacher VN Have Hours By Main Campus",
            "expression": [
              "",
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "   CALCULATE(  DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[Teacher Key]),",
              "",
              "\t\t    FILTER(",
              "\t\t       'Teaching Hours Detail By  Main Campus',",
              "\t\t        'Teaching Hours Detail By  Main Campus'[Teacher Type] = \"VN\"",
              "",
              "\t\t    )",
              "                         )",
              "     ,",
              "     CALCULATE(    DISTINCTCOUNT('Teaching Hours Detail By  Main Campus'[Teacher Key]),",
              "",
              "\t\t    FILTER(",
              "\t\t        'Teaching Hours Detail By  Main Campus',       ",
              "\t\t         'Teaching Hours Detail By  Main Campus'[Teacher Type] = \"VN\"",
              "",
              "\t\t    )",
              "                         )",
              "",
              ")"
            ]
          },
          {
            "name": "# Under 32 By Main Campus",
            "expression": [
              "",
              "var Temp = SUMMARIZE('Teaching Hours Detail By  Main Campus', 'Teaching Hours Detail By  Main Campus'[Teacher Key], \"NumHour\", 'Teaching Hours Detail By  Main Campus'[# of Hour By Month By Main Campus])",
              "RETURN COALESCE(COUNTX(FILTER(Temp, [NumHour]<32), 'Teaching Hours Detail By  Main Campus'[Teacher Key]),0)"
            ]
          },
          {
            "name": "% Avg Hour Teacher By Montn Vs FullTime Tye By Main Campus",
            "expression": "DIVIDE('Teaching Hours Detail By  Main Campus'[# of Avg Hour Teacher By Main Campus],'Teaching Hours Detail By  Main Campus'[# of Max Avg Hour Teacher By Main Campus],0.0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Teacher Have Month At Main Campus Vs Teacher Assign Campus By Main Campus",
            "expression": "DIVIDE('Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours Is Main Hours   By Main Campus],'Teacher Assignment'[# of hrt teacher assign],0.0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# Class not tutoring",
            "expression": " CALCULATE('Teaching Hours Detail By  Main Campus'[# of Class By Month By Main Campus],FILTER('List Class',LEFT('List Class'[List Class Code],2) <>\"Tu\"))"
          },
          {
            "name": "# Class Size Category",
            "expression": [
              "",
              "SWITCH(",
              "    TRUE(),",
              "    [# Class not tutoring] <= 70, \"XS\",",
              "    [# Class not tutoring] <= 140, \"S\",",
              "    [# Class not tutoring] <= 210, \"M\",",
              "    [# Class not tutoring] <= 280, \"L\",",
              "    \"XL\"",
              ")"
            ]
          },
          {
            "name": "# GV EX By Formular",
            "expression": [
              "",
              "VAR Tier = SELECTEDVALUE('Map Campus Vs Hrt'[Tier_HRT])",
              "VAR Campus_code= SELECTEDVALUE('Campus'[Campus Code])",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "",
              "     Campus_code IN { \"HCM_TL8\", \"HCM_TL8-2\" },",
              "        [# Class not tutoring] /10*0.9",
              ",",
              "",
              "   AND( Tier = \"Tier 1\",Campus_code IN { \"HCM_TL8\", \"HCM_TL8-2\" }),",
              "        [# Class not tutoring] / 8.3*0.9",
              ",",
              "",
              "    Tier = \"Tier 2\",",
              "        [# Class not tutoring] / 10*0.9",
              ",0",
              "",
              ")"
            ]
          },
          {
            "name": "# Diff EX",
            "expression": " COALESCE('Teacher Assignment'[# of hrt teacher nn assign] - 'Teaching Hours Detail By  Main Campus'[# GV EX By Formular],0)"
          },
          {
            "name": "% (SL GV EX < 32 H) / Total GV",
            "expression": "COALESCE( DIVIDE('Teaching Hours Detail By  Main Campus'[# Under 32 EX By Main Campus],'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours By Main Campus],0),0.0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "#GV VN By Formular",
            "expression": " COALESCE(DIVIDE([# Class not tutoring], 8.3, 0) * 1.1,0.0)"
          },
          {
            "name": "# Diff VN",
            "expression": " COALESCE('Teacher Assignment'[# of hrt teacher vn assign] - 'Teaching Hours Detail By  Main Campus'[#GV VN By Formular],0)"
          },
          {
            "name": "# Under 32 EX By Main Campus",
            "expression": "COALESCE(CALCULATE('Teaching Hours Detail By  Main Campus'[# Under 32 By Main Campus],'Teaching Hours Detail By  Main Campus'[Teacher Type]=\"NN\"),0)"
          },
          {
            "name": "# Under 32 VN By Main Campus",
            "expression": "COALESCE(CALCULATE('Teaching Hours Detail By  Main Campus'[# Under 32 By Main Campus],'Teaching Hours Detail By  Main Campus'[Teacher Type]=\"VN\"),0)"
          },
          {
            "name": "% (SL GV VN < 32 H) / Total GV",
            "expression": "COALESCE(DIVIDE( 'Teaching Hours Detail By  Main Campus'[# Under 32 VN By Main Campus],'Teaching Hours Detail By  Main Campus'[# of Teacher Have Hours By Main Campus],0.0),0.0)",
            "formatString": "0%;-0%;0%"
          }
        ]
      },
      {
        "name": "Teaching Hours Average",
        "columns": [
          {
            "name": "Salary Month Year",
            "dataType": "string",
            "sourceColumn": "Salary Month Year"
          },
          {
            "name": "Teacher Key",
            "dataType": "string",
            "sourceColumn": "Teacher Key"
          },
          {
            "name": "Contract Type",
            "dataType": "string",
            "sourceColumn": "ContractType"
          },
          {
            "name": "Lasted Date",
            "dataType": "dateTime",
            "sourceColumn": "Lasted_Date"
          },
          {
            "name": "Total Hour",
            "dataType": "double",
            "sourceColumn": "Total Hour",
            "formatString": "0.00"
          },
          {
            "name": "Contract No",
            "dataType": "string",
            "sourceColumn": "ContractNo"
          },
          {
            "name": "Start Date",
            "dataType": "dateTime",
            "sourceColumn": "StartDate"
          },
          {
            "name": "End Date",
            "dataType": "dateTime",
            "sourceColumn": "EndDate"
          },
          {
            "name": "Contract Months",
            "dataType": "int64",
            "sourceColumn": "Month_Contract"
          },
          {
            "name": "Cumulative Hours",
            "dataType": "double",
            "sourceColumn": "Sum_Cumulative_ToTal_Hours"
          },
          {
            "name": "Avg Hour",
            "dataType": "double",
            "sourceColumn": "Avg_Hour",
            "formatString": "0.00"
          },
          {
            "name": "Fulltime Type Code",
            "dataType": "int64",
            "sourceColumn": "FulltimeTypeCode",
            "formatString": "0"
          },
          {
            "type": "calculated",
            "name": "% Avg Hour",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "DIVIDE('Teaching Hours Average'[Avg Hour],'Teaching Hours Average'[Fulltime Type Code],0.0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Cumulative_Standard_Fulltime_Hours",
            "dataType": "int64",
            "sourceColumn": "Cumulative_Standard_Fulltime_Hours"
          },
          {
            "name": "Total_Remained_Hours",
            "dataType": "double",
            "sourceColumn": "Total_Remained_Hours"
          },
          {
            "type": "calculated",
            "name": "IsPassFT",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "if('Teaching Hours Average'[% Avg Hour]>=1,1,0)"
          },
          {
            "type": "calculated",
            "name": "Seniority",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "COALESCE([Contract Months]/12,0)"
          },
          {
            "type": "calculated",
            "name": "DateSalary",
            "dataType": "dateTime",
            "isDataTypeInferred": true,
            "expression": [
              "COALESCE(DATE(",
              "    RIGHT('Teaching Hours Average'[Salary Month Year],4)*1,",
              "    LEFT('Teaching Hours Average'[Salary Month Year],2)*1,",
              "    1",
              "),DATE(",
              "    \"1900\",",
              "    \"01\",",
              "    \"01\"",
              "))"
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TQM_AVERAGE_TEACHING_HOURS_F = Source{[Schema=\"DWH\",Item=\"VW_TQM_AVERAGE_TEACHING_HOURS_F\"]}[Data]",
                "in",
                "    DWH_VW_TQM_AVERAGE_TEACHING_HOURS_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# Seniority",
            "expression": " COALESCE(CALCULATE(Sum('Teaching Hours Average'[Seniority])),0.0)"
          },
          {
            "name": "# of Seniority Teacher EX",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Seniority],'Teacher'[Teacher Type] = \"NN\"),0.0)"
          },
          {
            "name": "# of Seniority Teacher VN",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Seniority],'Teacher'[Teacher Type] = \"VN\"),0.0)"
          },
          {
            "name": "# Avg Hour By GV",
            "expression": "COALESCE(SUm('Teaching Hours Average'[Avg Hour])/DISTINCTCOUNT('Teaching Hours Average'[Teacher Key]),0.0)",
            "formatString": "0.00"
          },
          {
            "name": "# of Avg Teacher EX",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Avg Hour By GV],'Teacher'[Teacher Type] = \"NN\"),0.0)",
            "formatString": "0.00"
          },
          {
            "name": "# Avg Last Year",
            "expression": [
              "",
              "COALESCE(",
              "CALCULATE(",
              "    'Teaching Hours Average'[# Avg Hour By GV],",
              "    SAMEPERIODLASTYEAR( 'Teaching Hours Average'[DateSalary])",
              "),0.0)"
            ],
            "formatString": "0.00"
          },
          {
            "name": "# of Avg Teacher EX FT",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Avg Hour By GV],'Teacher'[Teacher Type] = \"NN\",'Teaching Hours Average'[Contract Type]=\"FT\"),0.0)",
            "formatString": "0.00"
          },
          {
            "name": "# of Avg Teacher EX PT",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Avg Hour By GV],'Teacher'[Teacher Type] = \"NN\",'Teaching Hours Average'[Contract Type]=\"PT\"),0.0)",
            "formatString": "0.00"
          },
          {
            "name": "# of Avg Teacher VN",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Avg Hour By GV],'Teacher'[Teacher Type] = \"VN\"),0.0)",
            "formatString": "0.00"
          },
          {
            "name": "# of Avg Teacher VN Last Year",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Avg Last Year],'Teacher'[Teacher Type] = \"VN\"),0.0)",
            "formatString": "0.00"
          },
          {
            "name": "# of Avg Teacher NN Last Year",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Avg Last Year],'Teacher'[Teacher Type] = \"NN\"),0.0)",
            "formatString": "0.00"
          },
          {
            "name": "# of Avg Teacher VN FT",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Avg Hour By GV],'Teacher'[Teacher Type] = \"VN\",'Teaching Hours Average'[Contract Type]=\"FT\"),0.0)"
          },
          {
            "name": "# of Avg Teacher VN PT",
            "expression": "COALESCE(CALCULATE('Teaching Hours Average'[# Avg Hour By GV],'Teacher'[Teacher Type] = \"VN\",'Teaching Hours Average'[Contract Type]=\"PT\"),0.0)"
          }
        ]
      },
