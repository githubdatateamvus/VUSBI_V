          },
          {
            "type": "calculated",
            "name": "SAME OD-PD",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF(",
              "    AND(",
              "    AND(",
              "    AND( YEAR('ASA Overview OD'[First Class Open Date]) * 100 + MONTH('ASA Overview OD'[First Class Open Date]) <= YEAR('ASA Overview OD'[Invoice Date]) * 100 + MONTH('ASA Overview OD'[Invoice Date]),  NOT(ISBLANK('ASA Overview OD'[Invoice Date]))),NOT(ISBLANK('ASA Overview OD'[Invoice Date]))),",
              "'ASA Overview OD'[First Class Open Date] <> DATE(1900, 1, 1)),",
              "    \"OD-PD\",",
              "    \"NO\"",
              "      )"
            ]
          },
          {
            "type": "calculated",
            "name": "Add Column2",
            "dataType": "int64",
            "isDataTypeInferred": true
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_OVERVIEW_OD_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_OVERVIEW_OD_F\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(DWH_VW_ASA_OVERVIEW_OD_F,{{\"MainCourseFlag\", \"Main Course Flag\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Enrol OD",
            "expression": " CALCULATE(SUM('ASA Overview OD'[Number of Enrolments]),'ASA Overview OD'[Source Type]=\"Enrol\")",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "Enrol OD Revenue Amt",
            "expression": " CALCULATE(sum('ASA Overview OD'[Enrolment Amount]),'ASA Overview OD'[Source Type]=\"Payment\")",
            "formatString": "#,0.0",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Enrol Invoice",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview OD'[Invoice ID]))",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD in the period",
            "expression": [
              " ",
              "var from_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview OD'[Number of Enrolments])",
              "\t,ALL('Calendar'[Date])",
              "\t,'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date",
              "\t,'ASA Overview OD'[Source Type]=\"Enrol\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD MTD",
            "expression": [
              " /*",
              "var from_date = min('Calendar'[First Day Of Month])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview OD'[Number of Enrolments]),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)",
              "*/",
              "CALCULATE([# of Enrol OD],DATESMTD( 'Calendar'[Date]))"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD QTD",
            "expression": [
              " ",
              "var from_date = min('Calendar'[First Day Of Quarter])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview OD'[Number of Enrolments])",
              "\t,ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date",
              "\t,'ASA Overview OD'[Source Type]=\"Enrol\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD YTD",
            "expression": [
              " ",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview OD'[Number of Enrolments])",
              "\t,ALL('Calendar'[Date])",
              "\t,'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date",
              "\t,'ASA Overview OD'[Source Type]=\"Enrol\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD in the period MTD",
            "expression": [
              " ",
              "var from_month_date = min('Calendar'[First Day Of Month])",
              "var from_report_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(DISTINCTCOUNT('ASA Overview OD'[Invoice ID])",
              "\t,ALL('Calendar'[Date])",
              "\t,'Calendar'[Date] >= from_month_date && 'Calendar'[Date] <=to_date && 'Calendar'[Date] >= from_report_date",
              "\t,'ASA Overview OD'[Source Type]=\"Enrol\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD in the period QTD",
            "expression": [
              " ",
              "var from_date = min('Calendar'[First Day Of Quarter])",
              "var from_report_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(DISTINCTCOUNT('ASA Overview OD'[Invoice ID])",
              "\t,ALL('Calendar'[Date])",
              "\t,'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date && 'Calendar'[Date] >= from_report_date",
              "\t,'ASA Overview OD'[Source Type]=\"Enrol\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD in the period YTD",
            "expression": [
              " ",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var from_report_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview OD'[Number of Enrolments])",
              "\t,ALL('Calendar'[Date])",
              "\t,'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date && 'Calendar'[Date] >= from_report_date",
              "\t,'ASA Overview OD'[Source Type]=\"Enrol\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD before the period",
            "expression": " [# of Enrol OD] - [# of Enrol OD in the period]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD before the period MTD",
            "expression": " [# of Enrol OD MTD] - [# of Enrol OD in the period MTD]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD before the period QTD",
            "expression": " [# of Enrol OD QTD] - [# of Enrol OD in the period QTD]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD before the period YTD",
            "expression": " [# of Enrol OD YTD] - [# of Enrol OD in the period YTD]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD LM",
            "expression": " CALCULATE(SUM('ASA Overview OD'[Number of Enrolments]),PREVIOUSMONTH('Calendar'[Date]),'ASA Overview OD'[Source Type]=\"Enrol\")",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol OD in the period MTD vs LM",
            "expression": " ROUND(DIVIDE([# of Enrol OD in the period MTD],[# of Enrol OD LM],BLANK()),2)",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol OD before the period MTD vs LM",
            "expression": " DIVIDE([# of Enrol OD before the period MTD],[# of Enrol OD LM],BLANK())",
            "displayFolder": "Enrol"
          },
          {
            "name": "% CR OD",
            "expression": " ROUND(DIVIDE([# of New Enrol OD],'ASA Enquiries'[# of Enquiries],BLANK()),2)",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% CR OD in the period",
            "expression": " ROUND(DIVIDE([# of New Enrol OD in the period],'ASA Enquiries'[# of Enquiries],BLANK()),2)",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol OD Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Type]=2,'ASA Target'[Target Key]=\"TotalTarget\")",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol OD Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=8,'ASA Target'[Target Type]=3,'ASA Target'[Target Key]=\"TotalTarget\")",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD Target",
            "expression": " [# of New Enrol OD Target] + [# of Re Enrol OD Target]",
            "displayFolder": "Enrol"
          },
          {
            "name": "New Enrol OD Revenue Target Amt",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=8,'ASA Target'[Target Type]=9)",
            "displayFolder": "Revenue"
          },
          {
            "name": "Re Enrol OD Revenue Target Amt",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=8,'ASA Target'[Target Type]=10)",
            "displayFolder": "Revenue"
          },
          {
            "name": "Enrol OD Revenue Target Amt",
            "expression": " [New Enrol OD Revenue Target Amt] + [Re Enrol OD Revenue Target Amt]",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Enrol OD Remain",
            "expression": " IF([# of Enrol OD] > [# of Enrol OD Target],0,[# of Enrol OD Target] - [# of Enrol OD])",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD vs Target",
            "expression": " DIVIDE([# of Enrol OD],[# of Enrol OD Target],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol OD Revenue Amt vs Target",
            "expression": " DIVIDE([Enrol OD Revenue Amt],[Enrol OD Revenue Target Amt],BLANK())",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of New Enrol OD",
            "expression": " CALCULATE(SUM('ASA Overview OD'[Number of Enrolments]),'ASA Overview OD'[New Enrol Flag]=\"New Enrol\",'ASA Overview OD'[Source Type]=\"Enrol\")",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol OD",
            "expression": [
              " --CALCULATE(SUM('ASA Overview OD'[Number of Enrolments]),'ASA Overview OD'[New Enrol Flag]=\"Re Enrol\")",
              "CALCULATE(SUM('ASA Overview OD'[Number of Enrolments]),'ASA Overview OD'[New Enrol Flag]=\"Re Enrol\",'ASA Overview OD'[Source Type]=\"Enrol\")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "New Enrol OD Revenue Amt",
            "expression": [
              " ",
              "CALCULATE(sum('ASA Overview OD'[Enrolment Amount]),'ASA Overview OD'[New Enrol Flag]=\"New Enrol\",'ASA Overview OD'[Source Type]=\"Payment\")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "New Enrol OD Revenue Amt vs Target",
            "expression": " DIVIDE([New Enrol OD Revenue Amt],[New Enrol OD Revenue Target Amt],BLANK())",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of New Enrol OD vs Target",
            "expression": " DIVIDE([# of New Enrol OD],[# of New Enrol OD Target],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol OD in the period",
            "expression": [
              " ",
              "var from_date = min('Calendar'[Date])",
              "--var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview OD'[Number of Enrolments]),'ASA Overview OD'[Showed Date] >= from_date ,'ASA Overview OD'[New Enrol Flag]=\"New Enrol\",'ASA Overview OD'[Source Type]=\"Enrol\")"
            ],
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol OD in the period",
            "expression": [
              " ",
              "var from_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview OD'[Number of Enrolments]),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date,'ASA Overview OD'[New Enrol Flag]=\"Re Enrol\",'ASA Overview OD'[Source Type]=\"Enrol\")"
            ],
            "displayFolder": "Enrol"
          },
          {
            "name": "Re Enrol OD Revenue Amt",
            "expression": [
              " ",
              "CALCULATE(sum('ASA Overview OD'[Enrolment Amount]),'ASA Overview OD'[New Enrol Flag]=\"Re Enrol\",'ASA Overview OD'[Source Type]=\"Payment\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Re Enrol OD Revenue Amt vs Target",
            "expression": " DIVIDE([Re Enrol OD Revenue Amt],[Re Enrol OD Revenue Target Amt],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Re Enrol OD vs Target",
            "expression": " DIVIDE([# of Re Enrol OD],[# of Re Enrol OD Target],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD MTD LY",
            "expression": [
              " CALCULATE([# of Enrol OD MTD], SAMEPERIODLASTYEAR('Calendar'[Date]))",
              ""
            ],
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol OD MTD Growth vs LY",
            "expression": " IF(  [# of Enrol OD MTD LY]=0, 1, ROUND(DIVIDE([# of Enrol OD MTD], [# of Enrol OD MTD LY]),2) -1)",
            "displayFolder": "Enrol"
          },
          {
            "name": "Enrol OD Revenue Amt MTD LY",
            "expression": " CALCULATE([Enrol OD Revenue Amt MTD], SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Enrol OD Revenue Amt MTD Growth vs LY",
            "expression": " IF(  [Enrol OD Revenue Amt MTD LY]=0, 1, DIVIDE([Enrol OD Revenue Amt MTD], [Enrol OD Revenue Amt MTD LY]) -1)",
            "displayFolder": "Revenue"
          },
          {
            "name": "Enrol OD Revenue Amt MTD",
            "expression": " CALCULATE([Enrol OD Revenue Amt], DATESMTD('Calendar'[Date]))",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of New Enrol OD Campus Target",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),'ASA Target Manual'[Target Type]=\"Target New Enrolment OD\")",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol OD Campus Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type]=\"Target Re Enrolment OD\"))",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD Campus Target",
            "expression": " [# of New Enrol OD Campus Target] + [# of Re Enrol OD Campus Target]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "Revenue OD Campus Target",
            "expression": "[New Revenue OD Campus Target]+ [Re Revenue OD Campus Target]",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Student OD",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview OD'[User Information ID]))",
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "# of Class OD",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview OD'[First Class ID]))",
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "# of New Student OD",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview OD'[User Information ID]),'ASA Overview OD'[New Enrol Flag]=\"New Enrol\")",
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "# of Re Student OD",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview OD'[User Information ID]),'ASA Overview OD'[New Enrol Flag]=\"Re Enrol\")",
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "New Revenue OD Campus Target",
            "expression": [
              " CALCULATE(SUM('ASA Target Manual'[Target Value]),'ASA Target Manual'[Target Type]=\"Target New Revenue OD\")",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Re Revenue OD Campus Target",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),'ASA Target Manual'[Target Type]=\"Target Re Revenue OD\")",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Enrol OD Revenue Amt vs Campus Target",
            "expression": " DIVIDE([Enrol OD Revenue Amt],[Revenue OD Campus Target],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "displayFolder": "Revenue"
          },
          {
            "name": "% New Enrol OD Revenue Amt vs Campus Target",
            "expression": " DIVIDE([New Enrol OD Revenue Amt],[New Revenue OD Campus Target],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Re Enrol OD Revenue Amt vs Campus Target",
            "expression": " DIVIDE([Re Enrol OD Revenue Amt],[Re Revenue OD Campus Target],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Enrol OD LY",
            "expression": [
              " ",
              "var from_date = min('Calendar'[First Day Of Last Year])",
              "var to_date = max('Calendar'[Last Day Of Last Year])",
              "return CALCULATE(SUM('ASA Overview OD'[Number of Enrolments])",
              "\t,ALL('Calendar'[Date])",
              "\t,'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date",
              "\t,'ASA Overview OD'[Source Type]=\"Enrol\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol OD YTD Growth vs LY",
            "expression": " DIVIDE(([# of Enrol OD LY] - [# of Enrol OD YTD]),[# of Enrol OD LY],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol OD vs Campus Target",
            "expression": " DIVIDE([# of Enrol OD],[# of Enrol OD Campus Target],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% New Enrol OD vs Campus Target",
            "expression": " DIVIDE([# of New Enrol OD],[# of New Enrol OD Campus Target],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Re Enrol OD vs Campus Target",
            "expression": [
              " DIVIDE([# of Re Enrol OD],[# of Re Enrol OD Campus Target])",
              "--AVERAGEX(KEEPFILTERS(VALUES('Calendar'[Year Month])),CALCULATE(DIVIDE([# of Re Enrol OD],[# of Re Enrol OD Campus Target]))",
              "",
              ""
            ],
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Revenue Per Student OD",
            "expression": " DIVIDE([Enrol OD Revenue Amt],[# of Student OD],BLANK())",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Enrol By Campus By Chanel OD",
            "expression": [
              " CALCULATE(",
              "SUM('ASA Overview OD'[Number of Enrolments])",
              ",'ASA Overview OD'[Source Type]=\"Enrol\"",
              ",GROUPBY(Campus,Campus[Campus Code])",
              ",GROUPBY('List Consultant Type','List Consultant Type'[Channel])",
              ",REMOVEFILTERS()",
              ")"
            ]
          },
          {
            "name": "% Enrol By Campus By Chanel OD",
            "expression": "'ASA Overview OD'[# of Enrol OD]/'ASA Overview OD'[# of Enrol By Campus By Chanel OD]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Enrol OD 2019",
            "expression": [
              " ",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([# of Enrol OD],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol OD vs 2019",
            "expression": " DIVIDE([# of Enrol OD],[# of Enrol OD 2019],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol OD vs Budget",
            "expression": " DIVIDE([# of Enrol OD],[# of Enrol OD Budget],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "Enrol OD Revenue Amt 2019",
            "expression": [
              " ",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([Enrol OD Revenue Amt],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))"
            ],
            "formatString": "#,0.0",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Revenue OD vs Target",
            "expression": " DIVIDE([Enrol OD Revenue Amt],[Enrol OD Revenue Target Amt],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Revenue OD vs Budget",
            "expression": " DIVIDE([Enrol OD Revenue Amt],[Enrol OD Revenue Budget Amt],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Revenue OD vs 2019",
            "expression": " DIVIDE([Enrol OD Revenue Amt],[Enrol OD Revenue Amt 2019],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of New Student OD in the period",
            "expression": [
              " ",
              "var from_date = min('Calendar'[Date])",
              "return  CALCULATE(DISTINCTCOUNT('ASA Overview OD'[User Information ID]),'ASA Overview OD'[New Enrol Flag]=\"New Enrol\",'ASA Overview OD'[Showed Date] >= from_date,'ASA Overview OD'[Source Type]=\"Enrol\")"
            ]
          },
          {
            "name": "% Enrol OD vs Target",
            "expression": " [% Enrol OD vs Campus Target]",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD YTD LY",
            "expression": " CALCULATE([# of Enrol OD YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol OD YTD Growth vs YTD LY",
            "expression": " DIVIDE(([# of Enrol OD YTD] - [# of Enrol OD YTD LY]),[# of Enrol OD YTD LY],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol OD Budget",
            "expression": [
              "",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Enrol Opendate\"",
              "\t,'ASA Budget'[SubType]=\"New\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol OD Budget",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Enrol Opendate\"",
              "\t,'ASA Budget'[SubType]=\"Re\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol OD Budget",
            "expression": " [# of New Enrol OD Budget] + [# of Re Enrol OD Budget]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "Enrol OD Revenue Budget Amt",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Tuition Opendate\"",
              "\t,'ASA Budget'[SubType]=\"Tuition Opendate\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Enrol OD YOY",
            "expression": [
              " DIVIDE(",
              "[# of Enrol OD]-CALCULATE([# of Enrol OD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
              ",CALCULATE([# of Enrol OD],SAMEPERIODLASTYEAR('Calendar'[Date])),BLANK())",
              ""
            ],
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol OD Login VHub OD",
            "expression": " CALCULATE('ASA Overview OD'[# of Re Enrol OD],'Student'[IsLoginLMS] =\"True\")",
            "formatString": "0"
          },
          {
            "name": "# of Re Enrol OD Not Login VHub OD",
            "expression": " CALCULATE('ASA Overview OD'[# of Re Enrol OD],'Student'[IsLoginLMS] =\"False\")",
            "formatString": "0"
          },
          {
            "name": "% REOpen Login VHub",
            "expression": " DIVIDE( 'ASA Overview OD'[# of Re Enrol OD Login VHub OD],'ASA Overview OD'[# of Re Enrol OD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% REOpen Not Login VHub",
            "expression": " DIVIDE( 'ASA Overview OD'[# of Re Enrol OD Not Login VHub OD],'ASA Overview OD'[# of Re Enrol OD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Student OD Budget",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Student Opendate\"",
              "\t,'ASA Budget'[SubType]=\"New\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Re Student OD Budget",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Student Opendate\"",
              "\t,'ASA Budget'[SubType]=\"Re\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "% Average Re-Sign",
            "expression": [
              " ",
              "VAR Percentage_OD_vs_target = 'ASA Overview OD'[# of Re Enrol OD vs Target]",
              "VAR Percentage_KKHT = 'ASA Push Sale'[% Act vs Target KKHT]",
              "VAR Percentage_Pending = 'ASA Push Sale'[% Act vs Target Pending]",
              "VAR result = (Percentage_OD_vs_target +Percentage_KKHT+Percentage_Pending)/3",
              "Return result"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Student OD-PD",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview OD'[User Information ID]),'ASA Overview OD'[New Enrol Flag]=\"New Enrol\",'ASA Overview OD'[SAME OD-PD]=\"OD-PD\" )",
            "formatString": "0"
          },
          {
            "name": "# RE OD YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Overview OD'[# of Re Enrol OD],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "RE OD YTD PY",
            "expression": " CALCULATE('ASA Overview OD'[# RE OD YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Re Student OD PY",
            "expression": "CALCULATE('ASA Overview OD'[# of Re Student OD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Re Student OD YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Overview OD'[# of Re Student OD],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "# of Re Student OD YTD PY",
            "expression": " CALCULATE('ASA Overview OD'[# of Re Student OD YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of Re Student Target",
            "expression": " DIVIDE('ASA Overview OD'[# of Re Student OD],'ASA Overview OD'[# of Re Student OD Budget],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of Re Student PY",
            "expression": " DIVIDE('ASA Overview OD'[# of Re Student OD],'ASA Overview OD'[# of Re Student OD PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of Re Student YTD vs PY",
            "expression": " DIVIDE('ASA Overview OD'[# of RE Student OD YTD],'ASA Overview OD'[# of RE Student OD YTD PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "ASA Performance ReOD Bonus",
            "expression": [
              "",
              "SWITCH(",
              "   TRUE(),",
              "   [ASA Performance ReOD Rank] = \"Vượt trội\", 6000000,",
              "   [ASA Performance ReOD Rank] = \"Xuất sắc\", 3000000,",
              "   [ASA Performance ReOD Rank] =  \"Giỏi\", 1000000,  ",
              "   0",
              ")"
            ],
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Re Enrol OD ASA Need Gioi",
            "expression": "if(roundup('ASA Overview OD'[# of Re Enrol OD Target]*0.95,0)-'ASA Overview OD'[# of Re Enrol OD]>0,roundup('ASA Overview OD'[# of Re Enrol OD Target]*0.95,0)-'ASA Overview OD'[# of Re Enrol OD],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of Re Enrol OD ASA Xuat Sac",
            "expression": "if(roundup('ASA Overview OD'[# of Re Enrol OD Target]*1.0,0)-'ASA Overview OD'[# of Re Enrol OD]>0,roundup('ASA Overview OD'[# of Re Enrol OD Target]*1.0,0)-'ASA Overview OD'[# of Re Enrol OD],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of Re Enrol OD ASA Need Vuot Troi",
            "expression": "if(roundup('ASA Overview OD'[# of Re Enrol OD Target]*1.05,0)-'ASA Overview OD'[# of Re Enrol OD]>0,roundup('ASA Overview OD'[# of Re Enrol OD Target]*1.05,0)-'ASA Overview OD'[# of Re Enrol OD],0)",
            "formatString": "0.00"
          }
        ]
      },
