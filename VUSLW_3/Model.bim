        "measures": [
          {
            "name": "# of CVs By Province",
            "expression": [
              "",
              "var from_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "Return CALCULATE(DISTINCTCOUNT('HRT Application Location'[ApplicationId]),'HRT Application'[IsCVNonDup] = TRUE(),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          }
        ]
