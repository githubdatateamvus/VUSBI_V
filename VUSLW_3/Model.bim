      {
        "name": "Core Survey",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "int64",
            "sourceColumn": "Date Key"
          },
          {
            "name": "Survey Code",
            "dataType": "string",
            "sourceColumn": "Survey Code"
          },
          {
            "name": "Student Key",
            "dataType": "string",
            "sourceColumn": "Student Key"
          },
          {
            "name": "Branch Key",
            "dataType": "string",
            "sourceColumn": "Branch Key"
          },
          {
            "name": "Core Region",
            "dataType": "string",
            "sourceColumn": "Core Region"
          },
          {
            "name": "List class Key",
            "dataType": "string",
            "sourceColumn": "List class Key"
          },
          {
            "name": "Program ID",
            "dataType": "string",
            "sourceColumn": "Program ID"
          },
          {
            "name": "Template ID",
            "dataType": "string",
            "sourceColumn": "Template ID"
          },
          {
            "name": "Student Code",
            "dataType": "string",
            "sourceColumn": "Student Code"
          },
          {
            "name": "Program Code",
            "dataType": "string",
            "sourceColumn": "Program Code"
          },
          {
            "name": "Campus Code",
            "dataType": "string",
            "sourceColumn": "Campus Code"
          },
          {
            "name": "Leadid",
            "dataType": "string",
            "sourceColumn": "Leadid"
          },
          {
            "name": "Question",
            "dataType": "string",
            "sourceColumn": "Question"
          },
          {
            "name": "Answer",
            "dataType": "string",
            "sourceColumn": "Answer"
          },
          {
            "name": "Form",
            "dataType": "string",
            "sourceColumn": "Form"
          },
          {
            "name": "QC Activity",
            "dataType": "string",
            "sourceColumn": "QC Activity"
          },
          {
            "name": "Survey Question ID",
            "dataType": "string",
            "sourceColumn": "Survey Question ID"
          },
          {
            "name": "URL",
            "dataType": "string",
            "sourceColumn": "URL"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status"
          },
          {
            "name": "Area",
            "dataType": "string",
            "sourceColumn": "Area"
          },
          {
            "name": "Level Key",
            "dataType": "string",
            "sourceColumn": "Level Key"
          },
          {
            "name": "IsSatisfied",
            "dataType": "int64",
            "sourceColumn": "IsSatisfied"
          },
          {
            "name": "isCSAT",
            "dataType": "string",
            "sourceColumn": "isCSAT"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_SURVEY_F = Source{[Schema=\"DWH\",Item=\"VW_SURVEY_F\"]}[Data]",
                "in",
                "    DWH_VW_SURVEY_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "% Question CSAT",
            "expression": [
              " ",
              "CALCULATE(",
              "    DIVIDE(",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]), 'Core Survey'[IsSatisfied] = 1),",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]),NOT(ISBLANK('Core Survey'[IsSatisfied]))",
              "    )",
              "))"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Question Detractor",
            "expression": [
              " ",
              "CALCULATE(",
              "    DIVIDE(",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]), 'Core Survey'[IsSatisfied] = -1),",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]),NOT(ISBLANK('Core Survey'[IsSatisfied]))",
              ")",
              "    )",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Responser",
            "expression": [
              " ",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Current\",CALCULATE(",
              "    DIVIDE(",
              "        CALCULATE(DISTINCTCOUNT('Core Survey'[Survey Code]), 'Core Survey'[Status] = \"Submitted\"),",
              "        CALCULATE(DISTINCTCOUNT('Core Survey'[Survey Code]))",
              "    )",
              "))"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Responser LM",
            "expression": [
              " SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Previous\",",
              "CALCULATE(DIVIDE(",
              "        CALCULATE(DISTINCTCOUNT('Core Survey'[Survey Code]), 'Core Survey'[Status] = \"Submitted\"),",
              "        CALCULATE(DISTINCTCOUNT('Core Survey'[Survey Code]))",
              "    )",
              ",DATEADD('Calendar'[Date],-1,MONTH)",
              "))"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Question Detractor LM",
            "expression": [
              " CALCULATE('Core Survey'[% Question Detractor],DATEADD('Calendar'[Date],-1,MONTH)",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Question CSAT LM",
            "expression": [
              " CALCULATE('Core Survey'[% Question CSAT],DATEADD('Calendar'[Date],-1,MONTH)",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Submitted Survey Code",
            "expression": [
              "",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Current\",",
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Core Survey'[Survey Code]),",
              "    'Core Survey'[Status] = \"Submitted\"",
              "))"
            ]
          },
          {
            "name": "# of Submitted Survey Code LM",
            "expression": [
              " ",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Previous\",",
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Core Survey'[Survey Code]),",
              "    'Core Survey'[Status] = \"Submitted\",DATEADD('Calendar'[Date],-1,MONTH)",
              ")",
              ")",
              "",
              ""
            ]
          },
          {
            "name": "# of Waiting Survey Code",
            "expression": [
              "",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Current\",",
              "CALCULATE(",
              "    DISTINCTCOUNT('Core Survey'[Survey Code]),",
              "    'Core Survey'[Status] = \"Waiting for Submission\"",
              ")",
              ")"
            ]
          },
          {
            "name": "# of Waiting Survey Code LM",
            "expression": [
              "",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Previous\",",
              "CALCULATE(",
              "    DISTINCTCOUNT('Core Survey'[Survey Code]),",
              "    'Core Survey'[Status] = \"Waiting for Submission\",DATEADD('Calendar'[Date],-1,MONTH)",
              ")",
              ")"
            ]
          },
          {
            "name": "# of Survey Code",
            "expression": [
              " ",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Current\",",
              "CALCULATE(DISTINCTCOUNT('Core Survey'[Survey Code]))",
              ")"
            ]
          },
          {
            "name": "# of Survey Code LM",
            "expression": [
              " ",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Previous\",",
              "CALCULATE(DISTINCTCOUNT('Core Survey'[Survey Code]),DATEADD('Calendar'[Date],-1,MONTH))",
              ")"
            ]
          },
          {
            "name": "# Negative",
            "expression": [
              "",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Current\",",
              "CALCULATE(DISTINCTCOUNT('Core Survey'[Survey Code]),'Core Survey','Core Survey'[isCSAT] <> \"1\")",
              ")"
            ]
          },
          {
            "name": "% Negative",
            "expression": [
              " ",
              "  DIVIDE(",
              "        'Core Survey'[# Negative],",
              "        'Core Survey'[# of Submitted Survey Code]",
              "        )"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Csat LM",
            "expression": [
              " ",
              "  DIVIDE(",
              "        'Core Survey'[# Csat LM],",
              "        'Core Survey'[# of Submitted Survey Code LM]",
              "        )"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Negative LM",
            "description": "2",
            "expression": [
              " ",
              "  DIVIDE(",
              "        'Core Survey'[# Negative LM],",
              "        'Core Survey'[# of Submitted Survey Code LM]",
              "        )"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# Csat LM",
            "expression": [
              "",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Previous\",",
              "CALCULATE(DISTINCTCOUNT('Core Survey'[Survey Code]),'Core Survey'[isCSAT] = \"1\",DATEADD('Calendar'[Date],-1,MONTH)",
              ")",
              ")"
            ]
          },
          {
            "name": "# Negative LM",
            "expression": [
              "",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Previous\",",
              "CALCULATE(DISTINCTCOUNT('Core Survey'[Survey Code]),'Core Survey'[isCSAT] <> \"1\",DATEADD('Calendar'[Date],-1,MONTH)",
              ")",
              ")"
            ]
          },
          {
            "name": "% Yes Answer",
            "expression": " CALCULATE(DIVIDE(CALCULATE(COUNT('Core Survey'[Answer]),'Core Survey'[Answer] =\"Có\"),CALCULATE(COUNT('Core Survey'[Answer]),NOT(ISBLANK('Core Survey'[Answer])))))",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% No Answer",
            "expression": " CALCULATE(DIVIDE(CALCULATE(COUNT('Core Survey'[Answer]),'Core Survey'[Answer] =\"Không\"),CALCULATE(COUNT('Core Survey'[Answer]),NOT(ISBLANK('Core Survey'[Answer])))))",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Question Negative",
            "expression": [
              " ",
              "CALCULATE(",
              "    DIVIDE(",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]), 'Core Survey'[IsSatisfied] = -1),",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]),NOT(ISBLANK('Core Survey'[IsSatisfied]))",
              ")))"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# Of Yes Answer",
            "expression": " CALCULATE(COUNT('Core Survey'[Answer]),'Core Survey'[Answer] =\"Có\")"
          },
          {
            "name": "# Of No Answer",
            "expression": " CALCULATE(COUNT('Core Survey'[Answer]),'Core Survey'[Answer] =\"Không\")"
          },
          {
            "name": "# of Submitted Survey Code Old",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Core Survey'[Survey Code]),",
              "    'Core Survey'[Status] = \"Submitted\"",
              ")"
            ]
          },
          {
            "name": "# of Submitted Survey Code Old LM",
            "expression": [
              "",
              "CALCULATE('Core Survey'[# of Submitted Survey Code Old],DATEADD('Calendar'[Date],-1,MONTH))"
            ]
          },
          {
            "name": "% Question CSAT New",
            "expression": [
              " ",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Current\",CALCULATE(",
              "    DIVIDE(",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]), 'Core Survey'[IsSatisfied] = 1),",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]),NOT(ISBLANK('Core Survey'[IsSatisfied]))",
              "    )",
              ")))"
            ]
          },
          {
            "name": "% Question CSAT New LM",
            "expression": [
              " ",
              "SWITCH(SELECTEDVALUE('Axis Data'[Data]),\"Previous\",CALCULATE(",
              "    DIVIDE(",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]), 'Core Survey'[IsSatisfied] = 1),",
              "        CALCULATE(COUNT('Core Survey'[Survey Code]),NOT(ISBLANK('Core Survey'[IsSatisfied]))",
              "    )",
              "),DATEADD('Calendar'[Date],-1,MONTH)))"
            ]
          }
        ]
      },
