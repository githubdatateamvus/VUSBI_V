            "dataType": "int64",
            "sourceColumn": "created_hour"
          },
          {
            "name": "response_time_seconds",
            "dataType": "int64",
            "sourceColumn": "response_time_seconds"
          },
          {
            "name": "W_INTEGRATION_ID",
            "dataType": "string",
            "sourceColumn": "W_INTEGRATION_ID"
          },
          {
            "name": "W_EFFECTIVE_FROM_DT",
            "dataType": "dateTime",
            "sourceColumn": "W_EFFECTIVE_FROM_DT"
          },
          {
            "name": "W_EFFECTIVE_TO_DT",
            "dataType": "dateTime",
