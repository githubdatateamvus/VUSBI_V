              }
            ]
          },
          {
            "name": "% Of Lead Direct",
            "expression": " divide('Lead'[# Of Lead Direct] ,'Lead'[# of Lead])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Lead Referral",
            "expression": "CALCULATE('Lead'[# of Lead],'Source Information'[Media]=\"Referral\")",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% of Lead Digital vs Target",
            "expression": " DIVIDE( 'Lead'[# Of Lead Digital],'MKT Kpi Target Manual'[# of Kpi By Lead Digital Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Lead Direct vs Target",
            "expression": " DIVIDE( 'Lead'[# Of Lead Direct],'MKT Kpi Target Manual'[# of Kpi By Lead Dmk Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Lead Referral vs Target",
            "expression": " DIVIDE( 'Lead'[# of Lead Referral],'MKT Kpi Target Manual'[# of Kpi By Lead / QLead Referral Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Q.Lead To Lead Appoiment",
            "expression": " DIVIDE('Lead'[# of Lead Appoinment],'Lead'[# of Qualify Lead CRM],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Lead Appt to Show CRM",
            "expression": "DIVIDE('Lead'[# of Lead Enquiries CRM],'Lead'[# of Lead Appoinment],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Lead Appoinment For Month",
            "expression": [
              "",
              "CALCULATE('Lead'[# of Lead Appoinment],USERELATIONSHIP('Lead'[Date Appointment Key],'Calendar'[Date Key]))"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Care in Month",
            "expression": [
