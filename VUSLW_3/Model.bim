          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_OFFTRACK_COMPARE_STUDENT_SCORE_SK_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_OFFTRACK_COMPARE_STUDENT_SCORE_SK_F\"]}[Data]",
                "in",
                "    DWH_VW_ASA_OFFTRACK_COMPARE_STUDENT_SCORE_SK_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Group Vocabulary Increase Score",
            "expression": "CALCULATE(COUNT('ASA Offtrack Compare Score SK'[STUDENT_KEY]),ISBLANK('ASA Offtrack Compare Score SK'[Diff Vocabulary]) = FALSE() && 'ASA Offtrack Compare Score SK'[Diff Vocabulary]>0)"
          },
          {
            "name": "# of Group Vocabulary No Increase Score",
            "expression": "CALCULATE(COUNT('ASA Offtrack Compare Score SK'[STUDENT_KEY]),ISBLANK('ASA Offtrack Compare Score SK'[Diff Vocabulary]) = FALSE() && 'ASA Offtrack Compare Score SK'[Diff Vocabulary]=0)"
          },
          {
            "name": "# of Group Vocabulary Decrease Score",
            "expression": "CALCULATE(COUNT('ASA Offtrack Compare Score SK'[STUDENT_KEY]),ISBLANK('ASA Offtrack Compare Score SK'[Diff Vocabulary])=FALSE() && 'ASA Offtrack Compare Score SK'[Diff Vocabulary]<0)"
          },
          {
            "name": "# of Group Reading Increase Score",
            "expression": "CALCULATE(COUNT('ASA Offtrack Compare Score SK'[STUDENT_KEY]),ISBLANK('ASA Offtrack Compare Score SK'[Diff Reading]) = FALSE() && 'ASA Offtrack Compare Score SK'[Diff Reading]>0)"
          },
          {
            "name": "# of Group Reading No Increase Score",
            "expression": "CALCULATE(COUNT('ASA Offtrack Compare Score SK'[STUDENT_KEY]),ISBLANK('ASA Offtrack Compare Score SK'[Diff Reading])=FALSE() && 'ASA Offtrack Compare Score SK'[Diff Reading]=0)"
          },
          {
            "name": "# of Group Reading Decrease Score",
            "expression": "CALCULATE(COUNT('ASA Offtrack Compare Score SK'[STUDENT_KEY]),ISBLANK('ASA Offtrack Compare Score SK'[Diff Reading]) = FALSE() && 'ASA Offtrack Compare Score SK'[Diff Reading]<0)"
          },
          {
            "name": "% Group Vocabulary Increase Score Vs Total Student",
            "expression": "DIVIDE('ASA Offtrack Compare Score SK'[# of Group Vocabulary Increase Score],'ASA Offtrack Compare Score SK'[# of Total StudentHasScorePrev],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Group Vocabulary No Increase Score Vs Total Student",
            "expression": "DIVIDE('ASA Offtrack Compare Score SK'[# of Group Vocabulary No Increase Score],'ASA Offtrack Compare Score SK'[# of Total StudentHasScorePrev],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Group Vocabulary Decrease Score Vs Total Student",
            "expression": "DIVIDE('ASA Offtrack Compare Score SK'[# of Group Vocabulary Decrease Score],'ASA Offtrack Compare Score SK'[# of Total StudentHasScorePrev],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Group Reading Increase Score Vs Total Student",
            "expression": "DIVIDE('ASA Offtrack Compare Score SK'[# of Group Reading Increase Score],'ASA Offtrack Compare Score SK'[# of Total StudentHasScorePrev],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Group Reading No Increase Score Vs Total Student",
            "expression": "DIVIDE('ASA Offtrack Compare Score SK'[# of Group Reading No Increase Score],'ASA Offtrack Compare Score SK'[# of Total StudentHasScorePrev],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Group Reading Decrease Score Vs Total Student",
            "expression": "DIVIDE('ASA Offtrack Compare Score SK'[# of Group Reading Decrease Score],'ASA Offtrack Compare Score SK'[# of Total StudentHasScorePrev],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of AVE Group Vocabulary Increase Score After",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 2.Vocabulary]),'ASA Offtrack Compare Score SK'[Diff Vocabulary]>0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Vocabulary No Increase Score After",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 2.Vocabulary]),'ASA Offtrack Compare Score SK'[Diff Vocabulary]=0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Vocabulary Decrease Score After",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 2.Vocabulary]),'ASA Offtrack Compare Score SK'[Diff Vocabulary]<0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Reading Increase Score After",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 4.Reading]),'ASA Offtrack Compare Score SK'[Diff Reading]>0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Reading No Increase Score After",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 4.Reading]),'ASA Offtrack Compare Score SK'[Diff Reading]=0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Reading Decrease Score After",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 4.Reading]),'ASA Offtrack Compare Score SK'[Diff Reading]<0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Vocabulary Increase Score Before",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 2.Vocabulary Previous]),'ASA Offtrack Compare Score SK'[Diff Vocabulary]>0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Vocabulary No Increase Score Before",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 2.Vocabulary Previous]),'ASA Offtrack Compare Score SK'[Diff Vocabulary]=0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Vocabulary Decrease Score Before",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 2.Vocabulary Previous]),'ASA Offtrack Compare Score SK'[Diff Vocabulary]<0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Reading Increase Score Before",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 4.Reading Previous]),'ASA Offtrack Compare Score SK'[Diff Reading]>0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Reading No Increase Score Before",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 4.Reading Previous]),'ASA Offtrack Compare Score SK'[Diff Reading]=0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Group Reading Decrease Score Before",
            "expression": "CALCULATE(AVERAGE('ASA Offtrack Compare Score SK'[Final written 4.Reading Previous]),'ASA Offtrack Compare Score SK'[Diff Reading]<0)",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Diff Group Vocabulary Increase",
            "expression": " 'ASA Offtrack Compare Score SK'[# of AVE Group Vocabulary Increase Score After] -  'ASA Offtrack Compare Score SK'[# of AVE Group Vocabulary Increase Score Before]",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Diff Group Vocabulary No Increase",
            "expression": " 'ASA Offtrack Compare Score SK'[# of AVE Group Vocabulary No Increase Score After]  -  'ASA Offtrack Compare Score SK'[# of AVE Group Vocabulary No Increase Score Before]",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Diff Group Vocabulary Decrease",
            "expression": " 'ASA Offtrack Compare Score SK'[# of AVE Group Vocabulary Decrease Score After]  -  'ASA Offtrack Compare Score SK'[# of AVE Group Vocabulary Decrease Score Before]",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Diff Group Reading Increase",
            "expression": " 'ASA Offtrack Compare Score SK'[# of AVE Group Reading Increase Score After] -  'ASA Offtrack Compare Score SK'[# of AVE Group Reading Increase Score Before]",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Diff Group Reading No Increase",
            "expression": " 'ASA Offtrack Compare Score SK'[# of AVE Group Reading No Increase Score After] -  'ASA Offtrack Compare Score SK'[# of AVE Group Reading No Increase Score Before]",
            "formatString": "0.00"
          },
          {
            "name": "# of AVE Diff Group Reading Decrease",
            "expression": " 'ASA Offtrack Compare Score SK'[# of AVE Group Reading Decrease Score After] -  'ASA Offtrack Compare Score SK'[# of AVE Group Reading Decrease Score Before]",
            "formatString": "0.00"
          },
          {
            "name": "# of Total StudentHasScore",
            "expression": " CALCULATE(COUNT('ASA Offtrack Compare Score SK'[STUDENT_KEY]),ISBLANK('ASA Offtrack Compare Score SK'[Final written 1.Listening])=FALSE())"
          },
          {
            "name": "# of Total StudentHasScorePrev",
            "expression": " CALCULATE(COUNT('ASA Offtrack Compare Score SK'[STUDENT_KEY]),ISBLANK('ASA Offtrack Compare Score SK'[List Class Code Previous] )=FALSE())"
          },
          {
            "name": "# of Total StudentKK",
            "expression": " CALCULATE(COUNT('ASA Offtrack Compare Score SK'[STUDENT_KEY]))"
          }
        ]
      },
