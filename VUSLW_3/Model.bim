            "dataType": "dateTime",
            "sourceColumn": "DateOfClose"
          },
          {
            "name": "CreatedOn",
            "dataType": "dateTime",
            "sourceColumn": "CreatedOn"
          },
          {
            "name": "ListClassCode",
            "dataType": "string",
            "sourceColumn": "ListClassCode"
          },
          {
            "name": "OldStudentInClass",
            "dataType": "int64",
            "sourceColumn": "OldStudentInClass"
          },
          {
            "name": "NewStudentInClass",
            "dataType": "int64",
            "sourceColumn": "NewStudentInClass"
          },
          {
            "name": "ReEnrolRate",
            "dataType": "double",
            "sourceColumn": "ReEnrolRate",
            "formatString": "0"
          },
          {
            "name": "TeacherCode",
            "dataType": "string",
            "sourceColumn": "TeacherCode"
          },
          {
            "name": "GVNN",
            "dataType": "string",
            "sourceColumn": "GVNN"
          },
          {
            "name": "GVVN",
            "dataType": "string",
            "sourceColumn": "GVVN"
          },
          {
            "name": "TA",
            "dataType": "string",
            "sourceColumn": "TA"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TQM_DETAIL_REENROLMENTRATE_BY_TEACHER = Source{[Schema=\"DWH\",Item=\"VW_TQM_DETAIL_REENROLMENTRATE_BY_TEACHER\"]}[Data]",
                "in",
                "    DWH_VW_TQM_DETAIL_REENROLMENTRATE_BY_TEACHER"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Re Enrollment Rate",
            "expression": [
              " ",
              "VAR newstudent = CALCULATE(SUM('TQM ReEnrolment'[NewStudentInClass]))",
              "VAR oldstudent = CALCULATE(SUM('TQM ReEnrolment'[OldStudentInClass]))  ",
              "VAR result = DIVIDE(newstudent,oldstudent,BLANK())",
              "Return result"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
      {
        "name": "Dashboard PBI Notes",
        "columns": [
          {
            "name": "RowNumber",
            "dataType": "int64",
            "sourceColumn": "RowNumber"
