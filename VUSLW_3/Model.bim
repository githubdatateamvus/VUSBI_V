            "name": "Gross Cost",
            "dataType": "double",
            "sourceColumn": "Gross Cost"
          },
          {
            "name": "Gross Salary",
            "dataType": "double",
            "sourceColumn": "Gross Salary"
          },
          {
            "name": "Gross",
            "dataType": "double",
            "sourceColumn": "Gross"
          },
          {
            "name": "Balance",
            "dataType": "double",
            "sourceColumn": "Balance"
          },
          {
            "name": "Level Key",
            "dataType": "string",
            "sourceColumn": "Level Key"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date"
          },
          {
            "name": "From Time",
            "dataType": "string",
            "sourceColumn": "From Time"
          },
          {
            "name": "To Time",
            "dataType": "string",
            "sourceColumn": "To Time"
          },
          {
            "name": "HourRate",
            "dataType": "double",
            "sourceColumn": "HourRate"
          },
          {
            "name": "TeachingRealTotalHours",
            "dataType": "double",
            "sourceColumn": "TeachingRealTotalHours"
          },
          {
            "name": "BaseTechingCost",
            "dataType": "double",
            "sourceColumn": "BaseTechingCost"
          },
          {
            "name": "BenchMarkRate",
            "dataType": "double",
            "sourceColumn": "BenchMarkRate"
          },
          {
            "name": "BenchMarkTechingCost",
            "dataType": "double",
            "sourceColumn": "BenchMarkTechingCost"
          },
          {
            "name": "SalaryType",
            "dataType": "int64",
            "sourceColumn": "SalaryType"
          },
          {
            "name": "Other Group Code",
            "dataType": "string",
            "sourceColumn": "Other Group Code"
          },
          {
            "name": "SOURCE",
            "dataType": "string",
            "sourceColumn": "SOURCE"
          },
          {
            "type": "calculated",
            "name": "Group Column",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "'Teaching Cost'[Month Year]& \" - \" &'Teaching Cost'[Branch Key]& \" - \" &'Teaching Cost'[Teacher Key]"
          },
          {
            "type": "calculated",
            "name": "Count Group",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "CALCULATE(COUNT([Group Column]),FILTER('Teaching Cost',[Group Column]=EARLIER([Group Column])))"
          },
          {
            "type": "calculated",
            "name": "Aveg Extra Cost",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "'Teaching Cost'[Extra Cost]/'Teaching Cost'[Count Group]"
          },
          {
            "type": "calculated",
            "name": "Aveg Allowance VND",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "'Teaching Cost'[Total Allowance VND]/'Teaching Cost'[Count Group]"
          },
          {
            "type": "calculated",
            "name": "Aveg Allowce Travel VND",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "'Teaching Cost'[Allowce Travel VND]/'Teaching Cost'[Count Group]"
          },
          {
            "type": "calculated",
            "name": "Aveg Gross Salary",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "'Teaching Cost'[Gross Salary]/'Teaching Cost'[Count Group]"
          },
          {
            "type": "calculated",
            "name": "Aveg Teaching Advance Hours",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "'Teaching Cost'[Teaching Advance Hours]/'Teaching Cost'[Count Group]"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TEACHING_COST_NET_F = Source{[Schema=\"DWH\",Item=\"VW_TEACHING_COST_NET_F\"]}[Data]",
                "in",
                "    DWH_VW_TEACHING_COST_NET_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Gross Teaching Cost",
            "expression": [
              " ",
              "CALCULATE(sum('Teaching Cost'[Aveg Gross Salary]))",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "Total Travel Allowance",
            "expression": [
              " ",
              "CALCULATE(sum('Teaching Cost'[Aveg Allowce Travel VND]),'Teaching Cost'[Allowance Type]=2,'Teaching Cost'[Salary Status ID]=5)",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "Total Settlement Allowance",
            "expression": [
              " ",
              "CALCULATE(sum('Teaching Cost'[Aveg Allowce Travel VND]),'Teaching Cost'[Allowance Type]=1,'Teaching Cost'[Salary Status ID]=5)",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "Total Net Teaching Cost",
            "expression": " [Total Extra Cost] + [Total Teaching Base Salary]",
            "formatString": "#,0"
          },
          {
            "name": "Total Other Allowance",
            "expression": "  'Teaching Cost'[Total Allowance] - 'Teaching Cost'[Total Travel Allowance]-'Teaching Cost'[Total Settlement Allowance]",
            "formatString": "#,0"
          },
          {
            "name": "Total Allowance",
            "expression": [
              " ",
              "CALCULATE(sum('Teaching Cost'[Aveg Allowance VND])) + CALCULATE(sum('Teaching Cost'[Aveg Allowce Travel VND]))",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Allowance vs Net Teaching Cost",
            "expression": " DIVIDE([Total Allowance],[Total Net Teaching Cost],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%"
          },
          {
            "name": "Teaching Cost Benchmark",
            "expression": " CALCULATE(SUM('Teaching Cost'[BenchMarkTechingCost]))",
            "formatString": "#,0"
          },
          {
            "name": "Total Teaching Base Salary",
            "expression": " CALCULATE(SUM('Teaching Cost'[BaseTechingCost]))",
            "formatString": "#,0.00"
          },
          {
            "name": "Total Teaching Advance Hours",
            "expression": [
              " ",
              "CALCULATE(sum('Teaching Cost'[Aveg Teaching Advance Hours]))",
              ""
            ],
            "formatString": "#,0.00"
          },
          {
            "name": "Total Teaching Hours",
            "expression": " CALCULATE(SUM('Teaching Cost'[Total Hours]))",
            "formatString": "#,0.00"
          },
          {
            "name": "Total Teaching Extra Cost",
            "expression": [
              " ",
              "CALCULATE(SUM('Teaching Cost'[Aveg Allowance VND]))",
              ""
            ],
            "formatString": "#,0.00"
          },
          {
            "name": "Total Extra Cost",
            "expression": " CALCULATE(SUm('Teaching Cost'[Aveg Extra Cost]))",
            "formatString": "#,0"
          },
          {
            "name": "Cost Diff",
            "expression": " [Teaching Cost Benchmark] - [Total Net Teaching Cost]",
            "formatString": "#,0"
          },
          {
            "name": "Total Net Teaching Cost YTD",
            "expression": " TOTALYTD([Total Net Teaching Cost],'Calendar'[Date])",
            "formatString": "#,0"
          },
          {
            "name": "Teaching Cost Benchmark YTD",
            "expression": "  TOTALYTD([Teaching Cost Benchmark],'Calendar'[Date])",
            "formatString": "#,0"
          },
          {
            "name": "Cost Diff YTD",
            "expression": " [Teaching Cost Benchmark YTD] - [Total Net Teaching Cost YTD]",
            "formatString": "#,0"
          },
          {
            "name": "Cost MM",
            "expression": " DIVIDE('Teaching Cost'[Cost Diff],[Teaching Cost Benchmark])"
          },
          {
            "name": "% BM Cost vs Actual YTD",
            "expression": " IF([Total Net Teaching Cost YTD]=0,BLANK(),DIVIDE('Teaching Cost'[Teaching Cost Benchmark YTD],[Total Net Teaching Cost YTD]))"
          },
          {
            "name": "Cost YTDM",
            "expression": " IF([Teaching Cost Benchmark YTD]=0, BLANK(),DIVIDE(([Teaching Cost Benchmark YTD]-[Total Net Teaching Cost YTD]),[Teaching Cost Benchmark YTD]))",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
