          },
          {
            "type": "calculated",
            "name": "Custom Soft",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "If('Course'[Course Type Group Code] IN {\"SM\",\"HK\",\"HKPlus\",\"HKsv\"},1",
              ",if('Course'[Course Type Group Code] IN {\"SK\",\"SKplus\",\"SKsv\"},2",
              ",if('Course'[Course Type Group Code] IN {\"YL\",\"YLsv\"},3",
              ",if('Course'[Course Type Group Code] IN {\"EH\"},4",
              ",if('Course'[Course Type Group Code] IN {\"EAP\",\"IE\"},5",
              ",if('Course'[Course Type Group Code] IN {\"ITALK\"},6",
              ",if('Course'[Course Type Group Code] IN {\"SPECIALCOURSE\"},7",
              ",8",
              ")))))))"
            ]
          },
          {
            "name": "Student Hours Program",
            "dataType": "int64",
            "sourceColumn": "Student Hours Program"
          },
          {
            "name": "Hours Per Session",
            "dataType": "int64",
            "sourceColumn": "Hours Per Session"
          },
          {
            "name": "Number Of Session",
            "dataType": "int64",
            "sourceColumn": "Number Of Session"
          },
          {
            "type": "calculated",
            "name": "Course Type Group Code ASA",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              " ",
              "SWITCH (",
              "    TRUE (),",
              "",
              "    // ILE & ILX & ILn & EH group",
              "    (",
              "        'Course'[Course Type Group Code] = \"ILE\"",
              "        || 'Course'[Course Type Group Code] = \"ILX\"",
              "        || 'Course'[Course Type Group Code] = \"ILn\"",
              "        || 'Course'[Course Type Group Code] = \"EH\"",
              "        || 'Course'[Course Type Code] IN {",
              "            \"EAP\", \"EAP-A\", \"EAPS\", \"FCE\", \"IELTS\",",
              "            \"ILE\", \"ILX\", \"ILXS\", \"ILn\",",
              "            \"KET\", \"SAT\", \"TOEFL\", \"TOEIC\",",
              "            \"EH_Online\", \"EHS\", \"EIC\", \"EICp\",",
              "            \"IE\", \"SEIC\", \"SIE\", \"IE_Online\", \"EH\"",
              "        }",
              "    ),",
              "    \"ILE & ILX & ILn & EH\",",
              "",
              "    // ITALK group",
              "    (",
              "        'Course'[Course Type Group Code] = \"ITALK\"",
              "        || 'Course'[Course Type Code] IN { \"iTalk\", \"iTalk_Online\" }",
              "    ),",
              "    \"ITALK\",",
              "",
              "    // SK & SKplus group",
              "    (",
              "        'Course'[Course Type Group Code] = \"SK\"",
              "        || 'Course'[Course Type Group Code] = \"SKplus\"",
              "        || 'Course'[Course Type Code] IN {",
              "            \"SK\", \"SK - IL\", \"SK New Junior A (tuổi: 6-6.5)\",",
              "            \"SK New Junior B (tuổi: 6.5-7.5)\",",
              "            \"SK New Senior (tuổi: 8-10.5)\", \"SK Plus\",",
              "            \"SK-F\", \"SKn\", \"SKn.V3\", \"SKnorth\",",
              "            \"SKnorth Junior A (tuổi: 6-6.5)\",",
              "            \"SKnorth Junior B (tuổi: 6.5-7.5)\",",
              "            \"SKnorth Senior (tuổi: 8-10.5)\", \"SKnorthS\",",
              "            \"SKp\", \"SKplus2\", \"SKpro\",",
              "            \"SKPro1_Online\", \"SKPro2_Online\",",
              "            \"SKS\", \"SKplus\", \"SKsv\"",
              "        }",
              "    ),",
              "    \"SK & SKplus\",",
              "",
              "    // SM & HK & HKPlus group",
              "    (",
              "        'Course'[Course Type Group Code] = \"SM\"",
              "        || 'Course'[Course Type Group Code] = \"HK\"",
              "        || 'Course'[Course Type Group Code] = \"HKPlus\"",
              "        || 'Course'[Course Type Code] IN {",
              "            \"HK_4 tuổi\", \"HK_4.5 tuổi\", \"HK_5 tuổi\",",
              "            \"HK_5.5 tuổi\", \"HK_6 tuổi\", \"HKpremium\",",
              "            \"HK-V1\", \"HK-V2\", \"HKPlus\", \"HKsv\",",
              "            \"SM\", \"SM_V1 (tuổi: 4.0-4.5)\", \"SM_V1 (tuổi: 4.5-5.0)\",",
              "            \"SM_V1 (tuổi: 5.0-6.0)\", \"SM_V1north&V2 (tuổi: 4.5)\",",
              "            \"SM_V1north&V2 (tuổi: 5.0)\", \"SM_V1north&V2 (tuổi: 5.5-6.0)\",",
              "            \"SMK\", \"SMK - IL\", \"SMK Plus\", \"SMKp\",",
              "            \"SMnorth\", \"SMp\", \"SMpro\", \"SMS\", \"SMsv\"",
              "        }",
              "    ),",
              "    \"SM & HK & HKPlus\",",
              "",
              "    // YL group",
              "    (",
              "        'Course'[Course Type Group Code] = \"YL\"",
              "        || 'Course'[Course Type Code] IN { \"YLsv\", \"YLsv_Online\" }",
              "    ),",
              "    \"YL\",",
              "",
              "    // default",
              "    'Course'[Course Type Group Code]",
              ")"
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
