      {
        "name": "ASA Sales Allocation",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Date Key"
          },
          {
            "name": "Branch Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Branch Key"
          },
          {
            "name": "Student Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Student Key"
          },
          {
            "name": "List Class Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "List Class Key"
          },
          {
            "name": "Level Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Level Key"
          },
          {
            "name": "RevenueAllocationID",
            "dataType": "string",
            "sourceColumn": "RevenueAllocationID"
          },
          {
            "name": "UserInformationID",
            "dataType": "string",
            "sourceColumn": "UserInformationID"
          },
          {
            "name": "ListClassID",
            "dataType": "string",
            "sourceColumn": "ListClassID"
          },
          {
            "name": "Day of Study",
            "dataType": "dateTime",
            "sourceColumn": "Day of Study"
          },
          {
            "name": "From Time",
            "dataType": "string",
            "sourceColumn": "From Time"
          },
          {
            "name": "End Time",
            "dataType": "string",
            "sourceColumn": "End Time"
          },
          {
            "name": "Month Year",
            "dataType": "string",
            "sourceColumn": "Month Year"
          },
          {
            "name": "Class Type",
            "dataType": "int64",
            "sourceColumn": "Class Type"
          },
          {
            "name": "Remain Session",
            "dataType": "int64",
            "sourceColumn": "Remain Session"
          },
          {
            "name": "Tuition Fee Per Session",
            "dataType": "double",
            "sourceColumn": "Tuition Fee Per Session"
          },
          {
            "name": "No Of Session",
            "dataType": "int64",
            "sourceColumn": "No Of Session"
          },
          {
            "name": "Allocated Amount",
            "dataType": "double",
            "sourceColumn": "Allocated Amount"
          },
          {
            "name": "Invoice Type Key",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Invoice Type Key"
          },
          {
            "name": "TotalSession",
            "dataType": "int64",
            "sourceColumn": "TotalSession"
          },
          {
            "name": "Wallet Type",
            "dataType": "string",
            "sourceColumn": "Wallet Type"
          },
          {
            "name": "ListGroupTime",
            "dataType": "string",
            "sourceColumn": "ListGroupTime"
          },
          {
            "name": "isCore",
            "dataType": "string",
            "sourceColumn": "isCore"
          },
          {
            "name": "Minutes",
            "dataType": "int64",
            "sourceColumn": "Minutes"
          },
          {
            "name": "TeacherCode",
            "dataType": "string",
            "sourceColumn": "TeacherCode"
          },
          {
            "type": "calculated",
            "name": "Teaching Hour",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              " 'ASA Sales Allocation'[Minutes] / 60",
              "",
              ""
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_SALES_ALLOCATION_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_SALES_ALLOCATION_F\"]}[Data]",
                "in",
                "    DWH_VW_ASA_SALES_ALLOCATION_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Actual Weekly Amount",
            "expression": [
              " ",
              "var v_from = min('Calendar'[First Day Of Week FIN])",
              "var v_to = max('Calendar'[Last Day Of Week FIN])",
              "return CALCULATE(sum('ASA Sales Allocation'[Allocated Amount])",
              "\t,ALL('Calendar')",
              "\t,'ASA Sales Allocation'[Day of Study] >= v_from",
              "\t, 'ASA Sales Allocation'[Day of Study] <= v_to)"
            ],
            "formatString": "#,0.0"
          },
          {
            "name": "Actual Amount LY",
            "expression": " CALCULATE(sum('ASA Sales Allocation'[Allocated Amount]),SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "#,0.0"
          },
          {
            "name": "% Actual Amount vs LY",
            "expression": " DIVIDE([# of Allocated Amount],[Actual Amount LY],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "Budget Amt",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(SUM('ASA Budget'[Value])",
              "\t,'ASA Budget'[Type]=\"Accrual Revenue\"",
              "\t,'ASA Budget'[SubType]=\"Accrual Revenue\"",
              "\t,ALL('Calendar')",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)\t\t"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Actual Amt vs Budget",
            "expression": " DIVIDE([# of Allocated Amount],[Budget Amt],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# of Students Attendance Rollings",
            "expression": [
              " ",
              "var t_date = max('Calendar'[Date])",
              "var f_date = t_date-7",
              "var result =",
              "\tCALCULATE(",
              "\tDISTINCTCOUNT('ASA Sales Allocation'[Student Key]),",
              "\tFILTER('Calendar',CONVERT('Calendar'[IS OFF],INTEGER)<>1),",
              "\tFILTER('ASA Sales Allocation','ASA Sales Allocation'[Day of Study]>f_date && 'ASA Sales Allocation'[Day of Study]<=t_date)",
              "\t)",
              "\treturn result"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Active Students Budgets",
            "expression": [
              "",
              "VAR f_date = MIN ( 'Calendar'[First Day Of Month] )",
              "VAR t_date = MAX ( 'Calendar'[Last Day Of Month] )",
              "VAR result =",
              "    CALCULATE (",
              "        SUM ( 'ASA Budget'[Value] ),",
              "        FILTER (",
              "            'Calendar',",
              "              CONVERT ( 'Calendar'[IS OFF],INTEGER) <> 1",
              "                && 'Calendar'[Date] >= f_date",
              "                && 'Calendar'[Date] <= t_date",
              "        ),",
              "        FILTER ( 'ASA Budget', 'ASA Budget'[Type] = \"Active Students\" ),",
              "        FILTER ( 'ASA Budget', 'ASA Budget'[SubType] = \"Active Students\" )",
              "    )",
              "RETURN result"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Active Student vs Budgets",
            "expression": " DIVIDE([# of Students Attendance Rollings],[# of Active Students Budgets],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Student Attendance",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Week FIN])",
              "var t_date = max('Calendar'[Last Day Of Week FIN])",
              "var result =",
              "\t CALCULATE(",
              "\t DISTINCTCOUNT('ASA Sales Allocation'[Student Key]),",
              "\t FILTER('Calendar', CONVERT('Calendar'[IS OFF],INTEGER)<>1 && 'Calendar'[Date]>=f_date && 'Calendar'[Date]<=t_date)",
              "\t --FILTER('Course','Course'[Course Type Name]<>\"%Summer\" && 'Course'[Course Type Name]<>\"%Special\" )",
              "\t )",
              "Return result"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# Class Attendance",
            "expression": [
              "",
              "var f_date = min('Calendar'[First Day Of Week FIN])",
              "var t_date = max('Calendar'[Last Day Of Week FIN])",
              "var result = CALCULATE(",
              "\t    DISTINCTCOUNT('ASA Sales Allocation'[ListClassID]),",
              "\t    FILTER('Calendar',CONVERT('Calendar'[IS OFF],INTEGER)<>1 && 'Calendar'[Date]>=f_date && 'Calendar'[Date]<=t_date)",
              "\t    )",
              "Return result"
            ],
            "formatString": "0"
          },
          {
            "name": "Class Size of Attendance",
            "expression": " DIVIDE('ASA Sales Allocation'[# of Student Attendance],'ASA Sales Allocation'[# Class Attendance],BLANK())",
            "formatString": "#,0.0"
          },
          {
            "name": "# of Class Size X Frequency Budgets",
            "expression": [
              "",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "var result = CALCULATE(",
              "\t\tSUM('ASA Budget'[Value]),",
              "   \t\tFILTER('Calendar','Calendar'[Date]>=f_date && 'Calendar'[Date]<=t_date),",
              "    \t\tFILTER('ASA Budget','ASA Budget'[Type]=\"Class Size\"),",
              "  \t\tFILTER('ASA Budget','ASA Budget'[SubType]=\"Class Size x Frequency\")",
              "  \t\t)",
              "  Return result",
              ""
            ],
            "formatString": "0.00"
          },
          {
            "name": "# of Frequency Class Size Budgets",
            "expression": [
              "",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "var result = CALCULATE(",
              "\t    SUM('ASA Budget'[Value]),",
              "                  FILTER('Calendar','Calendar'[Date]>=f_date &&'Calendar'[Date]<=t_date),",
              "   \t   FILTER('ASA Budget','ASA Budget'[Type]=\"Class Size\"),",
              "   \t   FILTER('ASA Budget','ASA Budget'[SubType]=\"Frequency\")",
              "   \t   )",
              " Return result",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "# of Class Size Budgets",
            "expression": " DIVIDE('ASA Sales Allocation'[# of Class Size X Frequency Budgets],'ASA Sales Allocation'[# of Frequency Class Size Budgets],BLANK())",
            "formatString": "#,0.00"
          },
          {
            "name": "# of Students Attendance Rollings 2019",
            "expression": [
              " ",
              "var BaseYear = 2021",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear-CurrentYear",
              "Var result = CALCULATE([# of Students Attendance Rollings],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))",
              "Return result"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Class Size of Attendance 2019",
            "expression": [
              " ",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([Class Size of Attendance],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))",
              ""
            ],
            "formatString": "#,0.0"
          },
          {
            "name": "# of Active Students News",
            "expression": [
              " CALCULATE(",
              "\t\t\tDISTINCTCOUNT('ASA Sales Allocation'[Student Key]),",
              "\t\t\tFILTER('Calendar',CONVERT('Calendar'[IS OFF],INTEGER)<>1))",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Class Study New",
            "expression": " COUNTROWS(GROUPBY('ASA Sales Allocation','ASA Sales Allocation'[Date Key],'ASA Sales Allocation'[List Class Key]))",
            "formatString": "0"
          },
          {
            "name": "# of Attendance Study New",
            "expression": " CALCULATE(COUNT('ASA Sales Allocation'[Student Key]))",
            "formatString": "0"
          },
          {
            "name": "Class size Study New",
            "expression": " DIVIDE([# of Attendance Study New],[# of Class Study New],BLANK())",
            "formatString": "0.0"
          },
          {
            "name": "% Active Student VS Target",
            "expression": "DIVIDE('ASA Sales Allocation'[# of Student Attendance],'ASA Sales Allocation'[# of Active Student Campus Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Student Attendance By Category",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Week FIN])",
              "var t_date = max('Calendar'[Last Day Of Week FIN])",
              "var result_etl =",
              "\t CALCULATE(",
              "\t DISTINCTCOUNT('ASA Sales Allocation'[Student Key]),",
              "\t FILTER('Calendar', CONVERT('Calendar'[IS OFF],INTEGER)<>1 && 'Calendar'[Date]>=f_date && 'Calendar'[Date]<=t_date),",
              "\t FILTER('Course','Course'[ELT Type]= \"ELT\"  )",
              "\t )",
              "\t ",
              "var result_nonetl =",
              "\t CALCULATE(",
              "\t DISTINCTCOUNT('ASA Sales Allocation'[Student Key]),",
              "\t FILTER('Calendar', CONVERT('Calendar'[IS OFF],INTEGER)<>1 && 'Calendar'[Date]>=f_date && 'Calendar'[Date]<=t_date),",
              "\t FILTER('Course','Course'[ELT Type]= \"Non-ELT\"  )",
              "\t )",
              "Return result_etl + result_nonetl"
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Student Attendance By Category LY",
            "expression": " CALCULATE('ASA Sales Allocation'[# of Student Attendance By Category],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% Active Student Category VS Target",
            "expression": " DIVIDE('ASA Sales Allocation'[# of Student Attendance By Category],'ASA Sales Allocation'[# of Active Student Campus Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Active Student Category VS LY",
            "expression": " DIVIDE('ASA Sales Allocation'[# of Student Attendance By Category],'ASA Sales Allocation'[# of Student Attendance By Category LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Student Attendance By Category_CurrentMonth",
            "expression": [
              " ",
              "var f_date = TODAY()",
              "var result_etl =",
              "\t CALCULATE(",
              "\t DISTINCTCOUNT('ASA Sales Allocation'[Student Key]),",
              "\t FILTER('Calendar', CONVERT('Calendar'[IS OFF],INTEGER)<>1 && 'Calendar'[Date]=f_date ),",
              "\t FILTER('Course','Course'[ELT Type]= \"ELT\"  )",
              "\t )",
              "\t ",
              "var result_nonetl =",
              "\t CALCULATE(",
              "\t DISTINCTCOUNT('ASA Sales Allocation'[Student Key]),",
              "\t FILTER('Calendar', CONVERT('Calendar'[IS OFF],INTEGER)<>1 && 'Calendar'[Date]=f_date ),",
              "\t FILTER('Course','Course'[ELT Type]= \"Non-ELT\"  )",
              "\t )",
              "Return result_etl + result_nonetl"
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Active Student Campus Target",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Active Student\"))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Active Student Campus Target_CurrentMonth",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Active Student\"),FILTER('Calendar','Calendar'[Date]=TODAY()))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Attendance Study New LY",
            "expression": " CALCULATE('ASA Sales Allocation'[# of Attendance Study New],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "# of Class Study New LY",
            "expression": " CALCULATE('ASA Sales Allocation'[# of Class Study New],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "Class size Study New LY",
            "expression": " DIVIDE([# of Attendance Study New LY],[# of Class Study New LY],BLANK())",
            "formatString": "0.0"
          },
          {
            "name": "# of Total Sessions Of Class",
            "expression": [
              " ",
              "COUNTROWS(DISTINCT(",
              "            SELECTCOLUMNS('ASA Sales Allocation', \"CombineCol\",'ASA Sales Allocation'[Remain Session] & \" \" & 'ASA Sales Allocation'[ListClassID])",
              "            ))"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Total Hours Of Class",
            "expression": [
              " ",
              "SUMX(",
              "          DISTINCT(",
              "                          SELECTCOLUMNS('ASA Sales Allocation',\"CombineCol\",'ASA Sales Allocation'[ListClassID] & \"-\" & 'ASA Sales Allocation'[Remain Session])",
              "                          ),",
              "          CALCULATE(SUM('ASA Sales Allocation'[Minutes]))",
              "          )"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Class Session Fee",
            "expression": " Divide('ASA Sales Allocation'[# of Allocated Amount],'ASA Sales Allocation'[# of Total Sessions Of Class],0)",
            "formatString": "0"
          },
          {
            "name": "# of Student Session Fee",
            "expression": " Divide('ASA Sales Allocation'[# of Class Session Fee], 'ASA Sales Allocation'[# of Total Students Of Class],0)",
            "formatString": "0"
          },
          {
            "name": "# of Class Hour Fee",
            "expression": " Divide('ASA Sales Allocation'[# of Allocated Amount],'ASA Sales Allocation'[# of Total Hours Of Class],0)",
            "formatString": "0"
          },
          {
            "name": "# of Total Students Of Class",
            "expression": [
              " ",
              "CALCULATE(",
              "    COUNTROWS(",
              "        DISTINCT(",
              "            SELECTCOLUMNS(",
              "                'ASA Sales Allocation',",
              "                \"CombineCol\",",
              "                'ASA Sales Allocation'[Student Key] & \" \" & 'ASA Sales Allocation'[ListClassID]",
              "            )",
              "        )",
              "    ),",
              "    FILTER(",
              "        'Calendar',",
              "        CONVERT('Calendar'[IS OFF], INTEGER) <> 1",
              "    )",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Student Hour Fee",
            "expression": " Divide('ASA Sales Allocation'[# of Class Hour Fee], 'ASA Sales Allocation'[# of Total Students Of Class],0)",
            "formatString": "0"
          },
          {
            "name": "# of Class Student Fee",
            "expression": " Divide('ASA Sales Allocation'[# of Allocated Amount], 'ASA Sales Allocation'[# of Total Students Of Class],0)",
            "formatString": "0"
          },
          {
            "name": "# of Student Login Ovi",
            "expression": " CALCULATE('ASA Sales Allocation'[# of Active Students News],FILTER('Student Login Ovi','Student Login Ovi'[Is Student Login]=1)) +0",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% Student Login Ovi",
            "expression": " DIVIDE('ASA Sales Allocation'[# of Student Login Ovi],'ASA Sales Allocation'[# of Active Students News],0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Student Login Ovi  By Mobile",
            "expression": " CALCULATE('ASA Sales Allocation'[# of Active Students News],FILTER('Student Login Ovi','Student Login Ovi'[Is Student Login]=1),FILTER('Student Login Ovi','Student Login Ovi'[Is Student Login By Mobile]=1)) +0",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Student Login Ovi  By Web",
            "expression": " CALCULATE('ASA Sales Allocation'[# of Active Students News],FILTER('Student Login Ovi','Student Login Ovi'[Is Student Login]=1),FILTER('Student Login Ovi','Student Login Ovi'[Is Student Login By Web]=1)) +0",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Student Login Ovi  By Web And Mobile",
            "expression": " CALCULATE('ASA Sales Allocation'[# of Active Students News],FILTER('Student Login Ovi','Student Login Ovi'[Is Student Login]=1),FILTER('Student Login Ovi',AND('Student Login Ovi'[Is Student Login By Mobile]=1,'Student Login Ovi'[Is Student Login By Web]=1))) +0",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Student Login Ovi  Only By Web",
            "expression": " CALCULATE('ASA Sales Allocation'[# of Active Students News],FILTER('Student Login Ovi','Student Login Ovi'[Is Student Login]=1),FILTER('Student Login Ovi',AND('Student Login Ovi'[Is Student Login By Mobile]=0,'Student Login Ovi'[Is Student Login By Web]=1))) +0",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Parent Student",
            "expression": [
              " ",
              "--CALCULATE(DISTINCTCOUNT('Student Login Ovi'[Phone Parent]),FILTER('ASA Sales Allocation','ASA Sales Allocation'[# of Active Students News]>0))+0",
              "CALCULATE(COUNTROWS(GROUPBY('ASA Sales Allocation','Student Login Ovi'[Phone Parent])),FILTER('Student Login Ovi',ISBLANK('Student Login Ovi'[Phone Parent])=FALSE()))"
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Parent Student Login Ovi",
            "expression": [
              " CALCULATE('ASA Sales Allocation'[# of Parent Student],FILTER('Student Login Ovi','Student Login Ovi'[Is Parent Login]=1),FILTER('Student Login Ovi',ISBLANK('Student Login Ovi'[Phone Parent])=FALSE()))+0",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% Parent Student Login",
            "expression": [
              " DIVIDE('ASA Sales Allocation'[# of Parent Student Login Ovi],'ASA Sales Allocation'[# of Parent Student],0)",
              "+0"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Remain Active Student",
            "expression": "'ASA Sales Allocation'[# of Active Student Campus Target] - 'ASA Sales Allocation'[# of Student Attendance By Category]",
            "formatString": "0"
          },
          {
            "name": "Active Std YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Sales Allocation'[# of Student Attendance By Category],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "Active Std YTD PY",
            "expression": " CALCULATE('ASA Sales Allocation'[Active Std YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "Class size YTD",
            "expression": [
              "",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE(DIVIDE([# of Attendance Study New],[# of Class Study New],BLANK()),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "Class size YTD PY",
            "expression": " CALCULATE('ASA Sales Allocation'[Class size YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% Actual Class Size vs Target",
            "expression": " DIVIDE('ASA Sales Allocation'[Class size Study New],'ASA Sales Allocation'[# of Class Size Budgets], BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Actual Class Size vs LY",
            "expression": " DIVIDE('ASA Sales Allocation'[Class size Study New],'ASA Sales Allocation'[Class size Study New LY], BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Class Size YTD vs PY",
            "expression": " DIVIDE('ASA Sales Allocation'[Class size YTD],'ASA Sales Allocation'[Class size YTD PY], BLANK())"
          },
          {
            "name": "# of Student Attendance Category YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Sales Allocation'[# of Student Attendance By Category],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "# of Student Attendance Category YTD PY",
            "expression": " CALCULATE('ASA Sales Allocation'[# of Student Attendance Category YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% Active Student Category YTD vs PY",
            "expression": " DIVIDE('ASA Sales Allocation'[# of Student Attendance Category YTD],'ASA Sales Allocation'[# of Student Attendance Category YTD PY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Class Size Budgets Allocation",
            "expression": [
              "\tDIVIDE('ASA Sales Allocation'[# of Class Size X Frequency Budgets],'ASA Sales Allocation'[# of Frequency Class Size Budgets],BLANK())",
              ""
            ]
          },
          {
            "name": "# of Allocated Amount",
            "expression": " CALCULATE(sum('ASA Sales Allocation'[Allocated Amount]))",
            "formatString": "#,0.0"
          },
          {
            "name": "# of Teaching Hours",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('ASA Sales Allocation'[Teaching Hour])",
              ")",
              "",
              ""
            ]
          },
          {
            "name": "Avg Allocated Amount per Hour",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Allocated Amount],",
              "    [# of Teaching Hours],",
              "    0",
              ")",
              "",
              ""
            ],
            "formatString": "0.00"
          },
          {
            "name": "# of std hrs/std",
            "expression": " divide([# of Teaching Hours],[# of Student Attendance By Category],0.0)",
            "formatString": "0.00"
          },
          {
            "name": "% Revenue vs target",
            "expression": " divide ('ASA Sales Allocation'[# of Allocated Amount], 'ASA Target Manual'[# of Accrual Revenue Campus Target],0.0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Need Revenue",
            "expression": "'ASA Target Manual'[# of Accrual Revenue Campus Target] - 'ASA Sales Allocation'[# of Allocated Amount]"
          }
        ]
      },
      {
        "name": "Teacher Performance",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "int64",
            "sourceColumn": "Date Key"
          },
          {
            "name": "TeacherProfileKey",
            "dataType": "string",
            "sourceColumn": "TeacherProfileKey"
          },
          {
            "name": "CampusKey",
            "dataType": "string",
            "sourceColumn": "CampusKey"
          },
          {
            "name": "Week_Yearly",
            "dataType": "int64",
            "sourceColumn": "Week_Yearly"
          },
          {
            "name": "Week_Class",
            "dataType": "int64",
            "sourceColumn": "Week_Class"
          },
          {
            "name": "IsForeign",
            "dataType": "boolean",
            "sourceColumn": "IsForeign"
          },
          {
            "name": "IsTA",
            "dataType": "boolean",
            "sourceColumn": "IsTA"
          },
          {
            "name": "IsFullTime",
            "dataType": "boolean",
            "sourceColumn": "IsFullTime"
          },
          {
            "name": "Registration",
            "dataType": "int64",
            "sourceColumn": "Registration"
          },
          {
            "name": "TotalHour",
            "dataType": "double",
            "sourceColumn": "TotalHour"
          },
          {
            "name": "RealTotalHour",
            "dataType": "double",
            "sourceColumn": "RealTotalHour"
          },
          {
            "name": "TotalOnlineHour",
            "dataType": "double",
            "sourceColumn": "TotalOnlineHour"
          },
          {
            "name": "LimitRate",
            "dataType": "int64",
            "sourceColumn": "LimitRate"
          },
          {
            "name": "ClassKey",
            "dataType": "string",
            "sourceColumn": "ClassKey"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_TEACHER_PERFORMANCE = Source{[Schema=\"DWH\",Item=\"VW_TEACHER_PERFORMANCE_F\"]}[Data]",
                "in",
                "    DWH_TEACHER_PERFORMANCE"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Registered Hours",
            "expression": [
              " ",
              "Var SlicerCount = IF(ISFILTERED('Calendar'[Week Name FIN]),COUNTROWS(VALUES('Calendar'[Week Name FIN])),0)",
              "Var registration = SlicerCount* MAX('Teacher Performance'[Registration])",
              "return registration"
            ]
          },
          {
            "name": "# of Minimum Rate Hours",
            "expression": " MAX('Teacher Performance'[LimitRate])"
          },
          {
            "name": "# of Real Hours",
            "expression": [
              " SUM('Teacher Performance'[RealTotalHour])",
              ""
            ]
          },
          {
            "name": "# of Lower Performance TCTA",
            "expression": [
              " ",
              "var SumTable = CALCULATETABLE(",
              "    SUMMARIZE('Teacher Performance',",
              "    'Teacher Performance'[TeacherProfileKey], ",
              "    \"TotalScore\", SUM('Teacher Performance'[RealTotalHour]))",
              "    )",
              "var RootTable = CALCULATETABLE(",
              "    SUMMARIZE('Teacher Performance', ",
              "    'Teacher Performance'[TeacherProfileKey], ",
              "    \"LimitRate\",MAX('Teacher Performance'[LimitRate]))",
              "    )",
              "    ",
              "var TemJoin = NATURALINNERJOIN(RootTable,SumTable)",
              "RETURN COUNTX(FILTER(TemJoin, [TotalScore] < [LimitRate]),'Teacher Performance'[TeacherProfileKey])"
            ]
          },
          {
            "name": "% of Real Hours vs Registered Hours",
            "expression": [
              " DIVIDE('Teacher Performance'[# of Real Hours], 'Teacher Performance'[# of Registered Hours], BLANK())",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of Registered Hours vs Minimum Hours",
            "expression": " DIVIDE('Teacher Performance'[# of Registered Hours], 'Teacher Performance'[# of Minimum Rate Hours], BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Real Hours vs Minimum Hours",
            "expression": " DIVIDE('Teacher Performance'[# of Real Hours], 'Teacher Performance'[# of Minimum Rate Hours], BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of Lower Performance TCTA vs total TATC",
            "expression": " DIVIDE([# of Lower Performance TCTA], COUNT('Teacher Performance'[TeacherProfileKey]))",
            "formatString": "0%;-0%;0%"
          }
        ]
      },
