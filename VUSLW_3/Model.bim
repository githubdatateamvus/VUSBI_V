          },
          {
            "type": "calculated",
            "name": "SAM MONTH",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " IF('ASA Overview PD'[Year Month Show Date PD] = [Year Month Sign Date PD] ,\"SAME\",\"DIFF\")",
            "displayFolder": "Attribute"
