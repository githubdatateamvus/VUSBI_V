            "type": "calculated",
            "name": "Is_Sign",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "IF('ASA List Referral Detail'[NDGT_NgayDongPhi]<>BLANK(),1,0)"
          },
          {
            "type": "calculated",
            "name": "Is_Referral",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "IF('ASA List Referral Detail'[MaGioiThieu]<>BLANK(),1,0)"
          },
          {
            "type": "calculated",
            "name": "Is_Referral_notCare",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "IF(AND('ASA List Referral Detail'[IsCare]=0,'ASA List Referral Detail'[Is_Referral]=1),1,0)"
          },
          {
            "type": "calculated",
            "name": "Is_Show",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "IF('ASA List Referral Detail'[Show_Is] = TRUE(),1,0)"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_LISTREFERRAL_DETAIL = Source{[Schema=\"DWH\",Item=\"VW_ASA_LISTREFERRAL_DETAIL\"]}[Data]",
                "in",
                "    DWH_VW_ASA_LISTREFERRAL_DETAIL"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "TLHVGTSauCare_7",
            "expression": "IFERROR(DIVIDE(SUM('ASA List Referral Detail'[IsCareReferral]), SUM('ASA List Referral Detail'[IsCare])),0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "TLHVGT_8",
            "expression": "IFERROR(DIVIDE(SUM('ASA List Referral Detail'[Is_Referral]), SUM('ASA List Referral Detail'[SiSoLop])),0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "TLHVShow",
            "expression": "DIVIDE(SUM('ASA List Referral Detail'[Is_Show]), SUM('ASA List Referral Detail'[Is_Referral]))",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "TLSign",
            "expression": "DIVIDE(SUM('ASA List Referral Detail'[Is_Sign]),SUM('ASA List Referral Detail'[Is_Referral]))",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
