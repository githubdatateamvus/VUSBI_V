          },
          {
            "name": "ISNull",
            "dataType": "int64",
            "sourceColumn": "ISNull"
          },
          {
            "type": "calculated",
            "name": "Is Above Average",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF('Student Score'[Score]>=(IF( ISBLANK('Student Score'[MaxScore]),'Student Score'[# of TQM Max Score]/2,'Student Score'[MaxScore]/2)),\">= 50 % Benchmark\", \"< 50 % Benchmark\")"
          },
          {
            "name": "ISRemove",
            "dataType": "int64",
            "sourceColumn": "ISRemove"
          },
          {
            "name": "MaxScore",
            "dataType": "double",
            "sourceColumn": "MaxScore"
          },
          {
            "name": "ConditionLevelCode",
            "dataType": "string",
            "sourceColumn": "ConditionLevelCode"
          },
          {
            "name": "Enable",
            "dataType": "int64",
            "sourceColumn": "Enable"
          },
          {
            "name": "Subject Name 2",
            "dataType": "string",
            "sourceColumn": "SUBJECTNAME2"
          },
          {
            "name": "Subject",
            "dataType": "string",
            "sourceColumn": "SUBJECT"
          },
          {
            "name": "OrderSub",
            "dataType": "string",
            "sourceColumn": "OrderSub"
          },
          {
            "type": "calculated",
            "name": "ValueScore",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "if(OR('Student Score'[Score]<0,ISBLANK('Student Score'[Score])),BLANK(),'Student Score'[Score])"
          },
          {
            "name": "CampusCode",
            "dataType": "string",
            "sourceColumn": "CampusCode"
          },
          {
            "name": "CourseTypeCode",
            "dataType": "string",
            "sourceColumn": "CourseTypeCode"
          },
          {
            "name": "LevelCode",
