      {
        "name": "Call Log",
        "columns": [
          {
            "name": "Period",
            "dataType": "string",
            "sourceColumn": "PERIOD"
          },
          {
            "name": "Duration",
            "dataType": "double",
            "sourceColumn": "DURATION"
          },
          {
            "name": "Source Type",
            "dataType": "string",
            "sourceColumn": "SOURCE_TYPE"
          },
          {
            "name": "Object Type",
            "dataType": "string",
            "sourceColumn": "OBJECT_TYPE"
          },
          {
            "name": "Campus Key",
            "dataType": "string",
            "sourceColumn": "CAMPUS_KEY"
          },
          {
            "name": "Date Key",
            "dataType": "string",
            "sourceColumn": "DATE_KEY"
          },
          {
            "name": "User Key",
            "dataType": "string",
            "sourceColumn": "USER_KEY"
          },
          {
            "name": "Call Status",
            "dataType": "string",
            "sourceColumn": "CALL_STATUS"
          },
          {
            "name": "Student Key",
            "dataType": "string",
            "sourceColumn": "STUDENT_KEY"
          },
          {
            "name": "Total Call",
            "dataType": "int64",
            "sourceColumn": "TOTAL_CALL"
          },
          {
            "name": "Total Call Success",
            "dataType": "int64",
            "sourceColumn": "TOTAL_CALL_SUCCESS"
          },
          {
            "name": "Total Call Time More Than 30s",
            "dataType": "int64",
            "sourceColumn": "TOTAL_CALL_TIME_MORE_THAN_30S"
          },
          {
            "name": "Lead Key",
            "dataType": "string",
            "sourceColumn": "LEAD_KEY"
          },
          {
            "name": "Team User",
            "dataType": "string",
            "sourceColumn": "TEAM_USER"
          },
          {
            "name": "Type Call",
            "dataType": "string",
            "sourceColumn": "TYPE_CALL"
          },
          {
            "name": "Call Time",
            "dataType": "int64",
            "sourceColumn": "CALL_TIME"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_W_CALL_LOG = Source{[Schema=\"DWH\",Item=\"VW_CALL_LOG\"]}[Data]",
                "in",
                "    DWH_W_CALL_LOG"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of total_call",
            "expression": "CALCULATE(SUM('Call Log'[Total Call]))",
            "formatString": "0"
          },
          {
            "name": "# of total_call_success",
            "expression": "SUM('Call Log'[Total Call Success])",
            "formatString": "0"
          },
          {
            "name": "# of total_call_more_than_30",
            "expression": "CALCULATE(SUM('Call Log'[Total Call Time More Than 30s]))",
            "formatString": "0"
          },
          {
            "name": "# of total_time_call",
            "expression": [
              "CALCULATE(",
              "",
              "INT(SUM('Call Log'[Duration]) / 3600) & \":\" &",
              "RIGHT(\"0\" & INT((SUM('Call Log'[Duration]) - INT(SUM('Call Log'[Duration]) / 3600) * 3600) / 60), 2) & \":\" &",
              "RIGHT(\"0\" & MOD(SUM('Call Log'[Duration]), 3600), 2)",
              ")"
            ]
          },
          {
            "name": "# of TotalCallDate",
            "expression": [
              " CALCULATE( DISTINCTCOUNT('Call Log'[Date Key]),FILTER('Call Log','Call Log'[Date Key] <> BLANK()))",
              ""
            ]
          },
          {
            "name": "# Staff",
            "expression": " DISTINCTCOUNT('Users'[User Code])"
          },
          {
            "name": "# of RecycleNewCallSuccess",
            "expression": " Calculate('Call Log'[# of total_call_success], FILTER('Call Log',LEFT('Call Log'[Object Type],10) = \"RecycleNEW\"))"
          },
          {
            "name": "# of RecyclePendingCallSuccess",
            "expression": [
              " Calculate('Call Log'[# of total_call_success], FILTER('Call Log',LEFT('Call Log'[Object Type],14) = \"RecyclePENDING\"))",
              ""
            ]
          },
          {
            "name": "# of SNSCallSuccess",
            "expression": " Calculate('Call Log'[# of total_call_success], FILTER('Call Log',LEFT('Call Log'[Object Type],3) = \"SNS\"))"
          },
          {
            "name": "# of KKHTCallSuccess",
            "expression": [
              " Calculate('Call Log'[# of total_call_success], FILTER('Call Log',",
              "",
              " OR(",
              "\tLEFT('Call Log'[Object Type],17) = \"Kết khóa hết tiền\"",
              "\t,LEFT('Call Log'[Object Type],4) = \"KKHT\"",
              "   )",
              "",
              "))"
            ]
          },
          {
            "name": "# of PendingCallSuccess",
            "expression": " Calculate('Call Log'[# of total_call_success], FILTER('Call Log',LEFT('Call Log'[Object Type],9) = \"Tạm ngưng\"))"
          },
          {
            "name": "# of ActiveStudentCallSuccess",
            "expression": " Calculate('Call Log'[# of total_call_success], FILTER('Call Log',LEFT('Call Log'[Object Type],17) = \"Học Viên Đang Học\"))"
          },
          {
            "name": "# of ShowCallSuccess",
            "expression": " Calculate('Call Log'[# of total_call_success], FILTER('Call Log',LEFT('Call Log'[Object Type],15) = \"Học Viên Tư Vấn\"))"
          },
          {
            "name": "# of OtherCallSuccess",
            "expression": " 'Call Log'[# of total_call_success] - 'Call Log'[# of RecycleNewCallSuccess] - 'Call Log'[# of RecyclePendingCallSuccess] - 'Call Log'[# of SNSCallSuccess] - 'Call Log'[# of KKHTCallSuccess] - 'Call Log'[# of PendingCallSuccess] - 'Call Log'[# of ShowCallSuccess] - 'Call Log'[# of ActiveStudentCallSuccess]"
          },
          {
            "name": "# of AvgCallSuccessPerDay",
            "expression": [
              "",
              "Var result = DIVIDE('Call Log'[# of total_call_success],'Call Log'[# of TotalCallDate])",
              "Var final = DIVIDE(result,'Call Log'[# Staff])",
              "Return final"
            ],
            "formatString": "0"
          },
          {
            "name": "# of AvgTalkTimePerCall",
            "expression": [
              " ",
              "Var total_time = SUM('Call Log'[Duration])",
              "Var result = DIVIDE (total_time,'Call Log'[# of total_call_success])",
              "Return result/60"
            ]
          },
          {
            "name": "# of TotalPushsaleLead",
            "expression": " CALCULATE(DISTINCTCOUNT( 'Call Log'[Lead Key]),FILTER('Call Log','Call Log'[Source Type] = \"CORE\"),REMOVEFILTERS('Calendar'[Year]))"
          },
          {
            "name": "# of TotalKKHT",
            "expression": [
              " CALCULATE('Call Log'[# of TotalPushsaleLead],FILTER('Call Log',",
              " OR(",
              "\tLEFT('Call Log'[Object Type],17) = \"Kết khóa hết tiền\"",
              "\t,LEFT('Call Log'[Object Type],4) = \"KKHT\"",
              "   )",
              "))"
            ]
          },
          {
            "name": "Duration(Minute)",
            "expression": " SUM('Call Log'[Duration])/60"
          },
          {
            "name": "# of WaitEnrolmentCallSuccess",
            "expression": " Calculate('Call Log'[# of total_call_success], FILTER('Call Log',LEFT('Call Log'[Object Type],16) = \"Học Viên Chờ Lớp\"))"
          },
          {
            "name": "# total_lead_recycle_new_called",
            "expression": "Calculate('Call Log'[# total_lead_recycle_new_dial], FILTER('Call Log','Call Log'[Total Call Success] >0))"
          },
          {
            "name": "# total_lead_recycle_pending_called",
            "expression": "Calculate('Call Log'[# total_lead_recycle_pending_dial], FILTER('Call Log','Call Log'[Total Call Success] >0))"
          },
          {
            "name": "# total_lead_recycle_new_dial",
            "expression": "Calculate('Call Log'[# of TotalPushsaleLead], FILTER('Call Log',LEFT('Call Log'[Object Type],10) = \"RecycleNEW\"))"
          },
          {
            "name": "# total_lead_recycle_pending_dial",
            "expression": "Calculate('Call Log'[# of TotalPushsaleLead], FILTER('Call Log',LEFT('Call Log'[Object Type],14) = \"RecyclePending\"))"
          },
          {
            "name": "# total_lead_recycle_new_pending_dial",
            "expression": "'Call Log'[# total_lead_recycle_new_dial]+'Call Log'[# total_lead_recycle_pending_dial]"
          },
          {
            "name": "# total_lead_recycle_dial",
            "expression": " Calculate(DISTINCTCOUNT('Call Log'[Lead Key]), FILTER('Call Log',LEFT('Call Log'[Object Type],7) = \"Recycle\"))"
          },
          {
            "name": "# total_lead_recycle_called",
            "expression": " Calculate('Call Log'[# total_lead_recycle_dial], FILTER('Call Log','Call Log'[Total Call Success] >0))"
          }
        ]
      },
