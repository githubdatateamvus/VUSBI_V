          {
            "name": "createcampus",
            "dataType": "string",
            "sourceColumn": "createcampus"
          },
          {
            "type": "calculated",
            "name": "NumWeekOfTqmCreatedate",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "WEEKNUM('Class Urgency'[TQMcreatedate], 2) "
          },
          {
            "type": "calculated",
            "name": "NumWeekOfTqmOpenDate",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "WEEKNUM('Class Urgency'[TQMopendate], 2) "
          },
          {
            "type": "calculated",
            "name": "WeekDayOfTqmOpenDate",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "WEEKDAY('Class Urgency'[TQMopendate],2)"
          },
          {
            "type": "calculated",
            "name": "WeekDayOfTqmCreateDate",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "WEEKDAY('Class Urgency'[TQMcreatedate],2)"
          },
          {
            "type": "calculated",
            "name": "IsUrgentOpenClass",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "IF(",
              "AND('Class Urgency'[NumWeekOfTqmOpenDate]='Class Urgency'[NumWeekOfTqmCreatedate],",
              "         'Class Urgency'[tranxtype] = \"NewClass\")",
              ",1,",
              "If(",
              "AND( 'Class Urgency'[tranxtype] = \"NewClass\",",
              "AND(('Class Urgency'[NumWeekOfTqmOpenDate] - 'Class Urgency'[NumWeekOfTqmCreatedate])=1,",
              "        'Class Urgency'[WeekDayOfTqmCreateDate] IN {5,6,7} ))",
              ",1,0",
              "",
              ")",
              "",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "IsUrgentCloseClass",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              "If(AND('Class Urgency'[tranxtype] = \"UpdateClassCancel\",",
              "              'Class Urgency'[TQMurgencyhour]<48),1,0)",
              ""
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TQM_CLASS_URGENCY_F = Source{[Schema=\"DWH\",Item=\"VW_TQM_CLASS_URGENCY_F\"]}[Data]",
                "in",
                "    DWH_VW_TQM_CLASS_URGENCY_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# Total New Class",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Class Urgency'[classcode]),",
              "    FILTER(",
              "        'Class Urgency',",
              "        'Class Urgency'[tranxtype] = \"NewClass\"",
              "    )",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "# Total Urgent New Class",
            "expression": [
              "",
              "CALCULATE(",
              "   'Class Urgency'[# Total New Class],",
              "    FILTER (",
              "        'Class Urgency',",
              "        'Class Urgency'[IsUrgentOpenClass]=1)",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "# Total Closed Class",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Class Urgency'[classcode]),",
              "    FILTER(",
              "        'Class Urgency',",
              "        'Class Urgency'[tranxtype] = \"UpdateClassCancel\"",
              "    )",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "# Total Urgent Closed Class",
            "expression": [
              "",
              "CALCULATE(",
              "    'Class Urgency'[# Total Closed Class],",
              "    FILTER(",
              "        'Class Urgency',",
              "        'Class Urgency'[IsUrgentCloseClass] =1",
              "    )",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "% Urgent Closed Class",
            "expression": [
              "",
              "DIVIDE([# Total Urgent Closed Class], [# Total Closed Class], 0)"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# Total Campus New Class",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Class Urgency'[studycampus]),",
              "    FILTER(",
              "        'Class Urgency',",
              "        'Class Urgency'[tranxtype] = \"NewClass\"",
              "    )",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "# Total Campus Closed Class",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Class Urgency'[studycampus]),",
              "    FILTER(",
              "        'Class Urgency',",
              "        'Class Urgency'[tranxtype] = \"UpdateClassCancel\"",
              "    )",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "% Urgent New Class",
            "expression": "DIVIDE([# Total Urgent New Class],[# Total New Class],  0)",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
