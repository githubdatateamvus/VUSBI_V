          {
            "type": "calculated",
            "name": "Teaching Hours",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": " HOUR([EndTime]-[StartTime]) + MINUTE([EndTime]-[StartTime])/60"
          },
