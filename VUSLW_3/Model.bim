            "dataType": "dateTime",
            "sourceColumn": "CreatedOn"
          },
          {
            "name": "ModifiedOn",
            "dataType": "dateTime",
            "sourceColumn": "ModifiedOn"
          },
          {
            "name": "InsertOn",
            "dataType": "dateTime",
            "sourceColumn": "InsertOn"
          },
          {
            "name": "ReasonProbationFailID",
            "dataType": "string",
            "sourceColumn": "ReasonProbationFailID"
          },
          {
            "name": "ReasonProbationFail",
            "dataType": "string",
            "sourceColumn": "ReasonProbationFail"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_HRT_ALL_WORKER_ACTIONS_F = Source{[Schema=\"DWH\",Item=\"VW_HRT_ALL_WORKER_ACTIONS_F\"]}[Data]",
                "in",
                "    DWH_VW_HRT_ALL_WORKER_ACTIONS_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Upgrade",
            "expression": " CALCULATE(DISTINCTCOUNT('HRT All Worker Action'[PersonnelActionNumber]),'HRT All Worker Action'[IsUpgrade]=TRUE())",
            "formatString": "#,0"
          },
          {
            "name": "# of Passed Probations",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT All Worker Action'[PersonnelActionNumber]),",
              "    'HRT All Worker Action'[ResultProbation] = \"Pass\"",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Passed Probations",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Passed Probations],",
              "    [# of New Hires],",
              "    0",
              ")"
            ],
            "formatString": "#,0.00%;-#,0.00%;#,0.00%"
          },
          {
            "name": "# of New Hires",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT All Worker Action'[PersonnelActionNumber]),",
              "    KEEPFILTERS(",
              "        'HRT All Worker Action'[PersonnelActionType]",
              "            IN {\"NewHire\",\"Return\",\"Upgrade\"}",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of New Hires [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of New Hires],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% New Hires Growth [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of New Hires]  - [# of New Hires [Previous Year]]],",
              "    [# of New Hires [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "#,0.00%;-#,0.00%;#,0.00%"
          },
          {
            "name": "# of Passed Probations [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Passed Probations],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Passed Probations [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Passed Probations [Previous Year]]],",
              "    [# of New Hires [Previous Year]]],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Passed Probations Growth [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [% Passed Probations]  - [% Passed Probations [Previous Year]]],",
              "    [% Passed Probations [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Failed Probations",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT All Worker Action'[PersonnelActionNumber]),",
              "    'HRT All Worker Action'[ResultProbation] = \"Fail\"",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Passed Probations Change vs Previous Year (Percentage Point)",
            "expression": " [% Passed Probations] - [% Passed Probations [Previous Year]]]",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
