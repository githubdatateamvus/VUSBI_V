            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF(FORMAT('ASA Overview PD'[First Date Of Study], \"yyyy-MM\" )=\"1900-01\",\"\",FORMAT('ASA Overview PD'[First Date Of Study], \"yyyy-MM\" ))"
          },
          {
            "type": "calculated",
            "name": "Waiting Day",
            "dataType": "int64",
            "isDataTypeInferred": true,
