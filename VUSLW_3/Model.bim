              "    DISTINCTCOUNT('Teaching Hours Detail By Month'[Teacher Key]),",
              "    FILTER(",
              "        'Teaching Hours Detail By Month',",
              "        'Teaching Hours Detail By Month'[Teacher Type]  = \"NN\"",
              "",
              "    ),",
              "    USERELATIONSHIP('Teaching Hours Detail By Month'[Salary Month Year],'Salary Month Year'[Salary Month Year])",
              "   )",
              "",
              ")"
            ]
          },
          {
            "name": "# of Teacher VN Have Hours In Month",
            "expression": [
              "",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "      CALCULATE(",
              "    DISTINCTCOUNT('Teaching Hours Detail By Month'[Teacher Key]),",
              "    FILTER(",
              "        'Teaching Hours Detail By Month',",
              "        'Teaching Hours Detail By Month'[Teacher Type Adjusted] = \"VN\"",
              "",
              "    ),",
              "    USERELATIONSHIP('Teaching Hours Detail By Month'[Salary Month Year - Adjusted],'Salary Month Year'[Salary Month Year])",
              "   )",
              "",
              "     ",
              "     ,",
              "       CALCULATE(",
              "    DISTINCTCOUNT('Teaching Hours Detail By Month'[Teacher Key]),",
              "    FILTER(",
              "        'Teaching Hours Detail By Month',",
              "        'Teaching Hours Detail By Month'[Teacher Type]  = \"VN\"",
              "",
              "    ),",
              "    USERELATIONSHIP('Teaching Hours Detail By Month'[Salary Month Year],'Salary Month Year'[Salary Month Year])",
              "   )",
              "",
              ")"
            ]
          }
        ]
      },
      {
        "name": "Salary Month Year",
        "columns": [
          {
            "name": "Salary Month Year",
            "dataType": "string",
            "sourceColumn": "Salary Month Year"
          },
          {
            "name": "Year Month",
            "dataType": "string",
            "sourceColumn": "Year Month"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_SALARY_MONTH_YEAR_F = Source{[Schema=\"DWH\",Item=\"VW_SALARY_MONTH_YEAR_F\"]}[Data]",
                "in",
                "    DWH_VW_SALARY_MONTH_YEAR_F"
              ]
            }
          }
        ]
      },
