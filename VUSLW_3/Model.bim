        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TEACHING_HOURS_DETAIL_MONTH_F = Source{[Schema=\"DWH\",Item=\"VW_TEACHING_HOURS_DETAIL_MONTH_F\"]}[Data]",
                "in",
                "    DWH_VW_TEACHING_HOURS_DETAIL_MONTH_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Class By Month",
            "expression": [
              " ",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "    CALCULATE(DISTINCTCOUNT('Teaching Hours Detail By Month'[ClassId]),USERELATIONSHIP('Teaching Hours Detail By Month'[Salary Month Year - Adjusted],'Salary Month Year'[Salary Month Year])),",
              "    CALCULATE(DISTINCTCOUNT('Teaching Hours Detail By Month'[ClassId]),USERELATIONSHIP('Teaching Hours Detail By Month'[Salary Month Year],'Salary Month Year'[Salary Month Year]))",
              " )"
            ]
          },
          {
            "name": "# of Month Teacher",
            "expression": [
              "",
              "VAR from_date =",
              "    CALCULATE ( MIN ( 'Teaching Hours Detail By Month'[Date] ) )",
              "VAR to_date =",
              "    CALCULATE ( MAX ( 'Teaching Hours Detail By Month'[Date] ) )",
              "RETURN",
              "    IF (",
              "        ISBLANK ( from_date ) || ISBLANK ( to_date ),",
              "        BLANK (),",
              "        MAX ( 1, DATEDIFF ( from_date, to_date, MONTH ) )",
              "    )"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Max Avg Hour Teacher",
            "expression": [
              " ",
              "IF(",
              "    SELECTEDVALUE('AdjustValue'[IsAdjusted]) =1,",
              "     ",
              "     CALCULATE(AVERAGE('Teaching Hours Detail By Month'[Full Time Type Adjusted]),USERELATIONSHIP('Teaching Hours Detail By Month'[Salary Month Year - Adjusted],'Salary Month Year'[Salary Month Year])),",
              "     CALCULATE(AVERAGE('Teaching Hours Detail By Month'[FullTimeType]),USERELATIONSHIP('Teaching Hours Detail By Month'[Salary Month Year],'Salary Month Year'[Salary Month Year]))",
              "",
