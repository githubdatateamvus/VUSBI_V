            "name": "# of New Student PD",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
            "formatString": "#,0",
