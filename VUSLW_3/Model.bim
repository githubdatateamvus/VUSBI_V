            "sourceColumn": "W_DATASOURCE_NUM_ID"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_FACT_OVI_NOTIFICATION = Source{[Schema=\"DWH\",Item=\"VW_FACT_OVI_NOTIFICATION\"]}[Data]",
                "in",
                "    DWH_VW_FACT_OVI_NOTIFICATION"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "OVI Total Sent",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Ovi NotiIfication'),",
              "    'Ovi NotiIfication'[is_test_record] = \"N\",",
              "    'Ovi NotiIfication'[is_prod_env]    = \"Y\"",
              ")"
            ]
          },
          {
            "name": "OVI Total Read",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('Ovi NotiIfication'),",
              "    'Ovi NotiIfication'[is_test_record] = \"N\",",
              "    'Ovi NotiIfication'[is_prod_env]    = \"Y\",",
              "    'Ovi NotiIfication'[is_read_flag]   = \"Y\"",
              ")"
            ]
          },
          {
            "name": "OVI Total Unread",
            "expression": [
              "",
              "[OVI Total Sent] - [OVI Total Read]"
            ]
          },
          {
            "name": "OVI Read Rate %",
            "expression": [
              "",
              "DIVIDE(",
              "    [OVI Total Read],",
              "    [OVI Total Sent],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Read Rate % Label",
            "expression": [
              "",
              "FORMAT([OVI Read Rate %], \"0.00%\")"
            ]
          },
          {
            "name": "OVI Avg Response Time (s)",
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE('Ovi NotiIfication'[response_time_seconds]),",
              "    'Ovi NotiIfication'[is_test_record] = \"N\",",
              "    'Ovi NotiIfication'[is_prod_env]    = \"Y\",",
              "    'Ovi NotiIfication'[is_read_flag]   = \"Y\",",
              "    NOT ISBLANK('Ovi NotiIfication'[response_time_seconds])",
              ")"
            ]
          },
          {
            "name": "OVI Avg Response Time (min)",
            "expression": [
              "",
              "DIVIDE([OVI Avg Response Time (s)], 60, BLANK())"
            ]
          },
          {
            "name": "OVI Total Sent PrevMonth",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Total Sent],",
              "    DATEADD('Calendar'[Date], -1, MONTH)",
              ")"
            ]
          },
          {
            "name": "OVI Total Read PrevMonth",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Total Read],",
              "    DATEADD('Calendar'[Date], -1, MONTH)",
              ")"
            ]
          },
          {
            "name": "OVI Read Rate PrevMonth",
            "expression": [
              "",
              "DIVIDE(",
              "    [OVI Total Read PrevMonth],",
              "    [OVI Total Sent PrevMonth],",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Read Rate MoM Change",
            "expression": [
              "",
              "[OVI Read Rate %] - [OVI Read Rate PrevMonth]"
            ]
          },
          {
            "name": "OVI Sent MoM Growth %",
            "expression": [
              "",
              "DIVIDE(",
              "    [OVI Total Sent] - [OVI Total Sent PrevMonth],",
              "    [OVI Total Sent PrevMonth],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Total Sent YTD",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Total Sent],",
              "    DATESYTD('Calendar'[Date])",
              ")"
            ]
          },
          {
            "name": "OVI Total Read YTD",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Total Read],",
              "    DATESYTD('Calendar'[Date])",
              ")"
            ]
          },
          {
            "name": "OVI Read Rate by TypeGroup",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Read Rate %],",
              "    ALLEXCEPT('Ovi NotiIfication', 'Ovi NotiIfication'[type_group])",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Read Rate vs Avg",
            "expression": [
              "",
              "[OVI Read Rate %] - CALCULATE([OVI Read Rate %], ALL('Ovi NotiIfication'[type_group], 'Ovi NotiIfication'[app_name]))"
            ]
          },
          {
            "name": "OVI Read Rate Rank",
            "expression": [
              "",
              "RANKX(",
              "    ALLSELECTED('Ovi NotiIfication'[type_group]),",
              "    [OVI Read Rate %],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ]
          },
          {
            "name": "OVI % of Total Sent",
            "expression": [
              "",
              "DIVIDE(",
              "    [OVI Total Sent],",
              "    CALCULATE([OVI Total Sent], ALL('Ovi NotiIfication'[type_group], 'Ovi NotiIfication'[app_name], 'Ovi NotiIfication'[notification_type])),",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Read Rate by Hour",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Read Rate %],",
              "    ALLEXCEPT('Ovi NotiIfication', 'Ovi NotiIfication'[created_hour])",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Best Hour Label",
            "expression": [
              "",
              "VAR _BestHour =",
              "    TOPN(",
              "        1,",
              "        ADDCOLUMNS(",
              "            ALLNOBLANKROW('Ovi NotiIfication'[created_hour]),",
              "            \"RR\", CALCULATE([OVI Read Rate %],",
              "                'Ovi NotiIfication'[is_test_record]=\"N\",",
              "                'Ovi NotiIfication'[is_prod_env]=\"Y\")",
              "        ),",
              "        [RR], DESC",
              "    )",
              "RETURN",
              "    \"H\" & MINX(_BestHour, 'Ovi NotiIfication'[created_hour])",
              "    & \" (\" & FORMAT(MINX(_BestHour, [RR]), \"0.00%\") & \")\""
            ]
          },
          {
            "name": "OVI Peak Hour Volume",
            "expression": [
              "",
              "MAXX(",
              "    ADDCOLUMNS(",
              "        ALLNOBLANKROW('Ovi NotiIfication'[created_hour]),",
              "        \"Vol\", CALCULATE([OVI Total Sent],",
              "            'Ovi NotiIfication'[is_test_record]=\"N\",",
              "            'Ovi NotiIfication'[is_prod_env]=\"Y\")",
              "    ),",
              "    [Vol]",
              ")"
            ]
          },
          {
            "name": "OVI Read Rate by DayOfWeek",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Read Rate %],",
              "    ALLEXCEPT('Ovi NotiIfication', 'Ovi NotiIfication'[created_day_of_week])",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Read Rate by Month",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Read Rate %],",
              "    ALLEXCEPT('Calendar', 'Calendar'[Year], 'Calendar'[Month])",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Hour Performance Tier",
            "expression": [
              "",
              "VAR _RR = [OVI Read Rate %]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        _RR >= 0.15, \"Excellent (>=15%)\",",
              "        _RR >= 0.08, \"Good (8-14%)\",",
              "        _RR >= 0.03, \"Average (3-7%)\",",
              "        \"Poor (<3%)\"",
              "    )"
            ]
          },
          {
            "name": "OVI Read Rate by Province",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Read Rate %],",
              "    ALLEXCEPT('Ovi NotiIfication', 'Ovi NotiIfication'[student_province])",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Province Rank by Sent",
            "expression": [
              "",
              "RANKX(",
              "    ALLSELECTED('Ovi NotiIfication'[student_province]),",
              "    [OVI Total Sent],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ]
          },
          {
            "name": "OVI Province Rank by ReadRate",
            "expression": [
              "",
              "RANKX(",
              "    ALLSELECTED('Ovi NotiIfication'[student_province]),",
              "    [OVI Read Rate %],",
              "    ,",
              "    DESC,",
              "    DENSE",
              ")"
            ]
          },
          {
            "name": "OVI Province % of Total",
            "expression": [
              "",
              "DIVIDE(",
              "    [OVI Total Sent],",
              "    CALCULATE([OVI Total Sent], ALL('Ovi NotiIfication'[student_province])),",
              "    0",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "OVI Target Read Rate",
            "expression": " 0.05"
          },
          {
            "name": "OVI vs Target",
            "expression": [
              "",
              "[OVI Read Rate %] - [OVI Target Read Rate]"
            ]
          },
          {
            "name": "OVI vs Target Label",
            "expression": [
              "",
              "IF([OVI Read Rate %] >= [OVI Target Read Rate], \"DAT TARGET\", \"CHUA DAT\")"
            ]
          },
          {
            "name": "OVI vs Target Multiplier",
            "expression": [
              "",
              "DIVIDE([OVI Read Rate %], [OVI Target Read Rate], BLANK())"
            ]
          },
          {
            "name": "OVI Gap to Target",
            "expression": [
              "",
              "VAR _Target    = [OVI Target Read Rate]",
              "VAR _CurrentRR = [OVI Read Rate %]",
              "VAR _TotalSent = [OVI Total Sent]",
              "RETURN",
              "    IF(",
              "        _CurrentRR < _Target,",
              "        (_Target - _CurrentRR) * _TotalSent,",
              "        0",
              "    )"
            ]
          },
          {
            "name": "OVI Read Rate Color",
            "expression": [
              "",
              "VAR _RR = [OVI Read Rate %]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        _RR >= 0.15, \"#00B050\",   -- Xanh la: Tuyet voi >=15%",
              "        _RR >= 0.08, \"#FFC000\",   -- Vang: Tot 8-14%",
              "        _RR >= 0.05, \"#ED7D31\",   -- Cam: Dat target 5-7%",
              "        \"#FF0000\"                  -- Do: Chua dat <5%",
              "    )"
            ]
          },
          {
            "name": "OVI Sent Volume Color",
            "expression": [
              "",
              "VAR _Vol = [OVI Total Sent]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        _Vol >= 1000000, \"#1F3864\",  -- Dam: >= 1 trieu",
              "        _Vol >= 100000,  \"#2E75B6\",  -- Xanh: >= 100k",
              "        _Vol >= 10000,   \"#00B0F0\",  -- Nhat: >= 10k",
              "        \"#D9D9D9\"                     -- Xam: < 10k",
              "    )"
            ]
          },
          {
            "name": "OVI Province Alert Color",
            "expression": [
              "",
              "VAR _RR   = [OVI Read Rate %]",
              "VAR _Vol  = [OVI Total Sent]",
              "RETURN",
              "    IF(",
              "        _Vol > 10000 && _RR < 0.01,",
              "        \"#FF0000\",    -- Do: Volume lon nhung rate < 1% (bat thuong)",
              "        IF(_RR >= 0.07, \"#00B050\", IF(_RR >= 0.04, \"#FFC000\", \"#FF6600\"))",
              "    )"
            ]
          },
          {
            "name": "OVI Summary Card",
            "expression": [
              "",
              "FORMAT([OVI Total Sent]/1000000, \"0.0\") & \"M sent  |  \"",
              "    & FORMAT([OVI Total Read]/1000, \"0.0\") & \"K read  |  \"",
              "    & FORMAT([OVI Read Rate %], \"0.00%\")"
            ]
          },
          {
            "name": "OVI Active Apps Count",
            "expression": [
              "",
              "DISTINCTCOUNT('Ovi NotiIfication'[app_name])"
            ]
          },
          {
            "name": "OVI Active Notification Types",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('Ovi NotiIfication'[notification_type]),",
              "    'Ovi NotiIfication'[is_test_record] = \"N\",",
              "    'Ovi NotiIfication'[is_prod_env]    = \"Y\"",
              ")"
            ]
          },
          {
            "name": "OVI Read Rate Moving Avg 3M",
            "expression": [
              "",
              "CALCULATE(",
              "    [OVI Read Rate %],",
              "    DATESINPERIOD('Calendar'[Date], LASTDATE('Calendar'[Date]), -3, MONTH)",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
      {
        "name": "HRT Person in Charge",
        "columns": [
          {
            "name": "Personincharge",
            "dataType": "string",
            "sourceColumn": "Personincharge"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_HRT_PERSON_IN_CHARGE_D = Source{[Schema=\"DWH\",Item=\"VW_HRT_PERSON_IN_CHARGE_D\"]}[Data]",
                "in",
                "    DWH_VW_HRT_PERSON_IN_CHARGE_D"
              ]
            }
          }
        ]
      },
      {
        "name": "HRT Application Funnel Steps",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Step",
            "dataType": "string",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Step]"
          },
          {
            "type": "calculatedTableColumn",
            "name": "Order",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Order]"
          }
        ],
        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                " ",
                "DATATABLE(",
                "    \"Step\", STRING,",
                "    \"Order\", INTEGER,",
                "    {",
                "        { \"CV Applied\", 1 },",
                "        { \"Qualified CV\", 2 },",
                "        { \"Interview\", 3 },",
                "        { \"Interview Set Up\", 4 },",
                "        { \"Interview Confirmed\", 5 },",
                "        { \"Interview Passed\", 6 },",
                "        { \"Offer Sent\", 7 },",
                "        { \"Offer Accepted\", 8 },",
                "        { \"New Hire\", 9 },",
                "        { \"New Hire (Hiring)\", 10 }        ",
                "    }",
                ")"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Headcount",
            "expression": [
              " ",
              "SWITCH(",
              "    SELECTEDVALUE('HRT Application Funnel Steps'[Step]),",
              "    \"CV Applied\", 'HRT Application'[# of All CVs],",
              "    \"Qualified CV\", 'HRT Application'[# of Qualified CVs],",
              "    \"Interview\", 'HRT Application'[# of Interviewed CVs],",
              "    \"Interview Set Up\", 'HRT Application'[# of Interviewed CVs (by Interview Date)],",
              "    \"Interview Confirmed\", 'HRT Application'[# of Confirmed Interview CVs (by Interview Date)],",
              "    \"Interview Passed\", 'HRT Application'[# of Passed Interview CVs (by Interview Date)],",
              "    \"Offer Sent\", 'HRT Application'[# of Offered CVs (by Offer Date)],",
              "    \"Offer Accepted\", 'HRT Application'[# of Accepted Offer CVs (by Offer Date)],",
              "    \"New Hire\", 'HRT Application'[# of Employed CVs (by Assign Date)],",
              "    \"New Hire (Hiring)\", 'HRT Application'[# of Employed CVs])"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Conversion",
            "expression": [
              "",
              "VAR CurrentOrder = SELECTEDVALUE('HRT Application Funnel Steps'[Order])",
              "VAR CurrentValue = [# of Headcount]",
              "",
              "-- Lấy Order nhỏ nhất TRONG CÁC STEP ĐANG ĐƯỢC CHỌN",
              "VAR FirstVisibleOrder =",
              "    CALCULATE(",
              "        MIN('HRT Application Funnel Steps'[Order]),",
              "        ALLSELECTED('HRT Application Funnel Steps')",
              "    )",
              "",
              "-- Lấy Order của Step liền trước TRONG CÁC STEP ĐANG ĐƯỢC CHỌN",
              "VAR PrevVisibleOrder =",
              "    CALCULATE(",
              "        MAX('HRT Application Funnel Steps'[Order]),",
              "        FILTER(",
              "            ALLSELECTED('HRT Application Funnel Steps'),",
              "            'HRT Application Funnel Steps'[Order] < CurrentOrder",
              "        )",
              "    )",
              "",
              "-- Tính Headcount của Step liền trước đó",
              "VAR PrevValue =",
              "    CALCULATE(",
              "        [# of Headcount],",
              "        ALLSELECTED('HRT Application Funnel Steps'),",
              "        'HRT Application Funnel Steps'[Order] = PrevVisibleOrder",
              "    )",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(CurrentOrder),",
              "        BLANK(),",
              "        IF(",
              "            CurrentOrder = FirstVisibleOrder,",
              "            1, -- Step đầu tiên trong danh sách hiển thị luôn là 100%",
              "            DIVIDE(CurrentValue, PrevValue, BLANK())",
              "        )",
              "    )"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Overall Conversion",
            "expression": [
              "",
              "VAR CurrentValue = [# of Headcount]",
              "VAR FirstOrder =",
              "    CALCULATE(",
              "        MIN('HRT Application Funnel Steps'[Order]),",
              "        ALL('HRT Application Funnel Steps')",
              "    )",
              "VAR FirstValue =",
              "    CALCULATE(",
              "        [# of Headcount],",
              "        FILTER(",
              "            ALL('HRT Application Funnel Steps'),",
              "            'HRT Application Funnel Steps'[Order] = FirstOrder",
              "        )",
              "    )",
              "RETURN",
              "    DIVIDE(CurrentValue, FirstValue, 0)"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          }
        ]
      },
      {
        "name": "HRT Recruitment KPI Rules",
        "columns": [
          {
            "name": "RecruitmentKPIRules",
            "dataType": "string",
            "sourceColumn": "RecruitmentKPIRules"
          },
          {
            "name": "RecruitmentTeam",
            "dataType": "string",
            "sourceColumn": "RecruitmentTeam"
          },
          {
            "name": "MinRate",
            "dataType": "double",
            "sourceColumn": "MinRate"
          },
          {
            "name": "MaxRate",
            "dataType": "double",
            "sourceColumn": "MaxRate"
          },
          {
            "name": "ComparisonType",
            "dataType": "string",
            "sourceColumn": "ComparisonType"
          },
          {
            "name": "ConvertedKPIRate",
            "dataType": "double",
            "sourceColumn": "ConvertedKPIRate"
          },
          {
            "name": "ConditionText",
            "dataType": "string",
            "sourceColumn": "ConditionText"
          },
          {
            "name": "FromDate",
            "dataType": "dateTime",
            "sourceColumn": "FromDate"
          },
          {
            "name": "ToDate",
            "dataType": "dateTime",
            "sourceColumn": "ToDate"
          },
          {
            "name": "InsertDate",
            "dataType": "dateTime",
            "sourceColumn": "InsertDate"
          },
          {
            "name": "MeasureType",
            "dataType": "string",
            "sourceColumn": "MeasureType"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_HRT_RECRUITMENT_KPI_RULES_F = Source{[Schema=\"DWH\",Item=\"VW_HRT_RECRUITMENT_KPI_RULES_F\"]}[Data]",
                "in",
                "    DWH_VW_HRT_RECRUITMENT_KPI_RULES_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "% Converted KPI (On-Time Order)",
            "expression": [
              " ",
              "// 1. Dùng trực tiếp giá trị thực tế theo Filter Context hiện tại của báo cáo",
              "VAR _ActualRate = 'HRT Recruitment Project'[% On-Time Order]",
              "",
              "// 2. Lấy Team hiện tại (Lưu ý: Đảm bảo bảng KPI Rules có mối quan hệ với bảng Fact hoặc chọn từ Slicer)",
              "VAR _CurrentTeam = SELECTEDVALUE('HRT Recruitment KPI Rules'[RecruitmentTeam])",
              "",
              "// 3. Lấy Ngày hiện tại để so sánh FromDate - ToDate",
              "VAR _SelectedDate = MAX('Calendar'[Date]) ",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(_ActualRate),",
              "        BLANK(),",
              "        CALCULATE(",
              "            MAX('HRT Recruitment KPI Rules'[ConvertedKPIRate]),",
              "            FILTER(",
              "                'HRT Recruitment KPI Rules',",
              "                -- Khớp Team & MeasureType",
              "                'HRT Recruitment KPI Rules'[RecruitmentTeam] = _CurrentTeam",
              "                && 'HRT Recruitment KPI Rules'[MeasureType] = \"On-time Order\"",
              "                ",
              "                -- Khớp thời hạn áp dụng Rule",
              "                && _SelectedDate >= 'HRT Recruitment KPI Rules'[FromDate]",
              "                && _SelectedDate <= 'HRT Recruitment KPI Rules'[ToDate]",
              "                ",
              "                -- Đối chiếu dải MinRate - MaxRate theo ComparisonType",
              "                && (",
              "                    (",
              "                        'HRT Recruitment KPI Rules'[ComparisonType] = \"Less\"",
              "                        && _ActualRate >= 'HRT Recruitment KPI Rules'[MinRate]",
              "                        && _ActualRate < 'HRT Recruitment KPI Rules'[MaxRate]",
              "                    )",
              "                    ||",
              "                    (",
              "                        'HRT Recruitment KPI Rules'[ComparisonType] = \"More\"",
              "                        && _ActualRate <= 'HRT Recruitment KPI Rules'[MaxRate]",
              "                        && _ActualRate > 'HRT Recruitment KPI Rules'[MinRate]",
              "                    )",
              "                )",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Converted KPI (Passed Probation)",
            "expression": [
              " ",
              "// 1. Dùng trực tiếp giá trị thực tế của Passed Probation theo Filter Context hiện tại",
              "VAR _ActualRate = 'HRT All Worker Action'[% Passed Probations]",
              "",
              "// 2. Lấy Team hiện tại từ Slicer/Dimension đang dùng",
              "VAR _CurrentTeam = SELECTEDVALUE('Teacher Type'[TeacherType])",
              "",
              "// 3. Lấy Ngày hiện tại để so sánh FromDate - ToDate",
              "VAR _SelectedDate = MAX('Calendar'[Date]) ",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(_ActualRate),",
              "        BLANK(),",
              "        CALCULATE(",
              "            MAX('HRT Recruitment KPI Rules'[ConvertedKPIRate]),",
              "            FILTER(",
              "                -- Mở rộng tra cứu toàn bộ bảng Rules",
              "                ALL('HRT Recruitment KPI Rules'),",
              "                ",
              "                -- Khớp Team & MeasureType",
              "                'HRT Recruitment KPI Rules'[RecruitmentTeam] = _CurrentTeam",
              "                && 'HRT Recruitment KPI Rules'[MeasureType] = \"Passed Probation\"",
              "                ",
              "                -- Khớp thời hạn áp dụng Rule",
              "                && _SelectedDate >= 'HRT Recruitment KPI Rules'[FromDate]",
              "                && _SelectedDate <= 'HRT Recruitment KPI Rules'[ToDate]",
              "                ",
              "                -- Đối chiếu dải MinRate - MaxRate theo ComparisonType",
              "                && (",
              "                    (",
              "                        'HRT Recruitment KPI Rules'[ComparisonType] = \"Less\"",
              "                        && _ActualRate >= 'HRT Recruitment KPI Rules'[MinRate]",
              "                        && _ActualRate < 'HRT Recruitment KPI Rules'[MaxRate]",
              "                    )",
              "                    ||",
              "                    (",
              "                        'HRT Recruitment KPI Rules'[ComparisonType] = \"More\"",
              "                        && _ActualRate <= 'HRT Recruitment KPI Rules'[MaxRate]",
              "                        && _ActualRate > 'HRT Recruitment KPI Rules'[MinRate]",
              "                    )",
              "                )",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Converted KPI Full Year (Actual Expensive)",
            "expression": [
              " ",
              "// 1. Dùng trực tiếp giá trị thực tế của Passed Probation theo Filter Context hiện tại",
              "VAR _ActualRate = 'HRT Budget Classification Rules'[% Actual Expensive (Full Year)]",
              "",
              "// 2. Lấy Team hiện tại từ Slicer/Dimension đang dùng",
              "VAR _CurrentTeam = SELECTEDVALUE('Teacher Type'[TeacherType])",
              "",
              "// 3. Lấy Ngày hiện tại để so sánh FromDate - ToDate",
              "VAR _SelectedDate = MAX('Calendar'[Date]) ",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(_ActualRate),",
              "        BLANK(),",
              "        CALCULATE(",
              "            MAX('HRT Recruitment KPI Rules'[ConvertedKPIRate]),",
              "            FILTER(",
              "                -- Mở rộng tra cứu toàn bộ bảng Rules",
              "                ALL('HRT Recruitment KPI Rules'),",
              "                ",
              "                -- Khớp Team & MeasureType",
              "                'HRT Recruitment KPI Rules'[RecruitmentTeam] = _CurrentTeam",
              "                && 'HRT Recruitment KPI Rules'[MeasureType] = \"Actual Expensive\"",
              "                ",
              "                -- Khớp thời hạn áp dụng Rule",
              "                && _SelectedDate >= 'HRT Recruitment KPI Rules'[FromDate]",
              "                && _SelectedDate <= 'HRT Recruitment KPI Rules'[ToDate]",
              "                ",
              "                -- Đối chiếu dải MinRate - MaxRate theo ComparisonType",
              "                && (",
              "                    (",
              "                        'HRT Recruitment KPI Rules'[ComparisonType] = \"Less\"",
              "                        && _ActualRate >= 'HRT Recruitment KPI Rules'[MinRate]",
              "                        && _ActualRate < 'HRT Recruitment KPI Rules'[MaxRate]",
              "                    )",
              "                    ||",
              "                    (",
              "                        'HRT Recruitment KPI Rules'[ComparisonType] = \"More\"",
              "                        && _ActualRate <= 'HRT Recruitment KPI Rules'[MaxRate]",
              "                        && _ActualRate > 'HRT Recruitment KPI Rules'[MinRate]",
              "                    )",
              "                )",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Converted KPI Monthly (Actual Expensive)",
            "expression": [
              " ",
              "// 1. Dùng trực tiếp giá trị thực tế của Passed Probation theo Filter Context hiện tại",
              "VAR _ActualRate = 'HRT Budget Classification Rules'[% Actual Expensive (Monthly)]",
              "",
              "// 2. Lấy Team hiện tại từ Slicer/Dimension đang dùng",
              "VAR _CurrentTeam = SELECTEDVALUE('Teacher Type'[TeacherType])",
              "",
              "// 3. Lấy Ngày hiện tại để so sánh FromDate - ToDate",
              "VAR _SelectedDate = MAX('Calendar'[Date]) ",
              "",
              "RETURN",
              "    IF(",
              "        ISBLANK(_ActualRate),",
              "        BLANK(),",
              "        CALCULATE(",
              "            MAX('HRT Recruitment KPI Rules'[ConvertedKPIRate]),",
              "            FILTER(",
              "                -- Mở rộng tra cứu toàn bộ bảng Rules",
              "                ALL('HRT Recruitment KPI Rules'),",
              "                ",
              "                -- Khớp Team & MeasureType",
              "                'HRT Recruitment KPI Rules'[RecruitmentTeam] = _CurrentTeam",
              "                && 'HRT Recruitment KPI Rules'[MeasureType] = \"Actual Expensive\"",
              "                ",
              "                -- Khớp thời hạn áp dụng Rule",
              "                && _SelectedDate >= 'HRT Recruitment KPI Rules'[FromDate]",
              "                && _SelectedDate <= 'HRT Recruitment KPI Rules'[ToDate]",
              "                ",
              "                -- Đối chiếu dải MinRate - MaxRate theo ComparisonType",
              "                && (",
              "                    (",
              "                        'HRT Recruitment KPI Rules'[ComparisonType] = \"Less\"",
              "                        && _ActualRate >= 'HRT Recruitment KPI Rules'[MinRate]",
              "                        && _ActualRate < 'HRT Recruitment KPI Rules'[MaxRate]",
              "                    )",
              "                    ||",
              "                    (",
              "                        'HRT Recruitment KPI Rules'[ComparisonType] = \"More\"",
              "                        && _ActualRate <= 'HRT Recruitment KPI Rules'[MaxRate]",
              "                        && _ActualRate > 'HRT Recruitment KPI Rules'[MinRate]",
              "                    )",
              "                )",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "0%;-0%;0%"
          }
        ]
      },
      {
        "name": "HRT Budget Classification Rules",
        "columns": [
          {
            "name": "BudgetClassificationRules",
            "dataType": "string",
            "sourceColumn": "BudgetClassificationRules"
          },
          {
            "name": "BudgetItem",
            "dataType": "string",
            "sourceColumn": "BudgetItem"
          },
          {
            "name": "BudgetType",
            "dataType": "string",
            "sourceColumn": "BudgetType"
          },
          {
            "name": "FromDate",
            "dataType": "dateTime",
            "sourceColumn": "FromDate"
          },
          {
            "name": "ToDate",
            "dataType": "dateTime",
            "sourceColumn": "ToDate"
          },
          {
            "name": "InsertDate",
            "dataType": "dateTime",
            "sourceColumn": "InsertDate"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_HRT_BUDGET_CLASSIFICATION_RULES_F = Source{[Schema=\"DWH\",Item=\"VW_HRT_BUDGET_CLASSIFICATION_RULES_F\"]}[Data]",
                "in",
                "    DWH_VW_HRT_BUDGET_CLASSIFICATION_RULES_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Full Year Sourcing Budget (Active Student)",
            "expression": [
              " ",
              "// 1. Lấy danh sách BudgetItem thuộc nhóm \"Sourcing\" từ bảng Rules",
              "VAR _SourcingItems = ",
              "    CALCULATETABLE(",
              "        VALUES('HRT Budget Classification Rules'[BudgetItem]),",
              "        'HRT Budget Classification Rules'[BudgetType] = \"Sourcing\",",
              "        REMOVEFILTERS('HRT Budget Classification Rules')",
              "    )",
              "",
              "RETURN",
              "CALCULATE(",
              "    [# of Budget (Active student)],",
              "    ",
              "    -- 1. Điều kiện SubTeam thuộc nhóm EX, VN, TA",
              "    'Budget Management'[SubTeam] IN { \"EX\", \"VN\", \"TA\" },",
              "",
              "    -- 2. Lọc Item từ bảng Classification Rules sang Budget Management",
              "    TREATAS(_SourcingItems, 'Budget Management'[Item]),",
              "",
              "    -- 3. Đánh cầu nối ảo từ Slicer TeacherType sang SubTeam",
              "    TREATAS(",
              "        VALUES('Teacher Type'[TeacherType]),",
              "        'Budget Management'[SubTeam]",
              "    ),",
              "",
              "    -- 4. Bỏ qua lọc Tháng/Quý/Ngày nhưng GIỮ LẠI lọc Năm",
              "    ALLEXCEPT('Calendar', 'Calendar'[Year]) -- Thay 'Calendar'[Year] thành đúng tên cột Năm của bạn",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Monthly Sourcing Budget (Active Student)",
            "expression": [
              " ",
              "// 1. Lấy danh sách BudgetItem thuộc nhóm \"Sourcing\" từ bảng Rules",
              "VAR _SourcingItems = ",
              "    CALCULATETABLE(",
              "        VALUES('HRT Budget Classification Rules'[BudgetItem]),",
              "        'HRT Budget Classification Rules'[BudgetType] = \"Sourcing\",",
              "        REMOVEFILTERS('HRT Budget Classification Rules')",
              "    )",
              "",
              "RETURN",
              "CALCULATE(",
              "    [# of Budget (Active student)],",
              "    ",
              "    -- 1. Điều kiện SubTeam thuộc nhóm EX, VN, TA",
              "    'Budget Management'[SubTeam] IN { \"EX\", \"VN\", \"TA\" },",
              "",
              "    -- 2. Lọc Item từ bảng Classification Rules sang Budget Management",
              "    TREATAS(_SourcingItems, 'Budget Management'[Item]),",
              "",
              "    -- 3. Đánh cầu nối ảo truyền bộ lọc từ Slicer TeacherType sang SubTeam",
              "    TREATAS(",
              "        VALUES('Teacher Type'[TeacherType]),",
              "        'Budget Management'[SubTeam]",
              "    )",
              "",
              "    -- Để nguyên Filter Context thời gian (không can thiệp Calendar)",
              "    -- Power BI sẽ tự động lọc theo đúng Tháng/Năm bạn chọn trên Slicer",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Actual Expensive (Full Year)",
            "expression": " DIVIDE([# of PO Gross Amount], [# of Full Year Sourcing Budget (Active Student)],0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Actual Expensive (Monthly)",
            "expression": " DIVIDE([# of PO Gross Amount], [# of Monthly Sourcing Budget (Active Student)],0)",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      }
    ],
