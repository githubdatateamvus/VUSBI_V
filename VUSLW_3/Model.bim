          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_PLACEMENT_TEST_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_PLACEMENT_TEST_F\"]}[Data]",
                "in",
                "    DWH_VW_ASA_PLACEMENT_TEST_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Placement Test",
            "expression": "CALCULATE(DISTINCTCOUNT('ASA Placement Test'[Student Key]))"
          },
          {
            "name": "% of Placement Test > Sale",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD],'ASA Placement Test'[# of Placement Test],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of PT > Show",
            "expression": [
              "",
              "CALCULATE(",
              "    'ASA Placement Test'[# of Placement Test],",
              "    FILTER(",
              "        'ASA Placement Test',",
              "        VALUE(",
              "            FORMAT(",
              "                COALESCE('ASA Placement Test'[Show Date], DATE(1900,1,1)),",
              "                \"yyyyMM\"",
              "            )",
              "        ) = VALUE(LEFT('ASA Placement Test'[Date Key], 6))",
              "    )",
              ")"
            ]
          },
          {
            "name": "# of PT > Show > Sign",
            "expression": [
              "",
              "CALCULATE(",
              "    'ASA Placement Test'[# of PT > Show],",
              "    FILTER(",
              "        'ASA Placement Test',",
              "        VALUE(",
              "            FORMAT(",
              "                COALESCE('ASA Placement Test'[Sign Date], DATE(1900,1,1)),",
              "                \"yyyyMM\"",
              "            )",
              "        ) = VALUE(LEFT('ASA Placement Test'[Date Key], 6))",
              "    )",
              ")"
            ]
          },
          {
            "name": "# of PT > Sign",
            "expression": [
              "",
              "CALCULATE(",
              "    'ASA Placement Test'[# of Placement Test],",
              "    FILTER(",
              "        'ASA Placement Test',",
              "        VALUE(",
              "            FORMAT(",
              "                COALESCE('ASA Placement Test'[Sign Date], DATE(1900,1,1)),",
              "                \"yyyyMM\"",
              "            )",
              "        ) = VALUE(LEFT('ASA Placement Test'[Date Key], 6))",
              "    )",
              ")"
            ]
          },
          {
            "name": "% PT > Sign In",
            "expression": " DIVIDE('ASA Placement Test'[# of PT > Sign],'ASA Placement Test'[# of PT > Show],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% PT > Sign for",
            "expression": " DIVIDE('ASA Placement Test'[# of PT > Sign],'ASA Placement Test'[# of Placement Test],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Show > PT",
            "expression": " DIVIDE('ASA Placement Test'[# of PT > Show],'ASA Enquiries'[# of Enquiries],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Std Placement Test Oral",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Placement Test'[Student Key]),",
              "    FILTER(",
              "        'ASA Placement Test',",
              "        LEN('ASA Placement Test'[SkillOral] & \"\") > 0",
              "    )",
              ")",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Std Placement Test Oral & Written",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Placement Test'[Student Key]),",
              "    FILTER(",
              "        'ASA Placement Test',",
              "        LEN('ASA Placement Test'[SkillOral] & \"\") > 0 &&",
              "        LEN('ASA Placement Test'[SkillWritten] & \"\") > 0",
              "    )",
              ")",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Std Placement Test Written",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Placement Test'[Student Key]),",
              "    FILTER(",
              "        'ASA Placement Test',",
              "        LEN('ASA Placement Test'[SkillWritten] & \"\") > 0",
              "    )",
              ")",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Placement Test Skill Rating",
            "expression": [
              "",
              "SUMX(",
              "    VALUES('ASA Placement Test'[Student Key]),",
              "    VAR HasOral =",
              "        CALCULATE(",
              "            MAXX(",
              "                'ASA Placement Test',",
              "                IF(",
              "                    'ASA Placement Test'[SkillOral] <> BLANK() && 'ASA Placement Test'[SkillOral] <> \"\",",
              "                    1,",
              "                    0",
              "                )",
              "            )",
              "        ) = 1",
              "    VAR HasWritten =",
              "        CALCULATE(",
              "            MAXX(",
              "                'ASA Placement Test',",
              "                IF(",
              "                    'ASA Placement Test'[SkillWritten] <> BLANK() && 'ASA Placement Test'[SkillWritten] <> \"\",",
              "                    1,",
              "                    0",
              "                )",
              "            )",
              "        ) = 1",
              "    RETURN",
              "        IF(HasOral, 0.5, 0) + IF(HasWritten, 0.5, 0)",
              ")",
              ""
            ]
          },
          {
            "name": "% OL PLT vs Target Month",
            "expression": [
              " [# of Placement Test Skill Rating] /48",
              "",
              ""
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# OL PLT Target Month",
            "expression": [
              " 48",
              "",
              ""
            ]
          },
          {
            "name": "# of Placement Test YES",
            "expression": "CALCULATE('ASA Placement Test'[# of Placement Test],FILTER('ASA Placement Test','ASA Placement Test'[# of Placement Test Skill Rating]>0))",
            "formatString": "#,0"
          },
          {
            "name": "# of PT Sign",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Placement Test],",
              "    'ASA Placement Test'[Sign Date] > DATE(1900,1,1)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of PT Sign In Month",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of PT Sign],",
              "    FILTER(",
              "        'ASA Placement Test',",
              "        YEAR('ASA Placement Test'[Sign Date]) = YEAR('ASA Placement Test'[TestingDate]) &&",
              "        MONTH('ASA Placement Test'[Sign Date]) = MONTH('ASA Placement Test'[TestingDate])",
              "    )",
              ")",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of PT Sign For Month",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of PT Sign],",
              "    USERELATIONSHIP('ASA Placement Test'[DateSignKey], 'Calendar'[Date Key])",
              ")",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "% PT yes > sign",
            "expression": "DIVIDE('ASA Placement Test'[# of PT > Sign],'ASA Placement Test'[# of Placement Test YES],0)",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
