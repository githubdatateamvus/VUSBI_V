            "dataType": "string",
            "sourceColumn": "Case Type Detail Code"
          },
          {
            "name": "Case Type Detail Name",
            "dataType": "string",
            "sourceColumn": "Case Type Detail Name"
          },
          {
            "type": "calculated",
            "name": "Group Status",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "if('All Feedback Process'[Case Status] = \"Overdue\",\"Overdue\",\"OnTime\")"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_FEEDBACK_PROCESS_F = Source{[Schema=\"DWH\",Item=\"VW_FEEDBACK_PROCESS_F\"]}[Data]",
                "in",
                "    DWH_VW_FEEDBACK_PROCESS_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Case",
            "expression": "CALCULATE(DISTINCTCOUNT('All Feedback Process'[Case Key]))"
          },
          {
            "name": "# of Case Overdue",
            "expression": " CALCULATE('All Feedback Process'[# of Case], FILTER('All Feedback Process','All Feedback Process'[Case Status] = \"Overdue\"))"
          },
          {
            "name": "% CR Case Over Due",
            "expression": " DIVIDE('All Feedback Process'[# of Case Overdue],'All Feedback Process'[# of Case],0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Case Compliment",
            "expression": " CALCULATE('All Feedback Process'[# of Case], FILTER('All Feedback Process','All Feedback Process'[Feedback Type]=\"Khen ngợi\"))"
          },
          {
            "name": "# of Case Complaint",
            "expression": " CALCULATE('All Feedback Process'[# of Case], FILTER('All Feedback Process','All Feedback Process'[Feedback Type]=\"Phản ánh / Phàn nàn\"))"
          },
          {
            "name": "% CR Case On Active Student",
            "expression": " DIVIDE('All Feedback Process'[# of Case],'ASA Sales Allocation'[# of Active Students News])",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Case Ontime",
            "expression": " CALCULATE('All Feedback Process'[# of Case], FILTER('All Feedback Process','All Feedback Process'[Case Status] <> \"Overdue\"))"
          },
          {
            "name": "% CR Case On Time",
            "expression": "DIVIDE('All Feedback Process'[# of Case Ontime],'All Feedback Process'[# of Case],0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Case Feedback",
            "expression": " CALCULATE('All Feedback Process'[# of Case], FILTER('All Feedback Process','All Feedback Process'[Feedback Type]=\"Phản hồi thông tin / Đóng góp ý kiến\"))"
          },
          {
            "name": "# of Case PreMonth",
            "expression": "CALCULATE(DISTINCTCOUNT('All Feedback Process'[Case Key]),PREVIOUSMONTH('Calendar'[Date]))"
          },
          {
            "name": "# of Case Overdue PreMonth",
            "expression": " CALCULATE(DISTINCTCOUNT('All Feedback Process'[Case Key]),PREVIOUSMONTH('Calendar'[Date]),'All Feedback Process'[Case Status] = \"Overdue\")"
          },
          {
            "name": "# of Case Ontime PreMonth",
            "expression": " CALCULATE(DISTINCTCOUNT('All Feedback Process'[Case Key]),PREVIOUSMONTH('Calendar'[Date]),'All Feedback Process'[Case Status] <> \"Overdue\")"
          },
          {
            "name": "% CR Case Over Due PreMonth",
            "expression": " DIVIDE('All Feedback Process'[# of Case Overdue PreMonth],'All Feedback Process'[# of Case PreMonth],0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% CR Case On Time PreMonth",
            "expression": "DIVIDE('All Feedback Process'[# of Case Ontime PreMonth],'All Feedback Process'[# of Case PreMonth],0)",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
