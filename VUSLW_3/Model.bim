        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_HRT_RECRUITMENT_COST_F = Source{[Schema=\"DWH\",Item=\"VW_HRT_RECRUITMENT_COST_F\"]}[Data]",
                "in",
                "    DWH_VW_HRT_RECRUITMENT_COST_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of PO Gross Amount",
            "expression": [
              " ",
              "SUMX(",
              "    'HRT Recruitment Cost',",
              "    COALESCE('HRT Recruitment Cost'[PO_GrossAmount], 0)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of PO Cost per QCV",
            "expression": [
              " ",
              "DIVIDE(",
              "    SUM('HRT Recruitment Cost'[PO_GrossAmount]),",
              "    'HRT Application'[# of Qualified CVs],",
              "    0)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of PO Cost per Employed CV",
            "expression": [
              " ",
              "DIVIDE(",
              "    SUM('HRT Recruitment Cost'[PO_GrossAmount]),",
              "    'HRT Application'[# of Employed CVs],",
              "    0)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of PO Cost per CV",
            "expression": [
              " ",
              "DIVIDE(",
              "    SUM('HRT Recruitment Cost'[PO_GrossAmount]),",
              "    'HRT Application'[# of All CVs],",
              "    0)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% PO Cost per Employed CV Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of PO Cost per Employed CV] - [# of PO Cost per Employed CV [Previous Year]]],",
              "    [# of PO Cost per Employed CV [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "#,0.0%;-#,0.0%;#,0.0%"
          },
          {
            "name": "# of PO Cost per Employed CV [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of PO Cost per Employed CV],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of PO Gross Amount [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of PO Gross Amount],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% PO Gross Amount Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of PO Gross Amount] - [# of PO Gross Amount [Previous Year]]],",
              "    [# of PO Gross Amount [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of PO Cost per QCV [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of PO Cost per QCV],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% PO Cost per QCV Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of PO Cost per QCV] - [# of PO Cost per QCV [Previous Year]]],",
              "    [# of PO Cost per QCV [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of PO Cost per Interviewed CV",
            "expression": [
              " ",
              "DIVIDE(",
              "    SUM('HRT Recruitment Cost'[PO_GrossAmount]),",
              "    'HRT Application'[# of Interviewed CVs],",
              "    0)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% PO Cost per Interviewed CV Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of PO Cost per Interviewed CV] - [# of PO Cost per Interviewed CV [Previous Year]]],",
              "    [# of PO Cost per Interviewed CV [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of PO Cost per Interviewed CV [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of PO Cost per Interviewed CV],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of PO Cost per CV [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of PO Cost per CV],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% PO Cost per CV Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of PO Cost per CV] - [# of PO Cost per CV [Previous Year]]],",
              "    [# of PO Cost per CV [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of PO Cost per Offered CV",
            "expression": [
              " ",
              "DIVIDE(",
              "    SUM('HRT Recruitment Cost'[PO_GrossAmount]),",
              "    'HRT Application'[# of Offered CVs],",
              "    0)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% PO Cost per Offered CV Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of PO Cost per Offered CV] - [# of PO Cost per Offered CV [Previous Year]]],",
              "    [# of PO Cost per Offered CV [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of PO Cost per Offered CV [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of PO Cost per Offered CV],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Most Cost Effective Text",
            "expression": [
              "",
              "VAR MinValue =",
              "    MINX(",
              "        ALLSELECTED('Recruitment Media'[Media]),",
              "        [# of PO Cost per Employed CV]",
              "    )",
              "VAR MinSource =",
              "    CALCULATE(",
              "        SELECTEDVALUE('Recruitment Media'[Media]),",
              "        FILTER(",
              "            ALLSELECTED('Recruitment Media'[Media]),",
              "            [# of PO Cost per Employed CV] = MinValue",
              "        )",
              "    )",
              "RETURN",
              "    MinSource & \" (\" & FORMAT(MinValue/1000000, \"0.0\") & \"M VND/hire)\""
            ]
          },
          {
            "name": "Least Cost Effective Text",
            "expression": [
              "",
              "VAR MaxValue =",
              "    MAXX(",
              "        ALLSELECTED('Recruitment Media'[Media]),",
              "        [# of PO Cost per Employed CV]",
              "    )",
              "VAR MaxSource =",
              "    CALCULATE(",
              "        SELECTEDVALUE('Recruitment Media'[Media]),",
              "        FILTER(",
              "            ALLSELECTED('Recruitment Media'[Media]),",
              "            [# of PO Cost per Employed CV] = MaxValue",
              "        )",
              "    )",
              "RETURN",
              "    MaxSource & \" (\" & FORMAT(MaxValue/1000000, \"0.0\") & \"M VND/hire)\""
            ]
          },
          {
            "name": "Cost Range Text",
            "expression": [
              "",
              "VAR MinValue =",
              "    MINX(",
              "        ALLSELECTED('Recruitment Media'[Media]),",
              "        [# of PO Cost per Employed CV]",
              "    )",
              "VAR MaxValue =",
              "    MAXX(",
              "        ALLSELECTED('Recruitment Media'[Media]),",
              "        [# of PO Cost per Employed CV]",
              "    )",
              "RETURN",
              "    FORMAT(MinValue/1000000, \"0.0\") & \"M ~ \" & FORMAT(MaxValue/1000000, \"0.0\") & \"M VND\""
            ]
          },
          {
            "name": "Average Cost Text",
            "expression": [
              "",
              "VAR AvgValue =",
              "    AVERAGEX(",
              "        ALLSELECTED('Recruitment Media'[Media]),",
              "        [# of PO Cost per Employed CV]",
              "    )",
              "RETURN",
              "    FORMAT(AvgValue/1000000, \"0.0\") & \"M VND\""
            ]
          }
        ]
      },
