        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_MILESTONES_COMPETENCY_D = Source{[Schema=\"DWH\",Item=\"VW_MILESTONES_COMPETENCY_D\"]}[Data]",
                "in",
