            "dataType": "string",
            "sourceColumn": "Date Key"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_PUSH_SALE_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_PUSH_SALE_F\"]}[Data]",
                "in",
                "    DWH_VW_ASA_PUSH_SALE_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of KKHT & TN",
            "expression": " CALCULATE(DISTINCTCOUNT(   'ASA Push Sale'[Lead Key]))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of KKHT",
            "expression": [
              " CALCULATE('ASA Push Sale'[# of KKHT & TN],FILTER('ASA Push Sale',",
              "OR(",
              "LEFT('ASA Push Sale'[Object Type],17) = \"Kết khóa hết tiền\"",
              ",LEFT('ASA Push Sale'[Object Type],4) = \"KKHT\"",
              ")",
              "))"
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of HVKK Tam ngung",
            "expression": " CALCULATE('ASA Push Sale'[# of KKHT & TN],FILTER('ASA Push Sale',LEFT('ASA Push Sale'[Object Type],9)=\"Tạm ngưng\"))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of HVKK Tai GD",
            "expression": " CALCULATE('ASA Push Sale'[# of KKHT],NOT(ISBLANK('ASA Push Sale'[InvoiceDate] )))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of HVKK TN TGD",
            "expression": " CALCULATE('ASA Push Sale'[# of HVKK Tam ngung],NOT(ISBLANK('ASA Push Sale'[InvoiceDate] )))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% KKHT",
            "expression": " DIVIDE('ASA Push Sale'[# of HVKK Tai GD],'ASA Push Sale'[# of KKHT],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Pool HVKKHT",
            "expression": [
              " ",
              "AVERAGEX(",
              "    KEEPFILTERS(VALUES('Calendar'[Year Month])),",
              "    CALCULATE(DIVIDE('ASA Push Sale'[# of HVKK TN TGD],'ASA Push Sale'[# of HVKK Tam ngung],BLANK()))",
              ")",
              "",
              "",
              ""
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Total HVKKHT TGD",
            "expression": " 'ASA Push Sale'[# of HVKK Tai GD] + 'ASA Push Sale'[# of HVKK TN TGD]",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# Cared",
            "expression": " CALCULATE('ASA Push Sale'[# of KKHT & TN],FILTER('ASA Push Sale','ASA Push Sale'[Cared]= \"Cared\"))"
          },
          {
            "name": "% Student Cared",
            "expression": " DIVIDE('ASA Push Sale'[# Cared],'ASA Push Sale'[# of KKHT & TN])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Student-TGD",
            "expression": " DIVIDE('ASA Push Sale'[# of Total HVKKHT TGD],'ASA Push Sale'[# of KKHT & TN])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of KKCT",
            "expression": " CALCULATE('ASA Push Sale'[# of KKHT & TN],FILTER('ASA Push Sale',OR(LEFT('ASA Push Sale'[Object Type],17) = \"Kết khóa còn tiền\",LEFT('ASA Push Sale'[Object Type],4) = \"KKCT\")))"
          },
          {
            "name": "# of KKCT Tai GD",
            "expression": " CALCULATE('ASA Push Sale'[# of KKCT],NOT(ISBLANK('ASA Push Sale'[InvoiceDate] )))"
          },
          {
            "name": "% KKCT",
            "expression": " DIVIDE('ASA Push Sale'[# of KKCT Tai GD],'ASA Push Sale'[# of KKCT],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Duration TGD",
            "expression": [
              " ",
              "VAR full_date = SELECTEDVALUE('ASA Push Sale'[Full Date])",
              "VAR Invoice_date = SELECTEDVALUE('ASA Push Sale'[InvoiceDate])",
              "VAR result = DATEDIFF(full_date,Invoice_date,DAY)",
              "Return result"
            ]
          },
          {
            "name": "% Act vs Target KKHT",
            "expression": " DIVIDE('ASA Push Sale'[# of HVKK Tai GD],'ASA Overview PD'[# of KKHT TGD Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Act vs Target Pending",
            "expression": " DIVIDE('ASA Push Sale'[# of HVKK TN TGD],'ASA Overview PD'[# of Pending Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Total RE KKHT&TN TGD",
            "expression": " 'ASA Overview OD'[# of Re Enrol OD]+ 'ASA Push Sale'[# of HVKK Tai GD] + 'ASA Push Sale'[# of HVKK TN TGD]"
          },
          {
            "name": "# of KKHT TGD 0D",
            "expression": " CALCULATE('ASA Push Sale'[# of HVKK Tai GD],'ASA Push Sale'[tuition amount] = 0)"
          },
          {
            "name": "# of TN TGD 0D",
            "expression": " CALCULATE('ASA Push Sale'[# of HVKK TN TGD],'ASA Push Sale'[tuition amount] = 0)"
          },
          {
            "name": "# of HVKK Tam ngung chưa GD",
            "expression": " 'ASA Push Sale'[# of HVKK Tam ngung] - 'ASA Push Sale'[# of HVKK TN TGD]"
          },
          {
            "name": "# of KKHT chưa GD",
            "expression": " 'ASA Push Sale'[# of KKHT] - 'ASA Push Sale'[# of HVKK Tai GD]"
          },
          {
            "name": "# of Show SNS Push Sale",
            "expression": "CALCULATE('ASA Push Sale'[# of KKHT & TN],FILTER('ASA Push Sale',LEFT('ASA Push Sale'[Object Type],3) = \"SNS\"))",
            "formatString": "0"
          },
          {
            "name": "% CR Show>Sign SNS Push Sale",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD SNS],'ASA Push Sale'[# of Show SNS Push Sale],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of HVKK Tai GD OD",
            "expression": " CALCULATE('ASA Push Sale'[# of KKHT],NOT(ISBLANK('ASA Push Sale'[First_DateOfStudy] )))",
            "formatString": "0"
          },
          {
            "name": "% KKHT-TGD-OD",
            "expression": "DIVIDE('ASA Push Sale'[# of HVKK Tai GD OD],'ASA Push Sale'[# of HVKK Tai GD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of HVKK TN TGD OD",
            "expression": " CALCULATE('ASA Push Sale'[# of HVKK Tam ngung],NOT(ISBLANK('ASA Push Sale'[First_DateOfStudy] )))",
            "formatString": "0"
          },
          {
            "name": "% KKTN-TGD-OD",
            "expression": "DIVIDE('ASA Push Sale'[# of HVKK TN TGD OD],'ASA Push Sale'[# of HVKK TN TGD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Lead Recycle",
            "expression": " CALCULATE(DISTINCTCOUNT(   'ASA Push Sale'[Lead Key]),FILTER('ASA Push Sale',LEFT('ASA Push Sale'[Object Type],7)=\"Recycle\"))"
          },
          {
            "name": "% lead_recycle_dial vs lead_recycle",
            "expression": "DIVIDE('Call Log'[# total_lead_recycle_dial],'ASA Push Sale'[# of Lead Recycle],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% lead_recycle_called vs lead_recycle",
            "expression": "DIVIDE('Call Log'[# total_lead_recycle_called],'ASA Push Sale'[# of Lead Recycle],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% KKHT + TN TGD",
            "expression": [
              "'ASA Push Sale'[% KKHT]+'ASA Push Sale'[% Pool HVKKHT]",
              ""
            ],
            "formatString": "0%;-0%;0%"
          }
        ]
      },
