            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=9, 'ASA Target'[Target Key]=\"Three\")",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
