            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "# of New Enrol PD iTalk",
            "expression": " CALCULATE(sum('ASA Overview PD'[Number Of New Enrol]),CONTAINSSTRING (Course[Course Type Code],\"iTalk\"),'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol PD iTalk",
            "expression": " CALCULATE(sum('ASA Overview PD'[Number Of Re Enrol]),CONTAINSSTRING (Course[Course Type Code],\"iTalk\"),'ASA Overview PD'[New Enrol Flag]=\"Re Enrol\")",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD iTalk",
            "expression": " CALCULATE(sum('ASA Overview PD'[Number Of Enrol]),CONTAINSSTRING (Course[Course Type Code],\"iTalk\"))",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "New Enrol PD Revenue iTalk Amt",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),CONTAINSSTRING (Course[Course Type Code],\"iTalk\"),'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Re Enrol PD Revenue iTalk Amt",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),CONTAINSSTRING (Course[Course Type Code],\"iTalk\"),'ASA Overview PD'[New Enrol Flag]=\"Re Enrol\")",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Enrol PD Revenue iTalk Amt",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),CONTAINSSTRING (Course[Course Type Code],\"iTalk\"))",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Tuition Amt",
            "expression": " CALCULATE(SUM('ASA Overview PD'[Tuition Amount]))",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Total Discount",
            "expression": " [Tuition Amt] - [Enrol PD Revenue Amt]",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of New Enrol PD Package",
            "expression": " [# of New Enrol PD 2K] + [# of New Enrol PD 3K] + [# of New Enrol PD Over 4K]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol PD Package",
            "expression": " [# of Re Enrol PD 2K] + [# of Re Enrol PD 3K] + [# of Re Enrol PD Over 4K]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol PD Total Package",
            "expression": " [# of Re Enrol PD 1K]+[# of Re Enrol PD Package]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD Total Package",
            "expression": " [# of New Enrol PD 1K]+[# of New Enrol PD Package]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD Package in the period",
            "expression": [
              " ",
              "var from_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(DISTINCTCOUNT('ASA Overview PD'[Invoice ID])",
              "\t,ALL('Calendar'[Date])",
              "\t,'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date",
              "\t,'ASA Overview PD'[Showed Date] >= from_date",
              "\t,'ASA Overview PD'[New Enrol Flag]=\"New Enrol\"",
              "\t,'ASA Overview PD'[Payment Flag] = \"Học phí\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Revenue Per Student PD",
            "expression": " DIVIDE([PD Revenue Amt],[# of Student PD],BLANK())",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Enrol By Campus By Chanel PD",
            "expression": [
              " CALCULATE(",
              "\tSUM('ASA Overview PD'[Number Of Enrol])",
              "\t,GROUPBY(Campus,Campus[Campus Code])",
              "\t,GROUPBY('List Consultant Type','List Consultant Type'[Channel])",
              "\t,REMOVEFILTERS()",
              ")"
            ],
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol By Campus By Chanel PD",
            "expression": "'ASA Overview PD'[# of Enrol PD]/'ASA Overview PD'[# of Enrol By Campus By Chanel PD]",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD LM",
            "expression": " CALCULATE([# of New Enrol PD],PREVIOUSMONTH('Calendar'[Date]))",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD SameDayLastMonth",
            "expression": " CALCULATE(SUM('ASA Overview PD'[Number Of New Enrol]),'ASA Overview PD'[New Enrol Flag]=\"New Enrol\", DATEADD('Calendar'[Date],-1,MONTH))",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD No Italk Campus Target",
            "expression": [
              "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target New Enrolment PD No Italk\"))",
              ""
            ],
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD Italk Campus Target",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target New Enrolment PD Italk\"))",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
