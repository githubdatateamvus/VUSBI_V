          },
          {
            "type": "calculated",
            "name": "QUIZ1 SCORE",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "IF([LEVELCODE] IN {\"SKE3\", \"SKE4\",\"SKE5\",\"SKE6\",\"SKE7\",\"SKE8\",\"SKG1\",\"SKG2\",\"SKG3\",\"SKG4\",\"SKG5\",\"SKG6\",\"SKG7\",\"SKG8\"},[QUIZ1_GRAMMAR]+[QUIZ1_VOCABULARY],IF([LEVELCODE] IN{ \"SKE1\" , \"SKE2\"},[QUIZ1_FINAL]))"
          },
          {
            "type": "calculated",
            "name": "SCORE_CURRENT",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "IF( [LEVELCODE] IN {\"SKE3\", \"SKE4\",\"SKE5\",\"SKE6\",\"SKE7\",\"SKE8\",\"SKG1\",\"SKG2\",\"SKG3\",\"SKG4\",\"SKG5\",\"SKG6\",\"SKG7\",\"SKG8\"},[FINAL_GRAMMAR]+[FINAL_VOCABULARY],IF([LEVELCODE] IN{ \"SKE1\" , \"SKE2\"},[FINAL_OVERALL]))"
          },
          {
            "type": "calculated",
            "name": "IMPROVE_CURRENT",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF([SCORE_CURRENT] > [QUIZ1 SCORE], \"Yes\", \"No\")"
          },
          {
            "type": "calculated",
            "name": "IMPROVE_PRE",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF([QUIZ1_FINAL_CURRENT] > [FINAL_OVERALL], \"Yes\", \"No\")"
          }
        ],
        "partitions": [
