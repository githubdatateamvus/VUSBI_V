          },
          {
            "name": "RetentionRate",
            "dataType": "double",
            "sourceColumn": "RetentionRate"
          },
          {
            "name": "PlanLesson",
            "dataType": "int64",
            "sourceColumn": "PlanLesson"
          },
          {
            "name": "ActutalLesson",
            "dataType": "int64",
            "sourceColumn": "ActutalLesson"
          },
          {
            "name": "ActualTeachingRate",
            "dataType": "double",
            "sourceColumn": "ActualTeachingRate"
          },
          {
            "name": "Note",
            "dataType": "string",
            "sourceColumn": "Note"
          },
          {
