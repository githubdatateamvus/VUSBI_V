        "measures": [
          {
            "name": "# of comments",
            "expression": " CALCULATE( COUNT('Teacher Comments NonELT'[ClassKey]),'Teacher Comments NonELT'[feedback] <> BLANK())"
          },
          {
            "name": "# of comments day 6",
            "expression": " CALCULATE(COUNT('Teacher Comments NonELT'[ClassKey]),'Teacher Comments NonELT'[feedback] IN {\"Digidation Comment (After Day 6)\",\"Digiconnect Comment (After Day 6)\"})"
          },
          {
            "name": "# of comments day 11",
            "expression": "CALCULATE(COUNT('Teacher Comments NonELT'[ClassKey]),'Teacher Comments NonELT'[name] IN {\"Digidation Comment (After Day 11)\",\"Digiconnect Comment (After Day 11)\"})"
          }
        ]
