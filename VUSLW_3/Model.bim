          },
          {
            "name": "CampusKey",
            "dataType": "string",
            "sourceColumn": "CampusKey"
          },
          {
            "name": "TeacherCode",
            "dataType": "string",
            "sourceColumn": "TeacherCode"
          },
          {
            "name": "Observation_Score",
            "dataType": "double",
            "sourceColumn": "Observation_Score"
          },
          {
            "name": "Survey_Score",
            "dataType": "double",
            "sourceColumn": "Survey_Score"
          },
          {
            "name": "Retention_Score",
            "dataType": "double",
            "sourceColumn": "Retention_Score"
          },
          {
            "name": "Total_Score_1",
            "dataType": "double",
            "sourceColumn": "Total_Score_1"
          },
          {
            "name": "Discipline_Score",
            "dataType": "double",
            "sourceColumn": "Discipline_Score"
          },
          {
            "name": "Cooperation_Score",
            "dataType": "double",
            "sourceColumn": "Cooperation_Score"
          },
          {
            "name": "Total_Score_2",
            "dataType": "double",
            "sourceColumn": "Total_Score_2"
          },
          {
            "name": "Improvement_Skill_Score",
            "dataType": "double",
            "sourceColumn": "Improvement_Skill_Score"
          },
          {
            "name": "Total_Score_3",
            "dataType": "double",
            "sourceColumn": "Total_Score_3"
          },
          {
            "name": "Feedback_Score",
            "dataType": "double",
            "sourceColumn": "Feedback_Score"
          },
          {
            "name": "Total_Score",
            "dataType": "double",
            "sourceColumn": "Total_Score"
          },
          {
            "name": "RankName",
            "dataType": "string",
            "sourceColumn": "RankName"
          },
          {
            "name": "RankCode",
            "dataType": "string",
            "sourceColumn": "RankCode"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TEACHER_RANKING_NEW_F = Source{[Schema=\"DWH\",Item=\"VW_TEACHER_RANKING_NEW_F\"]}[Data]",
                "in",
                "    DWH_VW_TEACHER_RANKING_NEW_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Ranking Teacher New",
            "expression": " 'Teacher Ranking New'[# of Average Teacher New]+ 'Teacher Ranking New'[# of Excellent Teacher New] + 'Teacher Ranking New'[# of Fairly Good Teacher New] + 'Teacher Ranking New'[# of Good Teacher New]+ 'Teacher Ranking New'[# of Weak Teacher New]"
          },
          {
            "name": "# of Excellent Teacher New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking New'[TeacherCode]),  'Teacher Ranking New'[RankCode] = \"XUATSAC\")"
          },
          {
            "name": "# of Good Teacher New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking New'[TeacherCode]),  'Teacher Ranking New'[RankCode] = \"GIOI\")"
          },
          {
            "name": "# of Average Teacher New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking New'[TeacherCode]),  'Teacher Ranking New'[RankCode] = \"KHA\")"
          },
          {
            "name": "# of Fairly Good Teacher New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking New'[TeacherCode]), 'Teacher Ranking New'[RankCode] = \"KHAGIOI\")"
          },
          {
            "name": "# of Weak Teacher New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking New'[TeacherCode]),  'Teacher Ranking New'[RankCode] = \"TRUNGBINH\")"
          },
          {
            "name": "# of Ranking Teacher VUS New",
            "expression": " 'Teacher Ranking New'[# of Average Teacher VUS New]+'Teacher Ranking New'[# of Excellent Teacher VUS New]+'Teacher Ranking New'[# of Fairly Good Teacher VUS New] + 'Teacher Ranking New'[# of Good Teacher VUS New] +'Teacher Ranking New'[# of Weak Teacher VUS New]"
          },
          {
            "name": "# of Excellent Teacher VUS New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking VUS'[Teacher Code]), 'Teacher Ranking New'[RankCode] = \"XUATSAC\")"
          },
          {
            "name": "# of Good Teacher VUS New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking VUS'[Teacher Code]), 'Teacher Ranking New'[RankCode]= \"GIOI\")"
          },
          {
            "name": "# of Average Teacher VUS New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking VUS'[Teacher Code]), 'Teacher Ranking New'[RankCode] = \"KHA\")"
          },
          {
            "name": "# of Fairly Good Teacher VUS New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking VUS'[Teacher Code]), 'Teacher Ranking New'[RankCode] = \"KHAGIOI\")"
          },
          {
            "name": "# of Weak Teacher VUS New",
            "expression": " CALCULATE(DISTINCTCOUNT('Teacher Ranking VUS'[Teacher Code]), 'Teacher Ranking New'[RankCode] = \"TRUNGBINH\")"
          },
          {
            "name": "% Good Teacher New",
            "expression": " DIVIDE([# of Good Teacher New],'Teacher Ranking New'[# of Ranking Teacher New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Average Teacher New",
            "expression": " DIVIDE([# of Average Teacher New],'Teacher Ranking New'[# of Ranking Teacher New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Excellent Teacher New",
            "expression": " DIVIDE([# of Excellent Teacher New],'Teacher Ranking New'[# of Ranking Teacher New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Fairly Good Teacher New",
            "expression": " DIVIDE([# of Fairly Good Teacher New],'Teacher Ranking New'[# of Ranking Teacher New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Weak Teacher New",
            "expression": " DIVIDE([# of Weak Teacher New],'Teacher Ranking New'[# of Ranking Teacher New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Excellent Teacher VUS New",
            "expression": " DIVIDE([# of Excellent Teacher VUS New],'Teacher Ranking New'[# of Ranking Teacher VUS New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Good Teacher VUS New",
            "expression": " DIVIDE([# of Good Teacher VUS New],'Teacher Ranking New'[# of Ranking Teacher VUS New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Average Teacher VUS New",
            "expression": " DIVIDE([# of Average Teacher VUS New],'Teacher Ranking New'[# of Ranking Teacher VUS New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Fairly Good Teacher VUS New",
            "expression": " DIVIDE([# of Fairly Good Teacher VUS New],'Teacher Ranking New'[# of Ranking Teacher VUS New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Weak Teacher VUS New",
            "expression": " DIVIDE([# of Weak Teacher VUS New],'Teacher Ranking New'[# of Ranking Teacher VUS New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "Avg Teacher Ranking VUS New",
            "expression": " DIVIDE('Teacher Ranking New'[# of Ranking Teacher VUS New],[# of Campus],BLANK())"
          },
          {
            "name": "% Teacher Ranking vs VUS New",
            "expression": " DIVIDE('Teacher Ranking New'[# of Ranking Teacher New],'Teacher Ranking New'[# of Ranking Teacher VUS New],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
