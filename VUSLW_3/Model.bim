          },
          {
            "type": "calculated",
            "name": "Score Band 10",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR score = 'Student Score'[Score]",
              "VAR maxScore = 'Student Score'[MaxScore]",
              "VAR scaledScore = DIVIDE(score, maxScore) * 10",
              "",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    scaledScore < 0, \"# Not Taken\",",
              "    scaledScore < 1, \"0–0.9\",",
              "    scaledScore < 2, \"1–1.9\",",
              "    scaledScore < 3, \"2–2.9\",",
              "    scaledScore < 4, \"3–3.9\",",
              "    scaledScore < 5, \"4–4.9\",",
              "    scaledScore < 6, \"5–5.9\",",
              "    scaledScore < 7, \"6–6.9\",",
              "    scaledScore < 8, \"7–7.9\",",
              "    scaledScore < 9, \"8–8.9\",",
              "    scaledScore < 10, \"9 –9.9\",",
              "    \"9.91 10\"",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "Score Band 100",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR score = 'Student Score'[Score]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        score < 0, \"# Not Taken\",",
              "        score < 10, \"0–9\",",
              "        score < 20, \"10–19\",",
              "        score < 30, \"20–29\",",
              "        score < 40, \"30–39\",",
              "        score < 50, \"40–49\",",
              "        score < 60, \"50–59\",",
              "        score < 70, \"60–69\",",
              "        score < 80, \"70–79\",",
              "        score < 90, \"80–89\",",
              "        score < 100, \"90–99\",",
              "        \"9.1 100\")"
            ]
          },
          {
            "name": "ILE_Final",
            "dataType": "string",
            "sourceColumn": "ILE_Final"
          },
          {
            "type": "calculated",
            "name": "Score Band 0.5",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "VAR score = 'Student Score'[Score]",
              "VAR maxScore = 'Student Score'[MaxScore]",
              "VAR scaledScore = DIVIDE(score, maxScore) * 10",
              "",
              "RETURN",
              "SWITCH(",
              "    TRUE(),",
              "    \tscaledScore < 0, \"# Not Taken\",",
              "\tscaledScore < 0.5, \"0 –0.4\",",
              "\tscaledScore < 1, \"0.5 –0.9\",",
              "\tscaledScore < 1.5, \"1 –1.4\",",
              "\tscaledScore < 2, \"1.5 –1.9\",",
              "\tscaledScore < 2.5, \"2 –2.4\",",
              "\t    scaledScore < 3, \"2.5 –2.9\",",
              "\t    scaledScore < 3.5, \"3 –3.4\",",
              "\t    scaledScore < 4, \"3.5 –3.9\",",
              "\t    scaledScore < 4.5, \"4 –4.4\",",
              "\tscaledScore < 5, \"4.5 –4.9\",",
              "\tscaledScore < 5.5, \"5 –5.4\",",
              "\tscaledScore < 6, \"5.5 –5.9\",",
              "\tscaledScore < 6.5, \"6 –6.4\",",
              "\tscaledScore < 7, \"6.5 –6.9\",",
              "    scaledScore < 7.5, \"7 –7.4\",",
              "    scaledScore < 8, \"7.5 –7.9\",",
              "    scaledScore < 8.5, \"8 –8.4\",",
              "\tscaledScore < 9, \"8.5 –8.9\",",
              "    scaledScore < 9.5, \"9 –9.4\",",
              "    scaledScore < 10, \"9.5 –9.9\",",
              "    \"9.91 10\"",
              ")"
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_STUDENT_SCORE_LMS_ASA = Source{[Schema=\"DWH\",Item=\"VW_STUDENT_SCORE_LMS_ASA\"]}[Data]",
                "in",
                "    DWH_VW_STUDENT_SCORE_LMS_ASA"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of TQM Average Score",
            "expression": " 'Student Score'[# of TQM Total Score]/'Student Score'[# of TQM Total  Student Have Score  By Class]"
          },
          {
            "name": "# of TQM Median Score",
            "expression": " CALCULATE(MEDIANX(FILTER ( 'Student Score',AND('Student Score'[Enable]=1,'Student Score'[Score]<>-1)),'Student Score'[Score]))"
          },
          {
            "name": "# of TQM Min Score",
            "expression": " CALCULATE(MINX(FILTER ( 'Student Score',AND('Student Score'[Enable]=1,'Student Score'[Score]<>-1)),'Student Score'[Score]))"
          },
          {
            "name": "# of TQM Max Score",
            "expression": " CALCULATE(AVERAGE('Student Score'[MaxScore]),'Student Score'[Enable]=1,'Student Score'[Score]<>-1)"
          },
          {
            "name": "# of TQM Total Score",
            "expression": [
              " CALCULATE(",
              "",
              "SUMX(",
              "    SUMMARIZE(",
              "       ",
              "        FILTER(",
              "         'Student Score',",
              "         AND('Student Score'[Score]<>-1,'Student Score'[Enable]=1)",
              "          ),",
              "         'Student Score'[DateKey],",
              "         'Student Score'[ClassKey],",
              "         'Student Score'[StudentKey],",
              "         'Student Score'[CampusKey],",
              "         'Student Score'[LevelKey],",
              "         'Student Score'[TypeExam],",
              "          'Student Score'[Subject Name],",
              "         'Student Score'[Subject Name 2],",
              "        \"ScoreValue\", AVERAGE( 'Student Score'[Score])",
              "    ),",
              "    [ScoreValue]",
              ")",
              ")"
            ]
          },
          {
            "name": "# of TQM Total  Student Have Score",
            "expression": " CALCULATE(DISTINCTCOUNT('Student Score'[StudentKey]),'Student Score'[Score] <> -1,'Student Score'[Enable]=1)"
          },
          {
            "name": "# of TQM Avg YL Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Final\",CONTAINSSTRING('Student Score'[Subject Name],\"Result\"),OR(Course[Course Type Code]=\"YLn\",Course[Course Type Code]=\"YLpro\"))"
          },
          {
            "name": "# of TQM Avg ILE Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Mock Test\",CONTAINSSTRING('Student Score'[Subject Name],\"Overall\"),Course[Course Type Code]=\"ILE\")"
          },
          {
            "name": "# of TQM Avg ILX Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"mt ielts\",CONTAINSSTRING('Student Score'[Subject Name],\"Overall\"),Course[Course Type Code]=\"ILX\")"
          },
          {
            "name": "# of TQM Avg SK Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Final\",CONTAINSSTRING('Student Score'[Subject Name],\"Result\"),OR(OR(Course[Course Type Code]=\"SKn\",Course[Course Type Code]=\"SKnorth\"),Course[Course Type Code]=\"SKpro\"))"
          },
          {
            "name": "# of TQM Avg Starters Score Final Actual",
            "expression": "  CALCULATE( AVERAGEX('Student Score',VALUE('Student Score'[Score])),FILTER('Student Score','Student Score'[TypeExam]=\"Final\"),FiLTER('Student Score','Student Score'[Subject Name] IN {\"Result\",\"Result ( 10 )\",\"Result ( 100 )\"}),FILTER('Course',Course[Course Type Code] IN {\"SKn\",\"SKnorth\",\"SKpro\"}),FILTER('Course', Course[Level Group Code]=\"STARTERS\"),FILTER('Student Score','Student Score'[Score]<>-1),FILTER('Student Score','Student Score'[Enable]=1))"
          },
          {
            "name": "# of TQM Avg Movers Score Final Actual",
            "expression": "  CALCULATE( AVERAGEX('Student Score',VALUE('Student Score'[Score])),FILTER('Student Score','Student Score'[TypeExam]=\"Final\"),FiLTER('Student Score','Student Score'[Subject Name] IN {\"Result\",\"Result ( 10 )\",\"Result ( 100 )\"}),FILTER('Course',Course[Course Type Code] IN {\"SKn\",\"SKnorth\",\"SKpro\"}),FILTER('Course', Course[Level Group Code]=\"MOVERS\"),FILTER('Student Score','Student Score'[Score]<>-1),FILTER('Student Score','Student Score'[Enable]=1))"
          },
          {
            "name": "# of TQM Avg Flyers Score Final Actual",
            "expression": " CALCULATE( AVERAGEX('Student Score',VALUE('Student Score'[Score])),FILTER('Student Score','Student Score'[TypeExam]=\"Final\"),FiLTER('Student Score','Student Score'[Subject Name] IN {\"Result\",\"Result ( 10 )\",\"Result ( 100 )\"}),FILTER('Course',Course[Course Type Code] IN {\"SKn\",\"SKnorth\",\"SKpro\"}),FILTER('Course', Course[Level Group Code]=\"FLYERS\"),FILTER('Student Score','Student Score'[Score]<>-1),FILTER('Student Score','Student Score'[Enable]=1))"
          },
          {
            "name": "# of TQM Avg PYL Score Final Actual",
            "expression": " CALCULATE( AVERAGEX('Student Score',VALUE('Student Score'[Score])),FILTER('Student Score','Student Score'[TypeExam]=\"Final\"),FiLTER('Student Score','Student Score'[Subject Name]=\"Result\"),FILTER('Course',Course[Course Type Code] IN {\"YLn\",\"YLpro\"}),FILTER('Course', Course[Level Group Code]=\"PYL\"),FILTER('Student Score','Student Score'[Score]<>-1),FILTER('Student Score','Student Score'[Enable]=1))"
          },
          {
            "name": "# of TQM Avg YLC Score Final Actual",
            "expression": " CALCULATE( AVERAGEX('Student Score',VALUE('Student Score'[Score])),FILTER('Student Score','Student Score'[TypeExam]=\"Final\"),FiLTER('Student Score','Student Score'[Subject Name]=\"Result\"),FILTER('Course',Course[Course Type Code] IN {\"YLn\",\"YLpro\"}),FILTER('Course', Course[Level Group Code]=\"YLC\"),FILTER('Student Score','Student Score'[Score]<>-1),FILTER('Student Score','Student Score'[Enable]=1))"
          },
          {
            "name": "# of TQM Avg YLS Score Final Actual",
            "expression": "CALCULATE( AVERAGEX('Student Score',VALUE('Student Score'[Score])),FILTER('Student Score','Student Score'[TypeExam]=\"Final\"),FiLTER('Student Score','Student Score'[Subject Name]=\"Result\"),FILTER('Course',Course[Course Type Code] IN {\"YLn\",\"YLpro\"}),FILTER('Course', Course[Level Group Code]=\"YLS\"),FILTER('Student Score','Student Score'[Score]<>-1),FILTER('Student Score','Student Score'[Enable]=1))"
          },
          {
            "name": "# of TQM Avg EAP Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Mock Test\",CONTAINSSTRING('Student Score'[Subject Name],\"Overall\"),Course[Level Group Code]=\"EAP\")"
          },
          {
            "name": "# of TQM Avg ADULTS Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam] =\"Final Term\",CONTAINSSTRING('Student Score'[Subject Name],\"Overall\"),Course[Level Group Code]=\"ADULTS\")"
          },
          {
            "name": "# of TQM Total  Student Have Score No Distinct",
            "expression": " CALCULATE(Count('Student Score'[StudentKey]),'Student Score'[Score] <> -1,'Student Score'[Enable]=1)"
          },
          {
            "name": "# of TQM Average Score No Distinct",
            "expression": " 'Student Score'[# of TQM Total Score]/'Student Score'[# of TQM Total  Student Have Score No Distinct]"
          },
          {
            "name": "# of TQM Total  Student Have Score  By Class",
            "expression": " SUMX ( VALUES ( 'Student Score'[ClassKey] ), CALCULATE(DISTINCTCOUNT('Student Score'[StudentKey]),'Student Score'[Score] <> -1,'Student Score'[Enable]=1) )"
          },
          {
            "name": "# of TQM Average Score By Class",
            "expression": " 'Student Score'[# of TQM Total Score]/'Student Score'[# of TQM Total  Student Have Score  By Class]"
          },
          {
            "name": "# of TQM Avg IE/EH Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Final Term\", CONTAINSSTRING('Student Score'[Subject Name],\"Overall\"),Course[Level Group Code]=\"IE/EH\")"
          },
          {
            "name": "# of TQM Avg SKA Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Final\", CONTAINSSTRING('Student Score'[Subject Name],\"Result\"),Course[Level Group Code]=\"SKA\")"
          },
          {
            "name": "# of TQM Avg SKB Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Final\", CONTAINSSTRING('Student Score'[Subject Name],\"Result\"),Course[Level Group Code]=\"SKB\")"
          },
          {
            "name": "# of TQM Avg SKC Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Final\", CONTAINSSTRING('Student Score'[Subject Name],\"Result\"),Course[Level Group Code]=\"SKC\")"
          },
          {
            "name": "# of TQM Avg YE Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Final\", CONTAINSSTRING('Student Score'[Subject Name],\"Result\"),Course[Level Group Code]=\"YE\")"
          },
          {
            "name": "# of TQM Avg YI-YP Score Final Actual",
            "expression": " CALCULATE('Student Score'[# of TQM Average Score],'Student Score'[TypeExam]=\"Final\", CONTAINSSTRING('Student Score'[Subject Name],\"Result\"),Course[Level Group Code]=\"YI-YP\")"
          },
          {
            "name": "# of Class Total",
            "expression": " CALCULATE(DISTINCTCOUNT('Student Score'[ClassKey]),'Student Score'[Enable]=1)"
          },
          {
            "name": "# of TQM Total Student Have Score Oral Under 6",
            "expression": [
              " ",
              "    CALCULATE(",
              "        DISTINCTCOUNT('Student Score'[StudentKey]),",
              "        'Student Score'[Score] <> -1, ",
              "\t\t'Student Score'[TypeExam] = \"Final\",",
              "\t\t'Student Score'[Subject Name] = \"Oral\" || 'Student Score'[Subject Name] = \"Oral ( 10 )\",",
              "\t\t'Student Score'[Score] <6",
              "    )"
            ]
          },
          {
            "name": "% of TQM Total Student Have Score Oral Under 6 vs Total",
            "expression": [
              "\t",
              "ROUND(DIVIDE([# of TQM Total Student Have Score Oral Under 6], [# of TQM Total  Student Have Score],BLANK()),2)"
            ]
          },
          {
            "name": "# of TQM Total Student Have Score Oral Under 7",
            "expression": [
              " ",
              "    CALCULATE(",
              "        DISTINCTCOUNT('Student Score'[StudentKey]),",
              "        'Student Score'[Score] <> -1, ",
              "\t\t'Student Score'[TypeExam] = \"Final\",",
              "\t\t'Student Score'[Subject Name] = \"Oral\" || 'Student Score'[Subject Name] = \"Oral ( 10 )\",",
              "\t\t'Student Score'[Score] <7",
              "    )"
            ]
          },
          {
            "name": "% of TQM Total Student Have Score Oral Under 7 vs Total",
            "expression": [
              "\t",
              "ROUND(DIVIDE([# of TQM Total Student Have Score Oral Under 7], [# of TQM Total  Student Have Score],BLANK()),2)"
            ]
          },
          {
            "name": "# of TQM Total Student Have Score ILE Speaking Under 6",
            "expression": [
              " ",
              "    CALCULATE(",
              "        DISTINCTCOUNT('Student Score'[StudentKey]),",
              "               'Student Score'[Score] <> -1, ",
              "\t\t'Student Score'[TypeExam] = \"Mock Test\",",
              "\t\t'Student Score'[Subject Name] = \"4.Speaking\",",
              "\t\t'Student Score'[Score] <6,",
              "\t\t'Student Score'[Enable]=1    )"
            ]
          },
          {
            "name": "% of TQM Total Student Have Score ILE Speaking Under 6 vs Total",
            "expression": "\tROUND(DIVIDE([# of TQM Total Student Have Score ILE Speaking Under 6], [# of TQM Total  Student Have Score],BLANK()),2)"
          },
          {
            "name": "# of TQM Total Student Have Score ILE Speaking Under 7",
            "expression": [
              " ",
              "    CALCULATE(",
              "        DISTINCTCOUNT('Student Score'[StudentKey]),",
              "        'Student Score'[Score] <> -1, ",
              "\t\t'Student Score'[TypeExam] = \"Mock Test\",",
              "\t\t'Student Score'[Subject Name] = \"4.Speaking\",",
              "\t\t'Student Score'[Score] <7,",
              "\t\t'Student Score'[Enable]=1    )"
            ]
          },
          {
            "name": "% of TQM Total Student Have Score ILE Speaking Under 7 vs Total",
            "expression": "\tROUND(DIVIDE([# of TQM Total Student Have Score ILE Speaking Under 7],[# of TQM Total  Student Have Score],BLANK()),2)"
          },
          {
            "name": "% # Avg.Score Vs Max.Score",
            "expression": "DIVIDE('Student Score'[# of TQM Average Score],'Student Score'[# of TQM Max Score],0.0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Students",
            "expression": [
              "",
              "DISTINCTCOUNT('Student Score'[StudentKey])",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Pre Year Students",
            "expression": [
              "",
              "CALCULATE(",
              "    'Student Score'[# of Students],",
              "    DATEADD('Calendar'[Date], -1, YEAR)",
              ")"
            ]
          }
        ]
      },
