              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_SHARINGSESSION_F = Source{[Schema=\"DWH\",Item=\"VW_SHARINGSESSION_F\"]}[Data]",
                "in",
