            "dataType": "string",
            "sourceColumn": "REGION"
          },
          {
            "name": "COST_PER_STUDENT",
            "dataType": "int64",
            "sourceColumn": "COST_PER_STUDENT"
          },
          {
            "name": "EFFECTIVE_FROM_DATE",
            "dataType": "dateTime",
            "sourceColumn": "EFFECTIVE_FROM_DATE"
          },
          {
            "name": "EFFECTIVE_TO_DATE",
            "dataType": "dateTime",
            "sourceColumn": "EFFECTIVE_TO_DATE"
          },
          {
            "name": "IS_CURRENT",
            "dataType": "boolean",
            "sourceColumn": "IS_CURRENT"
          },
          {
            "name": "CREATED_AT",
            "dataType": "dateTime",
            "sourceColumn": "CREATED_AT"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_STUDENT_COST_F = Source{[Schema=\"DWH\",Item=\"VW_STUDENT_COST_F\"]}[Data]",
                "in",
                "    DWH_VW_STUDENT_COST_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "KPI Cost Per Student",
            "expression": [
              "",
              "VAR _Department = SELECTEDVALUE('Budget Management'[Department])",
              "VAR _Year = SELECTEDVALUE('Calendar'[Year])",
              "RETURN",
              "CALCULATE(",
              "    AVERAGE('KPI Cost Per Student'[Cost_per_Student]),",
              "    'KPI Cost Per Student'[Department] = _Department,",
              "    YEAR('KPI Cost Per Student'[Effective_From_Date]) = _Year",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "Diff KPI vs YTD Cost Per Student",
            "expression": " 'KPI Cost Per Student'[KPI Cost Per Student] - 'Budget Management'[# of YTD Cost Per Student]",
            "formatString": "#,0"
          }
        ]
      },
