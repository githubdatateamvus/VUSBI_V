      {
        "name": "List Class Schedule Teacher",
        "columns": [
          {
            "name": "TeacherProfileKey",
            "dataType": "string",
            "sourceColumn": "TeacherProfileKey"
          },
          {
            "name": "Branch Key",
            "dataType": "string",
            "sourceColumn": "Branch Key"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date"
          },
          {
            "name": "TeacherCode",
            "dataType": "string",
            "sourceColumn": "TeacherCode"
          },
          {
            "name": "IsForeign",
            "dataType": "boolean",
            "sourceColumn": "IsForeign"
          },
          {
            "name": "Teacher Type",
            "dataType": "string",
            "sourceColumn": "Teacher Type"
          },
          {
            "name": "TeacherContractType",
            "dataType": "string",
            "sourceColumn": "TeacherContractType"
          },
          {
            "name": "ContractKey",
            "dataType": "string",
            "sourceColumn": "ContractKey"
          },
          {
            "name": "Start Date",
            "dataType": "dateTime",
            "sourceColumn": "Start Date"
          },
          {
            "name": "End Date",
            "dataType": "dateTime",
            "sourceColumn": "End Date"
          },
          {
            "name": "HomeCampusCode",
            "dataType": "string",
            "sourceColumn": "HomeCampusCode"
          },
          {
            "name": "WeekDay",
            "dataType": "string",
            "sourceColumn": "WeekDay"
          },
          {
            "name": "DateNameSched",
            "dataType": "string",
            "sourceColumn": "DateNameSched"
          },
          {
            "name": "TotalHour",
            "dataType": "double",
            "sourceColumn": "TotalHour"
          },
          {
            "name": "TimeStandard",
            "dataType": "double",
            "sourceColumn": "TimeStandard"
          },
          {
            "name": "IS_OFF",
            "dataType": "boolean",
            "sourceColumn": "IS_OFF"
          },
          {
            "name": "Program Type",
            "dataType": "string",
            "sourceColumn": "Program Type"
          },
          {
            "name": "TQMArea",
            "dataType": "string",
            "sourceColumn": "TQMArea"
          },
          {
            "name": "ClassKey",
            "dataType": "string",
            "sourceColumn": "ClassKey"
          },
          {
            "name": "Date Key",
            "dataType": "int64",
            "sourceColumn": "Date Key"
          },
          {
            "type": "calculated",
            "name": "MergeContract",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF(OR([ContractKey]=\"Full Time-40\", [ContractKey] =\"Full Time-100\"),\"Full Time-80\",[ContractKey])"
          },
          {
            "name": "TeachingCampusCode",
            "dataType": "string",
            "sourceColumn": "TeachingCampusCode"
          },
          {
            "name": "ContractTypeCode",
            "dataType": "string",
            "sourceColumn": "ContractTypeCode"
          },
          {
            "name": "TypeOfTeachingHours",
            "dataType": "string",
            "sourceColumn": "TypeOfTeachingHours"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_LIST_CLASS_SCHEDULE_TEACHER = Source{[Schema=\"DWH\",Item=\"VW_LIST_CLASS_SCHEDULE_TEACHER\"]}[Data]",
                "in",
                "    DWH_VW_LIST_CLASS_SCHEDULE_TEACHER"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "DayOfWorking",
            "expression": [
              " /* tính số ngày làm việc Standard */",
              "VAR teachcode =",
              "    SELECTEDVALUE ( 'List Class Schedule Teacher'[TeacherCode])",
              "    VAR datemincontract =",
              "    MAXX (",
              "        FILTER ( 'List Class Schedule Teacher','List Class Schedule Teacher'[TeacherCode] = teachcode),",
              "        'List Class Schedule Teacher'[Start Date]",
              "    )",
              "VAR datemaxcontract =",
              "    MAXX (",
              "        FILTER ( 'List Class Schedule Teacher','List Class Schedule Teacher'[TeacherCode] = teachcode),",
              "        'List Class Schedule Teacher'[End Date]",
              "    )",
              "VAR result =",
              "    CALCULATE (",
              "        COUNTROWS ( FILTER('Calendar',CONVERT('Calendar'[IS OFF] ,INTEGER)<>1 ) ),",
              "        'Calendar'[Date] >= datemincontract",
              "            && 'Calendar'[Date] <= datemaxcontract,",
              "        KEEPFILTERS ( 'Calendar' )",
              "    )",
              "RETURN",
              "    result"
            ]
          },
          {
            "name": "Distinct Time",
            "expression": [
              " ",
              "SUMX(",
              "     VALUES('List Class Schedule Teacher'[TimeStandard])",
              "    ,'List Class Schedule Teacher'[TimeStandard]",
              ")"
            ]
          },
          {
            "name": "No of teacher",
            "expression": [
              "",
              "VAR t_date = max('Calendar'[Date Key])",
              "Return CALCULATE(DISTINCTCOUNT('List Class Schedule Teacher'[TeacherProfileKey]),'List Class Schedule Teacher'[Date Key] = t_date)"
            ]
          },
          {
            "name": "Standard Teaching Time",
            "expression": [
              "",
              "VAR PRT =/* tính giờ chuẩn giáo viên part time*/",
              "CALCULATE (",
              "SUMX ( VALUES ( 'List Class Schedule Teacher'[Date Key] ), [Distinct Time] ),",
              "'List Class Schedule Teacher'[TeacherContractType] = \"Part Time\",",
              "'List Class Schedule Teacher'[TeacherCode]",
              "= SELECTEDVALUE ( 'List Class Schedule Teacher'[TeacherCode] ),",
              "FILTER('List Class Schedule Teacher',CONVERT(",
              "'List Class Schedule Teacher'[IS_OFF],INTEGER)<>1)",
              ")",
              "VAR FLT =/* tính giờ chuẫn giáo viên full time*/",
              "CALCULATE (",
              "SUMX ( VALUES ( 'List Class Schedule Teacher'[Date Key] ), [Distinct Time] ),",
              "'List Class Schedule Teacher'[TeacherContractType] = \"Full Time\",",
              "'List Class Schedule Teacher'[TeacherCode]",
              "= SELECTEDVALUE ( 'List Class Schedule Teacher'[TeacherCode] ),",
              "FILTER('List Class Schedule Teacher',CONVERT(",
              "'List Class Schedule Teacher'[IS_OFF],INTEGER)<>1)",
              ")",
              "RETURN",
              "PRT + FLT"
            ]
          },
          {
            "name": "CountDayTeach",
            "expression": [
              "",
              "VAR SelectedWeekStart = MIN ( 'List Class Schedule Teacher'[Date])",
              "VAR SelectedWeekEnd = MAX ( 'List Class Schedule Teacher'[Date])",
              "VAR SelectedDateteach =  SELECTEDVALUE('List Class Schedule Teacher'[DateNameSched])",
              "VAR is_hour = SELECTEDVALUE('List Class Schedule Teacher'[TotalHour])",
              "RETURN",
              "    SUMX(",
              "            VALUES('List Class Schedule Teacher'[Date]),",
              "            SWITCH (",
              "            WEEKDAY ('List Class Schedule Teacher'[Date],2 ),",
              "            1, IF ( 'List Class Schedule Teacher'[Date] >= SelectedWeekStart && 'List Class Schedule Teacher'[Date] <= SelectedWeekEnd  && SelectedDateteach<>\"0\" , 1, 0 ),",
              "            2, IF ( 'List Class Schedule Teacher'[Date] >= SelectedWeekStart && 'List Class Schedule Teacher'[Date] <= SelectedWeekEnd  && SelectedDateteach<>\"0\"  , 1, 0 ),",
              "            3, IF ( 'List Class Schedule Teacher'[Date] >= SelectedWeekStart && 'List Class Schedule Teacher'[Date] <= SelectedWeekEnd  && SelectedDateteach<>\"0\"  , 1, 0 ),",
              "            4, IF ( 'List Class Schedule Teacher'[Date] >= SelectedWeekStart && 'List Class Schedule Teacher'[Date] <= SelectedWeekEnd  && SelectedDateteach<>\"0\"  , 1, 0 ),",
              "            5, IF ( 'List Class Schedule Teacher'[Date] >= SelectedWeekStart && 'List Class Schedule Teacher'[Date] <= SelectedWeekEnd  && SelectedDateteach<>\"0\"  , 1, 0 ),",
              "            6, IF ( 'List Class Schedule Teacher'[Date] >= SelectedWeekStart && 'List Class Schedule Teacher'[Date] <= SelectedWeekEnd  && SelectedDateteach<>\"0\"  , 1, 0 ),",
              "            7, IF ( 'List Class Schedule Teacher'[Date] >= SelectedWeekStart && 'List Class Schedule Teacher'[Date] <= SelectedWeekEnd  && SelectedDateteach<>\"0\"   ,1, 0 ),",
              "            BLANK ()",
              "        )",
              "    )"
            ]
          },
          {
            "name": "# Teacher Full Time",
            "expression": [
              " ",
              "Var t_date = MAX('Calendar'[Date Key])",
              "return CALCULATE(DISTINCTCOUNT('List Class Schedule Teacher'[TeacherProfileKey]),'List Class Schedule Teacher'[TeacherContractType]=\"Full Time\",'List Class Schedule Teacher'[Date Key] = t_date)"
            ]
          },
          {
            "name": "# Teacher Part Time",
            "expression": [
              "",
              " Var t_date = MAX('Calendar'[Date Key])",
              " Return CALCULATE(DISTINCTCOUNT('List Class Schedule Teacher'[TeacherProfileKey]),'List Class Schedule Teacher'[TeacherContractType]=\"Part Time\",'List Class Schedule Teacher'[Date Key] = t_date)"
            ]
          },
          {
            "name": "Total Standard Teaching Time",
            "expression": [
              " SUMX(VALUES('List Class Schedule Teacher'[TeacherCode])",
              ",'List Class Schedule Teacher'[Standard Teaching Time])"
            ]
          },
          {
            "name": "Total Teaching Hour",
            "expression": " CALCULATE(SUM('List Class Schedule Teacher'[TotalHour]))"
          },
          {
            "name": "CountDayActual",
            "expression": " CALCULATE(DISTINCTCOUNT('List Class Schedule Teacher'[Date]),'List Class Schedule Teacher'[DateNameSched] <> \"0\")"
          },
          {
            "name": "Average Total Teaching Hour",
            "expression": [
              "/* tính giờ dạy trung bình hàng tháng */",
              "        VAR MonthlyHours =",
              "            ADDCOLUMNS (",
              "                DISTINCT ( 'Calendar'[Month] ),",
              "                \"@MonthlyHours\", [Total Teaching Hour]",
              "            )",
              "    VAR TotalHour = FILTER(MonthlyHours, [@MonthlyHours] > 0)",
              "    VAR Result = AVERAGEX(TotalHour, [@MonthlyHours])",
              "  Return Result"
            ]
          },
          {
            "name": "Average of average month",
            "expression": [
              " /* tính trung bình của trung bình giờ dạy */",
              "VAR teacher_contract= SELECTEDVALUE('List Class Schedule Teacher'[TeacherContractType])",
              "VAR no_teacher = CALCULATE(DISTINCTCOUNT('List Class Schedule Teacher'[TeacherProfileKey]), REMOVEFILTERS('List Class Schedule Teacher'[TeacherContractType]), 'List Class Schedule Teacher'[TeacherContractType]= teacher_contract)",
              "VAR total_hour = [Total Teaching Hour]",
              "VAR result = DIVIDE( total_hour,no_teacher)",
              "",
              "Return IF( HASONEFILTER('Calendar'[Month Name]), result,",
              "        AVERAGEX(",
              "                VALUES('Calendar'[Month Name]),",
              "                VAR sub_no_teacher = CALCULATE(DISTINCTCOUNT('List Class Schedule Teacher'[TeacherProfileKey]), REMOVEFILTERS('List Class Schedule Teacher'[TeacherContractType]), 'List Class Schedule Teacher'[TeacherContractType]= teacher_contract)",
              "                VAR sub_total_hour = [Total Teaching Hour]",
              "                VAR sub_result = DIVIDE( sub_total_hour,sub_no_teacher)",
              "                RETURN sub_result",
              "        )",
              ")",
              ""
            ]
          },
          {
            "name": "Utilization Rate",
            "expression": " DIVIDE('List Class Schedule Teacher'[Total Teaching Hour],'List Class Schedule Teacher'[Total Standard Teaching Time],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Actual Sub Teaching Hour",
            "expression": [
              "",
              "\t\tCALCULATE (",
              "   \t\t\t SUMX (",
              "      \t\t\t\t  VALUES ( 'List Class Schedule Teacher'[Date Key]),",
              "        \t\t\t\t\t'List Class Schedule Teacher'[Total Teaching Hour]",
              "    \t\t\t\t),",
              "    \t\t\t'List Class Schedule Teacher'[TypeOfTeachingHours] = \"Sub Time\"",
              ")"
            ]
          },
          {
            "name": "Substitution Rate",
            "expression": " DIVIDE('List Class Schedule Teacher'[Actual Sub Teaching Hour],'List Class Schedule Teacher'[Total Teaching Hour],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Actual Not Sub Teaching Hour",
            "expression": [
              "",
              "\t\tCALCULATE (",
              "   \t\t\t SUMX (",
              "      \t\t\t\t  VALUES ( 'List Class Schedule Teacher'[Date Key]),",
              "        \t\t\t\t\t'List Class Schedule Teacher'[Total Teaching Hour]",
              "    \t\t\t\t),",
              "    \t\t\t'List Class Schedule Teacher'[TypeOfTeachingHours] = \"Not Sub Time\"",
              ")"
            ]
          },
          {
            "name": "# Expat Teachers",
            "expression": [
              " /* tính số giáo viên nước ngoài */",
              "var t_date = max('Calendar'[Date Key])",
              "Return CALCULATE(DISTINCTCOUNT('List Class Schedule Teacher'[TeacherProfileKey]),'List Class Schedule Teacher'[Date Key]=t_date,'List Class Schedule Teacher'[Teacher Type]=\"NN\")"
            ]
          },
          {
            "name": "# VN Teachers",
            "expression": [
              " /* tính số giáo viên Việt Nam*/",
              "var t_date = max('Calendar'[Date Key])",
              "Return CALCULATE(DISTINCTCOUNT('List Class Schedule Teacher'[TeacherProfileKey]),'List Class Schedule Teacher'[Date Key]=t_date,'List Class Schedule Teacher'[Teacher Type]=\"VN\")"
            ]
          },
          {
            "name": "% Fulltime vs Total Teacher",
            "expression": " DIVIDE( [# Teacher Full Time],[No of teacher],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Utilization Rate HCM",
            "expression": [
              " ",
              "VAR total_hour = CALCULATE(SUM('List Class Schedule Teacher'[TimeStandard]),'List Class Schedule Teacher'[TQMArea] =\"HCMC\")",
              "VAR total_standard_hour = CALCULATE(SUMX(VALUES('List Class Schedule Teacher'[TeacherCode])",
              ",'List Class Schedule Teacher'[Standard Teaching Time]),'List Class Schedule Teacher'[TQMArea] =\"HCMC\")",
              "VAR utilization_rate = DIVIDE(total_hour,total_standard_hour,BLANK())",
              "Return utilization_rate"
            ]
          },
          {
            "name": "Utilization Rate HN",
            "expression": [
              " ",
              "VAR total_hour = CALCULATE(SUM('List Class Schedule Teacher'[TimeStandard]),'List Class Schedule Teacher'[TQMArea] =\"HN\")",
              "VAR total_standard_hour = CALCULATE(SUMX(VALUES('List Class Schedule Teacher'[TeacherCode])",
              ",'List Class Schedule Teacher'[Standard Teaching Time]),'List Class Schedule Teacher'[TQMArea] =\"HN\")",
              "VAR utilization_rate = DIVIDE(total_hour,total_standard_hour,BLANK())",
              "Return utilization_rate"
            ]
          },
          {
            "name": "Utilization Rate Tier2",
            "expression": [
              " ",
              "VAR total_hour = CALCULATE(SUM('List Class Schedule Teacher'[TimeStandard]),'List Class Schedule Teacher'[TQMArea] =\"TIER 2\")",
              "VAR total_standard_hour = CALCULATE(SUMX(VALUES('List Class Schedule Teacher'[TeacherCode])",
              ",'List Class Schedule Teacher'[Standard Teaching Time]),'List Class Schedule Teacher'[TQMArea] =\"TIER 2\")",
              "VAR utilization_rate = DIVIDE(total_hour,total_standard_hour,BLANK())",
              "Return utilization_rate"
            ]
          }
        ]
      },
      {
        "name": "Student Score NonELT",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey"
          },
          {
            "name": "ClassKey",
            "dataType": "string",
            "sourceColumn": "ClassKey"
          },
          {
            "name": "StudentKey",
            "dataType": "string",
            "sourceColumn": "StudentKey"
          },
          {
            "name": "CampusKey",
            "dataType": "string",
            "sourceColumn": "CampusKey"
          },
          {
            "name": "LevelKey",
            "dataType": "string",
            "sourceColumn": "LevelKey"
          },
          {
            "name": "TypeExam",
            "dataType": "string",
            "sourceColumn": "TypeExam"
          },
          {
            "name": "SubjectName",
            "dataType": "string",
            "sourceColumn": "SubjectName"
          },
          {
            "name": "CourseType",
            "dataType": "string",
            "sourceColumn": "CourseType"
          },
          {
            "name": "SCORE",
            "dataType": "double",
            "sourceColumn": "SCORE",
            "formatString": "0.0"
          },
          {
            "name": "ISNull",
            "dataType": "int64",
            "sourceColumn": "ISNull"
          },
          {
            "name": "ISRemove",
            "dataType": "int64",
            "sourceColumn": "ISRemove"
          },
          {
            "name": "ListClassCode",
            "dataType": "string",
            "sourceColumn": "ListClassCode"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_STUDENT_SCORE_LMS_NONELT = Source{[Schema=\"DWH\",Item=\"VW_STUDENT_SCORE_LMS_NONELT\"]}[Data]",
                "in",
                "    DWH_VW_STUDENT_SCORE_LMS_NONELT"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Class Total NonELT",
            "expression": " CALCULATE(DISTINCTCOUNT('Student Score NonELT'[ClassKey]))"
          },
          {
            "name": "# of TQM Total Student NonELT Have Score",
            "expression": " CALCULATE(DISTINCTCOUNT('Student Score NonELT'[StudentKey]),'Student Score NonELT'[Score] <> -1,'Student Score NonELT'[ISRemove]=0)"
          },
          {
            "name": "# of TQM Total Student NonELT Have Score By Class",
            "expression": " SUMX ( VALUES ( 'Student Score NonELT'[ClassKey] ), CALCULATE(DISTINCTCOUNT('Student Score NonELT'[StudentKey]),'Student Score NonELT'[Score] <> -1,'Student Score NonELT'[ISRemove]=0))"
          },
          {
            "name": "# of TQM Total Student NonELT Have Score No Distinct",
            "expression": " CALCULATE(Count('Student Score NonELT'[StudentKey]),'Student Score NonELT'[Score] <> -1,'Student Score NonELT'[ISRemove]=0)"
          },
          {
            "name": "# of TQM Total Score NonELT",
            "expression": " CALCULATE(SUM('Student Score NonELT'[Score]),'Student Score NonELT'[ISRemove] =0, 'Student Score NonELT'[Score]<>-1)"
          },
          {
            "name": "# of TQM Average Score NonELT",
            "expression": " DIVIDE( 'Student Score NonELT'[# of TQM Total Score NonELT],'Student Score NonELT'[# of TQM Total Student NonELT Have Score By Class])"
          },
          {
            "name": "# of TQM Average Score NonELT By Class",
            "expression": " DIVIDE('Student Score NonELT'[# of TQM Total Score NonELT],'Student Score NonELT'[# of TQM Total Student NonELT Have Score By Class])"
          },
          {
            "name": "# of TQM Average Score NonELT No Distinct",
            "expression": " DIVIDE( 'Student Score NonELT'[# of Class Total NonELT],'Student Score NonELT'[# of TQM Total Student NonELT Have Score No Distinct])"
          },
          {
            "name": "# of TQM Max Score NonELT",
            "expression": " CALCULATE(MAXX(FILTER ( 'Student Score NonELT', 'Student Score NonELT'[Score] <> -1 ),'Student Score NonELT'[Score]))"
          },
          {
            "name": "# of TQM Median Score NonELT",
            "expression": " CALCULATE(MEDIANX(FILTER ( 'Student Score NonELT', 'Student Score NonELT'[Score] <> -1 ),'Student Score NonELT'[Score]))"
          },
          {
            "name": "of TQM Min Score NonELT",
            "expression": " CALCULATE(MINX(FILTER ( 'Student Score NonELT', 'Student Score NonELT'[Score] <> -1 ),'Student Score NonELT'[Score]))"
          },
          {
            "name": "# of Student NonELT",
            "expression": " CALCULATE(DISTINCTCOUNT('Student Score NonELT'[StudentKey]))"
          },
          {
            "name": "# of Class Digiconnect End",
            "expression": " CALCULATE('Student Score NonELT'[# of Class Total NonELT],'Student Score NonELT'[CourseType] =\"Digiconnect\", FILTER('List Class','List Class'[Date Of Close] <= TODAY()))"
          }
        ]
      },
