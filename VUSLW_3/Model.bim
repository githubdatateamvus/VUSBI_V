        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TEACHER_COMMENTS_LMS = Source{[Schema=\"DWH\",Item=\"VW_TEACHER_COMMENTS_LMS\"]}[Data]",
                "in",
                "    DWH_VW_TEACHER_COMMENTS_LMS"
              ]
            }
          }
