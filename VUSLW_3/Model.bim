            "expression": " DIVIDE( [# of New Enrol  Recycle PD],[# of New Enrol PD Recycle Campus Target],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% of New Enrol SNS PD vs Campus Target SNS",
            "expression": " DIVIDE( [# of New Enrol SNS PD],[# of New Enrol PD SNS Campus Target],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Sign MKT Target",
            "expression": " [# of New Enrol PD]*RANDBETWEEN(0.5,1.5)",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Sign vs MKT Target",
            "expression": " DIVIDE( [# of New Enrol OD],[# of Sign MKT Target],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Sign Per Day",
            "expression": " DIVIDE([# of New Enrol PD],CALCULATE(DISTINCTCOUNT('Calendar'[Date])),BLANK())",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Sign Per Day LY",
            "expression": " CALCULATE([# of Sign Per Day],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Sign LY",
            "expression": " CALCULATE([# of New Enrol PD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Sign vs LY",
            "expression": " DIVIDE( [# of New Enrol OD],[# of Sign LY],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD 2019",
            "expression": [
              "",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([# of Enrol PD],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "Enrol PD Revenue Amt 2019",
            "expression": [
              " ",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([Enrol PD Revenue Amt],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Enrol PD vs 2019",
            "expression": " DIVIDE( [# of Enrol PD],[# of Enrol PD 2019],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol PD Revenue vs 2019",
            "expression": " DIVIDE( [Enrol PD Revenue Amt],[Enrol PD Revenue Amt 2019],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of New Enrol PD 2019",
            "expression": [
              "",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([# of New Enrol PD],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% New Enrol PD vs 2019",
            "expression": " DIVIDE( [# of New Enrol PD],[# of New Enrol PD 2019],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Sign Per Day 2019",
            "expression": [
              " ",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([# of Sign Per Day],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Growth New Enrol PD vs LY",
            "expression": " DIVIDE( [# of New Enrol PD],[# of New Enrol PD LY],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD LY",
            "expression": [
              "CALCULATE([# of New Enrol PD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol Form Lead",
            "expression": "CALCULATE(DISTINCTCOUNT('ASA Overview PD'[Student Key]),'ASA Overview PD'[Lead Key]<>\"LEAD~0\",'ASA Overview PD'[New Enrol Flag]=\"New Enrol\",'ASA Overview PD'[Type Fee] = \"HP\")"
          },
          {
            "name": "% CR Lead To Sign Form Lead",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol Form Lead],'Lead'[# of Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Enquiries To New Enrol PD",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD],'ASA Enquiries'[# of Enquiries],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Budget",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Enrol Paymentdate\"",
              "\t,'ASA Budget'[SubType]=\"New\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol PD Budget",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Enrol Paymentdate\"",
              "\t,'ASA Budget'[SubType]=\"Re\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD Budget",
            "expression": " [# of New Enrol PD Budget]+[# of Re Enrol PD Budget]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol PD vs Budget",
            "expression": " DIVIDE([# of Enrol PD],[# of Enrol PD Budget],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "Enrol PD Revenue Budget",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Tuition Paymentdate\"",
              "\t,'ASA Budget'[SubType]=\"Tuition Paymentdate\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Enrol PD Revenue vs Budget",
            "expression": " DIVIDE([Enrol PD Revenue Amt],[Enrol PD Revenue Budget],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of MKT Sign Target By Channel",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA MKT Target By Channel'[Sign Value])",
              "\t,ALL('Calendar')",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)\t\t"
            ],
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "% Sign vs MKT Target By Channel",
            "expression": " DIVIDE([# of New Enrol OD],[# of MKT Sign Target By Channel],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Others"
          },
          {
            "name": "# of MKT Sign Target By Media",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA MKT Target By Media'[Sign Value])",
              "\t,ALL('Calendar')",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)\t"
            ],
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "% Sign vs MKT Target By Media",
            "expression": " DIVIDE([# of New Enrol OD],[# of MKT Sign Target By Media],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Others"
          },
          {
            "name": "Avg Courses Per Student",
            "expression": " DIVIDE([# of Enrol PD],[# of Student PD with Invoice],BLANK())",
            "formatString": "#,0.00",
            "displayFolder": "Others"
          },
          {
            "name": "Avg Revenue Per Student",
            "expression": " DIVIDE([Enrol PD Revenue Amt],[# of Student PD with Invoice],BLANK())",
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "# of Student PD Full Course",
            "expression": [
              " CALCULATE(DISTINCTCOUNT('ASA Overview PD'[User Information ID])",
              "\t,ALL(Course)",
              "\t,'ASA Overview PD'[Type Fee] = \"HP\")"
            ],
            "formatString": "0",
            "displayFolder": "Others"
          },
          {
            "name": "% Student",
            "expression": " DIVIDE([# of Student PD with Invoice],[# of Student PD with Invoice Full Course],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%",
            "displayFolder": "Others"
          },
          {
            "name": "Avg Revenue Per Enrol",
            "expression": " DIVIDE([Enrol PD Revenue Amt],[# of Enrol PD],BLANK())",
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "# of Enrol PD Full Course",
            "expression": [
              " CALCULATE(SUM('ASA Overview PD'[Number Of Enrol]),ALL(Course))",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Enrolment",
            "expression": " DIVIDE([# of Enrol PD],[# of Enrol PD Full Course],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%",
            "displayFolder": "Others"
          },
          {
            "name": "# of Student PD with Invoice",
            "expression": " COUNTROWS(GROUPBY('ASA Overview PD','ASA Overview PD'[User Information ID],'ASA Overview PD'[Invoice ID]))",
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "# of Student PD with Invoice Full Course",
            "expression": [
              " CALCULATE([# of Student PD with Invoice]",
              "\t,ALL(Course)",
              "\t,'ASA Overview PD'[Type Fee] = \"HP\")"
            ],
            "formatString": "#,0",
            "displayFolder": "Others"
          },
          {
            "name": "# of Re Enrol PD Campus Target",
            "expression": [
              " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Re Enrolment PD\"))",
              ""
            ]
          },
          {
            "name": "# of Enrol PD Campus Target",
            "expression": " 'ASA Overview PD'[# of New Enrol PD Campus Target] + 'ASA Overview PD'[# of Re Enrol PD Campus Target]"
          },
          {
            "name": "% of Enrol PD vs Campus Target",
            "expression": " DIVIDE([# of Enrol PD],[# of Enrol PD Campus Target],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of New Enrol PD TMK Campus Target",
            "expression": [
              " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target New Enrolment PD TMK\"))",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "# of Ave New Enrol PD Value",
            "expression": " divide('ASA Overview PD'[New Enrol PD Revenue Amt], 'ASA Overview PD'[# of New Enrol PD])",
            "formatString": "0"
          },
          {
            "name": "# Of New Enrolment from Show Date",
            "expression": [
              " CALCULATE('ASA Overview PD'[# of New Enrol PD],'ASA Overview PD'[Year Month Show Date PD]<>'ASA Overview PD'[Year Month Sign Date PD])",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "% Of New Enrolment from Show Date",
            "expression": " divide('ASA Overview PD'[# Of New Enrolment from Show Date],'ASA Enquiries'[# of Enquiries])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Of Italk vs Total",
            "expression": " divide('ASA Overview PD'[# of New Enrol PD iTalk],'ASA Overview PD'[# of New Enrol PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Of Referral vs Total",
            "expression": " divide('ASA overview Pd'[# of New Enrol Referral PD], 'ASA Overview PD'[# of New Enrol PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Of Recycle vs Total",
            "expression": " divide('ASA Overview PD'[# of New Enrol  Recycle PD], 'ASA Overview PD'[# of New Enrol PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Of SNS vs Total",
            "expression": " divide('ASA Overview PD'[# of New Enrol SNS PD],'ASA Overview PD'[# of New Enrol PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Digital",
            "expression": [
              " CALCULATE([# of New Enrol PD],'Source Information'[Media]=\"Digital\")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "% Of New Enrol PD Digital",
            "expression": " divide([# of New Enrol PD Digital],'Lead'[# Of Qualified Lead Digital])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Direct",
            "expression": [
              " CALCULATE([# of New Enrol PD],'Source Information'[Media]=\"Direct\")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "% Of New Enrol PD Direct",
            "expression": " divide([# of New Enrol PD Direct],'Lead'[# Of Qualified Lead Direct])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD From New Show",
            "expression": [
              "",
              "--IF(SELECTEDVALUE('ASA Overview PD'[Year Month Show Date PD])<>'ASA Overview PD'[Year Month Sign Date PD],",
              "CALCULATE( 'ASA Overview PD'[# of New Enrol PD] ,'ASA Overview PD'[SAM MONTH]=\"SAME\")"
            ],
            "formatString": "0"
          },
          {
            "name": "% of New-New Sign Vs Total",
            "expression": " divide ( 'ASA Overview PD'[# of New Enrol PD From New Show],'ASA Overview PD'[# of New Enrol PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Avg New PD Revenue Italk",
            "expression": " divide('ASA Overview PD'[New Enrol PD Revenue iTalk Amt] , 'ASA Overview PD'[# of New Enrol PD iTalk],BLANK())",
            "formatString": "0.0"
          },
          {
            "name": "Avg Re PD Revenue Italk",
            "expression": " divide('ASA Overview PD'[Re Enrol PD Revenue iTalk Amt] , 'ASA Overview PD'[# of Re Enrol PD iTalk],BLANK())",
            "formatString": "0.0"
          },
          {
            "name": "# of Revenue Per New Student PD",
            "expression": [
              " DIVIDE(CALCULATE(SUM('ASA Overview PD'[Payment Revenue Amount]),'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
              "                                     ,CALCULATE(DISTINCTCOUNT('ASA Overview PD'[User Information ID])",
              "\t\t\t\t\t\t\t\t\t                          ,'ASA Overview PD'[Type Fee] = \"HP\"",
              "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t  ,'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
              "\t\t\t\t\t\t\t\t\t\t\t\t,BLANK())"
            ]
          },
          {
            "name": "# of Revenue Per Re Student PD",
            "expression": [
              " DIVIDE(CALCULATE(SUM('ASA Overview PD'[Payment Revenue Amount]),'ASA Overview PD'[New Enrol Flag]=\"Re Enrol\")",
              "                                     ,CALCULATE(DISTINCTCOUNT('ASA Overview PD'[User Information ID])",
              "\t\t\t\t\t\t\t\t\t                          ,'ASA Overview PD'[Type Fee] = \"HP\"",
              "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t  ,'ASA Overview PD'[New Enrol Flag]=\"Re Enrol\")",
              "\t\t\t\t\t\t\t\t\t\t\t\t,BLANK())"
            ]
          },
          {
            "name": "# of New Student PD SNS",
            "expression": [
              " ",
              "var sns=CALCULATE( 'ASA Overview PD'[# of New Student PD] ,'ASA Overview PD'[SAM MONTH]=\"DIFF\",REMOVEFILTERS('Source Information'[Source Information Group Code]))",
              "return if(ISBLANK(sns),0,sns)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Student PD Referral",
            "expression": [
              " ",
              "var referral =CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Source Information Group Code]=\"Referral SP\",'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
              "return if(ISBLANK(referral),0,referral)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Student PD Recycle",
            "expression": [
              " ",
              "var recycle =CALCULATE('ASA Overview PD'[# of New Student PD],'User Information Type'[User Information Type]=\"Recycle\",'ASA Overview PD'[New Enrol Flag]=\"New Enrol\",REMOVEFILTERS('Source Information'[Source Information Group Code]))",
              "return if(ISBLANK(recycle),0,recycle)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Student PD New",
            "expression": [
              "",
              "VAR new_new =  'ASA Overview PD'[# of New Student PD] - 'ASA Overview PD'[# of New Student PD Referral] - 'ASA Overview PD'[# of New Student PD SNS] - 'ASA Overview PD'[# of New Student PD Recycle] -'ASA Overview PD'[# of New Student PD Sibling]",
              "return if(ISBLANK(new_new),0,if( new_new > 0,new_new,0 ))"
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Student PD iTalk",
            "expression": " CALCULATE('ASA Overview PD'[# of New Student PD],CONTAINSSTRING (Course[Course Type Code],\"iTalk\"),'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
            "formatString": "0"
          },
          {
            "name": "% of New Student PD vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student PD],'ASA Overview PD'[# of New Enrol PD Campus Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of New Student PD iTalk vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student PD iTalk],'ASA Overview PD'[# of New Enrol PD Italk Campus Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of New Student PD Recycle vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student PD Recycle],[# of New Enrol PD Recycle Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of New Student PD SNS vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student PD SNS],'ASA Overview PD'[# of New Enrol PD SNS Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of New Student PD New vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student PD New],'ASA Overview PD'[# of New Enrol PD TMK Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Enquiries To New Student New",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD New],'ASA Enquiries'[# Enquiries New],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Enquiries To New Student PD",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD],'ASA Enquiries'[# of Enquiries],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Std PD And Re Open Date",
            "expression": " 'ASA Overview PD'[# of New Student PD] + 'ASA Overview OD'[# of Re Enrol OD]",
            "formatString": "0"
          },
          {
            "name": "# of New Std PD And Re Open Date Target",
            "expression": " 'ASA Overview PD'[# of New Enrol PD Campus Target] + 'ASA Overview OD'[# of Re Enrol OD Campus Target]",
            "formatString": "0"
          },
          {
            "name": "% New Std PD And Re Open Date  vs Target",
            "expression": " DIVIDE('ASA Overview PD'[# of New Std PD And Re Open Date],'ASA Overview PD'[# of New Std PD And Re Open Date Target],BLANK())",
            "formatString": "0.0000%;-0.0000%;0.0000%"
          },
          {
            "name": "# of New Enrol By Program DD Target",
            "expression": [
              "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target New Enrolment By Program PD\"),'Course'[Course Type Group Code]=\"DD\")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Enrol By Program DC Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target New Enrolment By Program PD\"),'Course'[Course Type Group Code]=\"DC\")",
            "formatString": "0"
          },
          {
            "name": "# of Student DD",
            "expression": " calculate(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),FILTER('Course','Course'[Course Type Group Code]=\"DD\"))",
            "formatString": "0"
          },
          {
            "name": "# of Student DC",
            "expression": " calculate(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),FILTER('Course','Course'[Course Type Code]=\"DC\"))",
            "formatString": "0"
          },
          {
            "name": "% Std DD vs Target",
            "expression": " divide('ASA Overview PD'[# of Student DD],'ASA Overview PD'[# of New Enrol By Program DD Target],BLANK() )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Std DC vs Target",
            "expression": " divide('ASA Overview PD'[# of Student DC] ,'ASA Overview PD'[# of New Enrol By Program DC Target],BLANK() )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Sign Digital",
            "expression": "CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Digital\")"
          },
          {
            "name": "# of Sign Direct",
            "expression": "CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Direct\")"
          },
          {
            "name": "# of Sign Referral",
            "expression": "CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Referral\")",
            "formatString": "0"
          },
          {
            "name": "% of Sign Digital vs Target",
            "expression": " DIVIDE('ASA Overview PD'[# of Sign Digital],'MKT Kpi Target Manual'[# of Kpi By Sign Digital Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Sign Direct vs Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# of Sign Direct],'MKT Kpi Target Manual'[# of Kpi By Sign Dmk Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Sign Referral vs Target",
            "expression": " DIVIDE('ASA Overview PD'[# of Sign Referral],'MKT Kpi Target Manual'[# of Kpi By Sign Referral Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Student Login VHub PD",
            "expression": " CALCULATE('ASA Overview PD'[# of New Student PD],'Student'[IsLoginLMS]=\"True\")",
            "formatString": "0"
          },
          {
            "name": "# of New Student Not Login VHub PD",
            "expression": " CALCULATE('ASA Overview PD'[# of New Student PD],'Student'[IsLoginLMS]=\"False\")",
            "formatString": "0"
          },
          {
            "name": "% Ne Std PD Login VHub",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student Login VHub PD],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Ne Std PD Not Login VHub",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student Not Login VHub PD],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Student PD Budget",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Student Paymentdate\"",
              "\t,'ASA Budget'[SubType]=\"New\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date",
              "\t)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Re Student PD Budget",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "\t,ALL('Calendar')",
              "\t,'ASA Budget'[Type]=\"Student Paymentdate\"",
              "\t,'ASA Budget'[SubType]=\"Re\"",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Student PD LY",
            "expression": "CALCULATE('ASA Overview PD'[# of New Student PD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% of New Student PD LY",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD],'ASA Overview PD'[# of New Student PD LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of CR Lead > Sale Referal",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol Referral PD],'ASA Lead'[# of ASA Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Cont Recycle",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD Recycle],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Cont Referral",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD Referral],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Cont SNS",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD SNS],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Cont New-New",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD New],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Sign By TMK",
            "expression": "CALCULATE('ASA Overview PD'[# of New Student PD],'List Consultant Type'[Channel]=\"TMK\")"
          },
          {
            "name": "# of Sign By Non TMK",
            "expression": "CALCULATE('ASA Overview PD'[# of New Student PD],'List Consultant Type'[Channel]<>\"TMK\")"
          },
          {
            "name": "# of Target Sale Referral",
            "expression": [
              " CALCULATE(SUM('ASA Target Manual'[Target Value]),'ASA Target Manual'[Target Type] = \"Target Sale Referral\")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "% of Lead Referral vs Target Lead Referral ASA",
            "expression": " DIVIDE( 'Lead'[# of Lead Referral],'ASA Overview PD'[# of Target Sale Referral],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Revenue Summer Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Revenue Summer\"))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Student Big Event Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Big Event Student\"))",
            "formatString": "0"
          },
          {
            "name": "% Revenue Summer vs Target",
            "expression": " DIVIDE('ASA Overview PD'[# of Revenue Summer],'ASA Overview PD'[# of Revenue Summer Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of TMK Act vs Target Sales",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student PD TMK],'MKT Kpi Target Manual'[# of TMK Target Sales],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR-CM Show To Sign",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD From New Show],'ASA Enquiries'[# of Enquiries],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Revenue Grammar Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Revenue Grammar\"))"
          },
          {
            "name": "# of Student Grammar",
            "expression": " calculate(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),FILTER('Course','Course'[Course Type Code]=\"G\"))"
          },
          {
            "name": "# of Student Summer",
            "expression": " calculate(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),FILTER('Course','Course'[Course Type Group Code]=\"SUMMER\"))"
          },
          {
            "name": "# of Revenue Summer",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),FILTER('Course','Course'[Course Type Group Code]=\"SUMMER\"))"
          },
          {
            "name": "# of Revenue Grammar",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),FILTER('Course','Course'[Course Type Code]=\"G\"))"
          },
          {
            "name": "% Revenue Grammar vs Target",
            "expression": " DIVIDE('ASA Overview PD'[# of Revenue Grammar],'ASA Overview PD'[# of Revenue Grammar Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Std BigEvent vs Target",
            "expression": " divide('ASA Overview PD'[# of Student Big Event],'ASA Overview PD'[# of Student Big Event Target],BLANK() )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of New Student vs Target",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD],'ASA Overview PD'[# of New Enrol PD Target],BLANK())",
            "formatString": "0.0000%;-0.0000%;0.0000%"
          },
          {
            "name": "# of New Enrol By Program K12 Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target New Enrolment By Program PD\"),'Course'[Course Type Group Code]=\"K12\")"
          },
          {
            "name": "# of New Enrol By Program DCamp Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target New Enrolment By Program PD\"),'Course'[Course Type Code]=\"DCamp\")"
          },
          {
            "name": "% Std K12 vs Target",
            "expression": " divide('ASA Overview PD'[# of Student DC],'ASA Overview PD'[# of New Enrol By Program K12 Target],BLANK() )"
          },
          {
            "name": "% Std DCamp vs Target",
            "expression": " divide('ASA Overview PD'[# of Student DCamp],'ASA Overview PD'[# of New Enrol By Program DCamp Target],BLANK() )"
          },
          {
            "name": "# of Student K12",
            "expression": " calculate(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),FILTER('Course','Course'[Course Type Group Code]=\"K12\"))"
          },
          {
            "name": "# of Student DCamp",
            "expression": " calculate(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),FILTER('Course','Course'[Course Type Code]=\"DCamp\"))"
          },
          {
            "name": "# of Student Big Event",
            "expression": " calculate(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),FILTER('List Class','List Class'[List Class Code]=\"VFSD\"),FiLTER('Course','Course'[Course Type Code]=\"CAMP2018\"))"
          },
          {
            "name": "# of Student Teen Camp",
            "expression": " calculate(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),FILTER('List Class','List Class'[List Class Code]=\"VCJB\"),FiLTER('Course','Course'[Course Type Code]=\"CAMP2018\"))"
          },
          {
            "name": "Enrol PD Revenue Big Event",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),FILTER('Course','Course'[Course Type Code]=\"CAMP2018\"),FILTER('List Class','List Class'[List Class Code]=\"VFSD\"))",
            "formatString": "0"
          },
          {
            "name": "Enrol PD Revenue Teen Camp",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),FILTER('Course','Course'[Course Type Code]=\"CAMP2018\"),FILTER('List Class','List Class'[List Class Code]=\"VCJB\"))",
            "formatString": "0"
          },
          {
            "name": "% Growth New Student PD vs LY",
            "expression": " DIVIDE( [# of New Student PD],[# of New Student PD LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of KKHT TGD Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=11, 'ASA Target'[Target Key]=\"TotalTarget\")",
            "formatString": "0"
          },
          {
            "name": "# of Pending Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=12, 'ASA Target'[Target Key]=\"TotalTarget\")",
            "formatString": "0"
          },
          {
            "name": "# of New Student PD Sibling",
            "expression": [
              " ",
              "var referral =CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Source Information Group Code]=\"Sibling\",'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
              "---var siibling=CALCULATE(DISTINCTCOUNT('ASA List Invoice Tax New'[User Information Key]),FILTER('ASA List Invoice Tax New','ASA List Invoice Tax New'[EnrolRegType]=0 && 'ASA List Invoice Tax New'[SiblingDiscount]>0),FILTER('Source Information','Source Information'[Media] <> \"Referral\"))",
              "return if(ISBLANK(referral),BLANK(),referral)"
            ],
            "formatString": "0"
          },
          {
            "name": "% of New Student PD Referral vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student PD Referral],'ASA Overview PD'[# of New Enrol PD Referral Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of New Student PD Referral vs Campus Target No Sibling",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student PD Referral],'ASA Overview PD'[# of New Enrol PD Referral Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Student PD TMK",
            "expression": " CALCULATE('ASA Overview PD'[# of New Student PD],'List Consultant Type'[Channel] = \"TMK\")"
          },
          {
            "name": "% of New Student PD TMK",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD TMK],'ASA Overview PD'[# of New Student PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Student PD Walk-In",
            "expression": " CALCULATE('ASA Overview PD'[# of New Student PD],'List Consultant Type'[Channel] = \"Walk-in\")"
          },
          {
            "name": "% of New Student PD Walk-In",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD Walk-In],'ASA Overview PD'[# of New Student PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Lead Referral vs Target ASA",
            "expression": " DIVIDE( 'Lead'[# of Lead Referral],'ASA Overview PD'[# of Target Sale Referral],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Student PD Recycle Revenue Amt",
            "expression": [
              "",
              "var recycle_amt =CALCULATE(SUM('ASA Overview PD'[Payment Revenue Amount]),'User Information Type'[User Information Type]=\"Recycle\",'ASA Overview PD'[New Enrol Flag]=\"New Enrol\",REMOVEFILTERS('Source Information'[Source Information Group Code]))",
              " ",
              "return if(ISBLANK(recycle_amt),0,recycle_amt)"
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of New Enrol PD Sibling Campus Target",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target New Enrolment PD Sibling\"))",
            "formatString": "0"
          },
          {
            "name": "# of New Student PD_HotDeal",
            "expression": " CALCULATE ('ASA Overview PD'[# of New Student PD],'ASA Overview PD'[Showdate equal Signdate] = 1)"
          },
          {
            "name": "% CR New Student PD_Hotdeal",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD_HotDeal],'ASA Enquiries'[# of Enquiries],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# 1 of New Student PD Sibling",
            "expression": [
              " ",
              "--Ưu tiên 1",
              "var sibling=CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Sibling\",'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
              "return if(ISBLANK(sibling),0,sibling)"
            ],
            "formatString": "0"
          },
          {
            "name": "# 1 of New Student PD Referral",
            "expression": [
              " ",
              "--Ưu tiên 2",
              "var referral =CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Referral\",'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")",
              "return if(ISBLANK(referral),0,referral)"
            ],
            "formatString": "0"
          },
          {
            "name": "# 1 of New Student PD Recycle",
            "expression": [
              " ",
              "--Ưu tiên 3",
              "var recycle =CALCULATE('ASA Overview PD'[# of New Student PD],'User Information Type'[User Information Type]=\"Recycle\",'ASA Overview PD'[New Enrol Flag]=\"New Enrol\",'Source Information'[Media]<>\"Sibling\",'Source Information'[Media]<>\"Referral\")",
              "return if(ISBLANK(recycle),0,recycle)"
            ]
          },
          {
            "name": "# 1 of New Student PD New",
            "expression": [
              "",
              "--Ưu tiên 4",
              "Var new= CALCULATE('ASA Overview PD'[# of New Student PD],'ASA Overview PD'[ShowMonth equal SignMonth]=1,'ASA Overview PD'[New Enrol Flag]=\"New Enrol\",'Source Information'[Media]<>\"Sibling\",'Source Information'[Media]<>\"Referral\",'User Information Type'[User Information Type]<>\"Recycle\")",
              "return if(ISBLANK(new),0,new)"
            ],
            "formatString": "0"
          },
          {
            "name": "# 1 of New Student PD SNS",
            "expression": [
              " ",
              "--Số lượt new còn lại sau khi loại các ưu tiên",
              "var sns = CALCULATE('ASA Overview PD'[# of New Student PD],'ASA Overview PD'[ShowMonth equal SignMonth]=0,'ASA Overview PD'[New Enrol Flag]=\"New Enrol\",'Source Information'[Media]<>\"Sibling\",'Source Information'[Media]<>\"Referral\",'User Information Type'[User Information Type]<>\"Recycle\")",
              "return if(ISBLANK(sns),0,sns)"
            ],
            "formatString": "0"
          },
          {
            "name": "% CR Show > Sign Target",
            "expression": [
              " divide ( 'ASA Overview PD'[# of New Enrol PD Campus Target], 'MKT Kpi Target Manual'[Total_target_Show],BLANK())",
              "",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% CR Show > Sign LY",
            "expression": " CALCULATE('ASA Overview PD'[% CR Enquiries To New Student PD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Act vs Target CR Show > Sign",
            "expression": " divide ('ASA Overview PD'[% CR Enquiries To New Student PD],'ASA Overview PD'[% CR Show > Sign Target],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Act vs LY CR Show > Sign",
            "expression": " divide ('ASA Overview PD'[% CR Enquiries To New Student PD],'ASA Overview PD'[% CR Show > Sign LY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of New Student PD-OD",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),'ASA Overview PD'[New Enrol Flag]=\"New Enrol\",'ASA Overview PD'[SAME PD-OD]=\"PD-OD\" )",
            "formatString": "0"
          },
          {
            "name": "PD Revenue Amt LY",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Student PD LY",
            "expression": [
              " CALCULATE(DISTINCTCOUNT('ASA Overview PD'[User Information ID])",
              "\t,'ASA Overview PD'[Type Fee] = \"HP\",SAMEPERIODLASTYEAR('Calendar'[Date]))"
            ]
          },
          {
            "name": "# of Revenue Per New Student PD LY",
            "expression": [
              " ",
              "VAR Payment_Revenue_Amount_LY = CALCULATE(SUM('ASA Overview PD'[Payment Revenue Amount]),'ASA Overview PD'[New Enrol Flag]=\"New Enrol\",SAMEPERIODLASTYEAR('Calendar'[Date]))",
              "VAR New_enrol_LY = CALCULATE(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),'ASA Overview PD'[Type Fee] = \"HP\",'ASA Overview PD'[New Enrol Flag]=\"New Enrol\",SAMEPERIODLASTYEAR('Calendar'[Date]))",
              "VAR Result = DIVIDE(Payment_Revenue_Amount_LY,New_enrol_LY ,BLANK())",
              "Return Result"
            ],
            "formatString": "0"
          },
          {
            "name": "% of New Student PD-OD",
            "expression": "DIVIDE('ASA Overview PD'[# of New Student PD-OD],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of New Student PD Sibling vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# 1 of New Student PD Sibling],'ASA Overview PD'[# of New Enrol PD Sibling Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of New Student PD Referral vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# 1 of New Student PD Referral],'ASA Overview PD'[# of New Enrol PD Referral Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of New Student PD Recycle vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# 1 of New Student PD Recycle],[# of New Enrol PD Recycle Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of New Student PD New vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# 1 of New Student PD New],'ASA Overview PD'[# of New Enrol PD TMK Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of New Student PD SNS vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# 1 of New Student PD SNS],'ASA Overview PD'[# of New Enrol PD SNS Campus Target],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# 1 of New Student PD New (Single)",
            "expression": [
              " ",
              "Var new= CALCULATE('ASA Overview PD'[# of New Student PD],'ASA Overview PD'[ShowMonth equal SignMonth]=1)",
              "return if(ISBLANK(new),0,new)"
            ]
          },
          {
            "name": "% 1 CR Enquiries To New Student New (Single)",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD New (Single)],'ASA Enquiries'[# of Enquiries],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of Cont New-New",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD New],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of Cont Recycle",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD Recycle],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of Cont Referral",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD Referral],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of Cont SNS",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD SNS],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% 1 of Cont Siblling",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD Sibling],'ASA Overview PD'[# of New Student PD],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Revenue Camping Target",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Revenue Camping\"))"
          },
          {
            "name": "# of Enrol PD Revenue Camping",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),FILTER('Course','Course'[Course Type Code]=\"CAMPING\"),FILTER('List Class','List Class'[List Class Code]=\"XRNCT\"))"
          },
          {
            "name": "# of Student Camping",
            "expression": " calculate(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),FILTER('List Class','List Class'[List Class Code]=\"XRNCT\"),FiLTER('Course','Course'[Course Type Code]=\"CAMPING\"))"
          },
          {
            "name": "# of Revenue Summer&Grammar",
            "expression": "'ASA Overview PD'[# of Revenue Grammar] + 'ASA Overview PD'[# of Revenue Summer]"
          },
          {
            "name": "# of Revenue Summer&Grammar Target",
            "expression": " 'ASA Overview PD'[# of Revenue Grammar Target] + 'ASA Overview PD'[# of Revenue Summer Target]"
          },
          {
            "name": "% Revenue Summer&Grammar vs Target",
            "expression": "  DIVIDE('ASA Overview PD'[# of Revenue Summer&Grammar], 'ASA Overview PD'[# of Revenue Summer&Grammar Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Campus Target By Month",
            "expression": [
              "",
              "VAR CurrentYear = SELECTEDVALUE('Calendar'[Year])",
              "VAR CurrentMonth = SELECTEDVALUE('Calendar'[Month])",
              "VAR Result = CALCULATE(",
              "    SUM('ASA Target Manual'[Target Value]),",
              "    'ASA Target Manual'[Target Type] = \"Target New Enrolment PD\",",
              "    'Calendar'[Year] = CurrentYear,",
              "    'Calendar'[Month] = CurrentMonth,",
              "    REMOVEFILTERS('Calendar'[Date Number])",
              ")",
              "RETURN Result"
            ],
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% of New Student PD vs Campus Target By Month",
            "expression": " DIVIDE( 'ASA Overview PD'[# of New Student PD],'ASA Overview PD'[# of New Enrol PD Campus Target By Month],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# 1 of New Student PD Sib Ref Rec SNS",
            "expression": [
              "",
              "'ASA Overview PD'[# 1 of New Student PD Sibling]",
              "+ 'ASA Overview PD'[# 1 of New Student PD Referral]",
              "+ 'ASA Overview PD'[# 1 of New Student PD Recycle]",
              "+ 'ASA Overview PD'[# 1 of New Student PD SNS]"
            ],
            "formatString": "0"
          },
          {
            "name": "# 1 New Student PD Sib Ref Rec SNS Campus Target",
            "expression": [
              "",
              "'ASA Overview PD'[# of New Enrol PD Sibling Campus Target]",
              "+ 'ASA Overview PD'[# of New Enrol PD Referral Campus Target]",
              "+ 'ASA Overview PD'[# of New Enrol PD Recycle Campus Target]",
              "+ 'ASA Overview PD'[# of New Enrol PD SNS Campus Target]"
            ],
            "formatString": "0"
          },
          {
            "name": "% 1 of New Student PD Sib Ref Rec SNS vs Target",
            "expression": [
              "",
              "Divide('ASA Overview PD'[# 1 of New Student PD Sib Ref Rec SNS], 'ASA Overview PD'[# 1 New Student PD Sib Ref Rec SNS Campus Target],0)"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Re Student PD-OD",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),'ASA Overview PD'[New Enrol Flag]=\"Re Enrol\",'ASA Overview PD'[SAME PD-OD]=\"PD-OD\" )"
          },
          {
            "name": "# of Student PD-OD",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview PD'[User Information ID]),'ASA Overview PD'[SAME PD-OD]=\"PD-OD\" )"
          },
          {
            "name": "# of New Student Refferal + Sibling Campus Target",
            "expression": " [# of New Enrol PD Sibling Campus Target] + [# of New Enrol PD Referral Campus Target]"
          },
          {
            "name": "% Re Student PD-OD vs PD",
            "expression": " Divide('ASA Overview PD'[# of Re Student PD-OD],'ASA Overview PD'[# of Re Student PD])"
          },
          {
            "name": "# 1 of New Student Refferal + Sibling",
            "expression": " [# 1 of New Student PD Sibling] + [# 1 of New Student PD Referral]"
          },
          {
            "name": "% 1 of New Student PD Referral + Sibling vs Campus Target",
            "expression": " DIVIDE( 'ASA Overview PD'[# 1 of New Student PD Referral] + 'ASA Overview PD'[# 1 of New Student PD Sibling],  'ASA Overview PD'[# of New Student Refferal + Sibling Campus Target])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Remain Re-OD",
            "expression": "'ASA Overview OD'[# of Re Enrol OD Campus Target] - 'ASA Overview OD'[# of Re Enrol OD]",
            "formatString": "0"
          },
          {
            "name": "# of Remain New Student PD",
            "expression": "'ASA Overview PD'[# of New Enrol PD Campus Target] - 'ASA Overview PD'[# of New Student PD]",
            "formatString": "0"
          },
          {
            "name": "# New student pd YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Overview PD'[# of New Student PD],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "New student pd YTD PY",
            "expression": " CALCULATE('ASA Overview PD'[# New student pd YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% NEW 1 course",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD 1K],'ASA Overview PD'[# of New Student PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% NEW 2+ course",
            "expression": " 1 - 'ASA Overview PD'[% NEW 1 course]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% NEW 1 course PY",
            "expression": " CALCULATE('ASA Overview PD'[% NEW 1 course],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% NEW 2+ course PY",
            "expression": " CALCULATE('ASA Overview PD'[% NEW 2+ course],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% NEW 1 course YTD",
            "expression": [
              "",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE(DIVIDE('ASA Overview PD'[# of New Enrol PD 1K],'ASA Overview PD'[# of New Student PD],0),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% NEW 1 course YTD PY",
            "expression": " CALCULATE('ASA Overview PD'[% NEW 1 course YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% NEW 2+ course YTD PY",
            "expression": " 1 - 'ASA Overview PD'[% NEW 1 course YTD PY]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% NEW 2+ course YTD",
            "expression": " 1 - 'ASA Overview PD'[% NEW 1 course YTD]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of New Student PD Budget",
            "expression": " DIVIDE('ASA Overview PD'[# of New Student PD],'ASA Overview PD'[# of New Student PD Budget],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of New Student PD YTD vs PY",
            "expression": " DIVIDE('ASA Overview PD'[# New student pd YTD],'ASA Overview PD'[New student pd YTD PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of New Enrol PD Target Siblings",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=2, 'ASA Target'[Target Key]=\"TotalTarget\", 'ASA Target'[Student Source]=\"Siblings\")",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol Siblings vs Target Siblings",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD Sibling],'ASA Overview PD'[# of New Enrol PD Target Siblings], BLANK() )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Target Referral",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=2, 'ASA Target'[Target Key]=\"TotalTarget\", 'ASA Target'[Student Source]=\"Referral\")",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol Referral vs Target Referral",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD Referral],'ASA Overview PD'[# of New Enrol PD Target Referral], BLANK() )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Target Recycle",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=2, 'ASA Target'[Target Key]=\"TotalTarget\", 'ASA Target'[Student Source]=\"Recycle\")",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol Recycle vs Target Recycle",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD Recycle],'ASA Overview PD'[# of New Enrol PD Target Recycle], BLANK() )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Target SNS",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=2, 'ASA Target'[Target Key]=\"TotalTarget\", 'ASA Target'[Student Source]=\"SNS\")",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol SNS vs Target SNS",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD SNS],'ASA Overview PD'[# of New Enrol PD Target SNS], BLANK() )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Target New-New",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=2, 'ASA Target'[Target Key]=\"TotalTarget\", 'ASA Target'[Student Source]=\"New-New\")",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol New-New vs Target New-New",
            "expression": " DIVIDE('ASA Overview PD'[# 1 of New Student PD New],'ASA Overview PD'[# of New Enrol PD Target New-New], BLANK() )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% New Enrol PD Over 4K",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD Over 4K],'ASA Overview PD'[# of New student PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Re Enrol PD Over 4K",
            "expression": " DIVIDE('ASA Overview PD'[# of Re Enrol PD Over 4K],'ASA Overview PD'[# of Re Student PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Show2Sign Digital",
            "expression": " DIVIDE( 'ASA Overview PD'[# of Sign Digital],'ASA Enquiries'[# of Enquiries Digital] )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Show2Sign DMK",
            "expression": " DIVIDE( 'ASA Overview PD'[# of Sign Direct],'ASA Enquiries'[# of Enquiries Direct] )",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Digital LY",
            "expression": " CALCULATE(CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Digital\"),SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol PD Digital LY",
            "expression": "  Divide(CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Digital\"), 'ASA Overview PD'[# of New Enrol PD Digital LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Digital YTD",
            "expression": [
              "  ",
              " \t",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Digital\"),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Enrol PD Digital YTD PY",
            "expression": "CALCULATE('ASA Overview PD'[# of New Enrol PD Digital YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol PD Digital YTD",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD Digital YTD],'ASA Overview PD'[# of New Enrol PD Digital YTD PY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD DMK LY",
            "expression": " CALCULATE(CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Direct\"),SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol PD DMK LY",
            "expression": "  Divide(CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Direct\"), 'ASA Overview PD'[# of New Enrol PD Digital LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD DMK YTD",
            "expression": [
              "  ",
              " \t",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(CALCULATE('ASA Overview PD'[# of New Student PD],'Source Information'[Media]=\"Direct\"),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Enrol PD DMK YTD PY",
            "expression": "CALCULATE('ASA Overview PD'[# of New Enrol PD DMK YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol PD DMK YTD",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD DMK YTD],'ASA Overview PD'[# of New Enrol PD DMK YTD PY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD TMK LY",
            "expression": " CALCULATE('ASA Overview PD'[# of New Student PD TMK],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol PD TMK LY",
            "expression": "  Divide('ASA Overview PD'[# of New Student PD TMK], 'ASA Overview PD'[# of New Enrol PD TMK LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD TMK YTD",
            "expression": [
              "  ",
              " \t",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE('ASA Overview PD'[# of New Student PD TMK],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Enrol PD TMK YTD PY",
            "expression": "CALCULATE('ASA Overview PD'[# of New Enrol PD TMK YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol PD TMK YTD",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD TMK YTD],'ASA Overview PD'[# of New Enrol PD TMK YTD PY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Ref + Sib LY",
            "expression": " CALCULATE('ASA Overview PD'[# 1 of New Student Refferal + Sibling],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol PD Ref + Sib LY",
            "expression": "  Divide('ASA Overview PD'[# 1 of New Student Refferal + Sibling], 'ASA Overview PD'[# of New Enrol PD Ref + Sib LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Ref + Sib YTD",
            "expression": [
              "  ",
              " \t",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE('ASA Overview PD'[# 1 of New Student Refferal + Sibling],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of New Enrol PD Ref + Sib YTD PY",
            "expression": "CALCULATE('ASA Overview PD'[# of New Enrol PD Ref + Sib YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0"
          },
          {
            "name": "% of New Enrol PD Ref + Sib YTD",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD Ref + Sib YTD],'ASA Overview PD'[# of New Enrol PD Ref + Sib YTD PY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Recycle LY",
            "expression": " CALCULATE('ASA Overview PD'[# 1 of New Student PD Recycle],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of New Enrol PD Recycle LY",
            "expression": "  Divide('ASA Overview PD'[# 1 of New Student PD Recycle], 'ASA Overview PD'[# of New Enrol PD Recycle LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD Recycle YTD",
            "expression": [
              "  ",
              " \t",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE('ASA Overview PD'[# 1 of New Student PD Recycle],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "# of New Enrol PD Recycle YTD PY",
            "expression": "CALCULATE('ASA Overview PD'[# of New Enrol PD Recycle YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of New Enrol PD Recycle YTD",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD Recycle YTD],'ASA Overview PD'[# of New Enrol PD Recycle YTD PY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD SNS LY",
            "expression": " CALCULATE('ASA Overview PD'[# 1 of New Student PD SNS],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of New Enrol PD SNS LY",
            "expression": "  Divide('ASA Overview PD'[# 1 of New Student PD SNS], 'ASA Overview PD'[# of New Enrol PD SNS LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Enrol PD SNS YTD",
            "expression": [
              "  ",
              " \t",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE('ASA Overview PD'[# 1 of New Student PD SNS],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "# of New Enrol PD SNS YTD PY",
            "expression": "CALCULATE('ASA Overview PD'[# of New Enrol PD SNS YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of New Enrol PD SNS YTD",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD SNS YTD],'ASA Overview PD'[# of New Enrol PD SNS YTD PY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% RE 1 course",
            "expression": " DIVIDE('ASA Overview PD'[# of Re Enrol PD 1K],'ASA Overview PD'[# of Re Student PD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% RE 2+ course",
            "expression": " CALCULATE(1 - 'ASA Overview PD'[% RE 1 course])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% RE 1 course PY",
            "expression": [
              " CALCULATE('ASA Overview PD'[% RE 1 course],SAMEPERIODLASTYEAR('Calendar'[Date]))",
              "\t"
            ]
          },
          {
            "name": "% RE 2+ course PY",
            "expression": " CALCULATE('ASA Overview PD'[% RE 2+ course],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% RE 1 course YTD",
            "expression": [
              "",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(DIVIDE('ASA Overview PD'[# of Re Enrol PD 1K],'ASA Overview PD'[# of Re Student PD],0),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% RE 2+ course YTD",
            "expression": "CALCULATE(1 - 'ASA Overview PD'[% RE 1 course YTD])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% RE 1 course YTD PY",
            "expression": " CALCULATE('ASA Overview PD'[% RE 1 course YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% RE 2+ course YTD PY",
            "expression": " CALCULATE(1 - 'ASA Overview PD'[% RE 1 course YTD PY])"
          },
          {
            "name": "# of New Student PD non Skplus",
            "expression": "CALCULATE('ASA Overview PD'[# of New Student PD],'Course'[Course Type Group Code]<>\"Skplus\")"
          },
          {
            "name": "# of New Enrol PD Campus Target non Skplus",
            "expression": "CALCULATE('ASA Overview PD'[# of New Enrol PD Campus Target],'Course'[Course Type Group Code]<>\"Skplus\")"
          },
          {
            "name": "% of New Student vs Target non Skplus",
            "expression": "DIVIDE('ASA Overview PD'[# of New Student PD non Skplus],'ASA Overview PD'[# of New Enrol PD Target],BLANK())",
            "formatString": "0.0000%;-0.0000%;0.0000%"
          },
          {
            "name": "# of New Std PD non Skplus And Re Open Date Target",
            "expression": "'ASA Overview PD'[# of New Enrol PD Campus Target non Skplus] + 'ASA Overview OD'[# of Re Enrol OD Campus Target]"
          },
          {
            "name": "% New Std PD non Skplus And Re Open Date  vs Target",
            "expression": "DIVIDE('ASA Overview PD'[# of New Std PD non Skplus And Re Open Date],'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date Target],BLANK())",
            "formatString": "0.0000%;-0.0000%;0.0000%"
          },
          {
            "name": "# of New Std PD non Skplus And Re Open Date",
            "expression": "'ASA Overview PD'[# of New Student PD non Skplus] + 'ASA Overview OD'[# of Re Enrol OD]"
          },
          {
            "name": "% of New Student PD vs Campus Target non Skplus",
            "expression": "DIVIDE( 'ASA Overview PD'[# of New Student PD non Skplus],'ASA Overview PD'[# of New Enrol PD Campus Target non Skplus],BLANK())",
            "formatString": "0.0000%;-0.0000%;0.0000%"
          },
          {
            "name": "% of New Enrol Referral Sibling vs Target Referral Sibling ASA",
            "expression": "DIVIDE('ASA Overview PD'[# 1 of New Student Refferal + Sibling],('ASA Overview PD'[# of New Enrol PD Target Referral]+'ASA Overview PD'[# of New Enrol PD Target Siblings]), BLANK() )",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "ASA Performance NewPD Bonus non Skplus",
            "expression": [
              "",
              "SWITCH(",
              "   TRUE(),",
              "   [ASA Performance NewPD Rank non Skplus] = \"Vượt trội\", 6000000,",
              "   [ASA Performance NewPD Rank non Skplus] = \"Xuất sắc\", 3000000,",
              "   [ASA Performance NewPD Rank non Skplus] =  \"Giỏi\", 1000000,  ",
              "   0",
              ")"
            ],
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of New Student PD non Skplus ASA Need Gioi",
            "expression": " if(roundup('ASA Overview PD'[# of New Enrol PD Target]*0.9,0)-'ASA Overview PD'[# of New Student PD non Skplus]>0,roundup('ASA Overview PD'[# of New Enrol PD Target]*0.9,0)-'ASA Overview PD'[# of New Student PD non Skplus],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of New Student PD non Skplus ASA Need Xuat Sac",
            "expression": "if(roundup('ASA Overview PD'[# of New Enrol PD Target]*1.0,0)-'ASA Overview PD'[# of New Student PD non Skplus]>0,roundup('ASA Overview PD'[# of New Enrol PD Target]*1.0,0)-'ASA Overview PD'[# of New Student PD non Skplus],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of New Student PD non Skplus ASA Need Vuot Troi",
            "expression": "if(roundup('ASA Overview PD'[# of New Enrol PD Target]*1.1,0)-'ASA Overview PD'[# of New Student PD non Skplus]>0,roundup('ASA Overview PD'[# of New Enrol PD Target]*1.1,0)-'ASA Overview PD'[# of New Student PD non Skplus],0)",
            "formatString": "0.00"
          },
          {
            "name": "ASA Performance NewPD non Skplus_ReOD Bonus",
            "expression": [
              "",
              "SWITCH(",
              "   TRUE(),",
              "   [ASA Performance NewPD non Skplus_ReOD Rank] = \"Vượt trội\", 6000000,",
              "   [ASA Performance NewPD non Skplus_ReOD Rank] = \"Xuất sắc\", 3000000,",
              "   [ASA Performance NewPD non Skplus_ReOD Rank] =  \"Giỏi\", 1000000,  ",
              "   0",
              ")"
            ],
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of New Std PD non Skplus And Re Open Date ASA Need Gioi",
            "expression": "if(roundup(('ASA Overview PD'[# of New Enrol PD Target] + 'ASA Overview OD'[# of Re Enrol OD Target])*0.95,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date]>0,roundup(('ASA Overview PD'[# of New Enrol PD Target] + 'ASA Overview OD'[# of Re Enrol OD Target])*0.95,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of New Std PD non Skplus And Re Open Date ASA Need Xuat Sac",
            "expression": "if(roundup(('ASA Overview PD'[# of New Enrol PD Target] + 'ASA Overview OD'[# of Re Enrol OD Target])*1.0,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date]>0,roundup(('ASA Overview PD'[# of New Enrol PD Target] + 'ASA Overview OD'[# of Re Enrol OD Target])*1.0,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of New Std PD non Skplus And Re Open Date ASA Need Vuot troi",
            "expression": "if(roundup(('ASA Overview PD'[# of New Enrol PD Target] + 'ASA Overview OD'[# of Re Enrol OD Target])*1.05,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date]>0,roundup(('ASA Overview PD'[# of New Enrol PD Target] + 'ASA Overview OD'[# of Re Enrol OD Target])*1.05,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date],0)",
            "formatString": "0.00"
          },
          {
            "name": "ME Performance NewPD Bonus non Skplus",
            "expression": [
              "",
              "SWITCH(",
              "   TRUE(),",
              "   [ME Performance NewPD Rank non Skplus] = \"Vượt trội\", 6000000,",
              "   [ME Performance NewPD Rank non Skplus] = \"Xuất sắc\", 3000000,",
              "   [ME Performance NewPD Rank non Skplus] =  \"Giỏi\", 1000000,  ",
              "   0",
              ")"
            ],
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of New Student PD non Skplus ME Need Gioi",
            "expression": "if(roundup('ASA Overview PD'[# of New Enrol PD Campus Target non Skplus]*0.9,0)-'ASA Overview PD'[# of New Student PD non Skplus]>0,roundup('ASA Overview PD'[# of New Enrol PD Campus Target non Skplus]*0.9,0)-'ASA Overview PD'[# of New Student PD non Skplus],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of New Student PD non Skplus ME Need Xuat Sac",
            "expression": "if(roundup('ASA Overview PD'[# of New Enrol PD Campus Target non Skplus]*1.0,0)-'ASA Overview PD'[# of New Student PD non Skplus]>0,roundup('ASA Overview PD'[# of New Enrol PD Campus Target non Skplus]*1.0,0)-'ASA Overview PD'[# of New Student PD non Skplus],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of New Student PD non Skplus ME Need Vuot Troi",
            "expression": "if(roundup('ASA Overview PD'[# of New Enrol PD Campus Target non Skplus]*1.1,0)-'ASA Overview PD'[# of New Student PD non Skplus]>0,roundup('ASA Overview PD'[# of New Enrol PD Campus Target non Skplus]*1.1,0)-'ASA Overview PD'[# of New Student PD non Skplus],0)",
            "formatString": "0.00"
          },
          {
            "name": "Performance NewPD non Skplus and ReOD Bonus",
            "expression": [
              "",
              "SWITCH(",
              "   TRUE(),",
              "   [Performance NewPD non Skplus and ReOD Rank] = \"Vượt trội\", 12000000,",
              "   [Performance NewPD non Skplus and ReOD Rank] = \"Xuất sắc\", 6000000,",
              "   [Performance NewPD non Skplus and ReOD Rank] =  \"Giỏi\", 2000000,  ",
              "   0",
              ")"
            ],
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of New Std PD non Skplus And Re Open Date Need Gioi",
            "expression": "if(roundup('ASA Overview PD'[# of New Std PD non Skplus And Re Open Date Target]*0.95,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date]>0,roundup('ASA Overview PD'[# of New Std PD non Skplus And Re Open Date Target]*0.95,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of New Std PD non Skplus And Re Open Date Need Xuat Sac",
            "expression": "if(roundup('ASA Overview PD'[# of New Std PD non Skplus And Re Open Date Target]*1.0,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date]>0,roundup('ASA Overview PD'[# of New Std PD non Skplus And Re Open Date Target]*1.0,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date],0)",
            "formatString": "0.00"
          },
          {
            "name": "# of New Std PD non Skplus And Re Open Date Need Vuot Troi",
            "expression": "if(roundup('ASA Overview PD'[# of New Std PD non Skplus And Re Open Date Target]*1.05,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date]>0,roundup('ASA Overview PD'[# of New Std PD non Skplus And Re Open Date Target]*1.05,0)-'ASA Overview PD'[# of New Std PD non Skplus And Re Open Date],0)",
            "formatString": "0.00"
          },
          {
            "name": "# 1 of New Student Recycle + Refferal + Sibling",
            "expression": " 'ASA Overview PD'[# 1 of New Student PD Recycle]+ 'ASA Overview PD'[# 1 of New Student Refferal + Sibling]"
          },
          {
            "name": "# of New Enrol PD Recycle + Refferal + Sibling Campus Target",
            "expression": [
              " 'ASA Overview PD'[# of New Enrol PD Recycle Campus Target]+ 'ASA Overview PD'[# of New Student Refferal + Sibling Campus Target]",
              "",
              ""
            ]
          },
          {
            "name": "% 1 of New Student PD Recycle + Referral + Sibling vs Campus Target",
            "expression": [
              "DIVIDE('ASA Overview PD'[# 1 of New Student Recycle + Refferal + Sibling],'ASA Overview PD'[# of New Enrol PD Recycle + Refferal + Sibling Campus Target])",
              ""
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "New Enrol PD Revenue Tuition Amt",
            "expression": " CALCULATE(sum('ASA Overview PD'[Tuition Amount]),'ASA Overview PD'[New Enrol Flag]=\"New Enrol\")"
          },
          {
            "name": "Re Enrol PD Revenue Tuition Amt",
            "expression": " CALCULATE(sum('ASA Overview PD'[Tuition Amount]),'ASA Overview PD'[New Enrol Flag]=\"Re Enrol\")"
          },
          {
            "name": "# of Gap Total New",
            "expression": [
              " 'ASA Overview PD'[# of New Enrol PD Campus Target] - 'ASA Overview PD'[# of New Student PD]",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Gap Recycle New",
            "expression": [
              " 'ASA Overview PD'[# of New Enrol PD Recycle Campus Target] - 'ASA Overview PD'[# 1 of New Student PD Recycle]",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "of # Gap Ref/Sib New",
            "expression": [
              " 'ASA Overview PD'[# of New Student Refferal + Sibling Campus Target] - 'ASA Overview PD'[# 1 of New Student Refferal + Sibling]",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Gap New-New",
            "expression": [
              " 'ASA Overview PD'[# of New Enrol PD TMK Campus Target] - 'ASA Overview PD'[# 1 of New Student PD New]",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Gap Media New",
            "expression": [
              " 'MKT Kpi Target Manual'[Total_target_Sign] -'ASA Overview PD'[# of New Student PD]",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Gap TMK New",
            "expression": [
              " 'MKT Kpi Target Manual'[# of TMK Target Sales] - 'ASA Overview PD'[# of New Student PD TMK]",
              ""
            ],
            "formatString": "#,0"
          }
        ]
      },
      {
        "name": "ASA Target Manual",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Date Key"
          },
          {
            "name": "Branch Key",
            "dataType": "string",
            "sourceColumn": "Branch Key"
          },
          {
            "name": "Level Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Level Key"
          },
          {
            "name": "Data Version Key",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Data Version Key"
          },
          {
            "name": "Campus Code",
            "dataType": "string",
            "sourceColumn": "Campus Code"
          },
          {
            "name": "Group Program Code",
            "dataType": "string",
            "sourceColumn": "Group Program Code"
          },
          {
            "name": "Target Type",
            "dataType": "string",
            "sourceColumn": "Target Type"
          },
          {
            "name": "Target Value",
            "dataType": "double",
            "sourceColumn": "Target Value"
          },
          {
            "name": "Time Type",
            "dataType": "string",
            "sourceColumn": "Time Type"
          },
          {
            "name": "Study Branch Key",
            "dataType": "string",
            "sourceColumn": "Study Branch Key"
          },
          {
            "name": "Invoice Type Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "Invoice Type Key"
          },
          {
            "name": "End Date",
            "dataType": "dateTime",
            "sourceColumn": "End Date"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_TARGET_MANUAL_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_TARGET_MANUAL_F\"]}[Data]",
                "in",
                "    DWH_VW_ASA_TARGET_MANUAL_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Class Size Target",
            "expression": [
              "CALCULATE(DIVIDE(SUM('ASA Target Manual'[Target Value]),'ASA Target Manual'[# of Count Row],BLANK()),'ASA Target Manual'[Target Type]=\"Target Class size\",'ASA Target Manual'[Group Program Code] = BLANK())",
              ""
            ]
          },
          {
            "name": "# of Count Row",
            "expression": "COUNTROWS(GROUPBY('ASA Target Manual','ASA Target Manual'[Branch Key],'Calendar'[Year Month]))"
          },
          {
            "name": "# Target Revenue Allocation",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] =\"Target Revenue Allocation\"))"
          },
          {
            "name": "# of Accrual Revenue Campus Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Accrual Revenue\"))"
          },
          {
            "name": "# of Accrual Hour Campus Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Accrual Hour\"))"
          },
          {
            "name": "# of Accrual Session Campus Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Accrual Session\"))"
          },
          {
            "name": "# of Fee per Hrs Campus Target",
            "expression": "DIVIDE( 'ASA Target Manual'[# of Accrual Revenue Campus Target],'ASA Target Manual'[# of Accrual Hour Campus Target],BLANK())",
            "formatString": "0.00"
          },
          {
            "name": "# of Fee per Session Campus Target",
            "expression": "DIVIDE( 'ASA Target Manual'[# of Accrual Revenue Campus Target],'ASA Target Manual'[# of Accrual Session Campus Target],BLANK())",
            "formatString": "0.00"
          }
        ]
      },
      {
        "name": "ASA Baring Media View",
        "columns": [
          {
            "name": "Baring Media Key",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Baring Media Key"
          },
          {
            "name": "Baring Media Name",
            "dataType": "string",
            "sourceColumn": "Baring Media Name",
            "sortByColumn": "Baring Media Key"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_BARING_MEDIA_VIEW_D = Source{[Schema=\"DWH\",Item=\"VW_ASA_BARING_MEDIA_VIEW_D\"]}[Data]",
                "in",
                "    DWH_VW_ASA_BARING_MEDIA_VIEW_D"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Baring Media Value",
            "expression": [
              "",
              "var media = SELECTEDVALUE('ASA Baring Media View'[Baring Media Name])",
              "return",
              "\tSWITCH(media,",
              "\t\"Lead\", [# of Lead],",
              "\t\"Enquiries\", [# of Enquiries],",
              "\t\"New Enrol PD\",  [# of New Enrol PD])"
            ],
            "formatString": "#,0.00"
          }
        ]
      },
      {
        "name": "ASA Baring Program View",
        "columns": [
          {
            "name": "Baring Program Key",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Baring Program Key"
          },
          {
            "name": "Baring Program Name",
            "dataType": "string",
            "sourceColumn": "Baring Program Name",
            "sortByColumn": "Baring Program Key"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_BARING_PROGRAM_VIEW_D = Source{[Schema=\"DWH\",Item=\"VW_ASA_BARING_PROGRAM_VIEW_D\"]}[Data]",
                "in",
                "    DWH_VW_ASA_BARING_PROGRAM_VIEW_D"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Baring Program Value",
            "expression": [
              "",
              "var Program = SELECTEDVALUE('ASA Baring Program View'[Baring Program Name])",
              "return ",
              "\tSWITCH(Program,",
              "\t\"New Enrolment OD\", [# of New Enrol OD],",
              "\t\"Re Enrolment OD\", [# of Re Enrol OD],",
              "\t\"Total Enrolment OD\",  [# of Enrol PD],",
              "\t\"Revenue OD\", [Enrol PD Revenue Amt],",
              "\t\"New Enrolment PD\", [# of New Enrol PD],",
              "\t\"Re Enrolment PD\", [# of Re Enrol PD],",
              "\t\"Total Enrolment PD\",  [# of Enrol OD],",
              "\t\"Revenue PD\", [Enrol OD Revenue Amt]",
              "\t)"
            ],
            "formatString": "#,0.00"
          }
        ]
      },
      {
        "name": "Mixing Class",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey"
          },
          {
            "name": "ClassKey",
            "dataType": "string",
            "sourceColumn": "ClassKey"
          },
          {
            "name": "CampusKey",
            "dataType": "string",
            "sourceColumn": "CampusKey"
          },
          {
            "name": "LevelKey",
            "dataType": "string",
            "sourceColumn": "LevelKey"
          },
          {
            "name": "TC_TeacherCode",
            "dataType": "string",
            "sourceColumn": "TC_TeacherCode"
          },
          {
            "name": "TA_TeacherCode",
            "dataType": "string",
            "sourceColumn": "TA_TeacherCode"
          },
          {
            "name": "IsOnlineClass",
            "dataType": "boolean",
            "sourceColumn": "IsOnlineClass"
          },
          {
            "name": "IsForeign",
            "dataType": "boolean",
            "sourceColumn": "IsForeign"
          },
          {
            "name": "MaxTA",
            "dataType": "int64",
            "sourceColumn": "MaxTA"
          },
          {
            "name": "ExceedMaxTA",
            "dataType": "int64",
            "sourceColumn": "ExceedMaxTA"
          },
          {
            "name": "ProgramCode",
            "dataType": "string",
            "sourceColumn": "ProgramCode"
          },
          {
            "name": "TierArea",
            "dataType": "string",
            "sourceColumn": "TierArea"
          },
          {
            "name": "CampusCode",
            "dataType": "string",
            "sourceColumn": "CampusCode"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_MIXING_CLASS_F = Source{[Schema=\"DWH\",Item=\"VW_MIXING_CLASS_F\"]}[Data]",
                "in",
                "    DWH_VW_MIXING_CLASS_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# TC NN",
            "expression": "  CALCULATE( DISTINCTCOUNTNOBLANK([TC_TeacherCode]), 'Mixing Class'[IsForeign] = TRUE)"
          },
          {
            "name": "# TC VN",
            "expression": "  CALCULATE( DISTINCTCOUNTNOBLANK([TC_TeacherCode]), 'Mixing Class'[IsForeign] = FALSE)"
          },
          {
            "name": "# TA",
            "expression": " DISTINCTCOUNTNOBLANK('Mixing Class'[TA_TeacherCode])"
          },
          {
            "name": "# TC (ALL)",
            "expression": " [# TC VN] + [# TC NN]"
          },
          {
            "name": "# Mixing Class TC NN",
            "expression": [
              "",
              "var TempVN = CALCULATETABLE(",
              "    SUMMARIZE('Mixing Class', ",
              "           'Mixing Class'[ClassKey],",
              "            \"NumClassTCMixing1\", DISTINCTCOUNTNOBLANK('Mixing Class'[TC_TeacherCode])",
              "        ),",
              "        'Mixing Class'[IsForeign] = False",
              "    )",
              "var TempNN = CALCULATETABLE(",
              "    SUMMARIZE('Mixing Class', ",
              "             'Mixing Class'[ClassKey],",
              "            \"NumClassTCMixing2\", DISTINCTCOUNTNOBLANK('Mixing Class'[TC_TeacherCode])",
              "        ),",
              "        'Mixing Class'[IsForeign] = True",
              "    )",
              "var TempJoin = NATURALLEFTOUTERJOIN(TempVN, TempNN)",
              "RETURN COUNTX(FILTER(TempJoin, AND( [NumClassTCMixing1] = 1, [NumClassTCMixing2] >=5)), 'Mixing Class'[ClassKey])",
              "",
              "",
              ""
            ]
          },
          {
            "name": "# Mixing Class TC VN",
            "expression": [
              "",
              "var TempVN = CALCULATETABLE(",
              "    SUMMARIZE('Mixing Class', ",
              "           'Mixing Class'[ClassKey],",
              "            \"NumClassTCMixing1\", DISTINCTCOUNTNOBLANK('Mixing Class'[TC_TeacherCode])",
              "        ),",
              "        'Mixing Class'[IsForeign] = False",
              "    )",
              "var TempNN = CALCULATETABLE(",
              "    SUMMARIZE('Mixing Class', ",
              "            'Mixing Class'[ClassKey],",
              "            \"NumClassTCMixing2\", DISTINCTCOUNTNOBLANK('Mixing Class'[TC_TeacherCode])",
              "        ),",
              "        'Mixing Class'[IsForeign] = True",
              "    )",
              "var TempJoin = NATURALLEFTOUTERJOIN(TempVN, TempNN)",
              "RETURN COUNTX(FILTER(TempJoin, AND( [NumClassTCMixing1] >= 5, [NumClassTCMixing2] =1)), 'Mixing Class'[ClassKey])"
            ]
          },
          {
            "name": "# Mixing Class TA",
            "expression": [
              "",
              "var Temp = ",
              "    SUMMARIZE('Mixing Class', ",
              "    'Mixing Class'[ClassKey], ",
              "    \"NumClassTCMixing\", DISTINCTCOUNTNOBLANK('Mixing Class'[TA_TeacherCode])",
              "    )",
              "var _Base = ",
              "    SUMMARIZE('Mixing Class', ",
              "        'Mixing Class'[ClassKey],",
              "        'Mixing Class'[MaxTA]",
              "    )",
              "var TempJoin = NATURALLEFTOUTERJOIN(Temp, _Base)",
              "RETURN COUNTX(FILTER(TempJoin, [NumClassTCMixing] > 'Mixing Class'[MaxTA]), 'Mixing Class'[ClassKey])"
            ]
          },
          {
            "name": "# Mixing Class TC (ALL)",
            "expression": [
              "",
              "var Temp = SUMMARIZE('Mixing Class', 'Mixing Class'[ClassKey], \"NumClassTCMixing\", DISTINCTCOUNTNOBLANK('Mixing Class'[TC_TeacherCode]))",
              "RETURN COUNTX(FILTER(Temp, [NumClassTCMixing] >=5), 'Mixing Class'[ClassKey])"
            ]
          },
          {
            "name": "# TA vs Max TA",
            "expression": "  [# TA] - MAX('Mixing Class'[MaxTA])"
          },
          {
            "name": "Sum TC VN & NN",
            "expression": " [# TC NN] + [# TC VN]"
          },
          {
            "name": "Deviation",
            "expression": " [# TA] - MAX('Mixing Class'[MaxTA])"
          },
          {
            "name": "IsMixingTA",
            "expression": " IF( OR([# TA] >= 4 && MAX('Mixing Class'[MaxTA]) = 2, [# TA] >= 3 && MAX('Mixing Class'[MaxTA]) = 1), 1, 0)"
          },
          {
            "name": "IsMixingTC",
            "expression": " IF( [# TC VN] >= 3 ||  [# TC NN] >= 3 ||  AND([# TC NN] = 2, [# TC VN] = 2),  1,  0)"
          },
          {
            "name": "# Class",
            "expression": " CALCULATE(DISTINCTCOUNT('Mixing Class'[ClassKey]))"
          },
          {
            "name": "% Mixing Class Vs Class",
            "expression": " DIVIDE('Mixing Class'[# Mixing Class TC (ALL)],'Mixing Class'[# Class],0.0)",
            "formatString": "0.0%;-0.0%;0.0%"
          }
        ]
      },
      {
        "name": "Teacher Ranking New",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "string",
            "sourceColumn": "DateKey"
          },
          {
            "name": "TeacherProfileKey",
            "dataType": "string",
