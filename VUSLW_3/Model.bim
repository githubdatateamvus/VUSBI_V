              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_OBSERVATION_QA_QC_F = Source{[Schema=\"DWH\",Item=\"VW_OBSERVATION_QA_QC_F\"]}[Data],",
                "    #\"Removed Other Columns\" = Table.SelectColumns(DWH_VW_OBSERVATION_QA_QC_F,{\"KeyId\", \"CompetencyGroupKey\", \"CompetencyGroupCode\", \"CompetencyKey\", \"CompetencyCode\", \"CompetencyItemKey\", \"TeacherProfileKey\", \"ClassKey\", \"CampusKey\", \"LevelProgramKey\", \"RoomKey\", \"AssessmentDateKey\", \"ObserverKey\", \"GroupKey\", \"Observer2Key\", \"MilestonesCompetencyKey\", \"AssessmentCompetencyTotalScore\", \"AssessmentCompetencyTotalPoint\", \"AssessmentCompetencyMaximumTotalPoint\", \"AssessmentCompetencyItemScore\", \"AssessmentCompetencyItemChecked\", \"AssessmentPenaltyScore\", \"AssessmentTotalScore\", \"AssessmentRanking\", \"AssessmentPurpose\"})",
