            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Quality Lead CRM For Month",
            "expression": [
              "",
              "CALCULATE('Lead'[# of Qualify Lead CRM],USERELATIONSHIP('Lead'[Date Show Key],'Calendar'[Date Key]))"
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# % Appt > Show In Month",
            "expression": "  DIVIDE('Lead'[# of Lead Enquiries In Month],'Lead'[# of Lead Appoinment],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# % Q.Lead > Show In month",
            "expression": "  DIVIDE('Lead'[# of Lead Enquiries In Month],'Lead'[# of Qualify Lead CRM],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# % Q.Lead > Sign In month",
            "expression": "  DIVIDE('Lead'[# of Lead Enrol In Month],'Lead'[# of Qualify Lead CRM],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR LEAD > Q.Lead",
            "expression": " DIVIDE('Lead'[# of Qualify Lead CRM],'Lead'[# of Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Q.Lead > Show",
            "expression": " DIVIDE('Lead'[# of Lead Enquiries In Month],'Lead'[# of Qualify Lead CRM],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Q.Lead > Sign",
            "expression": "  DIVIDE('ASA Overview PD'[# of New Student PD],'Lead'[# of Qualify Lead CRM],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Dynamic Title",
            "expression": [
              "",
              "VAR Timeselected = YEAR(LASTDATE('Calendar'[Date]))",
              "Var Subtitle = \"Comparison\"  & \"  \" & Timeselected  & \"  \" & \"&\" &\"  \"& \"2019\"",
              "RETURN Subtitle"
            ]
          },
          {
            "name": "Total Target Q.Lead",
            "expression": "CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"Q.LEAD\")",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Kpi By Q.Lead Digital Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"Q.LEAD\",'MKT Kpi Target Manual'[Media]=\"Digital\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Q.Lead Dmk Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"Q.LEAD\",'MKT Kpi Target Manual'[Media]=\"Direct\")",
            "formatString": "0"
          },
          {
            "name": "% Total Q.Lead vs Total Target Q.Lead",
            "expression": " DIVIDE([# of Qualify Lead CRM],'Lead'[Total Target Q.Lead],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Of Qualified Lead Digital vs Target",
            "expression": " divide('Lead'[# Of Qualified Lead Digital] ,'Lead'[# of Kpi By Q.Lead Digital Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Of Qualified Lead Direct vs Target",
            "expression": " divide('Lead'[# Of Qualified Lead Direct] ,'Lead'[# of Kpi By Q.Lead Dmk Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Uncalled Lead",
            "expression": " CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]),FILTER('Lead',ISBLANK('Lead'[FIRST CALL])))",
            "formatString": "0"
          },
          {
            "name": "# of Lead Enquiries By Appointment Digital",
            "expression": " CALCULATE(DISTINCTCOUNT('Lead'[User Information Show]),FILTER('Lead','Lead'[User Information Show]<>\"ASA~0\"),FILTER('Lead',OR('Lead'[Appoiment Create By]=\"Core Edu Api 1 #\",'Lead'[Appoiment Create By]=\"VUS-PROD API System Account\")))",
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead Enquiries By Appointment TMK",
            "expression": " [# of Lead Enquiries In Month]-[# of Lead Enquiries By Appointment Digital]",
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead  By Appointment Digital",
            "expression": " CALCULATE('Lead'[# of Lead],FILTER('Lead',OR('Lead'[Appoiment Create By]=\"Core Edu Api 1 #\",'Lead'[Appoiment Create By]=\"VUS-PROD API System Account\")))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead By Appointment TMK",
            "expression": "'Lead'[# of Lead]-'Lead'[# of Lead  By Appointment Digital]",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% CR Lead To Show By Appointment  Digital",
            "expression": " DIVIDE('Lead'[# of Lead Enquiries By Appointment Digital],'Lead'[# of Lead  By Appointment Digital],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Lead To Show By Appointment  TMK",
            "expression": " DIVIDE('Lead'[# of Lead Enquiries By Appointment TMK],'Lead'[# of Lead By Appointment TMK],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Lead Untoucher",
            "expression": "CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]),FILTER('Lead','Lead'[Care Status]=\"Chưa có trạng thái\"))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead Toucher",
            "expression": "'Lead'[# of Lead] - 'Lead'[# of Lead Untoucher]",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead UnConnected",
            "expression": "CALCULATE([# of lead],'Lead'[Care Status] in {\"Chưa liên hệ được\",\"Gọi lại sau\"})",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead Unqualified",
            "expression": "CALCULATE([# of lead],'Lead'[Care Status] in {\"Không được gọi lại\",\"Không hợp lệ\",\"Không tiềm năng\",\"Chưa đủ tuổi\"})",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Qualify Lead LY",
            "expression": " CALCULATE('Lead'[# of Qualify Lead CRM],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% Qualified Lead LY vs Qualified Lead",
            "expression": " divide( 'Lead'[# of Qualify Lead CRM], 'Lead'[# of Qualify Lead LY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of Lead UnConnected",
            "expression": "DIVIDE('Lead'[# of Lead UnConnected],'Lead'[# of Lead Toucher],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Lead Enquiries In Month",
            "expression": [
              " CALCULATE(",
              "    [# of Lead Enquiries],",
              "    EOMONTH('Lead'[Show Date], 0) = EOMONTH('Lead'[Lead Date], 0)",
              ")",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead Enrol In Month",
            "expression": [
              " CALCULATE(",
              "    [# of Lead Enrol],",
              "    EOMONTH('Lead'[Sign Date], 0) = EOMONTH('Lead'[Lead Date], 0)",
              ")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "% of Lead Unqualified",
            "expression": "DIVIDE('Lead'[# of Lead Unqualified],'Lead'[# of Lead Toucher],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Lead Untoucher",
            "expression": "DIVIDE('Lead'[# of Lead Untoucher],'Lead'[# of Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Calculated Qualified Lead",
            "expression": " 'Lead'[# of Lead Toucher] - 'Lead'[# of Lead UnConnected]- 'Lead'[# of Lead Unqualified]"
          },
          {
            "name": "# of Phone",
            "expression": " CALCULATE(DISTINCTCOUNT('Lead'[Mobile]),FILTER('Lead','Lead'[Row Index]=1))"
          },
          {
            "name": "% CR Lead To Show In Month",
            "expression": " DIVIDE('Lead'[# of Lead Enquiries In Month],'Lead'[# of Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Show To Sign In Month",
            "expression": " DIVIDE('Lead'[# of Lead Enrol In Month],'Lead'[# of Lead Enquiries In Month],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Lead To Sign In Month",
            "expression": " DIVIDE('Lead'[# of Lead Enrol In Month],'Lead'[# of Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Lead Placement Test",
            "expression": " CALCULATE('Lead'[# of Lead],  'Lead'[Placement Test]=\"true\")"
          },
          {
            "name": "# of Lead YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('Lead'[# of Lead],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "% CR Lead > Show YTD",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries YTD],'Lead'[# of Lead YTD])"
          },
          {
            "name": "Lead YTD PY",
            "expression": " CALCULATE('Lead'[# of Lead YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% CR Lead > Show YTD PY",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries YTD PY],'Lead'[Lead YTD PY])"
          },
          {
            "name": "% Lead vs Target",
            "expression": " DIVIDE('Lead'[# of Lead],'MKT Kpi Target Manual'[Total_target_lead],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Lead YTD vs PY",
            "expression": " DIVIDE('Lead'[# of Lead YTD],'Lead'[Lead YTD PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Lead Digital PY",
            "expression": " CALCULATE('Lead'[# Of Lead Digital],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Lead Digital YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('Lead'[# Of Lead Digital],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "# of Lead Digital YTD PY",
            "expression": " CALCULATE('Lead'[# of Lead Digital PY],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of Lead Digital vs PY",
            "expression": " DIVIDE( 'Lead'[# Of Lead Digital],'Lead'[# of Lead Digital PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of Lead Digital YTD vs PY",
            "expression": " DIVIDE( 'Lead'[# of Lead Digital YTD],'Lead'[# of Lead Digital YTD PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Lead Direct PY",
            "expression": " CALCULATE('Lead'[# Of Lead Direct],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Lead Direct YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('Lead'[# Of Lead Direct],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "# of Lead Direct YTD PY",
            "expression": " CALCULATE('Lead'[# of Lead Direct PY],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of Lead Direct vs PY",
            "expression": " DIVIDE( 'Lead'[# Of Lead Direct],'Lead'[# of Lead Direct PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of Lead Direct YTD vs PY",
            "expression": " DIVIDE( 'Lead'[# of Lead Direct YTD],'Lead'[# of Lead Direct YTD PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Lead Referral PY",
            "expression": " CALCULATE('Lead'[# Of Lead Referral],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Lead Referral YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('Lead'[# Of Lead Referral],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "# of Lead Referral YTD PY",
            "expression": " CALCULATE('Lead'[# of Lead Referral PY],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of Lead Referral vs PY",
            "expression": " DIVIDE( 'Lead'[# Of Lead Referral],'Lead'[# of Lead Referral PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of Lead Referral YTD vs PY",
            "expression": " DIVIDE( 'Lead'[# of Lead Referral YTD],'Lead'[# of Lead Referral YTD PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Lead Care",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Lead],",
              "    NOT ISBLANK('Lead'[Care Date]),",
              "    'Lead'[Care Date] <> DATE(1900, 1, 1),'Lead'[Care Date]<>(DATE(1900, 1, 1) + TIME(7, 0, 0))",
              ")",
              "",
              ""
            ]
          },
          {
            "name": "# of Lead Appointment In Month",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Lead Appoinment],",
              "    EOMONTH('Lead'[Appointment At], 0) = EOMONTH('Lead'[Lead Date], 0)",
              ")",
              ""
            ]
          },
          {
            "name": "# of Lead Referal&Sibling",
            "expression": "CALCULATE( 'Lead'[# of Lead], 'Source Information'[Media] IN { \"Sibling\", \"Referral\" } )"
          },
          {
            "name": "% Act Lead Ref&Sibling vs Target",
            "expression": "DIVIDE('Lead'[# of Lead Referal&Sibling],'MKT Kpi Target Manual'[# of Target Lead Referal&Sibling],BLANK() )",
            "formatString": "0.0000%;-0.0000%;0.0000%"
          },
          {
            "name": "% CR LEAD > SHOW-Digital",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries Digital],'Lead'[# Of Lead Digital],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR LEAD > SHOW-DMK",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries Direct],'Lead'[# Of Lead Direct],BLANK())",
            "formatString": "0%;-0%;0%"
          }
        ]
      },
