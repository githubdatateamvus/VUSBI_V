            "dataType": "string",
            "sourceColumn": "OWNER_BY"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_LEAD_F = Source{[Schema=\"DWH\",Item=\"VW_LEAD_F\"]}[Data]",
                "in",
                "    DWH_VW_LEAD_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Lead",
            "expression": " CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead Enquiries",
            "expression": [
              "CALCULATE(",
              "    [# of Lead],                    -- base lead count",
              "    NOT ISBLANK('Lead'[Show Date]),  -- exclude blanks",
              "    'Lead'[Show Date] <> DATE(1900, 1, 1),",
              "    'Lead'[Show Date] <> (DATE(1900, 1, 1) + TIME(7, 0, 0))",
              ")",
              "",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "# of Lead Enrol",
            "expression": [
              "CALCULATE(",
              "    [# of Lead],                     -- base lead count",
              "    NOT ISBLANK('Lead'[Sign Date]),   -- exclude blanks",
              "    'Lead'[Sign Date] <> DATE(1900, 1, 1),",
              "    'Lead'[Sign Date] <> (DATE(1900, 1, 1) + TIME(7, 0, 0))",
              ")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "% CR Lead To Show",
            "expression": " DIVIDE('Lead'[# of Lead Enquiries],'Lead'[# of Lead],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Lead LM",
            "expression": " CALCULATE('Lead'[# of Lead],PREVIOUSMONTH('Calendar'[Date]))",
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead Same Day Last Month",
            "expression": " CALCULATE('Lead'[# of Lead], DATEADD('Calendar'[Date], -1, MONTH))",
            "formatString": "0"
          },
          {
            "name": "% CR Show To Sign",
            "expression": " DIVIDE('Lead'[# of Lead Enrol],'Lead'[# of Lead Enquiries],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Lead SameDayLastMonth",
            "expression": " CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]), DATEADD('Calendar'[Date], -1, MONTH)) ",
            "formatString": "0"
          },
          {
            "name": "# of Invalid Lead CRM",
            "expression": [
              " ",
              "CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]),FILTER('Lead','Lead'[Care Status]=\"Không hợp lệ\" && 'Lead'[Source Type]=\"CRM\"))"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Dup Lead CRM",
            "expression": [
              " ",
              "CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]),FILTER('Lead',OR('Lead'[Lead Status]=\"Duplicated\",OR('Lead'[Lead Status]=\"dupASA\" ,'Lead'[Lead Status]=\"dupTMK\")) && 'Lead'[Source Type]=\"CRM\"))"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Lead CRM",
            "expression": [
              " ",
              "CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]),FILTER('Lead','Lead'[Source Type]=\"CRM\"))"
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Valid Lead CRM",
            "expression": " [# of Lead CRM]-[# of Dup Lead CRM]",
            "formatString": "0"
          },
          {
            "name": "# of Verfiied Lead CRM",
            "expression": " [# of Valid Lead CRM]-[# of Invalid Lead CRM]",
            "formatString": "0"
          },
          {
            "name": "# of No Potential Lead",
            "expression": [
              " ",
              "CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]),FILTER('Lead','Lead'[Care Status]=\"Không tiềm năng\" && 'Lead'[Source Type]=\"CRM\"))"
            ],
            "formatString": "0"
          },
          {
            "name": "# of No Call Lead",
            "expression": [
              " ",
              "CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]),FILTER('Lead','Lead'[Care Status]=\"Không được gọi lại\" && 'Lead'[Source Type]=\"CRM\"))"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Qualify Lead CRM",
            "expression": [
              "",
              "   CALCULATE([# of lead],( 'Lead'[Care Status] in {\"Đang cân nhắc\",\"Hẹn lên trung tâm\",\"Hẹn tư vấn online\",\"Tiềm năng tương lai\",\"Rớt hẹn\",\"Đặt lịch hẹn Demo class\"} &&  NOT  'Lead'[Lead Status] IN {\"Unverified\",\"Canceled\",\"Duplicated\"}",
              "\t&& NOT  ISBLANK('Lead'[First Call Success]))",
              "\t|| NOT ISBLANK('Lead'[Show Date]))",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead LY",
            "expression": " CALCULATE(DISTINCTCOUNT('Lead'[Lead Key]),SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "\"\"#,0.00;(\"\"#,0.00);\"\"#,0.00",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"2\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% Lead vs LY",
            "expression": " DIVIDE('Lead'[# of Lead],'Lead'[# of Lead LY],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# of MKT Lead Target",
            "expression": " 'Lead'[# of Lead]*RANDBETWEEN(0.7,1.3)",
            "formatString": "#,0"
          },
          {
            "name": "% Lead vs MKT Target",
            "expression": " DIVIDE('Lead'[# of Lead],[# of MKT Lead Target],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# of Lead 2019",
            "expression": [
              " ",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([# of Lead],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% CR Lead vs 2019",
            "expression": " DIVIDE('Lead'[# of Lead],[# of Lead 2019], BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Growth Lead vs LY",
            "expression": " DIVIDE('Lead'[# of Lead],[# of Lead LY], BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Lead Enquiries For Month",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Lead Enquiries],",
              "    USERELATIONSHIP('Lead'[Date Show Key], 'Calendar'[Date Key])",
              ")",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead Enrol For Month",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Lead Enrol],",
              "    USERELATIONSHIP('Lead'[Date Sign Key], 'Calendar'[Date Key])",
              ")",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead Enrol Referral",
            "expression": "CALCULATE(DISTINCTCOUNT('Lead'[User Information Sign]),FILTER('Lead','Lead'[User Information Sign]<>\"ASA~0\"),'Lead'[Source Type]=\"ASA REFERRAL\")",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% CR Lead CRM To Qualify Lead CRM",
            "expression": " DIVIDE('Lead'[# of Qualify Lead CRM],'Lead'[# of Lead CRM],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% CR Q.Lead To Show CRM",
            "expression": " DIVIDE('Lead'[# of Lead Enquiries CRM],'Lead'[# of Qualify Lead CRM],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Lead Enquiries CRM",
            "expression": " CALCULATE(DISTINCTCOUNT('Lead'[User Information Show]),FILTER('Lead','Lead'[User Information Show]<>\"ASA~0\"),'Lead'[Source Type]=\"CRM\")",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Lead Enrol CRM",
            "expression": "CALCULATE(DISTINCTCOUNT('Lead'[User Information Sign]),FILTER('Lead','Lead'[User Information Sign]<>\"ASA~0\"),'Lead'[Source Type]=\"CRM\")",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% CR Q.Lead To Sign CRM",
            "expression": " DIVIDE('Lead'[# of Lead Enrol CRM],'Lead'[# of Qualify Lead CRM],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Lead Called",
            "expression": " CALCULATE('Lead'[# of Lead],'Lead'[First Call] <> BLANK())",
            "formatString": "0"
          },
          {
            "name": "# of Lead Called Success",
            "expression": " CALCULATE('Lead'[# of Lead],'Lead'[First Call Success] <> BLANK())",
            "formatString": "0"
          },
          {
            "name": "% CR Lead To Called",
            "expression": " DIVIDE('Lead'[# of Lead Called],'Lead'[# of Lead])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Lead To Called Success",
            "expression": " DIVIDE('Lead'[# of Lead Called Success],'Lead'[# of Lead])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Lead To Sign For Month",
            "expression": " DIVIDE('Lead'[# of Lead Enrol For Month],'Lead'[# of Lead],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% CR Lead To Show For Month",
            "expression": " DIVIDE('Lead'[# of Lead Enquiries For Month],'Lead'[# of Lead],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% CR Show To Sign For Month",
            "expression": " DIVIDE('Lead'[# of Lead Enrol For Month],'Lead'[# of Lead Enquiries For Month],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% CR Lead To Show For Month (2)",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],'Lead'[# of Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Show To Sign For Month (2)",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol PD Total Package],'ASA Enquiries'[# of Enquiries],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Lead Appoinment",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of Lead],",
              "    NOT ISBLANK('Lead'[Appointment At]),",
              "    'Lead'[Appointment At] <> DATE(1900, 1, 1),",
              "    'Lead'[Appointment At] <> (DATE(1900, 1, 1) + TIME(7, 0, 0))",
              ")",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% CR Lead Appoiment To Show",
            "expression": " DIVIDE('Lead'[# of Lead Enquiries In Month],'Lead'[# of Lead Appoinment],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Lead Appoiment To Show For Month",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],'Lead'[# of Lead Appoinment],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Lead ASA Ref To Sign ASA Ref",
            "expression": " DIVIDE('ASA Overview PD'[# of New Enrol Referral PD],'ASA Lead'[# of ASA Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of MKT Lead Target By Channel",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA MKT Target By Channel'[Lead Value])",
              "\t,ALL('Calendar')",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)\t"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Lead vs MKT Target By Channel",
            "expression": " DIVIDE('Lead'[# of Lead],[# of MKT Lead Target By Channel],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# of MKT Lead Target By Media",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA MKT Target By Media'[Lead Value])",
              "\t,ALL('Calendar')",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)\t"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Lead vs MKT Target By Media",
            "expression": " DIVIDE('Lead'[# of Lead],[# of MKT Lead Target By Media],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# Of Enquiries from Lead Date",
            "expression": [
              " CALCULATE('Lead'[# of Lead],'Lead'[Show Month Year]<> 'Lead'[Year Month Lead Date])",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "% Of Enquiries from Lead Date",
            "expression": [
              " divide('Lead'[# Of Enquiries from Lead Date] , 'Lead'[# of Qualify Lead CRM])",
              ""
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# Of Qualified Lead Digital",
            "expression": [
              "CALCULATE('Lead'[# of Qualify Lead CRM],'Source Information'[Media]=\"Digital\")",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% Of Qualified Lead Digital",
            "expression": " divide('Lead'[# Of Qualified Lead Digital] ,'Lead'[# of Lead])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# Of Qualified Lead Direct",
            "expression": "CALCULATE('Lead'[# of Qualify Lead CRM],'Source Information'[Media]=\"Direct\")",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% Of Qualified Lead Direct",
            "expression": " divide('Lead'[# Of Qualified Lead Direct] ,'Lead'[# of Lead])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# Of Lead Digital",
            "expression": "CALCULATE('Lead'[# of Lead],'Source Information'[Media]=\"Digital\")",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% Of Lead Digital",
            "expression": " divide('Lead'[# Of Lead Digital] ,'Lead'[# of Lead])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# Of Lead Direct",
            "expression": "CALCULATE('Lead'[# of Lead],'Source Information'[Media]=\"Direct\")",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
