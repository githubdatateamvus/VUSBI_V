        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": [
                "DATATABLE(",
                "    \"IsAdjusted\", INTEGER,",
                "    {",
                "        {0},{1}",
                "    }",
                ")"
              ]
            }
          }
        ]
      },
      {
