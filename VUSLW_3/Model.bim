          {
            "name": "Source Information Key",
            "dataType": "string",
            "sourceColumn": "Source Information Key"
          },
          {
            "name": "Level Key",
            "dataType": "string",
            "sourceColumn": "Level Key"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    FND_W_MKT_KPI_TARGET_MANUAL = Source{[Schema=\"DWH\",Item=\"VW_MKT_KPI_TARGET_MANUAL\"]}[Data]",
                "in",
                "    FND_W_MKT_KPI_TARGET_MANUAL"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Kpi By Lead Digital Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"LEAD\",'MKT Kpi Target Manual'[Media]=\"Digital\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Lead Dmk Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"LEAD\",'MKT Kpi Target Manual'[Media]=\"Direct\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Lead Referral Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"LEAD\",'MKT Kpi Target Manual'[Media]=\"Referral\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Sign Digital Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SIGN\",'MKT Kpi Target Manual'[Media]=\"Digital\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Sign Dmk Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SIGN\",'MKT Kpi Target Manual'[Media]=\"Direct\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Sign Referral Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SIGN\",'MKT Kpi Target Manual'[Media]=\"Referral\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Show Digital Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SHOW\",'MKT Kpi Target Manual'[Media]=\"Digital\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Show Dmk Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SHOW\",'MKT Kpi Target Manual'[Media]=\"Direct\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Show Referral Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SHOW\",'MKT Kpi Target Manual'[Media]=\"Referral\")",
            "formatString": "0"
          },
          {
            "name": "Total_target_lead",
            "expression": [
              "CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"LEAD\")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "Total_target_Show",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SHOW\")",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "Total_target_Sign",
            "expression": [
              " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SIGN\")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "Percentage Total Lead vs Total Target Lead",
            "expression": [
              " DIVIDE('Lead'[# of Lead],'MKT Kpi Target Manual'[Total_target_lead])",
              ""
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Percentage Total Show vs Total Target Show",
            "expression": [
              " DIVIDE('ASA Enquiries'[# of Enquiries],'MKT Kpi Target Manual'[Total_target_Show])",
              ""
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Percentage Total Sign vs Total Target Sign",
            "expression": [
              " DIVIDE('ASA Overview PD'[# of New Student PD],'MKT Kpi Target Manual'[Total_target_Sign])",
              ""
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Kpi By PT Digital Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"PT\",'MKT Kpi Target Manual'[Media]=\"Digital\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By PT Dmk Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"PT\",'MKT Kpi Target Manual'[Media]=\"Direct\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By PT Referral Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"PT\",'MKT Kpi Target Manual'[Media]=\"Referral\")",
            "formatString": "0"
          },
          {
            "name": "Total_target_PT",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"PT\")",
            "formatString": "0"
          },
          {
            "name": "Percentage Total PT vs Total Target PT",
            "expression": " DIVIDE('ASA Placement Test'[# of Placement Test],'MKT Kpi Target Manual'[Total_target_PT],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of TMK Target Sales",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SIGN TMK\")",
            "formatString": "0"
          },
          {
            "name": "# of TMK Target Show",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"SHOW TMK\")",
            "formatString": "0"
          },
          {
            "name": "# of Kpi By Q.Lead Referral Target",
            "expression": " CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"Q.LEAD\",'MKT Kpi Target Manual'[Media]=\"Referral\")"
          },
          {
            "name": "# of Kpi By Lead / QLead Referral Target",
            "expression": [
              " ",
              "VAR Qlead_target = 'MKT Kpi Target Manual'[# of Kpi By Q.Lead Referral Target]",
              "VAR lead_target = 'MKT Kpi Target Manual'[# of Kpi By Lead Referral Target]",
              "VAR result = IF (lead_target > 0 && Qlead_target  = 0,lead_target,Qlead_target)",
              "Return result",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "% Target_CR_Lead_2_Show",
            "expression": "DIVIDE('MKT Kpi Target Manual'[Total_target_Show],'MKT Kpi Target Manual'[Total_target_lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Target_CR_Lead_2_Sign",
            "expression": "DIVIDE('MKT Kpi Target Manual'[Total_target_Sign],'MKT Kpi Target Manual'[Total_target_lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Target_CR_Show_2_Sign",
            "expression": "DIVIDE('MKT Kpi Target Manual'[Total_target_Sign],'MKT Kpi Target Manual'[Total_target_Show],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Target Lead Referal&Sibling",
            "expression": "CALCULATE(SUM('MKT Kpi Target Manual'[KPI]),'MKT Kpi Target Manual'[KpiType]=\"LEAD\",'MKT Kpi Target Manual'[Media]IN { \"Sibling\", \"Referral\" })"
          },
          {
            "name": "Target Cr Lead > Show digital",
            "expression": " DIVIDE('MKT Kpi Target Manual'[# of Kpi By Show Digital Target],'MKT Kpi Target Manual'[# of Kpi By Lead Digital Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Target CR Lead > Show DMK",
            "expression": " DIVIDE('MKT Kpi Target Manual'[# of Kpi By Show Dmk Target],'MKT Kpi Target Manual'[# of Kpi By Lead Dmk Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Target CR Show > Sign",
            "expression": " DIVIDE('MKT Kpi Target Manual'[Total_target_Sign],'MKT Kpi Target Manual'[Total_target_Show],BLANK())",
            "formatString": "0%;-0%;0%"
          }
        ]
      },
      {
        "name": "ASA Ending Class 2",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "int64",
            "sourceColumn": "Date Key"
          },
          {
            "name": "Branch Key",
            "dataType": "string",
            "sourceColumn": "Branch Key"
          },
          {
            "name": "User Key",
            "dataType": "string",
            "sourceColumn": "User Key"
          },
          {
            "name": "Level Key",
            "dataType": "string",
            "sourceColumn": "Level Key"
          },
          {
            "name": "List Class Key",
            "dataType": "string",
            "sourceColumn": "List Class Key"
          },
          {
            "name": "OldCampusID",
            "dataType": "string",
            "sourceColumn": "OldCampusID"
          },
          {
            "name": "OldCourseTypeID",
            "dataType": "string",
            "sourceColumn": "OldCourseTypeID"
          },
          {
            "name": "OldListLevelID",
            "dataType": "string",
            "sourceColumn": "OldListLevelID"
          },
          {
            "name": "DateOfClose",
            "dataType": "dateTime",
            "sourceColumn": "DateOfClose"
          },
          {
            "name": "ActualClassID",
            "dataType": "string",
            "sourceColumn": "ActualClassID"
          },
          {
            "name": "ActualClassCode",
            "dataType": "string",
            "sourceColumn": "ActualClassCode"
          },
          {
            "name": "ActualDateOfOpen",
            "dataType": "dateTime",
            "sourceColumn": "ActualDateOfOpen"
          },
          {
            "name": "ActualListLevelCode",
            "dataType": "string",
            "sourceColumn": "ActualListLevelCode"
          },
          {
            "name": "TotalOldStudent",
            "dataType": "int64",
            "sourceColumn": "TotalOldStudent"
          },
          {
            "name": "TGD",
            "dataType": "int64",
            "sourceColumn": "TGD"
          },
          {
            "name": "TGDTre",
            "dataType": "int64",
            "sourceColumn": "TGDTre"
          },
          {
            "name": "TNTGD",
            "dataType": "int64",
            "sourceColumn": "TNTGD"
          },
          {
            "name": "W_DELETE_FLG",
            "dataType": "string",
            "sourceColumn": "W_DELETE_FLG"
          },
          {
            "name": "W_INTEGRATION_ID",
            "dataType": "string",
            "sourceColumn": "W_INTEGRATION_ID"
          },
          {
            "name": "W_EFFECTIVE_FROM_DT",
            "dataType": "dateTime",
            "sourceColumn": "W_EFFECTIVE_FROM_DT"
          },
          {
            "name": "W_EFFECTIVE_TO_DT",
            "dataType": "dateTime",
            "sourceColumn": "W_EFFECTIVE_TO_DT"
          },
          {
            "name": "W_CURRENT_FLG",
            "dataType": "string",
            "sourceColumn": "W_CURRENT_FLG"
          },
          {
            "name": "W_INSERT_DT",
            "dataType": "dateTime",
            "sourceColumn": "W_INSERT_DT"
          },
          {
            "name": "W_UPDATE_DT",
            "dataType": "dateTime",
            "sourceColumn": "W_UPDATE_DT"
          },
          {
            "name": "W_DATASOURCE_NUM_ID",
            "dataType": "int64",
            "sourceColumn": "W_DATASOURCE_NUM_ID"
          },
          {
            "name": "W_BATCH_ID",
            "dataType": "int64",
            "sourceColumn": "W_BATCH_ID"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_ENDING_COURSE_2_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_ENDING_COURSE_2_F\"]}[Data]",
                "in",
                "    DWH_VW_ASA_ENDING_COURSE_2_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Ending Class 2",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Ending Class 2'[List Class Key]))",
            "formatString": "0"
          },
          {
            "name": "# of Ending Student Retention Budget 2",
            "expression": [
              "",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "    ,ALL('Calendar')",
              "    ,'ASA Budget'[Type]=\"% Retention\"",
              "    ,'ASA Budget'[SubType]=\"Ending Student\"",
              "    ,'Calendar'[Date]>=f_date",
              "    ,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Ending Students 2",
            "expression": "CALCULATE(SUM('ASA Ending Class 2'[TotalOldStudent]))",
            "formatString": "0"
          },
          {
            "name": "# of Pending Students re-Enrol 2",
            "expression": " CALCULATE(SUm('ASA Ending Class 2'[TNTGD]))",
            "formatString": "0"
          },
          {
            "name": "# of re-Enrol Student 2",
            "expression": " CALCULATE(SUM('ASA Ending Class 2'[TGD]))",
            "formatString": "0"
          },
          {
            "name": "# of Re-Enrol Student Retention Budget 2",
            "expression": [
              "",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "    ,ALL('Calendar')",
              "    ,'ASA Budget'[Type]=\"% Retention\"",
              "    ,'ASA Budget'[SubType]=\"Re-Enrol Student\"",
              "    ,'Calendar'[Date]>=f_date",
              "    ,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Student Retention Budget 2",
            "expression": [
              "",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA Budget'[Value])",
              "    ,ALL('Calendar')",
              "    ,'ASA Budget'[Type]=\"% Retention\"",
              "    ,'ASA Budget'[SubType]=\"Retention Student\"",
              "    ,'Calendar'[Date]>=f_date",
              "    ,'Calendar'[Date]<=t_date)"
            ],
            "formatString": "0"
          },
          {
            "name": "% Re-Enrolment rate Budget 2",
            "expression": [
              " DIVIDE('ASA Ending Class 2'[# of Re-Enrol Student Retention Budget 2],'ASA Ending Class 2'[# of Ending Student Retention Budget 2]",
              ",BLANK())"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Retention rate Budget 2",
            "expression": [
              " DIVIDE('ASA Ending Class 2'[# of Re-Enrol Student Retention Budget 2] + 'ASA Ending Class 2'[# of Student Retention Budget 2],'ASA Ending Class 2'[# of Ending Student Retention Budget 2]",
              ",BLANK())"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% of Re-Enrollment Rate 2",
            "expression": " DIVIDE('ASA Ending Class 2'[# of Ending Students re-Enrol 2],'ASA Ending Class 2'[# of Ending Students 2],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Re-Enrollment Rate Avg 2",
            "expression": " AVERAGEX('Calendar', 'ASA Ending Class 2'[% of Re-Enrollment Rate 2])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% of Retention Rate 2",
            "expression": " DIVIDE(('ASA Ending Class 2'[# of Ending Students re-Enrol 2]+'ASA Ending Class 2'[# of Pending Students re-Enrol 2]),'ASA Ending Class 2'[# of Ending Students 2],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Retention Rate Avg 2",
            "expression": " AVERAGEX('Calendar', 'ASA Ending Class 2'[% of Retention Rate 2])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Ending Students re-Enrol 2",
            "expression": "'ASA Ending Class 2'[# of Late re-enrollmentStudents re-Enrol 2] + 'ASA Ending Class 2'[# of re-Enrol Student 2]",
            "formatString": "0"
          },
          {
            "name": "# of Late re-enrollmentStudents re-Enrol 2",
            "expression": " CALCULATE(SUm('ASA Ending Class 2'[TGDTre]))",
            "formatString": "0"
          },
          {
            "name": "# of Late re-enrollmentStudents re-Enrol 2 LY",
            "expression": " CALCULATE(SUm('ASA Ending Class 2'[TGDTre]),SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of re-Enrol Student 2 LY",
            "expression": " CALCULATE(SUM('ASA Ending Class 2'[TGD]),SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Ending Students 2 LY",
            "expression": "CALCULATE(SUM('ASA Ending Class 2'[TotalOldStudent]),SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of Re-Enrollment Rate 2 LY",
            "expression": " DIVIDE('ASA Ending Class 2'[# of Ending Students re-Enrol 2 LY],'ASA Ending Class 2'[# of Ending Students 2 LY],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Ending Students re-Enrol 2 LY",
            "expression": "'ASA Ending Class 2'[# of Late re-enrollmentStudents re-Enrol 2 LY] + 'ASA Ending Class 2'[# of re-Enrol Student 2 LY]"
          },
          {
            "name": "# of Pending Students re-Enrol 2 LY",
            "expression": " CALCULATE(SUm('ASA Ending Class 2'[TNTGD]),SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% of Retention Rate 2 LY",
            "expression": " DIVIDE(('ASA Ending Class 2'[# of Ending Students re-Enrol 2 LY]+'ASA Ending Class 2'[# of Pending Students re-Enrol 2 LY]),'ASA Ending Class 2'[# of Ending Students 2 LY],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          }
        ]
      },
