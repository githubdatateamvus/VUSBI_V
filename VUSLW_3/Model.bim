          },
          {
            "type": "calculated",
            "name": "CareMonth",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT('ASA List QC Care Detail'[CareDate],\"yymm\")"
          },
          {
            "type": "calculated",
            "name": "QC_CareName",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "RIGHT('ASA List QC Care Detail'[QCCareName],LEN('ASA List QC Care Detail'[QCCareName])-29)"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_LISTQCCARE_DETAIL = Source{[Schema=\"DWH\",Item=\"VW_ASA_LISTQCCARE_DETAIL\"]}[Data]",
                "in",
                "    DWH_VW_ASA_LISTQCCARE_DETAIL"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of QCCare Diem_TC_Max",
            "expression": [
              "MAXX(",
              "\t\t      {",
              "\t\t      [# of QCCare DTC1],",
              "\t\t      [# of QCCare DTC2],",
              "\t\t      [# of QCCare DTC3],",
              "\t\t      [# of QCCare DTC4],",
              "\t\t      [# of QCCare DTC5],",
              "\t\t      [# of QCCare DTC6]",
              "\t\t      },",
              "\t\t      [Value]",
              "\t\t      )"
            ]
          },
          {
            "name": "# of QCCare DTC1",
            "expression": "SUM('ASA List QC Care Detail'[TC1])"
          },
          {
            "name": "# of QCCare DTC2",
            "expression": "SUM('ASA List QC Care Detail'[TC2])"
          },
          {
            "name": "# of QCCare DTC3",
            "expression": "SUM('ASA List QC Care Detail'[TC3])"
          },
          {
            "name": "# of QCCare DTC4",
            "expression": "SUM('ASA List QC Care Detail'[TC4])"
          },
          {
            "name": "# of QCCare DTC5",
            "expression": "SUM('ASA List QC Care Detail'[TC5])"
          },
          {
            "name": "# of QCCare DTC6",
            "expression": "SUM('ASA List QC Care Detail'[TC6])"
          },
          {
            "name": "% of QCCare TC1vsMax",
            "expression": "[# of QCCare DTC1]/[# of QCCare Diem_TC_Max]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare TC3vsMax",
            "expression": "[# of QCCare DTC3]/[# of QCCare Diem_TC_Max]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare TC4vsMax",
            "expression": "[# of QCCare DTC4]/[# of QCCare Diem_TC_Max]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare TC5vsMax",
            "expression": "[# of QCCare DTC5]/[# of QCCare Diem_TC_Max]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare TC6vsMax",
            "expression": "[# of QCCare DTC6]/[# of QCCare Diem_TC_Max]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare DTC1",
            "expression": "[# of QCCare DTC1]/COUNT('ASA List QC Care Detail'[Branch_ID])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare DTC2",
            "expression": "[# of QCCare DTC2]/COUNT('ASA List QC Care Detail'[Branch_ID])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare DTC3",
            "expression": "[# of QCCare DTC3]/COUNT('ASA List QC Care Detail'[Branch_ID])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare DTC4",
            "expression": "[# of QCCare DTC4]/COUNT('ASA List QC Care Detail'[Branch_ID])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare DTC5",
            "expression": "[# of QCCare DTC5]/COUNT('ASA List QC Care Detail'[Branch_ID])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare DTC6",
            "expression": "[# of QCCare DTC6]/COUNT('ASA List QC Care Detail'[Branch_ID])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare DTCAll",
            "expression": "SUM('ASA List QC Care Detail'[Rate])/(COUNT('ASA List QC Care Detail'[Branch_ID])*6)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of QCCare TC2vsMax",
            "expression": "[# of QCCare DTC2]/[# of QCCare Diem_TC_Max]",
            "formatString": "0%;-0%;0%"
          }
        ]
      },
      {
        "name": "TQM ReEnrolment",
        "columns": [
          {
            "name": "Date Key",
