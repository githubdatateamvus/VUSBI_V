              ")",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Full Year Actual Expense",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Actual Expense],",
              "    ALLEXCEPT('Calendar','Calendar'[Year])",
              ")",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Full Year Budget Remaining",
            "expression": [
              "[# of Full Year Budget (Active Student)]- [# of Full Year Actual Expense]",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% of Full Year Actual Expense",
            "expression": " DIVIDE([# of Full Year Actual Expense],[# of Full Year Budget (Active Student)],0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% of YTD Actual Expense",
            "expression": [
              "",
              "DIVIDE(",
              "    'Budget Management'[# of YTD Actual Expense],",
              "    'Budget Management'[# of YTD Budget (Active student)],",
              "    0",
              ")",
              "",
              ""
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Actual ActiveStudent Fin",
            "expression": [
              "",
              "\tSUMX(",
              "\t        SUMMARIZE(",
              "\t            'Budget Management',",
              "\t            'Budget Management'[CampusCode],",
              "\t            'Budget Management'[MonthYear],",
              "\t            \"Students\", MAX('Budget Management'[Actual ActiveStudent])",
              "\t        ),",
              "\t        [Students]",
              "\t    )"
            ]
          },
          {
            "name": "# of Actual Expense (Non-Lương)",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Budget Management'[Actual Expense]),",
              "    NOT CONTAINSSTRING(",
              "        'Budget Management'[GroupItem],",
              "        \"lương\"",
              "    )",
              ")",
              "",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% of Actual Expense (Non-Lương)",
            "expression": [
              "",
              "DIVIDE(",
              "    'Budget Management'[# of Actual Expense (Non-Lương)],",
              "    [# of Budget (Active student)],",
              "    0",
              ")",
              "",
              ""
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
