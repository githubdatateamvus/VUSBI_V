            "isDataTypeInferred": true,
            "expression": "IF(NOT(ISBLANK('ASA Offtrack Compare Score SK'[Final written 2.Vocabulary])) && NOT(ISBLANK('ASA Offtrack Compare Score SK'[Final written 2.Vocabulary Previous])),'ASA Offtrack Compare Score SK'[Final written 2.Vocabulary] - 'ASA Offtrack Compare Score SK'[Final written 2.Vocabulary Previous])"
          },
          {
            "type": "calculated",
            "name": "Diff Reading",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "IF(NOT(ISBLANK('ASA Offtrack Compare Score SK'[Final written 4.Reading])) && NOT(ISBLANK('ASA Offtrack Compare Score SK'[Final written 4.Reading Previous])),'ASA Offtrack Compare Score SK'[Final written 4.Reading] - 'ASA Offtrack Compare Score SK'[Final written 4.Reading Previous])"
          },
