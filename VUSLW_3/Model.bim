          },
          {
            "name": "UTM_MEDIUMS",
            "dataType": "string",
            "sourceColumn": "UTM_MEDIUMS"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_W_CORE_EDU_LEAD_DUP_F = Source{[Schema=\"DWH\",Item=\"VW_CORE_EDU_LEAD_DUP_F\"]}[Data]",
                "in",
                "    DWH_W_CORE_EDU_LEAD_DUP_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Call Dup Lead",
            "expression": "CALCULATE(SUM('Dup Lead Mkt'[IS_CALL]))"
          },
          {
            "name": "# of Show Dup Lead",
            "expression": "CALCULATE(SUm('Dup Lead Mkt'[IS_SHOW]))"
          },
          {
            "name": "# of Sign Dup Lead",
            "expression": "CALCULATE(SUm('Dup Lead Mkt'[IS_SIGN]))"
          },
          {
            "name": "# of Dup Lead By Phone",
            "expression": "CALCULATE(DISTINCTCOUNT('Dup Lead Mkt'[LEAD_KEY]),FILTER('Dup Lead Mkt','Dup Lead Mkt'[DUP_BY_PHONE]=1))"
          },
          {
            "name": "% Lead To Dup Lead By Phone",
            "expression": " DIVIDE('Dup Lead Mkt'[# of Dup Lead By Phone],'Dup Lead Mkt'[# of All Lead],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of All Lead",
            "expression": "CALCULATE(DISTINCTCOUNT('Dup Lead Mkt'[LEAD_KEY]))"
          },
          {
            "name": "# of Dup Lead  Group 1",
            "expression": "CALCULATE(DISTINCTCOUNT('Dup Lead Mkt'[LEAD_KEY]),FILTER('Dup Lead Mkt','Dup Lead Mkt'[DUP_BY_STATUS]=1))"
          },
          {
            "name": "% Lead To Dup Lead Group 1",
            "expression": " DIVIDE('Dup Lead Mkt'[# of Dup Lead  Group 1],'Dup Lead Mkt'[# of All Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Dup Lead  Group 2",
            "expression": "CALCULATE(DISTINCTCOUNT('Dup Lead Mkt'[LEAD_KEY]),FILTER('Dup Lead Mkt','Dup Lead Mkt'[DUP_BY_STATUS]=2))"
          },
          {
            "name": "% Lead To Dup Lead Group 2",
            "expression": " DIVIDE('Dup Lead Mkt'[# of Dup Lead  Group 2],'Dup Lead Mkt'[# of All Lead],BLANK())",
            "formatString": "0%;-0%;0%"
          }
        ]
      },
