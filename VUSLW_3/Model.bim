      {
        "name": "Teacher Assignment",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "int64",
            "sourceColumn": "Date Key"
          },
          {
            "name": "Teacher Key",
            "dataType": "string",
            "sourceColumn": "Teacher Key"
          },
          {
            "name": "Teacher Profile ID",
            "dataType": "string",
            "sourceColumn": "Teacher Profile ID"
          },
          {
            "name": "Start Date",
            "dataType": "dateTime",
            "sourceColumn": "Start Date"
          },
          {
            "name": "End Date",
            "dataType": "dateTime",
            "sourceColumn": "End Date"
          },
          {
            "name": "Position Name",
            "dataType": "string",
            "sourceColumn": "Position Name"
          },
          {
            "name": "Teacher Type",
            "dataType": "string",
            "sourceColumn": "Teacher Type"
          },
          {
            "name": "Full Time Flag",
            "dataType": "string",
            "sourceColumn": "Full Time Flag"
          },
          {
            "name": "FulltimeTypeCode",
            "dataType": "string",
            "sourceColumn": "FulltimeTypeCode"
          },
          {
            "name": "FulltimeTypeName",
            "dataType": "string",
            "sourceColumn": "FulltimeTypeName"
          },
          {
            "name": "TeacherContractType",
            "dataType": "string",
            "sourceColumn": "TeacherContractType"
          },
          {
            "name": "TeacherCode",
            "dataType": "string",
            "sourceColumn": "TeacherCode"
          },
          {
            "name": "IsVUS",
            "dataType": "boolean",
            "sourceColumn": "IsVUS"
          },
          {
            "name": "Main Campus Key",
            "dataType": "string",
            "sourceColumn": "Main Campus Key"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date"
          },
          {
            "name": "TeacherProfileIdTQM",
            "dataType": "string",
            "sourceColumn": "TeacherProfileIdTQM"
          },
          {
            "name": "TeacherName",
            "dataType": "string",
            "sourceColumn": "TeacherName"
          },
          {
            "name": "Main Campus Code",
            "dataType": "string",
            "sourceColumn": "Main Campus Code"
          },
          {
            "name": "Contract_StartDateActual",
            "dataType": "dateTime",
            "sourceColumn": "Contract_StartDateActual"
          },
          {
            "name": "Contract_EndDateActual",
            "dataType": "dateTime",
            "sourceColumn": "Contract_EndDateActual"
          },
          {
            "name": "SOURCE",
            "dataType": "string",
            "sourceColumn": "SOURCE"
          },
          {
            "name": "Salary Month Year",
            "dataType": "string",
            "sourceColumn": "Salary Month Year"
          },
          {
            "name": "ContractNo",
            "dataType": "string",
            "sourceColumn": "ContractNo"
          },
          {
            "name": "ContractType",
            "dataType": "string",
            "sourceColumn": "ContractType"
          },
          {
            "name": "PersonnelActionType",
            "dataType": "string",
            "sourceColumn": "PersonnelActionType"
          },
          {
            "name": "StatusAction",
            "dataType": "string",
            "sourceColumn": "StatusAction"
          },
          {
            "name": "ContractCategory",
            "dataType": "string",
            "sourceColumn": "ContractCategory"
          },
          {
            "name": "NumofSession",
            "dataType": "int64",
            "sourceColumn": "NumofSession"
          },
          {
            "name": "IsActive",
            "dataType": "int64",
            "sourceColumn": "IsActive"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TEACHER_ASSIGNMENT_FULL_F = Source{[Schema=\"DWH\",Item=\"VW_TEACHER_ASSIGNMENT_FULL_F\"]}[Data]",
                "in",
                "    DWH_VW_TEACHER_ASSIGNMENT_FULL_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of hrt assign",
            "expression": "COALESCE(CALCULATE(DISTINCTCOUNT('Teacher Assignment'[Teacher Key]),'Teacher Assignment'[IsActive]=1),0)"
          },
          {
            "name": "# of hrt teacher assign",
            "expression": "COALESCE(CALCULATE('Teacher Assignment'[# of hrt assign],'Teacher Assignment'[Teacher Type] IN {\"NN\" ,\"VN\"} ),0)"
          },
          {
            "name": "# of hrt ta assign",
            "expression": "COALESCE(CALCULATE('Teacher Assignment'[# of hrt assign],'Teacher Assignment'[Teacher Type] = \"TA\"),0)"
          },
          {
            "name": "# of hrt teacher vn assign",
            "expression": "COALESCE(CALCULATE('Teacher Assignment'[# of hrt assign],'Teacher Assignment'[Teacher Type] = \"VN\"),0)"
          },
          {
            "name": "# of hrt teacher nn assign",
            "expression": "COALESCE(CALCULATE('Teacher Assignment'[# of hrt assign],'Teacher Assignment'[Teacher Type] = \"NN\"),0)"
          },
          {
            "name": "# of hrt teacher vn assign parttime",
            "expression": "COALESCE(CALCULATE('Teacher Assignment'[# of hrt assign],'Teacher Assignment'[Teacher Type] = \"VN\" && 'Teacher Assignment'[TeacherContractType]=\"Part Time\"),0)"
          },
          {
            "name": "# of hrt teacher vn assign fulltime",
            "expression": "COALESCE(CALCULATE('Teacher Assignment'[# of hrt assign],'Teacher Assignment'[Teacher Type] = \"VN\" && 'Teacher Assignment'[TeacherContractType]=\"Full Time\"),0)"
          },
          {
            "name": "# of hrt teacher nn assign partime",
            "expression": "COALESCE(CALCULATE('Teacher Assignment'[# of hrt assign],'Teacher Assignment'[Teacher Type] = \"NN\" && 'Teacher Assignment'[TeacherContractType]=\"Part Time\"),0)"
          },
          {
            "name": "# of hrt teacher nn assign fulltime",
            "expression": "COALESCE(CALCULATE('Teacher Assignment'[# of hrt assign],'Teacher Assignment'[Teacher Type] = \"NN\" && 'Teacher Assignment'[TeacherContractType]=\"Full Time\"),0)"
          },
          {
            "name": "# Avg Seniority",
            "expression": "COALESCE( 'Teaching Hours Average'[# Seniority]/'Teacher Assignment'[# of hrt teacher assign],0.0)",
            "formatString": "0.00"
          },
          {
            "name": "# Avg EX Seniority",
            "expression": "COALESCE( 'Teaching Hours Average'[# of Seniority Teacher EX]/'Teacher Assignment'[# of hrt teacher nn assign],0.0)",
            "formatString": "0.00"
          },
          {
            "name": "# Avg VN Seniority",
            "expression": " COALESCE('Teaching Hours Average'[# of Seniority Teacher VN]/'Teacher Assignment'[# of hrt teacher vn assign],0.0)",
            "formatString": "0.00"
          },
          {
            "name": "% EX FT / Total EX",
            "expression": "DIVIDE('Teacher Assignment'[# of hrt teacher nn assign fulltime] ,'Teacher Assignment'[# of hrt teacher nn assign],0.0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% VN FT / Total VN",
            "expression": "DIVIDE('Teacher Assignment'[# of hrt teacher vn assign fulltime],'Teacher Assignment'[# of hrt teacher vn assign],0.0)"
          },
          {
            "name": "# of hrt teacher nn philipin assign",
            "expression": [
              "",
              "COALESCE(CALCULATE(",
              "    'Teacher Assignment'[# of hrt assign],",
              "    'Teacher Assignment'[Teacher Type] = \"NN\",",
              "    'Teacher'[Nationalities] = \"Philippine\"",
              "),0)"
            ]
          },
          {
            "name": "% EX Philipin FT / Total EX",
            "expression": "DIVIDE('Teacher Assignment'[# of hrt teacher nn philipin assign] , 'Teacher Assignment'[# of hrt teacher nn assign],0.0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of hrt teacher nn nonnative assign",
            "expression": [
              "",
              "COALESCE(CALCULATE(",
              "    'Teacher Assignment'[# of hrt assign],",
              "    'Teacher Assignment'[Teacher Type] = \"NN\",",
              "    FILTER(",
              "        'Teacher',",
              "        NOT 'Teacher'[Nationalities] IN {",
              "            \"AMERICAN\",",
              "            \"AUSTRALIAN\",",
              "            \"BRITISH\",",
              "            \"CANADIAN\",",
              "            \"IRISH\",",
              "            \"SOUTH AFRICAN\"",
              "        }",
              "    )",
              "),0)"
            ]
          },
          {
            "name": "% EX Nonnative FT / Total EX",
            "expression": "DIVIDE('Teacher Assignment'[# of hrt teacher nn nonnative assign] , 'Teacher Assignment'[# of hrt teacher nn assign],0.0)",
            "formatString": "0%;-0%;0%"
          }
        ]
      },
