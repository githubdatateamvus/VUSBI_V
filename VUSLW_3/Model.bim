          },
          {
            "name": "End Time",
            "dataType": "dateTime",
            "sourceColumn": "End Time"
          },
          {
            "name": "Group Time",
            "dataType": "string",
            "sourceColumn": "Group Time"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TEACHER_SHARE_REQUEST_F = Source{[Schema=\"DWH\",Item=\"VW_TEACHER_SHARE_REQUEST_F\"]}[Data]",
                "in",
                "    DWH_VW_TEACHER_SHARE_REQUEST_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Class Borrow",
            "expression": "CALCULATE(DISTINCTCOUNT('Teacher Substitution Request'[Class Key]))"
          },
          {
            "name": "# of  Teacher Borrow",
            "expression": [
              "CALCULATE(DISTINCTCOUNT('Teacher Substitution Request'[Teacher Key])",
              ",FILTER('Teacher Substitution Request','Teacher Substitution Request'[Transaction Type]=\"Borrow\")",
              ",FILTER('Teacher Substitution Request','Teacher Substitution Request'[Teacher Type] IN {\"EX\",\"VN\"})",
              ")"
            ]
          },
          {
            "name": "% Teacher Borrow Vs Teacher Active Campus",
            "expression": "DIVIDE('Teacher Substitution Request'[# of  Teacher Borrow],'Teacher Assignment'[# of hrt teacher assign],0.0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of  Teacher Share",
            "expression": [
              "CALCULATE(DISTINCTCOUNT('Teacher Substitution Request'[Teacher Key])",
              ",FILTER('Teacher Substitution Request','Teacher Substitution Request'[Transaction Type]=\"Share\")",
              ",FILTER('Teacher Substitution Request','Teacher Substitution Request'[Teacher Type] IN {\"EX\",\"VN\"})",
              ") "
            ]
          },
          {
            "name": "% Teacher Share Vs Teacher Active Campus",
            "expression": "DIVIDE('Teacher Substitution Request'[# of  Teacher Share],'Teacher Assignment'[# of hrt teacher assign],0.0)",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# Avg Latency Day",
            "expression": " CALCULATE(AVERAGE('Teacher Substitution Request'[Latency Day]))",
            "formatString": "0.00"
          }
        ]
      },
      {
        "name": "Student Survey",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "string",
            "sourceColumn": "Date Key"
          },
          {
            "name": "id",
            "dataType": "string",
            "sourceColumn": "id"
          },
          {
            "name": "List Class Key",
            "dataType": "string",
            "sourceColumn": "List Class Key"
          },
          {
            "name": "Teacher Key",
            "dataType": "string",
            "sourceColumn": "Teacher Key"
          },
          {
            "name": "Campus Key",
            "dataType": "string",
            "sourceColumn": "Campus Key"
          },
          {
            "name": "survey_type",
            "dataType": "string",
            "sourceColumn": "survey_type"
          },
          {
            "name": "List Class Code",
            "dataType": "string",
            "sourceColumn": "List Class Code"
          },
          {
            "name": "Lesson No",
            "dataType": "string",
            "sourceColumn": "Lesson No"
          },
          {
            "name": "Plan Survey Date",
            "dataType": "dateTime",
            "sourceColumn": "Plan Survey Date"
          },
          {
            "name": "Survey Date",
            "dataType": "dateTime",
            "sourceColumn": "Survey Date"
          },
          {
            "name": "Create Date",
            "dataType": "dateTime",
            "sourceColumn": "Create Date"
          },
          {
            "name": "Create User Id",
            "dataType": "string",
            "sourceColumn": "Create User Id"
          },
          {
            "name": "State",
            "dataType": "string",
            "sourceColumn": "State"
          },
          {
            "name": "Start Date",
            "dataType": "dateTime",
            "sourceColumn": "Start Date"
          },
          {
            "name": "Start User",
            "dataType": "string",
            "sourceColumn": "Start User"
          },
          {
            "name": "Modify Date",
            "dataType": "dateTime",
            "sourceColumn": "Modify Date"
          },
          {
            "name": "Modify User Id",
            "dataType": "string",
            "sourceColumn": "Modify User Id"
          },
          {
            "name": "Survey Id",
            "dataType": "string",
            "sourceColumn": "Survey Id"
          },
          {
            "name": "Teacher Id",
            "dataType": "string",
            "sourceColumn": "Teacher Id"
          },
          {
            "name": "Submit Id",
            "dataType": "string",
            "sourceColumn": "Submit Id"
          },
          {
            "name": "Submit Date",
            "dataType": "dateTime",
            "sourceColumn": "Submit Date"
          },
          {
            "name": "Client Id",
            "dataType": "string",
            "sourceColumn": "Client Id"
          },
          {
            "name": "Question Id",
            "dataType": "string",
            "sourceColumn": "Question Id"
          },
          {
            "name": "Answer",
            "dataType": "string",
            "sourceColumn": "Answer"
          },
          {
            "type": "calculated",
            "name": "Score Value",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "CONVERT(IF('Student Survey'[Answer]=BLANK(),0.0,'Student Survey'[Answer]),DOUBLE)",
            "formatString": "0.00"
          },
          {
            "name": "List Level Key",
            "dataType": "string",
            "sourceColumn": "List Level Key"
          },
          {
            "type": "calculated",
            "name": "TotalScoreSv",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              "",
              "CALCULATE(",
              "    SUM( 'Student Survey'[Score Value]        ",
              "                ) ,ALLEXCEPT( 'Student Survey', 'Student Survey'[Survey Id],'Student Survey'[Teacher Id],'Student Survey'[Client Id] , 'Student Survey'[Submit Id] ),'Student Survey'[Question Id] <>\"6\"",
              ")"
            ],
            "formatString": "0.0"
          },
          {
            "type": "calculated",
            "name": "NameQuestion",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "CONCATENATE(\"Q.\",'Student Survey'[Question Id])"
          },
          {
            "name": "TotalStudentByPlannedAttendance",
            "dataType": "int64",
            "sourceColumn": "TotalStudentByPlannedAttendance"
          },
          {
            "name": "TotalStudentByActualAttendance",
            "dataType": "int64",
            "sourceColumn": "TotalStudentByActualAttendance"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_STUDENT_SURVEY_F = Source{[Schema=\"DWH\",Item=\"VW_STUDENT_SURVEY_F\"]}[Data]",
                "in",
                "    DWH_VW_STUDENT_SURVEY_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# Total Respon",
            "expression": "COALESCE (CALCULATE(DISTINCTCOUNT('Student Survey'[Submit Id])),0)",
            "formatString": "0"
          },
          {
            "name": "# Total Score",
            "expression": "'Student Survey'[# Avg Score Question 1] + 'Student Survey'[# Avg Score Question 2] +'Student Survey'[# Avg Score Question 3] + 'Student Survey'[# Avg Score Question 4] +'Student Survey'[# Avg Score Question 5]",
            "formatString": "0.0"
          },
          {
            "name": "# Avg Score",
            "expression": " COALESCE (CALCULATE(AVERAGE('Student Survey'[Score Value]),FILTER('Student Survey','Student Survey'[Question Id]<>\"6\")),0)",
            "formatString": "0.0"
          },
          {
            "name": "# Total Respon By Question 1",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Total Respon],FILTER('Student Survey','Student Survey'[Question Id]=\"1\")),0)",
            "formatString": "0"
          },
          {
            "name": "# Total Respon By Question 2",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Total Respon],FILTER('Student Survey','Student Survey'[Question Id]=\"2\")),0)",
            "formatString": "0"
          },
          {
            "name": "# Total Respon By Question 3",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Total Respon],FILTER('Student Survey','Student Survey'[Question Id]=\"3\")),0)",
            "formatString": "0"
          },
          {
            "name": "# Total Respon By Question 4",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Total Respon],FILTER('Student Survey','Student Survey'[Question Id]=\"4\")),0)",
            "formatString": "0"
          },
          {
            "name": "# Total Respon By Question 5",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Total Respon],FILTER('Student Survey','Student Survey'[Question Id]=\"5\")),0)",
            "formatString": "0"
          },
          {
            "name": "# Avg Score Question 1",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Avg Score],FILTER('Student Survey','Student Survey'[Question Id]=\"1\")),0)",
            "formatString": "0.0"
          },
          {
            "name": "# Avg Score Question 2",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Avg Score],FILTER('Student Survey','Student Survey'[Question Id]=\"2\")),0.0)",
            "formatString": "0.0"
          },
          {
            "name": "# Avg Score Question 3",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Avg Score],FILTER('Student Survey','Student Survey'[Question Id]=\"3\")),0.0)",
            "formatString": "0.0"
          },
          {
            "name": "# Avg Score Question 4",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Avg Score],FILTER('Student Survey','Student Survey'[Question Id]=\"4\")),0.0)",
            "formatString": "0.0"
          },
          {
            "name": "# Avg Score Question 5",
            "expression": "COALESCE (CALCULATE('Student Survey'[# Avg Score],FILTER('Student Survey','Student Survey'[Question Id]=\"5\")),0.0)",
            "formatString": "0.0"
          },
          {
            "name": "# Total Devices",
            "expression": "COALESCE (CALCULATE(DISTINCTCOUNT('Student Survey'[Client Id])),0)",
            "formatString": "0"
          },
          {
            "name": "# Total Survey",
            "expression": "COALESCE (CALCULATE(DISTINCTCOUNT('Student Survey'[Survey Id])),0)",
            "formatString": "0"
          },
          {
            "name": "# Total Class",
            "expression": "COALESCE (CALCULATE(DISTINCTCOUNT('Student Survey'[List Class Code])),0)",
            "formatString": "0"
          },
          {
            "name": "# Total Class No Respon",
            "expression": [
              "",
              " COALESCE (CALCULATE('Student Survey'[# Total Class],FILTER('Student Survey','Student Survey'[Submit Id]=\"\")),0)",
              ""
            ]
          },
          {
            "name": "# Total Respon/Devices",
            "expression": "DIVIDE('Student Survey'[# Total Respon],'Student Survey'[# Total Devices],0.0)",
            "formatString": "0.0"
          },
          {
            "name": "# Total Class No Student",
            "expression": "COALESCE (CALCULATE(DISTINCTCOUNT('Student Survey'[List Class Code]),FILTER('Student Survey','Student Survey'[# Total Student By Actual Attendance]=0)),0)",
            "formatString": "0"
          },
          {
            "name": "# Potential Outliers",
            "expression": [
              "VAR Classes =",
              "\t\t\tFILTER(",
              "\t\t\t\tVALUES('Student Survey'[List Class Key]),",
              "\t\t\t\t[# Total Respon/Devices] > 1",
              "\t\t\t)",
              "\t\tRETURN",
              "\t\tCOALESCE (COUNTROWS(Classes),0)"
            ],
            "formatString": "0"
          },
          {
            "name": "# Avg Score Question 6",
            "expression": [
              "COALESCE (CALCULATE(AVERAGE('Student Survey'[Score Value])",
              ",FILTER('Student Survey','Student Survey'[Question Id]=\"6\")",
              "),0.0)"
            ]
          },
          {
            "name": "# Total Respon By Question 6",
            "expression": [
              "COALESCE (CALCULATE('Student Survey'[# Total Respon]",
              ",FILTER('Student Survey','Student Survey'[Question Id]=\"6\")",
              ",FILTER('Student Survey','Student Survey'[survey_type]=\"End-of-course survey\")",
              "),0)"
            ]
          },
          {
            "name": "# Total Survey End Of Course Survey",
            "expression": [
              "COALESCE (CALCULATE(DISTINCTCOUNT('Student Survey'[Survey Id])",
              ",FILTER('Student Survey','Student Survey'[survey_type]=\"End-of-course survey\")",
              "),0)"
            ]
          },
          {
            "name": "# ScoreGroupByTeacher",
            "expression": [
              "",
              "VAR SelectedRank = SELECTEDVALUE('Teacher Rank Survey'[Rank])",
              " RETURN ",
              " CALCULATE(",
              "                                         DISTINCTCOUNT('Student Survey'[Teacher Key]),",
              "               FILTER(",
              "\t\t\t        VALUES('Student Survey'[Teacher Key]),",
              "\t\t\t         SWITCH(",
              "\t\t\t\t TRUE(),",
              "\t\t\t\t  'Student Survey'[# Total Score]>= 1 &&  'Student Survey'[# Total Score]<= 10, \"Bad (1-10)\",",
              "\t\t\t\t  'Student Survey'[# Total Score]>= 11 &&  'Student Survey'[# Total Score]<= 14, \"OK (11-14)\",",
              "\t\t\t\t  'Student Survey'[# Total Score]>= 15 &&  'Student Survey'[# Total Score]<= 20, \"Good (15-20)\",",
              "\t\t\t\t BLANK()",
              "\t\t\t\t)=SelectedRank",
              "\t\t        )",
              "      ",
              "                                          ",
              ")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "# ScoreGroupBySurvey",
            "expression": [
              "",
              "VAR SelectedRank = SELECTEDVALUE('Teacher Rank Survey'[Rank])",
              " RETURN ",
              " CALCULATE(",
              "                                         DISTINCTCOUNT('Student Survey'[Survey Id]),",
              "               FILTER(",
              "\t\t\t        VALUES('Student Survey'[Survey Id]),",
              "\t\t\t         SWITCH(",
              "\t\t\t\t TRUE(),",
              "\t\t\t\t  'Student Survey'[# Total Score]>= 1 &&  'Student Survey'[# Total Score]<= 10, \"Bad (1-10)\",",
              "\t\t\t\t  'Student Survey'[# Total Score]>= 11 &&  'Student Survey'[# Total Score]<= 14, \"OK (11-14)\",",
              "\t\t\t\t  'Student Survey'[# Total Score]>= 15 &&  'Student Survey'[# Total Score]<= 20, \"Good (15-20)\",",
              "\t\t\t\t BLANK()",
              "\t\t\t\t)=SelectedRank",
              "\t\t        )",
              "      ",
              "                                          ",
              ")",
              ""
            ]
          },
          {
            "name": "# Total Student By Planned Attendance",
            "expression": [
              "COALESCE (",
              "SUMX(",
              "    VALUES('Student Survey'[List Class Key]),",
              "    CALCULATE( AVERAGE('Student Survey'[TotalStudentByPlannedAttendance]) )",
              "),0)"
            ],
            "formatString": "0"
          },
          {
            "name": "# Respon Rate By Planned Attendance",
            "expression": "DIVIDE('Student Survey'[# Total Respon],'Student Survey'[# Total Student By Planned Attendance],0)",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# Total Student By Actual Attendance",
            "expression": [
              "COALESCE (",
              "SUMX(",
              "    VALUES('Student Survey'[List Class Key]),",
              "    CALCULATE( AVERAGE('Student Survey'[TotalStudentByActualAttendance]) )",
              "),0)"
            ],
            "formatString": "0"
          },
          {
            "name": "# Respon Rate By Actual  Attendance",
            "expression": "DIVIDE('Student Survey'[# Total Respon],'Student Survey'[# Total Student By Actual Attendance],0)",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# RankingGroup6",
            "expression": [
              "",
              "VAR SelectedRank = SELECTEDVALUE('Ranking Question 6'[Rank6])",
              " RETURN ",
              " CALCULATE(",
              "                                         DISTINCTCOUNT('Student Survey'[Submit Id]),",
              "               FILTER(",
              "\t\t\t        VALUES('Student Survey'[Submit Id]),",
              "\t\t\t         SWITCH(",
              "\t\t\t\t TRUE(),",
              "\t\t\t\t  'Student Survey'[# Avg Score Question 6]=1,\"1 Not Excited\",",
              "\t\t\t\t  'Student Survey'[# Avg Score Question 6]=2, \"2\",",
              "\t\t\t                  'Student Survey'[# Avg Score Question 6]=3, \"3\",",
              "                                                                  'Student Survey'[# Avg Score Question 6]=4, \"4 Very Excited\",",
              "",
              "\t\t\t\t BLANK()",
              "\t\t\t\t)=SelectedRank",
              "\t\t        )",
              "      ",
              "                                          ",
              ")",
              ""
            ]
          },
          {
            "name": "1-Submit Score",
            "expression": [
              "",
              "VAR CleanRows =",
              "    SUMMARIZE(",
              "        'Student Survey',",
              "        'Student Survey'[Submit Id],",
              "        'Student Survey'[Question Id],",
              "        \"Score\", MAX('Student Survey'[Score Value])",
              "    )",
              "RETURN",
              "SUMX(CleanRows, [Score])",
              "",
              ""
            ],
            "formatString": "0.00"
          },
          {
            "name": "1-Avg Submit Score",
            "expression": [
              "",
              "AVERAGEX(",
              "    VALUES('Student Survey'[Submit Id]),",
              "    CALCULATE( [1-Submit Score] )",
              ")",
              "",
              ""
            ],
            "formatString": "0.00"
          },
          {
            "name": "1- Survey Category",
            "expression": [
              "",
              "VAR s = [1-Avg Submit Score]",
              "RETURN",
              "    SWITCH(",
              "        TRUE(),",
              "        s <= 10, \"BAD\",",
              "        s <= 14, \"OK\",",
              "        s <= 20, \"GOOD\"",
              "    )",
              "",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "1-Count BAD",
            "expression": [
              "",
              "VAR Pairs =",
              "    SUMMARIZE(",
              "        'Student Survey',",
              "        'Student Survey'[Teacher Id],",
              "        'Student Survey'[Survey Id]",
              "    )",
              "RETURN",
              "COUNTROWS(",
              "    FILTER(",
              "        Pairs,",
              "        [1- Survey Category] = \"BAD\"",
              "    )",
              ")",
              "",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "1-Count OK",
            "expression": [
              "",
              "VAR Pairs =",
              "         SUMMARIZE(",
              "        'Student Survey',",
              "        'Student Survey'[Teacher Id],",
              "        'Student Survey'[Survey Id]",
              "    )",
              "RETURN",
              "COUNTROWS(",
              "    FILTER(",
              "        Pairs,",
              "        [1- Survey Category] = \"OK\"",
              "    )",
              ")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "1-Count GOOD",
            "expression": [
              "",
              "VAR Pairs =",
              "         SUMMARIZE(",
              "        'Student Survey',",
              "        'Student Survey'[Teacher Id],",
              "        'Student Survey'[Survey Id]",
              "    )",
              "RETURN",
              "COUNTROWS(",
              "    FILTER(",
              "        Pairs,",
              "        [1- Survey Category] = \"GOOD\"",
              "    )",
              ")",
              "",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "1-Survey Count by Category",
            "expression": [
              "",
              "VAR category = SELECTEDVALUE( 'Teacher Rank Table'[Rank] )",
              "RETURN",
              "SWITCH (",
              "    category,",
              "    \"BAD\", [1-Count BAD],",
              "    \"OK\",  [1-Count OK],",
              "    \"GOOD\",[1-Count GOOD]",
              ")",
              ""
            ]
          },
          {
            "name": "BAD-GOOD-OK",
            "expression": " 'Student Survey'[1-Count BAD] +'Student Survey'[1-Count OK] +'Student Survey'[1-Count GOOD]",
            "formatString": "0"
          },
          {
            "name": "# Total Responses TeacherID_ClassCode",
            "expression": [
              "",
              "SUMX(",
              "    SUMMARIZE(",
              "        'Student Survey',",
              "        'Student Survey'[Teacher id],",
              "        'Student Survey'[List Class Code],",
              "        \"DistinctSubmitCount\", DISTINCTCOUNT('Student Survey'[Submit Id])",
              "    ),",
              "    [DistinctSubmitCount]",
              ")"
            ]
          },
          {
            "name": "# Response Rate By Actual Attendance",
            "expression": "DIVIDE('Student Survey'[# Total Responses TeacherID_ClassCode],'Student Survey'[# Total Student By Actual Attendance],0)"
          },
          {
            "name": "# Response Rate By Planned Attendance",
            "expression": "DIVIDE('Student Survey'[# Total Responses TeacherID_ClassCode],'Student Survey'[# Total Student By Planned Attendance],0)"
          }
        ]
      },
