            "sourceColumn": "MainCampusKey"
          },
          {
            "name": "MainCampusCode",
            "dataType": "string",
            "sourceColumn": "MainCampusCode"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TQM_RETENTION_RATE_FOR_TEACHER_F = Source{[Schema=\"DWH\",Item=\"VW_TQM_RETENTION_RATE_FOR_TEACHER_F\"]}[Data]",
                "in",
                "    DWH_VW_TQM_RETENTION_RATE_FOR_TEACHER_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "% RetentionRateForTeacher",
            "expression": [
              "",
              "VAR _Num =",
              "    SUMX(",
              "        'TQM Retention Rate For Teacher',",
              "        'TQM Retention Rate For Teacher'[RetentionRate] *",
              "        'TQM Retention Rate For Teacher'[ActualTeachingRate]",
              "    )",
              "VAR _Den =",
              "    SUM('TQM Retention Rate For Teacher'[ActualTeachingRate])",
              "RETURN",
              "DIVIDE(_Num, _Den,0)"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% ActualTeachingRate",
            "description": "% tối đa là 1, nếu thực tế giảng dạy > plan thì % là 1",
            "expression": [
              "",
              "VAR Rate =",
              "    DIVIDE(",
              "        SUM('TQM Retention Rate For Teacher'[ActutalLesson]),",
              "        SUM('TQM Retention Rate For Teacher'[PlanLesson]),",
              "        0",
              "    )",
              "RETURN",
              "    MIN(Rate, 1)"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% RetentionRate",
            "expression": [
              "",
              "DIVIDE(",
              "    SUM('TQM Retention Rate For Teacher'[TotalReEnrolledStudents]),",
              "    SUM('TQM Retention Rate For Teacher'[TotalCourseCompleters]),",
              "    0",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          }
        ]
      },
