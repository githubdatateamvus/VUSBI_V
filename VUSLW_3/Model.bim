          {
            "type": "calculated",
            "name": "Vintage_Call",
            "dataType": "int64",
            "expression": [
              "",
              "VAR Raw = 'Campus'[Vintage]",
              "VAR Clean =",
              "    TRIM( SUBSTITUTE(Raw, UNICHAR(160), \"\") )   -- remove space ẩn",
              "VAR Y =",
              "    IFERROR(VALUE(Clean), BLANK())",
              "RETURN",
              "IF(",
              "    ISBLANK(Clean) ||",
              "    Clean IN { \"Unspecified\", \"0\", \"N/A\", \"Unknown\", \"-\", \"\" } ||",
              "    ISBLANK(Y),",
              "    2016,",
              "    Y",
              ")"
            ]
          }
        ],
