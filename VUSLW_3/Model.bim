      {
        "name": "KPI Cost Per Student",
        "columns": [
          {
            "name": "ID",
            "dataType": "int64",
            "sourceColumn": "ID"
          },
          {
            "name": "DEPARTMENT",
            "dataType": "string",
            "sourceColumn": "DEPARTMENT"
