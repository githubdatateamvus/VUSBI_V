            "name": "GroupCode",
            "dataType": "string",
            "sourceColumn": "GroupCode"
          },
          {
            "name": "GroupName",
            "dataType": "string",
            "sourceColumn": "GroupName"
          },
          {
            "name": "Min",
            "dataType": "double",
            "sourceColumn": "Min"
          },
          {
            "name": "Max",
            "dataType": "double",
            "sourceColumn": "Max"
          },
          {
            "name": "RankofSales",
            "dataType": "string",
            "sourceColumn": "RankofSales"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_RANK_OF_SALES = Source{[Schema=\"DWH\",Item=\"VW_ASA_RANK_OF_SALES\"]}[Data],",
                "    #\"Removed Other Columns\" = Table.SelectColumns(DWH_VW_ASA_RANK_OF_SALES,{\"ASA Branch Key\", \"StartDate\", \"EndDate\", \"CreatedDate\", \"AreaCode\", \"Area\", \"GroupCode\", \"GroupName\", \"Min\", \"Max\", \"RankofSales\"})",
                "in",
                "    #\"Removed Other Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Ranking Staff",
            "expression": [
              "",
              "VAR areacode = SELECTEDVALUE ( 'Campus'[Tier Area] )",
              "VAR new_students_pd = 'ASA Overview PD'[# of New Student PD]",
              "VAR _ranktable =",
              "    FILTER (",
              "        'ASA Rank Of Sales',",
              "        'ASA Rank Of Sales'[AreaCode] = areacode",
              "&& new_students_pd > 0",
              "&& new_students_pd >= 'ASA Rank Of Sales'[Min]",
              "&& new_students_pd <= 'ASA Rank Of Sales'[Max]",
              "    )",
              "RETURN",
              "    SUMMARIZE ( _ranktable, 'ASA Rank Of Sales'[RankofSales] )"
            ]
          },
          {
            "name": "# of Staff By Rank",
            "expression": [
              "",
              "SUMX (",
              "    VALUES ( 'Users'[User Code] ),",
              "    IF (",
              "        'ASA Overview PD'[# of New Student PD] > 0 && NOT(ISBLANK('Users'[User Code])),",
              "        (",
              "            CALCULATE ( COUNTX ( 'ASA Rank Of Sales', 'ASA Rank Of Sales'[Ranking Staff] ) )",
              "        )",
              "    )",
              ")",
              ""
            ],
            "formatString": "0"
          },
          {
            "name": "Average sale by ranking",
            "expression": [
              " AVERAGEX(",
              "        VALUES('Users'[User Code]),",
              "    IF(",
              "        'ASA Rank Of Sales'[# of Staff By Rank] > 0,",
              "        (",
              "             CALCULATE(",
              "                 SUMX(",
              "                'ASA Overview PD','ASA Overview PD'[# of New Student PD]",
              "                )",
              "            )",
              "        )",
              "    )",
              ")"
            ],
            "formatString": "0.00"
          },
          {
            "name": "% ASA NewPD_ReOD vs Target",
            "expression": " DIVIDE ([# of New Std PD And Re Open Date], [# of New Enrol PD Target]  + [# of Re Enrol OD target])",
            "formatString": "0.0000%;-0.0000%;0.0000%"
          },
          {
            "name": "% NewPD_ReOD vs Campus Target",
            "expression": [
              "",
              "AVERAGEX(",
              "    {",
              "        'ASA Overview PD'[% of New Student PD vs Campus Target],",
              "        'ASA Overview OD'[% Re Enrol OD vs Campus Target]",
              "    },",
              "  [Value]",
              ")"
            ],
            "formatString": "0.0000%;-0.0000%;0.0000%"
          },
          {
            "name": "ASA Performance NewPD_ReOD Rank",
            "expression": [
              "",
              "VAR _rate =",
              "    ROUND(",
              "       [% ASA NewPD_ReOD vs Target],",
              "        4",
              "     )",
              "RETURN",
              "IF (",
              "    ISBLANK ( [# of New Enrol PD Target] + [# of Re Enrol OD target] ),",
              "    BLANK(),",
              "    SWITCH (",
              "        TRUE(),",
              "        [% ASA NewPD_ReOD vs Target] >= 1.05, \"Vượt trội\",",
              "        [% ASA NewPD_ReOD vs Target] >= 1.0, \"Xuất sắc\",",
              "        [% ASA NewPD_ReOD vs Target] >= 0.95, \"Giỏi\",",
              "        [% ASA NewPD_ReOD vs Target] >= 0.90, \"Khá\",",
              "        \"Trung bình\"",
              "    )",
              ")",
              "",
              ""
            ]
          },
          {
            "name": "Performance NewPD_ReOD Rank",
            "expression": [
              "",
              "VAR _rate =",
              "    ROUND(",
              "        [% New Std PD And Re Open Date  vs Target] ,",
              "        4",
              "    )",
              "RETURN",
              "IF (",
              "    ISBLANK ( [# of New Std PD And Re Open Date Target] ),",
              "    BLANK(),",
              "    SWITCH (",
              "          TRUE(),",
              "\t    _rate >= 1.05, \"Vượt trội\",",
              "\t    _rate >= 1.0, \"Xuất sắc\",",
              "\t    _rate >= 0.95, \"Giỏi\",",
              "\t    _rate >= 0.90, \"Khá\",",
              "\t    \"Trung bình\"",
              "",
              "    )",
              ")",
              "",
              ""
            ]
          },
          {
            "name": "ASA Performance NewPD Rank",
            "expression": [
              "",
              "VAR _rate =",
              "    ROUND(",
              "       'ASA Overview PD'[% of New Student vs Target] ,",
              "        4",
              "     )",
              "RETURN",
              "IF (",
              "    ISBLANK ('ASA Overview PD'[% of New Student vs Target]  ),",
              "    BLANK(),",
              "    SWITCH (",
              "        TRUE(),",
              "       _rate >= 1.1, \"Vượt trội\",",
              "       _rate >= 1.0, \"Xuất sắc\",",
              "       _rate >= 0.9, \"Giỏi\",",
              "       _rate >= 0.8, \"Khá\",",
              "        \"Trung bình\"",
              "    )",
              ")",
              ""
            ]
          },
          {
            "name": "ASA Performance ReOD Rank",
            "expression": [
              "",
              "IF (",
              "    ISBLANK ( 'ASA Overview OD'[# of Re Enrol OD Target] ),",
              "    BLANK(),",
              "    SWITCH (",
              "        TRUE(),",
              "        'ASA Overview OD'[# of Re Enrol OD vs Target] >= 1.05, \"Vượt trội\",",
              "        'ASA Overview OD'[# of Re Enrol OD vs Target] >= 1.0, \"Xuất sắc\",",
              "        'ASA Overview OD'[# of Re Enrol OD vs Target] >= 0.95, \"Giỏi\",",
              "        'ASA Overview OD'[# of Re Enrol OD vs Target] >= 0.90, \"Khá\",",
              "        \"Trung bình\"",
              "    )",
              ")",
              "",
              ""
            ]
          },
          {
            "name": "% ASA NewPD non Skplus  and ReOD vs Target",
            "expression": "DIVIDE ([# of New Std PD non Skplus And Re Open Date] , [# of New Enrol PD Target] + [# of Re Enrol OD Target])",
            "formatString": "0.0000%;-0.0000%;0.0000%"
          },
          {
            "name": "ASA Performance NewPD non Skplus_ReOD Rank",
            "expression": [
              "",
              "VAR _rate =",
              "    ROUND(",
              "        [% ASA NewPD non Skplus  and ReOD vs Target],",
              "        4",
              "     )",
              " RETURN",
              "IF(ISBLANK([% ASA NewPD non Skplus  and ReOD vs Target]),BLANK(),",
              "SWITCH(",
              "   TRUE(),",
              "  _rate >= 1.05, \"Vượt trội\",",
              "   AND(_rate>= 1.0,_rate< 1.05), \"Xuất sắc\",",
              "   AND(_rate>= 0.95,_rate< 1.0), \"Giỏi\",",
              "   AND(_rate>= 0.90,_rate < 0.95), \"Khá\",",
              "   \"Trung bình\"",
              "))"
            ]
          },
          {
            "name": "Performance NewPD non Skplus and ReOD Rank",
            "expression": [
              "",
              "VAR _rate =",
              "    ROUND(",
              "        [% New Std PD non Skplus And Re Open Date  vs Target],",
              "        4",
              "    )",
              "RETURN",
              "IF(ISBLANK([% New Std PD non Skplus And Re Open Date  vs Target]),BLANK(),",
              "SWITCH(",
              "   TRUE(),",
              "  _rate >= 1.05, \"Vượt trội\",",
              "   AND(_rate >= 1.0,_rate < 1.05), \"Xuất sắc\",",
              "   AND(_rate >= 0.95,_rate< 1.0), \"Giỏi\",",
              "   AND(_rate >= 0.90,_rate<0.95), \"Khá\",",
              "   \"Trung bình\"",
              "))"
            ]
          },
          {
            "name": "ME Performance NewPD Rank non Skplus",
            "expression": [
              "",
              "VAR _rate =",
              "    ROUND(",
              "        'ASA Overview PD'[% of New Student PD vs Campus Target non Skplus],",
              "        4",
              "    )",
              "RETURN",
              "IF(ISBLANK('ASA Overview PD'[% of New Student PD vs Campus Target non Skplus]),BLANK(),",
              "SWITCH(",
              "   TRUE(),",
              "   _rate >= 1.1, \"Vượt trội\", ",
              "   AND(_rate >= 1.0,_rate < 1.1), \"Xuất sắc\",",
              "   AND(_rate>= 0.9,_rate < 1.0), \"Giỏi\",",
              "   AND(_rate >= 0.8,_rate < 0.9), \"Khá\",",
              "   \"Trung bình\"",
              "))"
            ]
          },
          {
            "name": "ASA Performance NewPD Rank non Skplus",
            "expression": [
              "",
              "VAR _rate =",
              "    ROUND(",
              "        'ASA Overview PD'[% of New Student vs Target non Skplus] ,",
              "        4",
              "     )",
              "RETURN",
              "if(ISBLANK( 'ASA Overview PD'[% of New Student vs Target non Skplus]),BLANK(),",
              "SWITCH(",
              "   TRUE(),",
              "   _rate >= 1.1, \"Vượt trội\",",
              "   AND(_rate >= 1.0,_rate < 1.1), \"Xuất sắc\",",
              "   AND(_rate >= 0.9,_rate < 1.0), \"Giỏi\",",
              "   AND(_rate >= 0.8,_rate < 0.9), \"Khá\",",
              "   \"Trung bình\"",
              "))"
            ]
          }
        ]
      },
      {
