          {
            "name": "SourceOldCl",
            "dataType": "string",
            "sourceColumn": "SourceOldCl"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_RETENTION_RATE_OPENING_PLAN_F = Source{[Schema=\"DWH\",Item=\"VW_RETENTION_RATE_OPENING_PLAN_F\"]}[Data]",
                "in",
                "    DWH_VW_RETENTION_RATE_OPENING_PLAN_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of HVKK",
            "expression": [
              "",
              "Var HVKK1=CALCULATE (DISTINCTCOUNT('ASA Retention Rate Opening Plan'[StudentID]),'ASA Retention Rate Opening Plan'[DateKey] < 20240901,'ASA Retention Rate Opening Plan'[OldListClassID] <> BLANK())",
              "Var HVKK2=CALCULATE (DISTINCTCOUNT('ASA Retention Rate Opening Plan'[StudentID]),'ASA Retention Rate Opening Plan'[DateKey] >= 20240901,'ASA Retention Rate Opening Plan'[OldListClassID] <> BLANK())",
              "Var Result = HVKK1 + HVKK2",
              "Return Result"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Re-OD",
            "expression": [
              "",
              "Var ReOD1=CALCULATE (DISTINCTCOUNT('ASA Retention Rate Opening Plan'[StudentID]),'ASA Retention Rate Opening Plan'[DateKey] < 20240901,'ASA Retention Rate Opening Plan'[ActualClassID] <> BLANK())",
              "Var ReOD2=CALCULATE (DISTINCTCOUNT('ASA Retention Rate Opening Plan'[StudentID]),'ASA Retention Rate Opening Plan'[DateKey] >= 20240901,'ASA Retention Rate Opening Plan'[ActualClassID] <> BLANK())",
              "Var Result = ReOD1 + ReOD2",
              "Return Result"
            ],
            "formatString": "0"
          },
          {
            "name": "# of HVKK Re-OD",
            "expression": "CALCULATE ('ASA Retention Rate Opening Plan'[# of Re-OD],FILTER('ASA Retention Rate Opening Plan','ASA Retention Rate Opening Plan'[OldListClassID] <> BLANK()))",
            "formatString": "0"
          },
          {
            "name": "# of HVTN Re-OD",
            "expression": "'ASA Retention Rate Opening Plan'[# of Re-OD] - 'ASA Retention Rate Opening Plan'[# of HVKK Re-OD]",
            "formatString": "0"
          },
          {
            "name": "% Retention",
            "expression": [
              " AVERAGEX(",
              "    KEEPFILTERS(VALUES('Calendar'[Year Month])),",
              "    CALCULATE(DIVIDE('ASA Retention Rate Opening Plan'[# of Re-OD],'ASA Retention Rate Opening Plan'[# of HVKK]))",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Re-Enrolment",
            "expression": " 'ASA Retention Rate Opening Plan'[# of HVKK Re-OD]/'ASA Retention Rate Opening Plan'[# of HVKK]",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# Retention OD Target",
            "expression": " CALCULATE( SUM('ASA Target Manual'[Target Value]), 'ASA Target Manual'[Target Type] = \"Target Retention OD\")"
          },
          {
            "name": "% Retention vs Target",
            "expression": " CALCULATE(DIVIDE('ASA Retention Rate Opening Plan'[% Retention],'ASA Retention Rate Opening Plan'[# Retention OD Target]))",
            "formatString": "0.0%;-0.0%;0.0%"
          }
        ]
      },
      {
