      {
        "name": "Campus Consultant",
        "columns": [
          {
            "name": "ASA Branch Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "ASA Branch Key"
          },
          {
            "name": "QLGV Branch Key",
            "dataType": "string",
            "isHidden": true,
            "sourceColumn": "QLGV Branch Key"
          },
          {
            "name": "Branch Code",
            "dataType": "string",
            "sourceColumn": "Branch Code"
          },
          {
            "name": "Branch Code Old",
            "dataType": "string",
            "sourceColumn": "Branch Code Old"
