        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_HRT_APPLICATION_LOCATION_F = Source{[Schema=\"DWH\",Item=\"VW_HRT_APPLICATION_LOCATION_F\"]}[Data]",
