          {
            "name": "Dur Create To Show (H)",
            "dataType": "double",
            "sourceColumn": "Dur Create To Show (H)",
            "formatString": "0.0"
          },
          {
            "type": "calculated",
            "name": "YM show",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT('ASA Enquiries'[Show Date], \"yyyy-MM\" )"
          },
          {
            "type": "calculated",
            "name": "YM sign",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT('ASA Enquiries'[Sign Date], \"yyyy-MM\" )"
          },
          {
            "type": "calculated",
            "name": "SAM YM",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF('ASA Enquiries'[YM show] = 'ASA Enquiries'[YM sign] ,\"SAME\",\"DIFF\")"
          },
          {
            "type": "calculated",
            "name": "Show Date (D)",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT('ASA Enquiries'[Show Date],\"yyyy-mm-dd\") "
          },
          {
            "type": "calculated",
            "name": "Sign Date (D)",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "FORMAT('ASA Enquiries'[Sign Date],\"yyyy-mm-dd\") "
          },
          {
            "name": "Reason SNS",
            "dataType": "string",
            "sourceColumn": "Reason SNS"
          },
          {
            "name": "Reason SNS Detail",
            "dataType": "string",
            "sourceColumn": "Reason SNS Detail"
          },
          {
            "name": "Care Status Name",
            "dataType": "string",
            "sourceColumn": "Care Status Name"
          },
          {
            "name": "Care Status Detail Name",
            "dataType": "string",
            "sourceColumn": "Care Status Detail Name"
          },
          {
            "name": "Lead Status",
            "dataType": "string",
            "sourceColumn": "Lead Status"
          },
          {
            "name": "score_category",
            "dataType": "string",
            "sourceColumn": "score_category"
          },
          {
            "name": "Dur_Show_To_Sign (D)",
            "dataType": "int64",
            "sourceColumn": "Dur_Show_To_Sign (D)"
          },
          {
            "name": "PTDate",
            "dataType": "dateTime",
            "sourceColumn": "PTDate"
          },
          {
            "name": "Dur Show To PT (D)",
            "dataType": "double",
            "sourceColumn": "Dur Show To PT (D)"
          },
          {
            "name": "Dur Lead To Show (D)",
            "dataType": "double",
            "sourceColumn": "Dur Lead To Show (D)"
          },
          {
            "name": "PTDateKey",
            "dataType": "string",
            "sourceColumn": "PTDateKey"
          },
          {
            "name": "Show_Time_Group",
            "dataType": "string",
            "sourceColumn": "Show_Time_Group"
          },
          {
            "name": "Dur_Lead_To_Show_Days",
            "dataType": "int64",
            "sourceColumn": "Dur_Lead_To_Show_Days"
          },
          {
            "name": "Dur_Lead_To_Show_Months",
            "dataType": "double",
            "sourceColumn": "Dur_Lead_To_Show_Months"
          },
          {
            "name": "Lead_Created_Date",
            "dataType": "dateTime",
            "sourceColumn": "Lead_Created_Date"
          },
          {
            "name": "Lead_Created_Month",
            "dataType": "dateTime",
            "sourceColumn": "Lead_Created_Month"
          },
          {
            "name": "Show_Month",
            "dataType": "dateTime",
            "sourceColumn": "Show_Month"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_SHOW_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_SHOW_F\"]}[Data]",
                "in",
                "    DWH_VW_ASA_SHOW_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Enquiries",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Enquiries'[User Information ID]))",
            "formatString": "#,0"
          },
          {
            "name": "# of Enquiries Target",
            "expression": [
              " CALCULATE(SUM('ASA Target Manual'[Target Value]),'ASA Target Manual'[Target Type]=\"Target Show\")",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Enquiries vs Target",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],'ASA Enquiries'[# of Enquiries Target],BLANK())",
            "formatString": "#,0.00%;-#,0.00%;#,0.00%"
          },
          {
            "name": "# of Enquiries By Campus By Channel",
            "expression": [
              " CALCULATE(",
              "    DISTINCTCOUNT('ASA Enquiries'[User Information ID])",
              "\t,GROUPBY(Campus,Campus[Campus Code])",
              "\t,GROUPBY('List Consultant Type','List Consultant Type'[Channel])",
              "\t,REMOVEFILTERS()",
              ")"
            ]
          },
          {
            "name": "% Enquiries By Campus By Channel",
            "expression": " 'ASA Enquiries'[# of Enquiries]/'ASA Enquiries'[# of Enquiries By Campus By Channel]",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Enquiries LM",
            "expression": "  CALCULATE([# of Enquiries],PREVIOUSMONTH('Calendar'[Date]))"
          },
          {
            "name": "# of Enquiries SameDayLastMonth",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Enquiries'[User Information ID]), DATEADD('Calendar'[Date], -1, MONTH))"
          },
          {
            "name": "% CR Lead To Show Total",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],'Lead'[# of Lead],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Enquiries LY",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Enquiries'[User Information ID]),SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "#,0"
          },
          {
            "name": "% Enquiries vs LY",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],'ASA Enquiries'[# of Enquiries LY],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# of Enquiries MKT Target",
            "expression": " 'ASA Enquiries'[# of Enquiries]*RANDBETWEEN(0.5,1.5)",
            "formatString": "#,0"
          },
          {
            "name": "% Enquiries vs MKT Target",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],[# of Enquiries MKT Target],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# of Enquries Per Day",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],CALCULATE(DISTINCTCOUNT('Calendar'[Date])),BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "# of Enquries Per Day LY",
            "expression": " CALCULATE([# of Enquries Per Day],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "#,0"
          },
          {
            "name": "# of Enquiries 2019",
            "expression": [
              "",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([# of Enquiries],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Enqueries vs 2019",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],'ASA Enquiries'[# of Enquiries 2019],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Enquries Per Day 2019",
            "expression": [
              " ",
              "var BaseYear = 2019",
              "var CurrentYear=SELECTEDVALUE('Calendar'[Year])",
              "var YearsToGoBack = BaseYear- CurrentYear",
              "return CALCULATE([# of Enquries Per Day],DATEADD('Calendar'[Date],YearsToGoBack,YEAR))"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Growth Enqueries vs LY",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries] ,'ASA Enquiries'[# of Enquiries LY],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Enquiries From Lead",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Enquiries'[User Information ID]),FILTER('ASA Enquiries','ASA Enquiries'[Lead Key]<>\"LEAD~0\"))"
          },
          {
            "name": "% CR Lead To Show From Lead",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries From Lead],'Lead'[# of Lead],BLANK())"
          },
          {
            "name": "# of Enquiries MKT Target By Channel",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA MKT Target By Channel'[Show Value])",
              "\t,ALL('Calendar')",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)\t"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Enquiries MKT Target By Media",
            "expression": [
              " ",
              "var f_date = min('Calendar'[First Day Of Month])",
              "var t_date = max('Calendar'[Last Day Of Month])",
              "return CALCULATE(sum('ASA MKT Target By Media'[Show Value])",
              "\t,ALL('Calendar')",
              "\t,'Calendar'[Date]>=f_date",
              "\t,'Calendar'[Date]<=t_date)\t"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Enquiries vs MKT Target By Channel",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],[# of Enquiries MKT Target By Channel],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "% Enquiries vs MKT Target By Media",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries],[# of Enquiries MKT Target By Media],BLANK())",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# of Sign For Month From Enquiries",
            "expression": " Calculate ([# of Enquiries], month('ASA Enquiries'[Sign Date]) <> month ('ASA Enquiries'[Show Date]),'ASA Enquiries'[Sign Date] <> blank())"
          },
          {
            "name": "#of SNS",
            "expression": " CALCULATE('ASA Enquiries'[#of SNS In Month],DATEADD ( 'Calendar'[Date], -3, MONTH )) +CALCULATE('ASA Enquiries'[#of SNS In Month],DATEADD ( 'Calendar'[Date], -2, MONTH ))+CALCULATE('ASA Enquiries'[#of SNS In Month],DATEADD ( 'Calendar'[Date], -1, MONTH ))"
          },
          {
            "name": "#of SNS In Month",
            "expression": " CALCULATE('ASA Enquiries'[# of Enquiries], ISBLANK ('ASA Enquiries'[Sign Date]) )"
          },
          {
            "name": "#of SNS Pending",
            "expression": " 'ASA Enquiries'[#of SNS] - 'ASA Enquiries'[#of SNS In Month]"
          },
          {
            "name": "# of Enquiries Digital",
            "expression": "CALCULATE('ASA Enquiries'[# of Enquiries],'Source Information'[Media]=\"Digital\")",
            "formatString": "0"
          },
          {
            "name": "# of Enquiries Direct",
            "expression": "CALCULATE('ASA Enquiries'[# of Enquiries],'Source Information'[Media]=\"Direct\")",
            "formatString": "0"
          },
          {
            "name": "# of Enquiries Referral",
            "expression": "CALCULATE('ASA Enquiries'[# of Enquiries],'Source Information'[Media]=\"Referral\")",
            "formatString": "0"
          },
          {
            "name": "% of Enquiries Digital vs Target",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries Digital],'MKT Kpi Target Manual'[# of Kpi By Show Digital Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Enquiries Direct vs Target",
            "expression": " DIVIDE( 'ASA Enquiries'[# of Enquiries Direct],'MKT Kpi Target Manual'[# of Kpi By Show Dmk Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Enquiries Referral vs Target",
            "expression": " DIVIDE( 'ASA Enquiries'[# of Enquiries Referral],'MKT Kpi Target Manual'[# of Kpi By Show Referral Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Show > Placement Test",
            "expression": " DIVIDE('ASA Placement Test'[# of Placement Test],'ASA Enquiries'[# of Enquiries],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of TMK Act vs Target Show",
            "expression": " DIVIDE( 'ASA Enquiries'[# of Show TMK New],'MKT Kpi Target Manual'[# of TMK Target Show],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of New Show Recycle Campus Target",
            "expression": "CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Show Recycle\"))",
            "formatString": "0"
          },
          {
            "name": "# of New Show Referral Campus Target",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Show Referral\"))",
            "formatString": "0"
          },
          {
            "name": "# of New Show SNS Campus Target",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Show Show Not Sign\"))",
            "formatString": "0"
          },
          {
            "name": "# of New Show TMK Campus Target",
            "expression": " CALCULATE(SUM('ASA Target Manual'[Target Value]),FILTER('ASA Target Manual','ASA Target Manual'[Target Type] = \"Target Show TMK\"))",
            "formatString": "0"
          },
          {
            "name": "# of Show Recycle",
            "expression": "CALCULATE('ASA Enquiries'[# of Enquiries],'User Information Type'[User Information Type]=\"Recycle\")",
            "formatString": "0"
          },
          {
            "name": "# of Show Referral",
            "expression": "CALCULATE('ASA Enquiries'[# of Enquiries],'Source Information'[Media] = \"Referral\")",
            "formatString": "0"
          },
          {
            "name": "# of Show TMK",
            "expression": " CALCULATE('ASA Enquiries'[# of Enquiries],'Student'[User Information Type Name]=\"New\")",
            "formatString": "0"
          },
          {
            "name": "# of Show SNS",
            "expression": "  CALCULATE('ASA Enquiries'[# of Enquiries],FILTER('ASA Enquiries','ASA Enquiries'[Sign Date]= BLANK()))",
            "formatString": "0"
          },
          {
            "name": "% Show Recycle vs Campus Target",
            "expression": " DIVIDE('ASA Enquiries'[# of Show Recycle],'ASA Enquiries'[# of New Show Recycle Campus Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Show Referral vs Campus Target",
            "expression": "DIVIDE('ASA Enquiries'[# of Show Referral],'ASA Enquiries'[# of New Show Referral Campus Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Show SNS vs Campus Target",
            "expression": "DIVIDE('ASA Enquiries'[# of Show SNS],'ASA Enquiries'[# of New Show SNS Campus Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% Show TMK vs Campus Target",
            "expression": "DIVIDE('ASA Enquiries'[# of Show TMK],'ASA Enquiries'[# of New Show TMK Campus Target],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Show>Sign Recycle",
            "expression": "DIVIDE('ASA Overview PD'[# of New Student PD Recycle],'ASA Enquiries'[# of Show Recycle],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Show>Sign Referral",
            "expression": "DIVIDE('ASA Overview PD'[# of New Student PD Referral],'ASA Enquiries'[# of Show Referral],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Show>Sign SNS",
            "expression": "DIVIDE('ASA Overview PD'[# of New Student PD SNS],'ASA Push Sale'[# of Show SNS Push Sale],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% CR Show>Sign TMK",
            "expression": "DIVIDE('ASA Overview PD'[# of New Student PD New],'ASA Enquiries'[# of Show TMK],BLANK())",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "Is_SNS",
            "expression": [
              "",
              "VAR thismonth = SELECTEDVALUE('Calendar'[Date])",
              "VAR showdate = SELECTEDVALUE('ASA Enquiries'[Show Date])",
              "VAR monthbefore = DATEDIFF(showdate,thismonth,MONTH)",
              "Return monthbefore"
            ]
          },
          {
            "name": "# Enquiries New",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Enquiries'[User Information ID]),FILTER('User Information Type','User Information Type'[User Information Type Name] = \"New\"))"
          },
          {
            "name": "# 1 of Show Sibling",
            "expression": [
              " ",
              " var sibling=CALCULATE('ASA Enquiries'[# of Enquiries],'Source Information'[Media]=\"Sibling\")",
              " return if(ISBLANK(sibling),0,sibling)"
            ],
            "formatString": "0"
          },
          {
            "name": "# 1 of Show Referral",
            "expression": [
              " ",
              " var referral=CALCULATE('ASA Enquiries'[# of Enquiries],'Source Information'[Media]=\"Referral\")",
              " return if(ISBLANK(referral),0,referral)"
            ],
            "formatString": "0"
          },
          {
            "name": "# 1 of Show Recycle",
            "expression": [
              " ",
              " var recycle =CALCULATE('ASA Enquiries'[# of Enquiries],'User Information Type'[User Information Type]=\"Recycle\",'Source Information'[Media]<>\"Sibling\",'Source Information'[Media]<>\"Referral\")",
              " return if(ISBLANK(recycle),0,recycle)"
            ],
            "formatString": "0"
          },
          {
            "name": "# 1 of Show New",
            "expression": [
              " ",
              " var new =CALCULATE('ASA Enquiries'[# of Enquiries],'User Information Type'[User Information Type]<>\"Recycle\",'Source Information'[Media]<>\"Sibling\",'Source Information'[Media]<>\"Referral\")",
              " return if(ISBLANK(new),0,new)"
            ],
            "formatString": "0"
          },
          {
            "name": "# 1 of Show SNS (Single)",
            "expression": [
              " ",
              "VAR current_year = SELECTEDVALUE('Calendar'[Year])",
              "VAR current_month = ",
              "CALCULATE(",
              "    MAX('Calendar'[Month Number]),",
              "    'Calendar'[Month] = SELECTEDVALUE('Calendar'[Month])",
              ")",
              "VAR report_date = EOMONTH(DATE(current_year, current_month, 1), 0)",
              "VAR SNS = ",
              "    CALCULATE(",
              "        'ASA Enquiries'[# of Enquiries],",
              "        DATEDIFF('ASA Enquiries'[Show Date], report_date, MONTH) >= 1",
              "        &&",
              "        DATEDIFF('ASA Enquiries'[Show Date], report_date, MONTH) <= 3,",
              "        'ASA Enquiries'[SAM YM] = \"DIFF\",",
              "        REMOVEFILTERS('Calendar'[Month], 'Calendar'[Year]))",
              "RETURN IF(ISBLANK(SNS), 0, SNS)"
            ],
            "formatString": "0"
          },
          {
            "name": "# of Show TMK New",
            "expression": " CALCULATE('ASA Enquiries'[# of Enquiries],'List Consultant Type'[Channel] = \"TMK\")",
            "formatString": "0"
          },
          {
            "name": "# of Enquiries YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Enquiries'[# of Enquiries],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "% CR Enquiries > Sign YTD",
            "expression": "DIVIDE('ASA Overview PD'[# New student pd YTD],'ASA Enquiries'[# of Enquiries YTD])"
          },
          {
            "name": "# of Enquiries YTD PY",
            "expression": " CALCULATE('ASA Enquiries'[# of Enquiries YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% CR Enquiries > Show YTD PY",
            "expression": " DIVIDE('ASA Overview PD'[# New student pd YTD],'ASA Enquiries'[# of Enquiries YTD PY],BLANK())"
          },
          {
            "name": "% Enquiries YTD vs LY",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries YTD],'ASA Enquiries'[# of Enquiries YTD PY],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Enquiries Digital PY",
            "expression": " CALCULATE('ASA Enquiries'[# of Enquiries Digital],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Enquiries Digital YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Enquiries'[# of Enquiries Digital],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "% Enquiries Digital vs LY",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries Digital],'ASA Enquiries'[# of Enquiries Digital PY],BLANK())"
          },
          {
            "name": "% Enquiries Digital YTD vs LY",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries Digital YTD],'ASA Enquiries'[# Enquiries Digital YTD PY],BLANK())"
          },
          {
            "name": "# Enquiries Digital YTD PY",
            "expression": " CALCULATE('ASA Enquiries'[# of Enquiries Digital YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Enquiries Direct PY",
            "expression": " CALCULATE('ASA Enquiries'[# of Enquiries Direct],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Enquiries Direct YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Enquiries'[# of Enquiries Direct],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "# of Enquiries Direct YTD PY",
            "expression": " CALCULATE('ASA Enquiries'[# of Enquiries Direct YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% Enquiries Direct vs LY",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries Direct],'ASA Enquiries'[# of Enquiries Direct PY],BLANK())"
          },
          {
            "name": "% Enquiries Direct YTD vs LY",
            "expression": " DIVIDE('ASA Enquiries'[# of Enquiries Direct YTD],'ASA Enquiries'[# of Enquiries Direct YTD PY],BLANK())"
          },
          {
            "name": "# of Show Referral PY",
            "expression": " CALCULATE('ASA Enquiries'[# 1 of Show Referral],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "# of Show Referral YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Enquiries'[# 1 of Show Referral],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "# of Show Referral YTD PY",
            "expression": " CALCULATE('ASA Enquiries'[# of Show Referral YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% Show Referral vs Target",
            "expression": " DIVIDE( 'ASA Enquiries'[# 1 of Show Referral],'MKT Kpi Target Manual'[# of Kpi By Show Referral Target],BLANK())"
          },
          {
            "name": "% Show Referral vs PY",
            "expression": " DIVIDE( 'ASA Enquiries'[# 1 of Show Referral],'ASA Enquiries'[# of Show Referral PY],BLANK())"
          },
          {
            "name": "% Show Referral YTD vs LY",
            "expression": " DIVIDE('ASA Enquiries'[# of Show Referral YTD],'ASA Enquiries'[# of Show Referral YTD PY],BLANK())"
          },
          {
            "name": "% CR Lead To Show Total PY",
            "expression": "  CALCULATE('ASA Enquiries'[% CR Lead To Show Total],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% CR Lead To Show Total YTD",
            "expression": [
              " ",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE('ASA Enquiries'[% CR Lead To Show Total],ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ]
          },
          {
            "name": "% CR Lead To Show Total YTD PY",
            "expression": "  CALCULATE('ASA Enquiries'[% CR Lead To Show Total PY],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% CR Lead To Show Total vs Target",
            "expression": "DIVIDE('ASA Enquiries'[% CR Lead To Show Total],'MKT Kpi Target Manual'[% Target_CR_Lead_2_Show],BLANK())"
          },
          {
            "name": "% CR Lead To Show Total vs PY",
            "expression": " DIVIDE('ASA Enquiries'[% CR Lead To Show Total],'ASA Enquiries'[% CR Lead To Show Total PY],BLANK())"
          },
          {
            "name": "% CR Lead To Show Total YTD vs PY",
            "expression": "DIVIDE('ASA Enquiries'[% CR Lead To Show Total YTD],'ASA Enquiries'[% CR Lead To Show Total YTD PY],BLANK())"
          },
          {
            "name": "% CR Show to sign YTD PY",
            "expression": "  CALCULATE('ASA Enquiries'[% CR Enquiries > Sign YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))"
          },
          {
            "name": "% CR Show > Sign vs Target",
            "expression": " divide ( 'ASA Overview PD'[% CR Enquiries To New Student PD], 'ASA Overview PD'[% CR Show > Sign Target],BLANK())"
          },
          {
            "name": "% CR Show > sign vs PY",
            "expression": "DIVIDE('ASA Overview PD'[% CR Enquiries To New Student PD],'ASA Overview PD'[% CR Show > Sign LY],BLANK())"
          },
          {
            "name": "% CR Show > sign YTD vs PY",
            "expression": "DIVIDE('ASA Enquiries'[% CR Enquiries > Sign YTD],'ASA Enquiries'[% CR Show to sign YTD PY],BLANK())"
          },
          {
            "name": "# of Enquiries PT",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Enquiries],",
              "    'ASA Enquiries'[PTDate] > DATE(1900,1,1)",
              ")",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Enquiries PT In Month",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Enquiries PT],",
              "    FILTER(",
              "        'ASA Enquiries',",
              "        YEAR('ASA Enquiries'[PTDate]) = YEAR('ASA Enquiries'[Show Date]) &&",
              "        MONTH('ASA Enquiries'[PTDate]) = MONTH('ASA Enquiries'[Show Date])",
              "    )",
              ")",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Enquiries PT For Month",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Enquiries PT],",
              "    USERELATIONSHIP('ASA Enquiries'[PTDateKey], 'Calendar'[Date Key])",
              ")",
              "",
              ""
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Enquiries PT",
            "expression": [
              "",
              "DIVIDE([# of Enquiries PT], [# of Enquiries])"
            ],
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# of Enquiries PT - Sign",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Enquiries],",
              "    'ASA Enquiries'[PTDate] > DATE(1900,1,1),",
              "    'ASA Enquiries'[Sign Date] > DATE(1900,1,1)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Enquiries PT - Sign",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Enquiries PT - Sign],",
              "    [# of Enquiries PT]",
              "    )"
            ],
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Show2Sign 24h",
            "expression": [
              "",
              "CALCULATE(",
              "    'ASA Enquiries'[# of Enquiries],",
              "    'ASA Enquiries'[Dur_Show_To_Sign (D)] >= 0,",
              "    'ASA Enquiries'[Dur_Show_To_Sign (D)] <= 1,",
              "    'ASA Enquiries'[Sign Date] >= DATE(1900, 1, 2)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Show2Sign 24h",
            "expression": " DIVIDE([# of Show2Sign 24h],'ASA Enquiries'[# of Enquiries])",
            "formatString": "#,0%;-#,0%;#,0%"
          },
          {
            "name": "# of Show2Sign 72h",
            "expression": [
              "",
              "CALCULATE(",
              "    'ASA Enquiries'[# of Enquiries],",
              "    'ASA Enquiries'[Dur_Show_To_Sign (D)] >= 2,",
              "    'ASA Enquiries'[Dur_Show_To_Sign (D)] <= 3",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Show2Sign 72h",
            "expression": " DIVIDE([# of Show2Sign 72h],'ASA Enquiries'[# of Enquiries])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Show2Sign >72h",
            "expression": [
              "",
              "CALCULATE(",
              "    'ASA Enquiries'[# of Enquiries],",
              "    'ASA Enquiries'[Dur_Show_To_Sign (D)] >= 4",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Show2Sign >72h",
            "expression": " DIVIDE([# of Show2Sign >72h],'ASA Enquiries'[# of Enquiries])",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% ASA Total KKHT_TN TGD",
            "expression": " ('ASA Push Sale'[# of HVKK Tai GD] + 'ASA Push Sale'[# of HVKK TN TGD])/('ASA Overview PD'[# of KKHT TGD Target] + 'ASA Overview PD'[# of Pending Target])"
          }
        ]
      },
