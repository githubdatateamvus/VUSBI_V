          },
          {
            "name": "IsAcceptedOfferCV",
            "dataType": "boolean",
            "sourceColumn": "IsAcceptedOfferCV"
          },
          {
            "name": "IsConfirmedInterviewCV",
            "dataType": "boolean",
            "sourceColumn": "IsConfirmedInterviewCV"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_HRT_APPLICATION_F = Source{[Schema=\"DWH\",Item=\"VW_HRT_APPLICATION_F\"]}[Data]",
                "in",
                "    DWH_VW_HRT_APPLICATION_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of All CVs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[IsCVNonDup] = TRUE())",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Employed CVs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[IsEmployedCV] = TRUE())",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Interviewed CVs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[IsInterviewedCV] = TRUE())",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Offered CVs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[IsOfferedCV] = TRUE())",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Passed Interview CVs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[IsPassedInterviewCV] = TRUE())",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Qualified CVs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[IsQCV] = TRUE())",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Qualifed CVs vs All CVs",
            "expression": " DIVIDE('HRT Application'[# of Qualified CVs],'HRT Application'[# of All CVs],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Interviewed CVs vs Qualified CVs",
            "expression": " DIVIDE('HRT Application'[# of Interviewed CVs],'HRT Application'[# of Qualified CVs],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Passed Interview CVs vs Interviewed CVs",
            "expression": " DIVIDE('HRT Application'[# of Passed Interview CVs],'HRT Application'[# of All CVs],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Employed CVs vs Qualified CVs",
            "expression": " DIVIDE('HRT Application'[# of Employed CVs],'HRT Application'[# of Qualified CVs],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Employed CVs vs Offered CVs",
            "expression": " DIVIDE('HRT Application'[# of Employed CVs],'HRT Application'[# of Offered CVs],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% CVs Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of All CVs] - [# of All CVs [Previous Year]]], // Tử số: Sự thay đổi về số lượng CV so với tháng trước",
              "    [# of All CVs [Previous Year]]],                  // Mẫu số: Số lượng CV của tháng trước",
              "    BLANK()                                              // Giá trị trả về nếu mẫu số là BLANK (hoặc 0)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Employed CVs Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Employed CVs] - [# of Employed CVs [Previous Year]]], // Tử số: Sự thay đổi về số lượng CV so với tháng trước",
              "    [# of Employed CVs [Previous Year]]],                  // Mẫu số: Số lượng CV của tháng trước",
              "    BLANK()                                              // Giá trị trả về nếu mẫu số là BLANK (hoặc 0)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Interviewed CVs Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Interviewed CVs] - [# of Interviewed CVs [Previous Year]]], // Tử số: Sự thay đổi về số lượng CV so với tháng trước",
              "    [# of Interviewed CVs [Previous Year]]],                  // Mẫu số: Số lượng CV của tháng trước",
              "    BLANK()                                              // Giá trị trả về nếu mẫu số là BLANK (hoặc 0)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Offered CVs Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Offered CVs] - [# of Offered CVs [Previous Year]]], // Tử số: Sự thay đổi về số lượng CV so với tháng trước",
              "    [# of Offered CVs [Previous Year]]],                  // Mẫu số: Số lượng CV của tháng trước",
              "    BLANK()                                              // Giá trị trả về nếu mẫu số là BLANK (hoặc 0)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Passed Interview CVs Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Passed Interview CVs] - [# of Passed Interview CVs [Previous Year]]], // Tử số: Sự thay đổi về số lượng CV so với tháng trước",
              "    [# of Passed Interview CVs [Previous Year]]],                  // Mẫu số: Số lượng CV của tháng trước",
              "    BLANK()                                              // Giá trị trả về nếu mẫu số là BLANK (hoặc 0)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Qualified CVs Delta Growth",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Qualified CVs] - [# of Qualified CVs [Previous Year]]], // Tử số: Sự thay đổi về số lượng CV so với tháng trước",
              "    [# of Qualified CVs [Previous Year]]],                  // Mẫu số: Số lượng CV của tháng trước",
              "    BLANK()                                              // Giá trị trả về nếu mẫu số là BLANK (hoặc 0)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Average Apl To Hire Days",
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE('HRT Application'[AplToHireDays]),",
              "    NOT ISBLANK('HRT Application'[AplToHireDays])",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Rejected CVs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    'HRT Application'[IsRejectedCV] = TRUE())"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Interviewed CVs (by Interview Date)",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    'HRT Application'[IsInterviewedCV] = TRUE(),",
              "    USERELATIONSHIP(",
              "        'Calendar'[Date],",
              "        'HRT Application'[InterviewDate]",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Employed CVs (by Assign Date)",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    'HRT Application'[IsEmployedCV] = TRUE(),",
              "    USERELATIONSHIP(",
              "        'Calendar'[Date],",
              "        'HRT Application'[AssignDate]",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Offered CVs (by Offer Date)",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    'HRT Application'[IsOfferedCV] = TRUE(),",
              "    USERELATIONSHIP(",
              "        'Calendar'[Date],",
              "        'HRT Application'[OfferDate]",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of TAs Took Test",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[TestRanking] <> BLANK()),",
              "    KEEPFILTERS('HRT Application'[TeacherType] = \"TA\"),",
              "    KEEPFILTERS('HRT Application'[TestCode] <> BLANK())",
              "    )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of TAs Not Took Test",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[TestRanking] = BLANK()),",
              "    KEEPFILTERS('HRT Application'[TeacherType] = \"TA\"),",
              "    KEEPFILTERS('HRT Application'[TestCode] <> BLANK())",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of TAs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[TeacherType] = \"TA\"),",
              "    KEEPFILTERS('HRT Application'[TestCode] <> BLANK())",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of All CVs [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of All CVs],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Employed CVs [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of Employed CVs],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Interviewed CVs [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of Interviewed CVs],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Passed Interview CVs [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of Passed Interview CVs],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Offered CVs [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of Offered CVs],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Qualified CVs [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [# of Qualified CVs],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Employed CVs vs QCVs (by Assign Date)",
            "expression": " DIVIDE('HRT Application'[# of Employed CVs (by Assign Date)],'HRT Application'[# of Accepted Offer CVs (by Offer Date)],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Passed Interview CVs (by Interview Date)",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    'HRT Application'[IsPassedInterviewCV] = TRUE(),",
              "    USERELATIONSHIP(",
              "        'Calendar'[Date],",
              "        'HRT Application'[InterviewDate]",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Accepted Offer CVs (by Offer Date)",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    'HRT Application'[IsAcceptedOfferCV] = TRUE(),",
              "    USERELATIONSHIP(",
              "        'Calendar'[Date],",
              "        'HRT Application'[OfferDate]",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Accepted Offered CVs vs Offered CVs (by Offer Date)",
            "expression": " DIVIDE('HRT Application'[# of Accepted Offer CVs (by Offer Date)],'HRT Application'[# of Offered CVs (by Offer Date)],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Confirmed Interview CVs (by Interview Date)",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    'HRT Application'[IsConfirmedInterviewCV] = TRUE(),",
              "    USERELATIONSHIP(",
              "        'Calendar'[Date],",
              "        'HRT Application'[InterviewDate]",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Confirmed Interview CVs vs Qualified CVs (by Interview Date)",
            "expression": " DIVIDE('HRT Application'[# of Confirmed Interview CVs (by Interview Date)],'HRT Application'[# of Qualified CVs],BLANK())",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%"
          },
          {
            "name": "% Confirmed Interview CVs vs Interviewed CVs (by Interview Date)",
            "expression": " DIVIDE('HRT Application'[# of Confirmed Interview CVs (by Interview Date)],'HRT Application'[# of Interviewed CVs (by Interview Date)],BLANK())",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%"
          },
          {
            "name": "% Passed Interview CVs vs Confirmed Interview CVs (by Interview Date)",
            "expression": " DIVIDE('HRT Application'[# of Passed Interview CVs (by Interview Date)],'HRT Application'[# of Confirmed Interview CVs (by Interview Date)],BLANK())",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%"
          },
          {
            "name": "% Offered CVs vs Passed Interview CVs (by Offer Date)",
            "expression": " DIVIDE('HRT Application'[# of Offered CVs (by Offer Date)],'HRT Application'[# of Passed Interview CVs (by Interview Date)],BLANK())",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%"
          },
          {
            "name": "% Employed CVs vs Confirmed Interview CVs (by Assign Date)",
            "expression": " DIVIDE('HRT Application'[# of Employed CVs (by Assign Date)],[# of Confirmed Interview CVs (by Interview Date)],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Employed CVs vs Accepted Offer CVs (by Offer Date)",
            "expression": " DIVIDE('HRT Application'[# of Employed CVs (by Assign Date)],'HRT Application'[# of Accepted Offer CVs (by Offer Date)],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Employed CVs vs Qualified CVs (by Assign Date)",
            "expression": " DIVIDE('HRT Application'[# of Employed CVs (by Assign Date)],'HRT Application'[# of Qualified CVs],BLANK())",
            "formatString": "#,0.0%;-#,0.0%;#,0.0%"
          },
          {
            "name": "% Qualified CVs vs All CVs [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [% Qualifed CVs vs All CVs],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% QCVs Change vs Previous Year (Percentage Point)",
            "expression": " [% Qualifed CVs vs All CVs] - [% Qualified CVs vs All CVs [Previous Year]]]",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Offered CVs vs Interviewed CVs",
            "expression": " DIVIDE('HRT Application'[# of Offered CVs],'HRT Application'[# of Interviewed CVs],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Interviewed CVs vs Qualified CVs [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [% Interviewed CVs vs Qualified CVs],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Interviewed CVs Change vs Previous Year (Percentage Point)",
            "expression": " [% Interviewed CVs vs Qualified CVs] - [% Interviewed CVs vs Qualified CVs [Previous Year]]]",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Offered CVs vs Interviewed CVs [Previous Year]",
            "expression": [
              " ",
              "CALCULATE(",
              "    [% Offered CVs vs Interviewed CVs],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Offered CVs Change vs Previous Year (Percentage Point)",
            "expression": " [% Offered CVs vs Interviewed CVs] - [% Offered CVs vs Interviewed CVs [Previous Year]]]",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Employed CVs vs CVs",
            "expression": " DIVIDE('HRT Application'[# of Employed CVs],'HRT Application'[# of All CVs],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of UnQualified CVs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[IsQCV] = FALSE()),",
              "    KEEPFILTERS('HRT Application'[Status] = \"Rejection\")",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Failed Interview CVs",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Application'[ApplicationRecId]),",
              "    KEEPFILTERS('HRT Application'[IsInterviewedCV] = TRUE()),",
              "    KEEPFILTERS('HRT Application'[IsOfferedCV] = FALSE()),",
              "    KEEPFILTERS('HRT Application'[Status] = \"Rejection\")",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Accepted Offered CVs vs Passed Interview (by Interview Date)",
            "expression": " DIVIDE('HRT Application'[# of Accepted Offer CVs (by Offer Date)],'HRT Application'[# of Passed Interview CVs],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          }
        ]
      },
      {
        "name": "HRT Recruitment Project",
        "columns": [
          {
            "name": "DateKey",
            "dataType": "int64",
            "sourceColumn": "DateKey"
          },
          {
            "name": "CampusKey",
            "dataType": "string",
            "sourceColumn": "CampusKey"
          },
          {
            "name": "RORecId",
            "dataType": "string",
            "sourceColumn": "RORecId"
          },
          {
            "name": "OrderID",
            "dataType": "string",
            "sourceColumn": "OrderID"
          },
          {
            "name": "Legal",
            "dataType": "string",
            "sourceColumn": "Legal"
          },
          {
            "name": "Personincharge",
            "dataType": "string",
            "sourceColumn": "Personincharge"
          },
          {
            "name": "Qty",
            "dataType": "int64",
            "sourceColumn": "Qty"
          },
          {
            "name": "ROProgramType",
            "dataType": "string",
            "sourceColumn": "ROProgramType"
          },
          {
            "name": "TeacherType",
            "dataType": "string",
            "sourceColumn": "TeacherType"
          },
          {
            "name": "Campus",
            "dataType": "string",
            "sourceColumn": "Campus"
          },
          {
            "name": "OpenDate",
            "dataType": "dateTime",
            "sourceColumn": "OpenDate"
          },
          {
            "name": "CloseDate",
            "dataType": "dateTime",
            "sourceColumn": "CloseDate"
          },
          {
            "name": "AssignDate",
            "dataType": "dateTime",
            "sourceColumn": "AssignDate"
          },
          {
            "name": "ApplicationCode",
            "dataType": "string",
            "sourceColumn": "ApplicationCode"
          },
          {
            "name": "ApplicationRecId",
            "dataType": "string",
            "sourceColumn": "ApplicationRecId"
          },
          {
            "name": "ApplicantCode",
            "dataType": "string",
            "sourceColumn": "ApplicantCode"
          },
          {
            "name": "NameCode",
            "dataType": "string",
            "sourceColumn": "NameCode"
          },
          {
            "name": "Person",
            "dataType": "string",
            "sourceColumn": "Person"
          },
          {
            "name": "Status",
            "dataType": "string",
            "sourceColumn": "Status"
          },
          {
            "name": "CompletionDays",
            "dataType": "int64",
            "sourceColumn": "CompletionDays"
          },
          {
            "name": "RecruitmentProjectKey",
            "dataType": "string",
            "sourceColumn": "RecruitmentProjectKey"
          },
          {
            "name": "ApplicationKey",
            "dataType": "string",
            "sourceColumn": "ApplicationKey"
          },
          {
            "name": "CampusGroup",
            "dataType": "string",
            "sourceColumn": "CampusGroup"
          },
          {
            "name": "Area",
            "dataType": "string",
            "sourceColumn": "Area"
          },
          {
            "name": "SLAStatus",
            "dataType": "string",
            "sourceColumn": "SLAStatus"
          },
          {
            "name": "CreatedOn",
            "dataType": "dateTime",
            "sourceColumn": "CreatedOn"
          },
          {
            "name": "ModifiedOn",
            "dataType": "dateTime",
            "sourceColumn": "ModifiedOn"
          },
          {
            "name": "PersonnelActionType",
            "dataType": "string",
            "sourceColumn": "PersonnelActionType"
          },
          {
            "name": "OrderType",
            "dataType": "string",
            "sourceColumn": "OrderType"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_HRT_RECRUITMENT_PROJECT_F = Source{[Schema=\"DWH\",Item=\"VW_HRT_RECRUITMENT_PROJECT_F\"]}[Data]",
                "in",
                "    DWH_VW_HRT_RECRUITMENT_PROJECT_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Recruitment Days",
            "expression": [
              " ",
              "var from_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "Return CALCULATE(SUM('HRT Recruitment Project'[CompletionDays]),'HRT Recruitment Project'[CompletionDays]<>BLANK(),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Order",
            "expression": " DISTINCTCOUNT('HRT Recruitment Project'[RORecId])",
            "formatString": "#,0"
          },
          {
            "name": "# of Unfilled Order With Tentative",
            "expression": " CALCULATE(DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),'HRT Recruitment Project'[SLAStatus] IN {\"In Progress With Tentative\"})",
            "formatString": "#,0"
          },
          {
            "name": "# of Unfilled Order Without Tentative",
            "expression": " CALCULATE(DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),'HRT Recruitment Project'[SLAStatus] IN {\"In Progress Without Tentative\"})",
            "formatString": "#,0"
          },
          {
            "name": "# of Order Backlog",
            "expression": [
              "",
              "-- 1. Bắt ngày từ Slicer Calendar bình thường",
              "VAR vFromDate = MIN('Calendar'[Date])",
              "VAR vToDate   = MAX('Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),",
              "    ",
              "    -- 2. Xóa bỏ hoàn toàn bộ lọc của Calendar ảnh hưởng lên bảng dữ liệu tuyển dụng",
              "    REMOVEFILTERS('Calendar'),",
              "    ",
              "    -- 3. Ép hệ thống quét qua toàn bộ dữ liệu lịch sử của CloseDate và AssignDate",
              "    KEEPFILTERS(",
              "        ('HRT Recruitment Project'[CloseDate] >= vFromDate",
              "        && 'HRT Recruitment Project'[CloseDate] <= vToDate)",
              "        ||",
              "        (",
              "        \t'HRT Recruitment Project'[CloseDate] < vFromDate",
              "            \t&&",
              "\t (",
              "\t       ISBLANK('HRT Recruitment Project'[AssignDate])",
              "\t       || 'HRT Recruitment Project'[AssignDate] = DATE(1900,1,1)",
              "\t       || 'HRT Recruitment Project'[AssignDate] >= vFromDate",
              "\t )",
              "         )",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Order Backlog [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Order Backlog],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Order Backlog Growth [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Order Backlog] -  [# of Order Backlog [Previous Year]]], ",
              "    [# of Order Backlog [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Late Order Backlog",
            "expression": [
              "",
              "-- Order được fill trễ, closedate< fromdate, assigndate trong tháng",
              "-- 1. Bắt ngày từ Slicer Calendar bình thường",
              "VAR vFromDate = MIN('Calendar'[Date])",
              "VAR vToDate   = MAX('Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),",
              "    ",
              "    -- 2. Xóa bỏ hoàn toàn bộ lọc của Slicer Calendar",
              "    REMOVEFILTERS('Calendar'),",
              "    ",
              "    -- 3. Giữ lại các bộ lọc khác (Phòng ban, vị trí, dòng raw data...) ",
              "    -- và gộp thêm cụm điều kiện logic của Backlog Late vào",
              "    KEEPFILTERS(",
              "        'HRT Recruitment Project'[CloseDate] < 'HRT Recruitment Project'[AssignDate]",
              "            &&",
              "        'HRT Recruitment Project'[AssignDate] >= vFromDate",
              "            &&",
              "        'HRT Recruitment Project'[AssignDate] <= vToDate",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Late Order Backlog [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Late Order Backlog],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Overdue Order Backlog",
            "expression": [
              "",
              "-- Quá hạn nhưng chưa được fill trong kỳ báo cáo",
              "-- 1. Bắt ngày từ Slicer Calendar bình thường",
              "VAR vFromDate = MIN('Calendar'[Date])",
              "VAR vToDate   = MAX('Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),",
              "    ",
              "    -- 2. Xóa bỏ hoàn toàn bộ lọc của Slicer Calendar",
              "    REMOVEFILTERS('Calendar'),",
              "    ",
              "    -- 3. Giữ lại các bộ lọc khác và gộp điều kiện Overdue + logic Backlog ngày tháng vào",
              "    KEEPFILTERS(",
              "         vToDate - 'HRT Recruitment Project'[CloseDate] >= 1",
              "            &&",
              "        'HRT Recruitment Project'[CloseDate] < TODAY()",
              "            &&",
              "        (",
              "            ISBLANK('HRT Recruitment Project'[AssignDate])",
              "            || 'HRT Recruitment Project'[AssignDate] = DATE(1900,1,1)",
              "            || 'HRT Recruitment Project'[AssignDate] > vToDate",
              "        )",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Overdue Order Backlog [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "   [# of Overdue Order Backlog],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Outstanding Order",
            "expression": [
              "",
              "-- Order quá hạn từ các kỳ báo cáo trước",
              "-- 1. Bắt ngày từ Slicer Calendar bình thường",
              "VAR vFromDate = MIN('Calendar'[Date])",
              "VAR vToDate   = MAX('Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),",
              "    ",
              "    -- 2. Xóa bỏ hoàn toàn bộ lọc của Calendar ảnh hưởng lên bảng dữ liệu tuyển dụng",
              "    REMOVEFILTERS('Calendar'),",
              "    ",
              "    -- 3. Ép hệ thống quét qua toàn bộ dữ liệu lịch sử của CloseDate và AssignDate",
              "    KEEPFILTERS(",
              "        (",
              "        \t'HRT Recruitment Project'[CloseDate] < vFromDate",
              "            \t&&",
              "\t (",
              "\t       ISBLANK('HRT Recruitment Project'[AssignDate])",
              "\t       || 'HRT Recruitment Project'[AssignDate] = DATE(1900,1,1)",
              "\t       || 'HRT Recruitment Project'[AssignDate] >= vFromDate",
              "\t )",
              "         )",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Outstanding Order [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Outstanding Order],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Outstanding Order Growth [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Outstanding Order] - [# of Outstanding Order [Previous Year]]],",
              "    [# of Outstanding Order [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Order [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Order],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "0"
          },
          {
            "name": "% Order Growth [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Order] -  [# of Order [Previous Year]]], ",
              "    [# of Order [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Late Order Backlog",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Late Order Backlog], ",
              "    [# of Order Backlog],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Overdue Order Backlog",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Overdue Order Backlog], ",
              "    [# of Order Backlog],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Not Yet Due Order",
            "expression": [
              " ",
              "-- Order chưa đến hạn: closedate trong kỳ BC nhưng chưa được fill",
              "VAR vFromDate = MIN('Calendar'[Date])",
              "VAR vToDate   = MAX('Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),",
              "        ",
              "    -- 3. Giữ lại các bộ lọc khác và gộp điều kiện Overdue + logic Backlog ngày tháng vào",
              "    KEEPFILTERS(",
              "            'HRT Recruitment Project'[CloseDate] >= TODAY()",
              "                &&",
              "            (ISBLANK('HRT Recruitment Project'[AssignDate])",
              "            || 'HRT Recruitment Project'[AssignDate] = DATE(1900,1,1)",
              "            || 'HRT Recruitment Project'[AssignDate] > vToDate)",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Not Yet Due Order",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Not Yet Due Order], ",
              "    [# of Order],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Overdue 1-30 days",
            "expression": [
              "",
              "VAR vToDate = MAX('Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),",
              "    -- 2. Xóa bỏ hoàn toàn bộ lọc của Calendar ảnh hưởng lên bảng dữ liệu tuyển dụng",
              "    REMOVEFILTERS('Calendar'),        ",
              "    -- Giữ nguyên bộ lọc Calendar và các Slicer khác, chỉ gộp thêm điều kiện quá hạn",
              "    KEEPFILTERS(",
              "            (ISBLANK('HRT Recruitment Project'[AssignDate])",
              "            || 'HRT Recruitment Project'[AssignDate] = DATE(1900,1,1)",
              "            || 'HRT Recruitment Project'[AssignDate] > vToDate)",
              "            &&",
              "        'HRT Recruitment Project'[CloseDate] < TODAY()",
              "            &&",
              "            ( ",
              "                vToDate - 'HRT Recruitment Project'[CloseDate] >= 1 ",
              "                && vToDate - 'HRT Recruitment Project'[CloseDate] <= 30 ",
              "            )",
              "        )",
              "    )"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Overdue 31-60 days",
            "expression": [
              "",
              "VAR vToDate = MAX('Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),",
              "    REMOVEFILTERS('Calendar'),        ",
              "    -- Giữ nguyên bộ lọc Calendar và các Slicer khác, chỉ gộp thêm điều kiện quá hạn",
              "    KEEPFILTERS(",
              "            (ISBLANK('HRT Recruitment Project'[AssignDate])",
              "            || 'HRT Recruitment Project'[AssignDate] = DATE(1900,1,1)",
              "            || 'HRT Recruitment Project'[AssignDate] > vToDate)",
              "            &&",
              "            ( ",
              "                vToDate - 'HRT Recruitment Project'[CloseDate] >= 31",
              "                && vToDate - 'HRT Recruitment Project'[CloseDate] <= 60 ",
              "            )",
              "        )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Overdue >60 days",
            "expression": [
              "",
              "VAR vToDate = MAX('Calendar'[Date])",
              "",
              "RETURN",
              "CALCULATE(",
              "    DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),",
              "    REMOVEFILTERS('Calendar'),        ",
              "    -- Giữ nguyên bộ lọc Calendar và các Slicer khác, chỉ gộp thêm điều kiện quá hạn",
              "    KEEPFILTERS(",
              "            (ISBLANK('HRT Recruitment Project'[AssignDate])",
              "            || 'HRT Recruitment Project'[AssignDate] = DATE(1900,1,1)",
              "            || 'HRT Recruitment Project'[AssignDate] > vToDate)",
              "            &&",
              "            ( ",
              "                vToDate - 'HRT Recruitment Project'[CloseDate] > 60",
              "            )",
              "        )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Filled Order (by Assign Date)",
            "expression": [
              " ",
              "CALCULATE(DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),'HRT Recruitment Project'[SLAStatus] IN {\"On Time\",\"Late\"},",
              "    USERELATIONSHIP(",
              "        'Calendar'[Date],",
              "        'HRT Recruitment Project'[AssignDate]",
              "    )",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Filled Order (by Assign Date) [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Filled Order (by Assign Date)],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% Filled Order (by Assign Date)",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Filled Order (by Assign Date)], ",
              "    [# of Order Backlog],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Filled Order (by Assign Date) [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Filled Order (by Assign Date) [Previous Year]]],",
              "    [# of Order Backlog [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Filled Order (by Assign Date) Change vs Previous Year (Percentage Point)",
            "expression": " [% Filled Order (by Assign Date)]- [% Filled Order (by Assign Date) [Previous Year]]]",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Late Order Backlog [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Late Order Backlog [Previous Year]]], ",
              "    [# of Order Backlog [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Overdue Order Backlog [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of Overdue Order Backlog [Previous Year]]], ",
              "    [# of Order Backlog [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Late Order Change vs Previous Year (Percentage Point)",
            "expression": " [% Late Order Backlog]- [% Late Order Backlog [Previous Year]]]",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% Overdue Order Backlog Change vs Previous Year (Percentage Point)",
            "expression": " [% Overdue Order Backlog]- [% Overdue Order Backlog [Previous Year]]]",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of On-Time Order",
            "expression": " CALCULATE(DISTINCTCOUNT('HRT Recruitment Project'[RORecId]),'HRT Recruitment Project'[SLAStatus] = \"On Time\")",
            "formatString": "#,0"
          },
          {
            "name": "# of On-Time Order [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of On-Time Order],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "% On-Time Order [Previous Year]",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of On-Time Order [Previous Year]]],",
              "    [# of Order [Previous Year]]],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% On-Time Order",
            "expression": [
              "",
              "DIVIDE(",
              "    [# of On-Time Order], ",
              "    [# of Order],",
              "    BLANK()",
              ")"
            ],
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "% On-Time Order Change vs Previous Year (Percentage Point)",
            "expression": " [% On-Time Order]- [% On-Time Order [Previous Year]]]",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of Average Recruitment Days",
            "expression": " CALCULATE(AVERAGE('HRT Recruitment Project'[CompletionDays]),'HRT Recruitment Project'[CompletionDays]<>BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "# of Average Recruitment Days [Previous Year]",
            "expression": [
              "",
              "CALCULATE(",
              "   [# of Average Recruitment Days],",
              "    DATEADD(Calendar[Date], -1, YEAR)",
              ")"
            ],
            "formatString": "#,0"
          },
          {
            "name": "# of Average Recruitment Days Delta [Previous Year]",
            "expression": [
              "",
              "[# of Average Recruitment Days] - [# of Average Recruitment Days [Previous Year]]]"
            ],
            "formatString": "#,0"
          }
        ]
      },
