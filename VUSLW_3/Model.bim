          },
          {
            "name": "ListLevelCode",
            "dataType": "string",
            "sourceColumn": "ListLevelCode"
          },
          {
            "type": "calculated",
            "name": "CheckMid",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "IF(AND([MidTerm]>=TODAY()-7,[MidTerm]<=TODAY()),1,0)",
            "formatString": "0"
          },
          {
            "type": "calculated",
            "name": "CheckFinal",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "IF(AND([DateOfClose]>=TODAY()-7,[DateOfClose]<=TODAY()),1,0)",
            "formatString": "0"
          },
          {
            "type": "calculated",
            "name": "CheckMidMonth",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "IF(AND([MidTerm]>=EOMONTH(TODAY(), -1) + 1,[MidTerm]<=TODAY()),1,0)",
            "formatString": "0"
          },
          {
            "type": "calculated",
            "name": "CheckFinalMonth",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "IF(AND([DateOfClose]>=EOMONTH(TODAY(), -1) + 1,[DateOfClose]<=EOMONTH(TODAY(), 0)),1,0)"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_LIST_CLASS_SCHEDULE_NONELT = Source{[Schema=\"DWH\",Item=\"VW_LIST_CLASS_SCHEDULE_NONELT\"]}[Data]",
                "in",
                "    DWH_VW_LIST_CLASS_SCHEDULE_NONELT"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Teaching Hours NonELT",
            "expression": " CALCULATE(Sum('List Class NonELT'[TeachingHours]))",
            "formatString": "0.0"
          },
          {
            "name": "# of DC class",
            "expression": " CALCULATE(COUNT('List Class NonELT'[Class Key]),'List Class NonELT'[CourseTypeCode]= \"DC\")"
          },
          {
            "name": "# of CMath class",
            "expression": " CALCULATE(COUNT('List Class NonELT'[Class Key]),'List Class NonELT'[CourseTypeCode]= \"CMath\")"
          },
          {
            "name": "# of DD class",
            "expression": " CALCULATE(COUNT('List Class NonELT'[Class Key]),'List Class NonELT'[CourseTypeCode]= \"DD\")"
          },
          {
            "name": "# of DC class Opening",
            "expression": " CALCULATE(DISTINCTCOUNT('List Class NonELT'[Class Key]),'List Class NonELT'[CourseTypeCode]= \"DC\",'List Class NonELT'[Status] =\"Opening\")"
          },
          {
            "name": "# of DC class Happening",
            "expression": " CALCULATE(DISTINCTCOUNT('List Class NonELT'[Class Key]),'List Class NonELT'[CourseTypeCode]= \"DC\",'List Class NonELT'[Status] =\"Happening\")"
          },
          {
            "name": "# of DC class Ending",
            "expression": " CALCULATE(DISTINCTCOUNT('List Class NonELT'[Class Key]),'List Class NonELT'[CourseTypeCode]= \"DC\",'List Class NonELT'[Status] =\"Ending\")"
          },
          {
            "name": "# of DD class Opening",
            "expression": " CALCULATE(DISTINCTCOUNT('List Class NonELT'[Class Key]),'List Class NonELT'[CourseTypeCode]= \"DD\",'List Class NonELT'[Status] =\"Opening\")"
          },
          {
            "name": "# of DD class Happening",
            "expression": " CALCULATE(DISTINCTCOUNT('List Class NonELT'[Class Key]),'List Class NonELT'[CourseTypeCode]= \"DD\",'List Class NonELT'[Status] =\"Happening\")"
          },
          {
            "name": "# of DD class Ending",
            "expression": " CALCULATE(DISTINCTCOUNT('List Class NonELT'[Class Key]),'List Class NonELT'[CourseTypeCode]= \"DD\",'List Class NonELT'[Status] =\"Ending\")"
          },
          {
            "name": "# Class of Test in MidMonth",
            "expression": [
              "",
              "\t\t\tCALCULATE(",
              "\t\t\t\tSUMX(VALUES('List Class NonELT'[MidTerm]),[Total check]),'List Class NonELT'[CheckMidMonth] = 1)",
              "\t\t\t",
              ""
            ]
          },
          {
            "name": "# Class of Test in FinMonth",
            "expression": [
              "",
              "\t\t\tCALCULATE(",
              "\t\t\t\tSUMX(VALUES('List Class NonELT'[DateOfClose]),[Total check]),'List Class NonELT'[CheckFinalMonth] = 1)",
              "\t\t\t",
              ""
            ]
          },
          {
            "name": "Total check",
            "expression": " CALCULATE(DISTINCTCOUNT('List Class NonELT'[ListLevelCode]))"
          },
          {
            "name": "Sortmeasure",
            "expression": [
              " ",
              "VAR teacher_code = SELECTEDVALUE ( 'List Class NonELT'[TeacherCode])",
              "VAR coursetype  = SELECTEDVALUE ( 'List Class NonELT'[CourseTypeCode] )",
              "VAR campus_code = SELECTEDVALUE('List Class NonELT'[Campus Code])",
              "VAR tmp =",
              "    FILTER (",
              "        ALL ( 'List Class NonELT' ),",
              "        'List Class NonELT'[TeacherCode] = teacher_code",
              "            && 'List Class NonELT'[CourseTypeCode] = coursetype ",
              "            && 'List Class NonELT'[Campus Code] = campus_code",
              "            )",
              "RETURN",
              "    RANKX ( tmp, CALCULATE ( SELECTEDVALUE ( 'List Class NonELT'[Date] ) ),, DESC, DENSE )"
            ]
          },
          {
            "name": "# of Class NonELT",
            "expression": [
              " ",
              "--var t_date = max('Calendar'[Date Key])",
              " CALCULATE(DISTINCTCOUNT('List Class NonELT'[Class Key]))"
            ]
          }
        ]
      },
