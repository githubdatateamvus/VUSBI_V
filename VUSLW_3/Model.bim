        "measures": [
          {
            "name": "# of Budget Approved",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Budget Management'[Budget Approved])",
              ")"
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Budget (Active student)",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Budget Management'[Budget (Active student)])",
              ")",
              "",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Actual Expense",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('Budget Management'[Actual Expense])",
              ")",
              "",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Budget Remaining",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Budget (Active student)] - [# of Actual Expense]",
              ")",
              "",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% of Actual Expense",
            "expression": [
              "",
              "CALCULATE(",
              "    DIVIDE(",
              "        [# of Actual Expense],",
              "        [# of Budget (Active student)],",
              "        0",
              "    )",
              ")",
              ""
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of Full Year Budget Approved",
            "expression": [
              "",
              "CALCULATE(",
              "    [# of Budget Approved],",
              "    ALLEXCEPT('Calendar', 'Calendar'[Year])",
              ")",
              ""
            ],
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
