        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_LEAD_POOL_RECYCLE_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_LEAD_POOL_RECYCLE_F\"]}[Data]",
                "in",
                "    DWH_VW_ASA_LEAD_POOL_RECYCLE_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Active Lead",
            "expression": "CALCULATE('ASA Lead Pool Recycle'[# of Assigned Lead] - 'ASA Lead Pool Recycle'[# of Withdrawal Recycle Lead 48h])"
          },
          {
            "name": "# of Call Lead",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Lead Pool Recycle'[LeadKey]),",
              "    FILTER(",
              "        'ASA Lead Pool Recycle',",
              "        'ASA Lead Pool Recycle'[FirstCall] >= 'ASA Lead Pool Recycle'[AssignedOn] && NOT(ISBLANK('ASA Lead Pool Recycle'[AssignedOn])))",
              "    )"
            ]
          },
          {
            "name": "# of Call Success Lead",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Lead Pool Recycle'[LeadKey]),",
              "    FILTER(",
              "        'ASA Lead Pool Recycle',",
              "        'ASA Lead Pool Recycle'[FirstCallSuccess] >= 'ASA Lead Pool Recycle'[AssignedOn] && NOT(ISBLANK('ASA Lead Pool Recycle'[AssignedOn]))",
              "         && 'ASA Lead Pool Recycle'[FirstCallSuccess] >= 'ASA Lead Pool Recycle'[FirstCall])",
              "    )"
            ]
          },
          {
            "name": "# of Care Lead",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Lead Pool Recycle'[LeadKey]),",
              "    FILTER(",
              "        'ASA Lead Pool Recycle',",
              "        'ASA Lead Pool Recycle'[CareDate] >= 'ASA Lead Pool Recycle'[AssignedOn] && NOT(ISBLANK('ASA Lead Pool Recycle'[AssignedOn])))",
              "    )"
            ]
          },
          {
            "name": "# of Appointment Lead",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Lead Pool Recycle'[LeadKey]),",
              "    FILTER(",
              "        'ASA Lead Pool Recycle',",
              "        'ASA Lead Pool Recycle'[AppointmentAt] >= 'ASA Lead Pool Recycle'[AssignedOn] && NOT(ISBLANK('ASA Lead Pool Recycle'[AssignedOn])))",
              "    )"
            ]
          },
          {
            "name": "# of Placement Test Lead",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Lead Pool Recycle'[LeadKey]),",
              "    FILTER(",
              "        'ASA Lead Pool Recycle',",
              "        'ASA Lead Pool Recycle'[PlacementTest] >= 'ASA Lead Pool Recycle'[AssignedOn] && NOT(ISBLANK('ASA Lead Pool Recycle'[AssignedOn])))",
              "    )"
            ]
          },
          {
            "name": "# of Show Lead",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Lead Pool Recycle'[LeadKey]),",
              "    FILTER(",
              "        'ASA Lead Pool Recycle',",
              "        'ASA Lead Pool Recycle'[ShowDate] >= 'ASA Lead Pool Recycle'[AssignedOn] && NOT(ISBLANK('ASA Lead Pool Recycle'[AssignedOn])))",
              "    )"
            ]
          },
          {
            "name": "# of Sign Lead",
            "expression": [
              "",
              "CALCULATE(",
              "    DISTINCTCOUNT('ASA Lead Pool Recycle'[LeadKey]),",
              "    FILTER(",
              "        'ASA Lead Pool Recycle',",
              "        'ASA Lead Pool Recycle'[SignDate] >= 'ASA Lead Pool Recycle'[AssignedOn] && NOT(ISBLANK('ASA Lead Pool Recycle'[AssignedOn])))",
              "    )"
            ]
          },
          {
            "name": "# of Inactive Lead",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Lead Pool Recycle'[LeadKey]),FILTER('ASA Lead Pool Recycle',(ISBLANK('ASA Lead Pool Recycle'[AssignedOn]))))"
          },
          {
            "name": "# of Withdrawal Recycle Lead 48h",
            "expression": " CALCULATE(COUNT('ASA Lead Pool Recycle'[IsWithdrawalBy48hAssigned]),FILTER('ASA Lead Pool Recycle','ASA Lead Pool Recycle'[IsWithdrawalBy48hAssigned] = 1))"
          },
          {
            "name": "# of Assigned Lead",
            "expression": "CALCULATE(DISTINCTCOUNT('ASA Lead Pool Recycle'[LeadKey]),FILTER('ASA Lead Pool Recycle',NOT((ISBLANK('ASA Lead Pool Recycle'[AssignedOn])))))"
          }
        ]
      },
