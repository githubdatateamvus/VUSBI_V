          },
          {
            "name": "Customer Id Zalo",
            "dataType": "string",
            "sourceColumn": "CUSTOMER_ID_ZALO"
          },
          {
            "name": "Customer Name",
            "dataType": "string",
            "sourceColumn": "CUSTOMER_NAME"
          },
          {
            "name": "Customer Phone",
            "dataType": "string",
            "sourceColumn": "CUSTOMER_PHONE"
          },
          {
            "name": "Total Customer Message",
            "dataType": "int64",
            "sourceColumn": "TOTAL_CUSTOMER_MESSAGE"
          },
          {
            "name": "Campus Key",
            "dataType": "string",
            "sourceColumn": "CAMPUS_KEY"
          },
          {
            "name": "Period",
            "dataType": "string",
            "sourceColumn": "PERIOD"
          },
          {
            "name": "Full Name",
            "dataType": "string",
            "sourceColumn": "FULL_NAME"
          },
          {
            "name": "Object Type",
            "dataType": "string",
            "sourceColumn": "OBJECT_TYPE"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_W_PANCAKE_CHAT_ZALO = Source{[Schema=\"DWH\",Item=\"W_PANCAKE_CHAT_ZALO\"]}[Data]",
                "in",
                "    DWH_W_PANCAKE_CHAT_ZALO"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Customer Zalo",
            "expression": "CALCULATE(DISTINCTCOUNT('Pancake Chat Zalo'[Customer Id]))"
          },
          {
            "name": "# of Staff Message Send",
            "expression": " CALCULATE(SUm('Pancake Chat Zalo'[Total Staff Message]))"
          },
          {
            "name": "# of Customer Message Response",
            "expression": " CALCULATE(SUm('Pancake Chat Zalo'[Total Customer Message]))"
          },
          {
            "name": "# of ActiveStudentChatZalo",
            "expression": " Calculate('Pancake Chat Zalo'[# of Customer Zalo], FILTER('Pancake Chat Zalo',LEFT('Pancake Chat Zalo'[Object Type],17) = \"Hoc Vien Dang Hoc\"))"
          },
          {
            "name": "# of KKHTChatZalo",
            "expression": [
              " Calculate('Pancake Chat Zalo'[# of Customer Zalo], ",
              "                               FILTER('Pancake Chat Zalo',",
              "\t\t\t\t\t\t\t\t\t\t\t\t\t\t OR(",
              "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\tLEFT('Pancake Chat Zalo'[Object Type],17) = \"Kết khóa hết tiền\"",
              "\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t,LEFT('Pancake Chat Zalo'[Object Type],4) = \"KKHT\"",
              "\t\t\t\t\t\t\t\t\t\t\t\t\t\t   )",
              "",
              "\t\t\t\t\t\t\t\t\t )",
              "\t\t\t\t\t\t\t )"
            ]
          },
          {
            "name": "# of PendingChatZalo",
            "expression": " Calculate('Pancake Chat Zalo'[# of Customer Zalo], FILTER('Pancake Chat Zalo',LEFT('Pancake Chat Zalo'[Object Type],9) = \"Tạm ngưng\"))"
          },
          {
            "name": "# of RecycleNewChatZalo",
            "expression": " Calculate('Pancake Chat Zalo'[# of Customer Zalo], FILTER('Pancake Chat Zalo',LEFT('Pancake Chat Zalo'[Object Type],10) = \"RecycleNEW\"))"
          },
          {
            "name": "# of RecyclePendingChatZalo",
            "expression": " Calculate('Pancake Chat Zalo'[# of Customer Zalo], FILTER('Pancake Chat Zalo',LEFT('Pancake Chat Zalo'[Object Type],14) = \"RecyclePENDING\"))"
          },
          {
            "name": "# of ShowChatZalo",
            "expression": " Calculate('Pancake Chat Zalo'[# of Customer Zalo], FILTER('Pancake Chat Zalo',LEFT('Pancake Chat Zalo'[Object Type],13) = \"Hoc Vien Show\"))"
          },
          {
            "name": "# of SNSChatZalo",
            "expression": " Calculate('Pancake Chat Zalo'[# of Customer Zalo], FILTER('Pancake Chat Zalo',LEFT('Pancake Chat Zalo'[Object Type],3) = \"SNS\"))"
          },
          {
            "name": "# of OtherChatZalo",
            "expression": "'Pancake Chat Zalo'[# of Customer Zalo]-'Pancake Chat Zalo'[# of KKHTChatZalo]-'Pancake Chat Zalo'[# of PendingChatZalo]-'Pancake Chat Zalo'[# of RecycleNewChatZalo]-'Pancake Chat Zalo'[# of RecyclePendingChatZalo]-'Pancake Chat Zalo'[# of SNSChatZalo]-'Pancake Chat Zalo'[# of ShowChatZalo]-'Pancake Chat Zalo'[# of ActiveStudentChatZalo]-'Pancake Chat Zalo'[# of LeadChatZalo]"
          },
          {
            "name": "# of LeadChatZalo",
            "expression": " Calculate('Pancake Chat Zalo'[# of Customer Zalo], FILTER('Pancake Chat Zalo',LEFT('Pancake Chat Zalo'[Period],4) = \"Lead\"))"
          }
        ]
      },
