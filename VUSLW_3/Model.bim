            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Enrol PD Revenue Amt",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]))",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of New Enrol PD 2K Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=2, 'ASA Target'[Target Key]=\"Two\")",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD Over 4K Target",
