          {
            "name": "Birthday",
            "dataType": "dateTime",
            "sourceColumn": "Birthday"
          },
          {
            "name": "Create On",
            "dataType": "dateTime",
            "sourceColumn": "Create On",
            "formatString": "yyyy-MM-dd HH:mm:ss",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"DateTimeCustom\"><DateTimes><DateTime LCID=\"1033\" Group=\"GeneralLongDateTime\" FormatString=\"yyyy-MM-dd HH:mm:ss\" /></DateTimes></Format>"
              }
            ]
          },
          {
            "type": "calculated",
            "name": "Year Of DOB",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF(",
              "  ISBLANK([Birthday]),",
              "  \"\",",
              "  IF(",
              "    YEAR([Birthday]) >= 1996,",
              "    \"Y-\" & YEAR([Birthday]),",
              "    \"G-\"",
              "    & (",
              "        1985",
              "        - (ROUND((1995 - YEAR([Birthday])) / 10,0) * 10)",
              "      )",
              "    & \"-\"",
              "    & (",
              "        1995",
              "        - (ROUND((1995 - YEAR([Birthday])) / 10,0) * 10)",
              "      )",
              "  )",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "Group Of Age",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " IF(year(TODAY()) - year(Student[Birthday])<= 29, \"Group Under 29 Age\",IF(AND((year(TODAY()) - year(Student[Birthday])>= 30),(year(TODAY()) - year(Student[Birthday])< 50)),\"Group From 30 -50 Age\", \"Group From Over 50 Age\"))"
          },
          {
            "name": "IsLoginLMS",
            "dataType": "string",
            "sourceColumn": "IsLoginLMS"
          },
          {
            "name": "Learn English Center Name",
            "dataType": "string",
            "sourceColumn": "Learn English Center Name"
          },
          {
            "name": "Study Objective Name",
            "dataType": "string",
            "sourceColumn": "Study Objective Name"
          },
          {
            "name": "Study Objective Code",
            "dataType": "string",
            "sourceColumn": "Study Objective Code"
          }
        ],
