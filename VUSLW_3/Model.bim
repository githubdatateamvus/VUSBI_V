            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": [
              " IF( FORMAT( 'ASA Overview PD'[Date of Invoice], \"yyyy-MM-dd\") = FORMAT('ASA Overview PD'[Showed Date],\"yyyy-MM-dd\") , 1, 0)",
              " "
            ]
          },
          {
            "type": "calculated",
            "name": "ShowMonth equal SignMonth",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "IF( FORMAT( 'ASA Overview PD'[Date of Invoice], \"yyyy-MM\") = FORMAT('ASA Overview PD'[Showed Date],\"yyyy-MM\") , 1, 0)"
          },
          {
            "type": "calculated",
            "name": "Year Month Open Date PD",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " FORMAT('ASA Overview PD'[Class Open Date Study], \"yyyy-MM\" )"
          },
          {
            "type": "calculated",
            "name": "SAME PD-OD",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": " IF(AND('ASA Overview PD'[First Date Of Study] <> DATE(1900, 1, 1),ISBLANK('ASA Overview PD'[First Date Of Study])=FALSE()), \"PD-OD\",\"NO\" )"
          },
          {
            "name": "Use Wallet",
            "dataType": "double",
            "sourceColumn": "Use Wallet"
          },
          {
            "name": "% CR Show > Sign YTD",
            "dataType": "int64",
            "isHidden": true,
            "sourceColumn": "Date Key",
            "displayFolder": "Attribute"
          },
          {
            "name": "score_category",
            "dataType": "string",
            "sourceColumn": "score_category"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_OVERVIEW_PD_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_OVERVIEW_PD_F\"]}[Data],",
                "    #\"Renamed Columns\" = Table.RenameColumns(DWH_VW_ASA_OVERVIEW_PD_F,{{\"MainCourseFlag\", \"Main Course Flag\"}})",
                "in",
                "    #\"Renamed Columns\""
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Enrol PD",
            "expression": " [# of New Enrol PD]+[# of Re Enrol PD]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol PD",
            "expression": [
              " SWITCH(SELECTEDVALUE('Invoice Type'[Invoice Type Name]),",
              "\t\"New\",0,",
              "\t\"Re\",CALCULATE(SUM('ASA Overview PD'[Number Of Re Enrol]),ALL('Invoice Type')),",
              "\tCALCULATE(SUM('ASA Overview PD'[Number Of Re Enrol])))",
              "\t",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD 3K",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview PD'[Invoice ID]),'Package Course'[Package Course Group]=\"3K\",'ASA Overview PD'[Type Fee] = \"HP\")",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD Over 4K",
            "expression": " CALCULATE(DISTINCTCOUNT('ASA Overview PD'[Invoice ID]),'Package Course'[Package Course Group]=\">=4K\",'ASA Overview PD'[Type Fee] = \"HP\")",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD MTD",
            "expression": [
              " /*",
              "var from_date = min('Calendar'[First Day Of Month])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview PD'[NumberOfEnrol]),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)",
              "*/",
              "CALCULATE([# of Enrol PD],DATESMTD( 'Calendar'[Date]))"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD QTD",
            "expression": [
              " ",
              "var from_date = min('Calendar'[First Day Of Quarter])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview PD'[Number Of Enrol]),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol PD in Period MTD vs LM",
            "expression": " DIVIDE([# of Enrol PD in the period MTD],[# of Enrol PD LM],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD in the period QTD",
            "expression": [
              " ",
              "var from_date = min('Calendar'[First Day Of Quarter])",
              "var from_report_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview PD'[Number Of Enrol]),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date && 'Calendar'[Date] >= from_report_date)"
            ],
            "displayFolder": "Enrol"
          },
          {
            "name": "% CR",
            "expression": " ROUND(DIVIDE([# of New Enrol PD],'ASA Enquiries'[# of Enquiries],BLANK()),2)",
            "formatString": "#,0%;-#,0%;#,0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD Package",
            "expression": " [# of Enrol PD 2K] + [# of Enrol PD 3K] + [# of Enrol PD Over 4K]",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "Enrol PD Revenue 2K Amt",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),'Package Course'[Package Course Group]=\"2K\")",
            "displayFolder": "Revenue"
          },
          {
            "name": "Enrol PD Revenue Over 4K Amt",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]),'Package Course'[Package Course Group]=\">=4K\")",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of New Enrol PD 1K Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=2, 'ASA Target'[Target Key]=\"One\")",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD 3K Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=2, 'ASA Target'[Target Key]=\"Three\")",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of New Enrol PD Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=2, 'ASA Target'[Target Key]=\"TotalTarget\")",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol PD 2K Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=3, 'ASA Target'[Target Key]=\"Two\")",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Re Enrol PD Over 4K Target",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=3, 'ASA Target'[Target Key]=\"Four\")",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD 1K Target",
            "expression": " [# of New Enrol PD 1K Target] + [# of Re Enrol PD 1K Target]",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD 3K Target",
            "expression": " [# of New Enrol PD 3K Target] + [# of Re Enrol PD 3K Target]",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD Target",
            "expression": " [# of New Enrol PD Target] + [# of Re Enrol PD Target]",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD 2K Remain",
            "expression": " [# of Enrol PD 2K]-[# of Enrol PD 2K Target]",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD Over 4K Remain",
            "expression": " [# of Enrol PD Over 4K]-[# of Enrol PD Over 4K Target]",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol PD 1K vs Target",
            "expression": " DIVIDE( [# of Enrol PD 1K],[# of Enrol PD 1K Target],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol PD 3K vs Target",
            "expression": " DIVIDE( [# of Enrol PD 3K],[# of Enrol PD 3K Target],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol PD vs Target",
            "expression": " DIVIDE( [# of Enrol PD],[# of Enrol PD Target],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "New Enrol PD Revenue 2K Target Amt",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=9, 'ASA Target'[Target Key]=\"Two\")",
            "displayFolder": "Revenue"
          },
          {
            "name": "New Enrol PD Revenue Over 4K Target Amt",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=9, 'ASA Target'[Target Key]=\"Four\")",
            "displayFolder": "Revenue"
          },
          {
            "name": "Re Enrol PD Revenue 1K Target Amt",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=10, 'ASA Target'[Target Key]=\"One\")",
            "displayFolder": "Revenue"
          },
          {
            "name": "Re Enrol PD Revenue 3K Target Amt",
            "expression": " CALCULATE(SUM('ASA Target'[Target Value]),'ASA Target'[Target Group Type]=7,'ASA Target'[Target Type]=10, 'ASA Target'[Target Key]=\"Three\")",
            "displayFolder": "Revenue"
          },
          {
            "name": "Re Enrol PD Revenue Target Amt",
            "expression": " [Re Enrol PD Revenue 1K Target Amt] +  [Re Enrol PD Revenue 2K Target Amt] +  [Re Enrol PD Revenue 3K Target Amt] +  [Re Enrol PD Revenue Over 4K Target Amt]",
            "displayFolder": "Revenue"
          },
          {
            "name": "Enrol PD Revenue 2K Target Amt",
            "expression": " [New Enrol PD Revenue 2K Target Amt] + [Re Enrol PD Revenue 2K Target Amt]",
            "displayFolder": "Revenue"
          },
          {
            "name": "Enrol PD Revenue Over 4K Target Amt",
            "expression": " [New Enrol PD Revenue Over 4K Target Amt] + [Re Enrol PD Revenue Over 4K Target Amt]",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Enrol PD Revenue 1K Amt vs Target",
            "expression": " DIVIDE([Enrol PD Revenue 1K Amt],[Enrol PD Revenue 1K Target Amt],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Enrol PD Revenue 3K Amt vs Target",
            "expression": " DIVIDE([Enrol PD Revenue 3K Amt],[Enrol PD Revenue 3K Target Amt],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "% Enrol PD Revenue Amt vs Target",
            "expression": " DIVIDE([Enrol PD Revenue Amt],[Enrol PD Revenue Target Amt],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Enrol PD before the period",
            "expression": " [# of Enrol PD] - [# of Enrol PD in the period]",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD before the period QTD",
            "expression": " [# of Enrol PD QTD] - [# of Enrol PD in the period QTD]",
            "displayFolder": "Enrol"
          },
          {
            "name": "% Enrol PD before Period MTD vs LM",
            "expression": " DIVIDE([# of Enrol PD before the period MTD],[# of Enrol PD LM],BLANK())",
            "formatString": "0%;-0%;0%",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD MTD LY",
            "expression": [
              "  CALCULATE([# of Enrol PD MTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
              ""
            ],
            "displayFolder": "Enrol"
          },
          {
            "name": "Enrol PD Revenue Amt MTD LY",
            "expression": [
              "  CALCULATE([Enrol PD Revenue Amt MTD], SAMEPERIODLASTYEAR('Calendar'[Date]))",
              ""
            ],
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "Enrol PD Revenue Amt MTD",
            "expression": " CALCULATE([Enrol PD Revenue Amt], DATESMTD('Calendar'[Date]))",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of New Enrol PD",
            "description": "0",
            "expression": " CALCULATE(sum('ASA Overview PD'[Number Of New Enrol]))",
            "formatString": "#,0",
            "displayFolder": "Enrol"
          },
          {
            "name": "MKT Amt",
            "expression": " CALCULATE(SUM('ASA Overview PD'[MKT Amount]))",
            "formatString": "#,0",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Invoice PD",
