          },
          {
            "name": "PD Revenue Amt",
            "expression": " CALCULATE(sum('ASA Overview PD'[Payment Revenue Amount]))",
            "displayFolder": "Revenue"
          },
          {
            "name": "# of Enrol PD in the period",
            "expression": [
              " ",
              "var from_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview PD'[Number Of Enrol]),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD LM",
            "expression": "  CALCULATE([# of Enrol PD],PREVIOUSMONTH('Calendar'[Date]))",
            "formatString": "0",
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD YTD",
            "expression": [
              " ",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview PD'[Number Of Enrol]),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD in the period MTD",
            "expression": [
              " ",
              "var from_month_date = max('Calendar'[First Day Of Month])",
              "var from_report_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview PD'[Number Of Enrol]),ALL('Calendar'[Date]),'Calendar'[Date] >= from_month_date && 'Calendar'[Date] <=to_date && 'Calendar'[Date] >= from_report_date)"
            ],
            "displayFolder": "Enrol"
          },
          {
            "name": "# of Enrol PD in the period YTD",
            "expression": [
              " ",
              "var from_date = min('Calendar'[First Day Of Year])",
              "var from_report_date = min('Calendar'[Date])",
              "var to_date = max('Calendar'[Date])",
              "return CALCULATE(SUM('ASA Overview PD'[Number Of Enrol]),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date && 'Calendar'[Date] >= from_report_date)"
            ],
            "displayFolder": "Enrol"
          },
          {
            "name": "% CR in the period",
