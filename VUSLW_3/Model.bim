          },
          {
            "type": "calculated",
            "name": "Is_Current",
            "dataType": "boolean",
            "isDataTypeInferred": true,
            "expression": "AND(TODAY()<='List Class'[Date Of Close],TODAY()>='List Class'[Date Of Open])",
            "formatString": "\"TRUE\";\"TRUE\";\"FALSE\""
          }
        ],
        "partitions": [
