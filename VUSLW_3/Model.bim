              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_ASA_OFFTRACK_REENROLLMENT_F = Source{[Schema=\"DWH\",Item=\"VW_ASA_OFFTRACK_REENROLLMENT_F\"]}[Data]",
                "in",
                "    DWH_VW_ASA_OFFTRACK_REENROLLMENT_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of OfftrackInformation NoOfOfftrack",
            "expression": "CALCULATE(SUM('ASA Offtrack Information'[IS_OFFTRACK]))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of OfftrackInformation NoOfOntrack",
            "expression": "CALCULATE(SUM('ASA Offtrack Information'[IS_ONTRACK]))",
            "formatString": "\"\"#,0;(\"\"#,0);\"\"#,0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% OfftrackInformation OntrackRate",
            "expression": "DIVIDE([# of OfftrackInformation NoOfOntrack],[# of OfftrackInformation NoOfOfftrack],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          }
        ]
      },
      {
        "name": "Invoice Promotion",
        "columns": [
          {
            "name": "Date Key",
            "dataType": "int64",
            "sourceColumn": "Date Key"
          },
          {
            "name": "Branch Code",
            "dataType": "string",
            "sourceColumn": "Branch Code"
          },
          {
            "name": "Branch Key",
            "dataType": "string",
            "sourceColumn": "Branch Key"
          },
          {
            "name": "Student Key",
            "dataType": "string",
            "sourceColumn": "Student Key"
          },
          {
            "name": "Student Code",
            "dataType": "string",
            "sourceColumn": "Student Code"
          },
          {
            "name": "User Information ID",
            "dataType": "string",
            "sourceColumn": "User Information ID"
          },
          {
            "name": "Registration ID",
            "dataType": "string",
            "sourceColumn": "Registration ID"
          },
          {
            "name": "List Class Code",
            "dataType": "string",
            "sourceColumn": "List Class Code"
          },
          {
            "name": "List Class Key",
            "dataType": "string",
            "sourceColumn": "List Class Key"
          },
          {
            "name": "List Level Code",
            "dataType": "string",
            "sourceColumn": "List Level Code"
          },
          {
            "name": "Level Key",
            "dataType": "string",
            "sourceColumn": "Level Key"
          },
          {
            "name": "Student Type",
            "dataType": "string",
            "sourceColumn": "Student Type"
          },
          {
            "name": "Description",
            "dataType": "string",
            "sourceColumn": "Description"
          },
          {
            "name": "Promotion Program Code",
            "dataType": "string",
            "sourceColumn": "Promotion Program Code"
          },
          {
            "name": "Promotion Package Code",
            "dataType": "string",
            "sourceColumn": "Promotion Package Code"
          },
          {
            "name": "Promotion Package Line",
            "dataType": "string",
            "sourceColumn": "Promotion Package Line"
          },
          {
            "name": "Promotion Type",
            "dataType": "string",
            "sourceColumn": "Promotion Type"
          },
          {
            "name": "Voucher Source",
            "dataType": "string",
            "sourceColumn": "Voucher Source"
          },
          {
            "name": "Discount Type",
            "dataType": "string",
            "sourceColumn": "Discount Type"
          },
          {
            "name": "Before Discount",
            "dataType": "double",
            "sourceColumn": "Before Discount"
          },
          {
            "name": "Discount Amount",
            "dataType": "int64",
            "sourceColumn": "Discount Amount"
          },
          {
            "name": "Final Payment",
            "dataType": "double",
            "sourceColumn": "Final Payment"
          },
          {
            "name": "Discount Order",
            "dataType": "int64",
            "sourceColumn": "Discount Order"
          },
          {
            "name": "ASA Source Mapping",
            "dataType": "string",
            "sourceColumn": "ASA Source Mapping"
          },
          {
            "name": "Number Of Enrol",
            "dataType": "int64",
            "sourceColumn": "Number Of Enrol"
          },
          {
            "name": "Source Information Key",
            "dataType": "string",
            "sourceColumn": "Source Information Key"
          },
          {
            "name": "Deducted Session",
            "dataType": "int64",
            "sourceColumn": "Deducted Session"
          },
          {
            "type": "calculated",
            "name": "Student Hours of Student",
            "dataType": "double",
            "expression": "('Invoice Promotion'[Number Of Enrol] *RELATED('Course'[Student Hours Program])) -('Invoice Promotion'[Deducted Session]*RELATED('Course'[Hours Per Session]))"
          },
          {
            "type": "calculated",
            "name": "Gross Amount",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "CALCULATE(MAX('Invoice Promotion'[Before Discount]),FILTER('Invoice Promotion',[Registration ID]=EARLIER([Registration ID])))"
          },
          {
            "type": "calculated",
            "name": "TotalDiscount",
            "dataType": "int64",
            "isDataTypeInferred": true,
            "expression": "CALCULATE(SUM('Invoice Promotion'[Discount Amount]),FILTER('Invoice Promotion',[Registration ID]=EARLIER([Registration ID])))"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_INVOICE_PAYMENT_ALL_DISCOUNT_F = Source{[Schema=\"DWH\",Item=\"VW_INVOICE_PAYMENT_ALL_DISCOUNT_F\"]}[Data]",
                "in",
                "    DWH_VW_INVOICE_PAYMENT_ALL_DISCOUNT_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of New Student Siblings Discount",
            "expression": " CALCULATE(DISTINCTCOUNT('Invoice Promotion'[Student Key]),FILTER('Invoice Promotion','Invoice Promotion'[Student Type]=\"New\" && 'Invoice Promotion'[Voucher Source]=\"Sibling\" && 'Invoice Promotion'[Discount Type]=\"Voucher\"))"
          },
          {
            "name": "# of Student Hours of Student",
            "expression": "CALCULATE(SUm('Invoice Promotion'[Student Hours of Student]))",
            "formatString": "0.0"
          },
          {
            "name": "# of Net Tuition",
            "expression": [
              " ",
              "CALCULATE(",
              "",
              "SUMX(",
              "    SUMMARIZE(",
              "       ",
              "         'Invoice Promotion',",
              "         'Invoice Promotion'[Registration ID],",
              "        \"Payment\", AVERAGE('Invoice Promotion'[Final Payment])",
              "    ),",
              "    [Payment]",
              ")",
              ")",
              ""
            ],
            "formatString": "\"\"#,0.0;(\"\"#,0.0);\"\"#,0.0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"1\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "# of Fee/Std/Hrs",
            "expression": " DIVIDE( 'Invoice Promotion'[# of Net Tuition],'Invoice Promotion'[# of Student Hours of Student],0.0)",
            "formatString": "\"\"#,0.0;(\"\"#,0.0);\"\"#,0.0",
            "annotations": [
              {
                "name": "Format",
                "value": "<Format Format=\"Currency\" Accuracy=\"1\"><Currency LCID=\"1033\" DisplayName=\"\" Symbol=\"\" PositivePattern=\"0\" NegativePattern=\"0\" /></Format>"
              }
            ]
          },
          {
            "name": "% of Promotion",
            "expression": [
              " ",
              "DIVIDE(sum('Invoice Promotion'[TotalDiscount]),sum('Invoice Promotion'[Gross Amount]),0)",
              "--DIVIDE(CALCULATE(SUM('Invoice Promotion'[Discount Amount]),ALLEXCEPT('Invoice Promotion','Invoice Promotion'[Registration ID])),CALCULATE(MAX('Invoice Promotion'[Before Discount]),ALLEXCEPT('Invoice Promotion','Invoice Promotion'[Registration ID])),0.0)"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Target Promotion NEW 35%",
            "expression": " 0.35",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion PY",
            "expression": " CALCULATE('Invoice Promotion'[% of Promotion],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion New",
            "expression": [
              " ",
              "CALCULATE(DIVIDE(sum('Invoice Promotion'[TotalDiscount]),sum('Invoice Promotion'[Gross Amount]),0),'Invoice Promotion'[Student Type]=\"New\")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion RE",
            "expression": [
              " ",
              "CALCULATE(DIVIDE(sum('Invoice Promotion'[TotalDiscount]),sum('Invoice Promotion'[Gross Amount]),0),'Invoice Promotion'[Student Type]=\"RE\")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion New PY",
            "expression": " CALCULATE('Invoice Promotion'[% Promotion New],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion RE PY",
            "expression": " CALCULATE('Invoice Promotion'[% Promotion RE],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion YTD",
            "expression": [
              "",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE(DIVIDE(sum('Invoice Promotion'[TotalDiscount]),sum('Invoice Promotion'[Gross Amount]),0),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion YTD PY",
            "expression": " CALCULATE('Invoice Promotion'[% Promotion YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Target Promotion RE 18%",
            "expression": "0.18",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Target Promotion 26%",
            "expression": "0.26",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion New YTD",
            "expression": [
              "",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE(CALCULATE(DIVIDE(sum('Invoice Promotion'[TotalDiscount]),sum('Invoice Promotion'[Gross Amount]),0),'Invoice Promotion'[Student Type]=\"New\"),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion New YTD PY",
            "expression": " CALCULATE('Invoice Promotion'[% Promotion New YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion RE YTD",
            "expression": [
              "",
              " var from_date = min('Calendar'[First Day Of Year])",
              " var to_date = max('Calendar'[Date])",
              " return CALCULATE(CALCULATE(DIVIDE(sum('Invoice Promotion'[TotalDiscount]),sum('Invoice Promotion'[Gross Amount]),0),'Invoice Promotion'[Student Type]=\"RE\"),ALL('Calendar'[Date]),'Calendar'[Date] >= from_date && 'Calendar'[Date] <=to_date)"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion RE YTD PY",
            "expression": " CALCULATE('Invoice Promotion'[% Promotion RE YTD],SAMEPERIODLASTYEAR('Calendar'[Date]))",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% of Promotion vs Target",
            "expression": " DIVIDE('Invoice Promotion'[% of Promotion],'Invoice Promotion'[% Target Promotion 26%])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion New vs Target",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion New],'Invoice Promotion'[% Target Promotion NEW 35%])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion RE vs Target",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion RE],'Invoice Promotion'[% Target Promotion RE 18%])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion PY vs Target",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion PY],'Invoice Promotion'[% Target Promotion 26%])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion New PY vs Target",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion New PY],'Invoice Promotion'[% Target Promotion NEW 35%])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion RE PY vs Target",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion RE PY],'Invoice Promotion'[% Target Promotion RE 18%])",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% Promotion vs PY",
            "expression": " DIVIDE('Invoice Promotion'[% of Promotion],'Invoice Promotion'[% Promotion PY])"
          },
          {
            "name": "% Promotion YTD vs PY",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion YTD],'Invoice Promotion'[% Promotion YTD PY])"
          },
          {
            "name": "% Promotion RE vs PY",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion RE],'Invoice Promotion'[% Promotion RE PY])"
          },
          {
            "name": "% Promotion RE YTD vs PY",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion RE YTD],'Invoice Promotion'[% Promotion RE YTD PY])"
          },
          {
            "name": "% Promotion New vs PY",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion New],'Invoice Promotion'[% Promotion New PY])"
          },
          {
            "name": "% Promotion New YTD vs PY",
            "expression": " DIVIDE('Invoice Promotion'[% Promotion New YTD],'Invoice Promotion'[% Promotion New YTD PY])"
          }
        ]
      },
      {
        "name": "Student ILE Result",
        "columns": [
          {
            "name": "DATE_KEY",
            "dataType": "int64",
            "sourceColumn": "DATE_KEY"
          },
          {
            "name": "STUDENT_KEY",
            "dataType": "string",
            "sourceColumn": "STUDENT_KEY"
          },
          {
            "name": "CAMPUS_KEY",
            "dataType": "string",
            "sourceColumn": "CAMPUS_KEY"
          },
          {
            "name": "LEVEL_KEY",
            "dataType": "string",
            "sourceColumn": "LEVEL_KEY"
          },
          {
            "name": "COURSE_TYPE_CODE",
            "dataType": "string",
            "sourceColumn": "COURSE_TYPE_CODE"
          },
          {
            "name": "TUTORTYPE",
            "dataType": "string",
            "sourceColumn": "TUTORTYPE"
          },
          {
            "name": "CLASSOBSERVE",
            "dataType": "string",
            "sourceColumn": "CLASSOBSERVE"
          },
          {
            "name": "MINI_TEST1_LISTENING",
            "dataType": "double",
            "sourceColumn": "MINI_TEST1_LISTENING"
          },
          {
            "name": "MINI_TEST1_READING",
            "dataType": "double",
            "sourceColumn": "MINI_TEST1_READING"
          },
          {
            "name": "MINI_TEST2_LISTENING",
            "dataType": "double",
            "sourceColumn": "MINI_TEST2_LISTENING"
          },
          {
            "name": "MINI_TEST2_READING",
            "dataType": "double",
            "sourceColumn": "MINI_TEST2_READING"
          },
          {
            "name": "MINI_TEST3_LISTENING",
            "dataType": "double",
            "sourceColumn": "MINI_TEST3_LISTENING"
          },
          {
            "name": "MINI_TEST3_READING",
            "dataType": "double",
            "sourceColumn": "MINI_TEST3_READING"
          },
          {
            "name": "CLASSSTUDYING",
            "dataType": "string",
            "sourceColumn": "CLASSSTUDYING"
          },
          {
            "name": "MINI_TEST2_LISTENING_CURRENT",
            "dataType": "double",
            "sourceColumn": "MINI_TEST2_LISTENING_CURRENT"
          },
          {
            "name": "MINI_TEST2_READING_CURRENT",
            "dataType": "double",
            "sourceColumn": "MINI_TEST2_READING_CURRENT"
          },
          {
            "name": "STUDYTUTORING",
            "dataType": "string",
            "sourceColumn": "STUDYTUTORING"
          },
          {
            "type": "calculated",
            "name": "MINI_TEST1",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "([MINI_TEST1_LISTENING]+[MINI_TEST1_READING])/10"
          },
          {
            "type": "calculated",
            "name": "MINI_TEST2",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "([MINI_TEST2_LISTENING]+[MINI_TEST2_READING])/10"
          },
          {
            "name": "LEVELCODE",
            "dataType": "string",
            "sourceColumn": "LEVELCODE"
          },
          {
            "name": "MOCK_TEST_OVERALL",
            "dataType": "double",
            "sourceColumn": "MOCK_TEST_OVERALL"
          },
          {
            "type": "calculated",
            "name": "IMPROVE_CURRENT",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": [
              "IF(",
              "   ( [LEVELCODE] = \"ILE4.A\" && [MOCK_TEST_OVERALL] > 3.5 ) ||",
              "   ( [LEVELCODE] = \"ILE4.B\" && [MOCK_TEST_OVERALL] > 4 ) ||",
              "   ( [LEVELCODE] = \"ILE5.A\" && [MOCK_TEST_OVERALL] > 4.5) ||",
              "   ( [LEVELCODE] = \"ILE5.B\" && [MOCK_TEST_OVERALL] > 5) ||",
              "   ( [LEVELCODE] = \"ILE6.A\" && [MOCK_TEST_OVERALL] > 5.5) ||",
              "   ( [LEVELCODE] = \"ILE6.B\" && [MOCK_TEST_OVERALL] > 6) ||",
              "   ( [LEVELCODE] = \"ILE7.A\" && [MOCK_TEST_OVERALL] > 6.5) ||",
              "   ( [LEVELCODE] = \"ILE7.B\" && [MOCK_TEST_OVERALL] > 7),",
              "    \"Yes\",",
              "    \"No\"",
              ")"
            ]
          },
          {
            "type": "calculated",
            "name": "IMPROVE_PRE",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "IF([TUTORTYPE]=\"Mock test/TB mini-test\" && [MINI_TEST2_CURRENT] > 6 , \"Yes\",\"No\")"
          },
          {
            "type": "calculated",
            "name": "MINI_TEST2_CURRENT",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "([MINI_TEST2_LISTENING_CURRENT]+[MINI_TEST2_READING_CURRENT])/10"
          },
          {
            "type": "calculated",
            "name": "AVERAGE_MINITEST",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              "([MINI_TEST1]+[MINI_TEST2]+[MINI_TEST3])/3",
              ""
            ]
          },
          {
            "type": "calculated",
            "name": "MINI_TEST3",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "([MINI_TEST3_LISTENING]+[MINI_TEST3_READING])/10"
          },
          {
            "type": "calculated",
            "name": "MINITEST1/MINITEST2",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": "IF([MINI_TEST1] <=6,[MINI_TEST1],IF([MINI_TEST2]<=6,[MINI_TEST2]))"
          },
          {
            "type": "calculated",
            "name": "MOCKTEST/MINITEST",
            "dataType": "double",
            "isDataTypeInferred": true,
            "expression": [
              "IF([AVERAGE_MINITEST] <= 6, [AVERAGE_MINITEST], IF(([LEVELCODE] = \"ILE4.A\" && [MOCK_TEST_OVERALL] <= 3.5) ||",
              "    ([LEVELCODE] = \"ILE4.B\" && [MOCK_TEST_OVERALL] <= 4) ||",
              "    ([LEVELCODE] = \"ILE5.A\" && [MOCK_TEST_OVERALL] <= 4.5) ||",
              "    ([LEVELCODE] = \"ILE5.B\" && [MOCK_TEST_OVERALL] <= 5) ||",
              "    ([LEVELCODE] = \"ILE6.A\" && [MOCK_TEST_OVERALL] <= 5.5) ||",
              "    ([LEVELCODE] = \"ILE6.B\" && [MOCK_TEST_OVERALL] <= 6) ||",
              "    ([LEVELCODE] = \"ILE7.A\" && [MOCK_TEST_OVERALL] <= 6.5) ||",
              "    ([LEVELCODE] = \"ILE7.B\" && [MOCK_TEST_OVERALL] <= 7),[MOCK_TEST_OVERALL]))"
            ]
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_CHECK_STUDENT_PROGRESS_ILE_AFTER_TUTORING = Source{[Schema=\"DWH\",Item=\"VW_CHECK_STUDENT_PROGRESS_ILE_AFTER_TUTORING\"]}[Data]",
                "in",
                "    DWH_VW_CHECK_STUDENT_PROGRESS_ILE_AFTER_TUTORING"
              ]
            }
          }
        ]
      },
