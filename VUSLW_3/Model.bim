            "sourceColumn": "LevelCode"
          },
          {
            "name": "ClassCode",
            "dataType": "string",
            "sourceColumn": "ClassCode"
          },
          {
            "name": "StudentCode",
            "dataType": "string",
            "sourceColumn": "StudentCode"
          },
          {
            "name": "FullName",
            "dataType": "string",
            "sourceColumn": "FullName"
          },
          {
            "name": "Final Result",
