            "dataType": "string",
            "sourceColumn": "MainCampusKey"
          },
          {
            "name": "MainCampusCode",
            "dataType": "string",
            "sourceColumn": "MainCampusCode"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TQM_RETENTION_RATE_FOR_TEACHER_F = Source{[Schema=\"DWH\",Item=\"VW_TQM_RETENTION_RATE_FOR_TEACHER_F\"]}[Data]",
                "in",
                "    DWH_VW_TQM_RETENTION_RATE_FOR_TEACHER_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "% RetentionRateForTeacher (HomeCampus)",
            "expression": [
              "",
              "VAR _Num =",
              "    SUMX(",
              "        'TQM Retention Rate For Teacher I HomeCampus',",
              "        'TQM Retention Rate For Teacher I HomeCampus'[RetentionRate] *",
              "        'TQM Retention Rate For Teacher I HomeCampus'[ActualTeachingRate]",
              "    )",
              "VAR _Den =",
              "    SUM('TQM Retention Rate For Teacher I HomeCampus'[ActualTeachingRate])",
              "RETURN",
              "DIVIDE(_Num, _Den,0)"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% ActualTeachingRate (HomeCampus)",
            "expression": [
              "",
              "VAR Rate =",
              "    DIVIDE(",
              "        SUM('TQM Retention Rate For Teacher I HomeCampus'[ActutalLesson]),",
              "        SUM('TQM Retention Rate For Teacher I HomeCampus'[PlanLesson]),",
              "        0",
              "    )",
              "RETURN",
              "    MIN(Rate, 1)"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "% RetentionRate (HomeCampus)",
            "expression": [
              "",
              "DIVIDE(",
              "    SUM('TQM Retention Rate For Teacher I HomeCampus'[TotalReEnrolledStudents]),",
              "    SUM('TQM Retention Rate For Teacher I HomeCampus'[TotalCourseCompleters]),",
              "    0",
              ")"
            ],
            "formatString": "0.0%;-0.0%;0.0%"
          }
        ]
      },
