      {
        "name": "Teaching Hours Detail",
        "columns": [
          {
            "name": "TeacherProfileKey",
            "dataType": "string",
            "sourceColumn": "TeacherProfileKey"
          },
          {
            "name": "ClassKey",
            "dataType": "string",
            "sourceColumn": "ClassKey"
          },
          {
            "name": "LevelProgramKey",
            "dataType": "string",
            "sourceColumn": "LevelProgramKey"
          },
          {
            "name": "CampusKey",
            "dataType": "string",
            "sourceColumn": "CampusKey"
          },
          {
            "name": "ScheduleDateKey",
            "dataType": "string",
            "sourceColumn": "ScheduleDateKey"
          },
          {
            "name": "TypeOfTeachingHours",
            "dataType": "string",
            "sourceColumn": "TypeOfTeachingHours"
          },
          {
            "name": "RealTotalHour",
            "dataType": "double",
            "sourceColumn": "RealTotalHour"
          },
          {
            "name": "TeacherContractType",
            "dataType": "string",
            "sourceColumn": "TeacherContractType"
          },
          {
            "name": "FulltimeTypeCode",
            "dataType": "string",
            "sourceColumn": "FulltimeTypeCode"
          },
          {
            "name": "FulltimeTypeName",
            "dataType": "string",
            "sourceColumn": "FulltimeTypeName"
          },
          {
            "name": "TeachingCampus",
            "dataType": "string",
            "sourceColumn": "TeachingCampus"
          },
          {
            "name": "HomeCampus",
            "dataType": "string",
            "sourceColumn": "HomeCampus"
          },
          {
            "name": "StartDate",
            "dataType": "dateTime",
            "sourceColumn": "StartDate"
          },
          {
            "name": "EndDate",
            "dataType": "dateTime",
            "sourceColumn": "EndDate"
          },
          {
            "name": "StartTime",
            "dataType": "string",
            "sourceColumn": "StartTime"
          },
          {
            "name": "EndTime",
            "dataType": "string",
            "sourceColumn": "EndTime"
          },
          {
            "name": "ListGroupTime",
            "dataType": "string",
            "sourceColumn": "ListGroupTime"
          },
          {
            "name": "ListClassScheduleID",
            "dataType": "string",
            "sourceColumn": "ListClassScheduleID"
          },
          {
            "name": "Source",
            "dataType": "string",
            "sourceColumn": "Source"
          },
          {
            "name": "DeductTime",
            "dataType": "double",
            "sourceColumn": "DeductTime"
          },
          {
            "name": "ReasonForDeduction",
            "dataType": "string",
            "sourceColumn": "ReasonForDeduction"
          },
          {
            "name": "TypeOfDeduction",
            "dataType": "string",
            "sourceColumn": "TypeOfDeduction"
          },
          {
            "name": "TotalHour",
            "dataType": "double",
            "sourceColumn": "TotalHour"
          },
          {
            "name": "IsWaive",
            "dataType": "string",
            "sourceColumn": "IsWaive"
          },
          {
            "name": "Salary Month Year",
            "dataType": "string",
            "sourceColumn": "Salary Month Year"
          },
          {
            "name": "IsActive",
            "dataType": "string",
            "sourceColumn": "IsActive"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_TEACHER_HOUR_DETAIL_F = Source{[Schema=\"DWH\",Item=\"VW_TEACHER_HOUR_DETAIL_F\"]}[Data]",
                "in",
                "    DWH_VW_TEACHER_HOUR_DETAIL_F"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of Scheduled Classes",
            "expression": " CALCULATE(DISTINCTCOUNT('Teaching Hours Detail'[ClassKey]))"
          },
          {
            "name": "Total Real Hour",
            "expression": " CALCULATE(Sum('Teaching Hours Detail'[RealTotalHour]))"
          },
          {
            "name": "% SubTime vs Total Time",
            "expression": " DIVIDE('Teaching Hours Detail'[Total Sub Hours],'Teaching Hours Detail'[Total Real Hour],BLANK())",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "Top 10 Campus",
            "expression": " IF([Ranking Campus] <=10,[Total Sub Hours])"
          },
          {
            "name": "Ranking Campus",
            "expression": [
              " IF([Total Sub Hours] >0,",
              "\t\t\tRANKX(ALLSELECTED('Campus'[Campus Code]),[Total Sub Hours],,DESC,DENSE))",
              "\t\t\t"
            ]
          },
          {
            "name": "# of Campus by Sub Time",
            "expression": [
              " ",
              "\t\t\tSUMX(VALUES('Teacher'[Teacher Code]),",
              "\t\t\tCALCULATE(COUNTX('Teaching Hours Detail','Teaching Hours Detail'[TeachingCampus]),'Teaching Hours Detail'[TypeOfTeachingHours]=\"Sub Hour\"))"
            ]
          },
          {
            "name": "Total Main Hour",
            "expression": [
              "",
              "\t\tCALCULATE (",
              "   \t\t\t SUMX (",
              "      \t\t\t\t  VALUES ( 'Teaching Hours Detail'[ScheduleDateKey] ),",
              "        \t\t\t\t\t'Teaching Hours Detail'[Total Real Hour]",
              "    \t\t\t\t),",
              "    \t\t\t'Teaching Hours Detail'[TypeOfTeachingHours] = \"Main Hour\"",
              ")"
            ]
          },
          {
            "name": "Total Sub Hours",
            "expression": [
              "",
              "\t\tCALCULATE (",
              "   \t\t\t SUMX (",
              "      \t\t\t\t  VALUES ( 'Teaching Hours Detail'[ScheduleDateKey] ),",
              "        \t\t\t\t\t'Teaching Hours Detail'[Total Real Hour]",
              "    \t\t\t\t),",
              "    \t\t\t'Teaching Hours Detail'[TypeOfTeachingHours] = \"Sub Hour\"",
              ")"
            ]
          },
          {
            "name": "Average Sub Hours",
            "expression": [
              "",
              "        VAR MonthlyHours =",
              "            ADDCOLUMNS (",
              "                DISTINCT ( 'Calendar'[Month] ),",
              "                \"@MonthlyHours\", [Total Sub Hours]",
              "            )",
              "    VAR TotalHour = FILTER(MonthlyHours, [@MonthlyHours] > 0)",
              "    VAR Result = AVERAGEX(TotalHour, [@MonthlyHours])",
              "  Return Result"
            ]
          },
          {
            "name": "Average Main Hour",
            "expression": [
              "",
              "        VAR MonthlyHours =",
              "            ADDCOLUMNS (",
              "                DISTINCT ( 'Calendar'[Month] ),",
              "                \"@MonthlyHours\", [Total Main Hour]",
              "            )",
              "    VAR TotalHour = FILTER(MonthlyHours, [@MonthlyHours] > 0)",
              "    VAR Result = AVERAGEX(TotalHour, [@MonthlyHours])",
              "  Return Result"
            ]
          }
        ]
      },
