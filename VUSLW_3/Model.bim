          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"Warehouse-VUSDWHPRO\",",
                "    DWH_VW_OFFTRACK = Source{[Schema=\"DWH\",Item=\"VW_OFFTRACK\"]}[Data]",
                "in",
                "    DWH_VW_OFFTRACK"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "# of OffTrack",
            "expression": "CALCULATE(DISTINCTCOUNT('OffTrack'[Userinformation Key]),FILTER('OffTrack','OffTrack'[Is Offtrack]=1)) +0"
          },
          {
            "name": "# of OnTrack",
            "expression": "CALCULATE(DISTINCTCOUNT('OffTrack'[Userinformation Key]),FILTER('OffTrack','OffTrack'[Is Ontrack]=1)) +0"
          },
          {
            "name": "# of OffTrackByPending",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Is Booking]=\"P\")) +0"
          },
          {
            "name": "# of OffTrackByReject",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Is Booking]=\"N\"))+0"
          },
          {
            "name": "# of OffTrackByRegis",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Is Booking]=\"Y\")) + 0"
          },
          {
            "name": "% OffTrackVsOnTrack",
            "expression": "DIVIDE('OffTrack'[# of OnTrack],'OffTrack'[# of OffTrack],BLANK()) +0",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of ClassOfftrack",
            "expression": "CALCULATE(DISTINCTCOUNT('OffTrack'[List Class Key])) +0"
          },
          {
            "name": "# of OffTrackByTutoring",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Type Offtrack Name]=\"Offtrack tutoring\"))+0"
          },
          {
            "name": "# of OffTrackByReviewOfffline",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Type Offtrack Name]=\"Offtrack By Teacher\"))+0"
          },
          {
            "name": "# of OffTrackByASA",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Type Offtrack Name]=\"Offtrack By ASA\")) +0"
          },
          {
            "name": "# of OffTrackIsCare",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Is Care]=1))+0"
          },
          {
            "name": "# of OffTrackByRegis_One_Times",
            "expression": [
              "CALCULATE('OffTrack'[# of OffTrackByRegis],FILTER(",
              "        SUMMARIZE('OffTrack','OffTrack'[Offtrack Class Code],\"Total\",COUNT('OffTrack'[Offtrack Class Code]))",
              "\t\t,[Total] = 1))+0"
            ]
          },
          {
            "name": "# of OffTrackByRegis_2_Times",
            "expression": [
              "CALCULATE('OffTrack'[# of OffTrackByRegis],FILTER(",
              "        SUMMARIZE('OffTrack','OffTrack'[Offtrack Class Code],\"Total\",COUNT('OffTrack'[Offtrack Class Code]))",
              "\t\t,[Total] = 2)) +0"
            ]
          },
          {
            "name": "# of OffTrackByRegis_More_Times",
            "expression": [
              "CALCULATE('OffTrack'[# of OffTrackByRegis],FILTER(",
              "        SUMMARIZE('OffTrack','OffTrack'[Offtrack Class Code],\"Total\",COUNT('OffTrack'[Offtrack Class Code]))",
              "\t\t,[Total] >=3)) + 0"
            ]
          },
          {
            "name": "# of OffTrackByConditionBookingOviApp",
            "expression": [
              "CALCULATE('OffTrack'[# of OffTrack],",
              "\t",
              "\tFILTER('Course','Course'[Course Type Group Code] IN {\"SK\",\"YL\"}) ,FILTER('OffTrack','OffTrack'[Tutoring Type] IN {\"Quiz 1\",\"Midterm\"}) ",
              "",
              ") + 0"
            ]
          },
          {
            "name": "# of OffTrackByRegisOviApp",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Is Booking]=\"Y\"),FILTER('OffTrack','OffTrack'[Source Of Demand]=\"OVI App\"))+0"
          },
          {
            "name": "# of OffTrackByRegisASATick",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Is Booking]=\"Y\"),FILTER('OffTrack','OffTrack'[Source Of Demand]=\"ASA TICK\"))+0"
          },
          {
            "name": "# of OffTrackByRegis_ShowByOvi",
            "expression": "CALCULATE('OffTrack'[# of OffTrackByConditionBookingOviApp],FILTER('OffTrack','OffTrack'[Is Booking]=\"Y\"))+0"
          },
          {
            "name": "# of OffTrackByRegisASATick_ShowByOvi",
            "expression": "CALCULATE('OffTrack'[# of OffTrackByConditionBookingOviApp],FILTER('OffTrack','OffTrack'[Is Booking]=\"Y\"),FILTER('OffTrack','OffTrack'[Source Of Demand]=\"ASA TICK\"))+0"
          },
          {
            "name": "# of OffTrackByRegisOviApp_ShowByOvi",
            "expression": "CALCULATE('OffTrack'[# of OffTrackByConditionBookingOviApp],FILTER('OffTrack','OffTrack'[Is Booking]=\"Y\"),FILTER('OffTrack','OffTrack'[Source Of Demand]=\"OVI App\")) + 0"
          },
          {
            "name": "# of OffTrackByReject_ShowByOvi",
            "expression": "CALCULATE('OffTrack'[# of OffTrackByConditionBookingOviApp],FILTER('OffTrack','OffTrack'[Is Booking]=\"N\")) + 0"
          },
          {
            "name": "# of OffTrackByPending_ShowByOvi",
            "expression": "CALCULATE('OffTrack'[# of OffTrackByConditionBookingOviApp],FILTER('OffTrack','OffTrack'[Is Booking]=\"P\")) + 0"
          },
          {
            "name": "# of Offtrack Tgd",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Year Month Charge] <> BLANK()) )"
          },
          {
            "name": "% OfftrackTgdVSTotalOfftrackBeforeMonth",
            "expression": "DIVIDE('OffTrack'[# of Offtrack Tgd],'OffTrack'[# of OfftrackBeforeMonth],BLANK())",
            "formatString": "0.00%;-0.00%;0.00%"
          },
          {
            "name": "# of OfftrackBeforeMonth",
            "expression": [
              "",
              "var year_month=SELECTEDVALUE('OffTrack'[Year Month Charge],MAX('OffTrack'[Year Month Charge]))",
              "RETURN CALCULATE(DISTINCTCOUNT('OffTrack'[Userinformation Key]),FILTER('OffTrack','OffTrack'[Is Offtrack]=1)",
              "                                  --,ALL('OffTrack'[Offtrack YM])",
              "                                  -- ,ALL('OffTrack')",
              "                                  ,FILTER('OffTrack',  'OffTrack'[Offtrack YM] <=IF(ISBLANK(year_month),\"1900-01\",year_month))",
              "                                  )"
            ]
          },
          {
            "name": "# of OffTrack KKHT By Regis",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Is Booking]=\"Y\"),FILTER('OffTrack',LEFT('OffTrack'[Objecttype Pushsale],17) = \"Kết khóa hết tiền\")) + 0"
          },
          {
            "name": "# of OffTrack KKHT By Regis Vs TGD",
            "expression": "CALCULATE('OffTrack'[# of OffTrack KKHT By Regis],FILTER('OffTrack','OffTrack'[Is Reenrolled]=1)) + 0"
          },
          {
            "name": "%  OffTrack KKHT By Regis Vs TGD",
            "expression": "DIVIDE('OffTrack'[# of OffTrack KKHT By Regis Vs TGD],'OffTrack'[# of OffTrack KKHT By Regis],0)",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of OffTrack KKHT By Reject",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Is Booking]=\"N\"),FILTER('OffTrack',LEFT('OffTrack'[Objecttype Pushsale],17) = \"Kết khóa hết tiền\")) + 0"
          },
          {
            "name": "# of OffTrack KKHT By Reject Vs TGD",
            "expression": "CALCULATE('OffTrack'[# of OffTrack KKHT By Reject],FILTER('OffTrack','OffTrack'[Is Reenrolled]=1)) + 0"
          },
          {
            "name": "% OffTrack KKHT By Reject Vs TGD",
            "expression": "DIVIDE('OffTrack'[# of OffTrack KKHT By Reject Vs TGD],'OffTrack'[# of OffTrack KKHT By Reject],0)",
            "formatString": "0.0%;-0.0%;0.0%"
          },
          {
            "name": "# of OffTrack KKHT",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack',LEFT('OffTrack'[Objecttype Pushsale],17) = \"Kết khóa hết tiền\")) + 0"
          },
          {
            "name": "# selectvalue",
            "expression": [
              "SELECTEDVALUE('OffTrack'[Year Month Charge],MAX('OffTrack'[Year Month Charge]))",
              ""
            ]
          },
          {
            "name": "% OffTrack TGD",
            "expression": "DIVIDE('OffTrack'[# of Offtrack Tgd],'OffTrack'[# of OffTrack],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "# of Offtrack Booking Tgd",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Year Month Charge] <> BLANK()),OffTrack[Is Booking]=\"Y\" )"
          },
          {
            "name": "# of Offtrack No Booking Tgd",
            "expression": "CALCULATE('OffTrack'[# of OffTrack],FILTER('OffTrack','OffTrack'[Year Month Charge] <> BLANK()),OffTrack[Is Booking]=\"N\" )"
          },
          {
            "name": "% of Offtrack Booking Tgd",
            "expression": " DIVIDE([# of Offtrack Booking Tgd],OffTrack[# of OffTrackByRegis],0)",
            "formatString": "0%;-0%;0%"
          },
          {
            "name": "% of Offtrack No Booking Tgd",
            "expression": " DIVIDE([# of Offtrack No Booking Tgd],OffTrack[# of OffTrackByReject],0)",
            "formatString": "0%;-0%;0%"
          }
        ]
      },
